back.NEWEST`` keeps only the newest one, and\n            ``AgeFallback.NONE`` returns an empty list so the caller can\n            implement its own fallback strategy.\n\n'''+s[b:]\ns=s.replace('''    if max_age_cutoff is not None:\n        logger.info(\n            \"%s: found''','''    if max_age_cutoff is not None and _is_pinned(provider, req):\n        logger.info(\n            \"%s: skipping age filter for pinned constraint (%d candidate(s))\",\n            req.name,\n            len(candidates_list),\n        )\n    elif max_age_cutoff is not None:\n        logger.info(\n            \"%s: found''',1)\na=s.index(\"        elif fallback_on_empty_age_filter:\")\nb=s.index(\"    # Convert candidates to list\")\ns=s[:a]+'''        elif age_fallback is AgeFallback.ALL:\n            logger.warning(\n                \"%s: all %d candidate(s) of %s are older than %d days, \"\n                \"keeping all to avoid empty resolution\",\n                req.name,\n                len(candidates_list),\n                req,\n                max_age_days,\n            )\n        elif age_fallback is AgeFallback.NEWEST:\n            # candidates are sorted by version, highest first\n            newest = candidates_list[:1]\n            logger.info(\n                \"%s: all %d candidate(s) of %s are older than %d days, \"\n                \"falling back to newest version %s\",\n                req.name,\n                len(candidates_list),\n                req,\n                max_age_days,\n                newest[0].version if newest else None,\n            )\n            candidates_list = newest\n        else:\n            logger.info(\n                \"%s: all %d candidate(s) of %s are older than %d days\",\n                req.name,\n                len(candidates_list),\n                req,\n                max_age_days,\n            )\n            candidates_list = []\n\n'''+s[b:]\nopen(p,'w').write(s)\n\np='src/fromager/bootstrap_requirement_resolver.py'\ns=open(p).read()\ns=s.replace(\"                fallback_on_empty_age_filter=not self.multiple_versions,\\n\",'''                # In multi-version mode, build the newest version when nothing is\n                # inside the age window to avoid cascading failures in dependents.\n                age_fallback=(\n                    resolver.AgeFallback.NEWEST\n                    if self.multiple_versions\n                    else resolver.AgeFallback.ALL\n                ),\n''')\nopen(p,'w').write(s)\n\np='tests/test_cooldown.py'\ns=open(p).read()\ns=s.replace(\"                fallback_on_empty_age_filter=False,\",\"                age_fallback=resolver.AgeFallback.NONE,\")\ns=s.replace(\"def test_max_release_age_candidates_without_upload_time_pass_through\",'''def test_max_release_age_all_too_old_newest_fallback(\n    caplog: pytest.LogCaptureFixture,\n) -> None:\n    \"\"\"AgeFallback.NEWEST keeps only the newest candidate and logs at INFO.\"\"\"\n    max_age_cutoff = _BOOTSTRAP_TIME + datetime.timedelta(days=1)\n    with requests_mock.Mocker() as r:\n        r.get(\n            \"https://pypi.org/simple/test-pkg/\",\n            json=_cooldown_json_response,\n            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n        )\n        provider = resolver.PyPIProvider(include_sdists=True)\n        with caplog.at_level(logging.INFO, logger=\"fromager.resolver\"):\n            results = resolver.find_all_matching_from_provider(\n                provider,\n                Requirement(\"test-pkg\"),\n                max_age_cutoff=max_age_cutoff,\n                age_fallback=resolver.AgeFallback.NEWEST,\n            )\n    assert [str(v) for _, v in results] == [\"2.0.0\"]\n    assert \"falling back to newest version 2.0.0\" in caplog.text\n    assert \"keeping all to avoid empty resolution\" not in caplog.text\n\n\ndef _pinned_provider(constraint: str) -> resolver.PyPIProvider:\n    constraints = Constraints()\n    constraints.add_constraint(constraint)\n    return resolver.PyPIProvider(include_sdists=True, constraints=constraints)\n\n\ndef test_max_release_age_pinned_constraint_skips_age_filter(\n    caplog: pytest.LogCaptureFixture,\n) -> None:\n    \"\"\"An exact ``==`` pin older than the window is kept, with no warning.\"\"\"\n    max_age_cutoff = _BOOTSTRAP_TIME + datetime.timedelta(days=1)\n    with requests_mock.Mocker() as r:\n        r.get(\n            \"https://pypi.org/simple/test-pkg/\",\n            json=_cooldown_json_response,\n            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n        )\n        provider = _pinned_provider(\"test-pkg==1.2.2\")\n        with caplog.at_level(logging.INFO, logger=\"fromager.resolver\"):\n            results = resolver.find_all_matching_from_provider(\n                provider,\n                Requirement(\"test-pkg\"),\n                max_age_cutoff=max_age_cutoff,\n                age_fallback=resolver.AgeFallback.NONE,\n            )\n    assert [str(v) for _, v in results] == [\"1.2.2\"]\n    assert (\n        \"test-pkg: skipping age filter for pinned constraint (1 candidate(s))\"\n        in caplog.text\n    )\n    assert \"keeping all to avoid empty resolution\" not in caplog.text\n\n\ndef test_max_release_age_range_constraint_is_still_filtered() -> None:\n    \"\"\"Range constraints are age-filtered like unconstrained packages.\"\"\"\n    max_age_cutoff = _BOOTSTRAP_TIME + datetime.timedelta(days=1)\n    with requests_mock.Mocker() as r:\n        r.get(\n            \"https://pypi.org/simple/test-pkg/\",\n            json=_cooldown_json_response,\n            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n        )\n        provider = _pinned_provider(\"test-pkg<2.0\")\n        results = resolver.find_all_matching_from_provider(\n            provider,\n            Requirement(\"test-pkg\"),\n            max_age_cutoff=max_age_cutoff,\n            age_fallback=resolver.AgeFallback.NONE,\n        )\n    assert results == []\n\