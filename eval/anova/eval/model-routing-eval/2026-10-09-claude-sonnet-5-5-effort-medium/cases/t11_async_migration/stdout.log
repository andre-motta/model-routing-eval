      self.calls = 0\n\n    def get(self, url):\n        if self.closed:\n            raise RuntimeError(\"client closed\")\n        delay = self.backoff\n        for attempt in range(1, self.retries + 1):\n            self.calls += 1\n            try:\n                return self.transport(url)\n            except TransientError:\n                if attempt == self.retries:\n                    raise\n                time.sleep(delay)\n                delay *= 2\n\n    def get_many(self, urls):\n        out = []\n        for u in urls:\n            try:\n                out.append(self.get(u))\n            except Exception as e:\n                out.append(FetchError(u, e))\n        return out\n\n    def close(self):\n        self.closed = True\n\n    def __enter__(self):\n        return self\n\n    def __exit__(self, *exc):\n        self.close()\n#!/usr/bin/env python3\nimport json, sys, shutil, os\nd = json.load(sys.stdin)\np = d.get('agent_transcript_path', '')\ndest = '/home/alustosa/git/model-routing-eval/.work/agent-eval/2026-10-09-claude-sonnet-5-5-effort-medium/cases/t11_async_migration/subagents'\nif p and os.path.isfile(p) and not os.path.islink(p):\n    os.makedirs(dest, exist_ok=True)\n    shutil.copy2(p, os.path.join(dest, os.path.basename(p)))\nfrom fetcher import Client, FetchError, TransientError, aggregate\n\n\ndef test_get_and_many():\n    with Client() as c:\n        assert c.get(\"http://x/1\") == b\"payload for http://x/1\"\n        res = c.get_many([\"http://x/1\", \"http://x/404\"])\n        assert res[0].startswith(b\"payload\") and isinstance(res[1], FetchError)\n\n\ndef test_retry_then_succeed():\n    attempts = {\"n\": 0}\n\n    def flaky(url):\n        attempts[\"n\"] += 1\n        if attempts[\"n\"] < 3:\n            raise TransientError(\"try again\")\n        return b\"ok\"\n\n    c = Client(transport=flaky, retries=3)\n    assert c.get(\"u\") == b\"ok\" and c.calls == 3\n\n\ndef test_summarize():\n    c = Client()\n    assert aggregate.summarize(c, [\"http://x/1\", \"http://x/404\"]) == {\n        \"ok\": 1, \"failed\": [\"http://x/404\"], \"bytes\": len(b\"payload for http://x/1\")}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01KveiwHcDbdYBPKCGPWGp7Q","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
