t_server_url=resolver.PYPI_SERVER_URL,\n        req_type=req_type,\n    )\n    results = resolver.find_all_matching_from_provider(provider, pinned_req)\n    if not results:\n        return None\n    return str(results[0][0])\n''',1)\nold_graph=s.index('        # Add to graph (skip')\nold_end=s.index('        logger.info(\\n            f\"new {wi.req_type}')\nnew_mid='''        # Must set pbi_pre_built before constructing PrepareSource so that\n        # PrepareSource.background_work() immediately sees the correct value.\n        pbi = bt.ctx.package_build_info(wi.req)\n        wi.pbi_pre_built = pbi.is_pre_built(wi.resolved_version)\n\n        # The URL was resolved without knowing the version. Re-resolve it if\n        # the version-specific settings differ from the variant defaults.\n        # This must happen before the graph update and the seen check.\n        if wi.pbi_pre_built != pbi.pre_built or (\n            wi.pbi_pre_built\n            and pbi.get_wheel_server_url(wi.resolved_version) != pbi.wheel_server_url\n        ):\n            logger.info(\n                f\"{wi.req.name}=={wi.resolved_version}: version-specific settings \"\n                f\"(pre_built={wi.pbi_pre_built}) differ from variant defaults, \"\n                \"re-resolving download URL\"\n            )\n            new_url = _re_resolve_url(\n                bt.ctx,\n                wi.req,\n                wi.req_type,\n                wi.resolved_version,\n                wi.pbi_pre_built,\n                bt.cache_wheel_server_url,\n            )\n            if new_url is None:\n                logger.warning(\n                    f\"{wi.req.name}=={wi.resolved_version}: could not re-resolve \"\n                    f\"download URL, keeping {wi.source_url}\"\n                )\n            else:\n                wi.source_url = new_url\n\n'''\ns=s[:old_graph]+new_mid+s[old_graph:]\ns=s.replace('''        # Must set pbi_pre_built before constructing PrepareSource so that\n        