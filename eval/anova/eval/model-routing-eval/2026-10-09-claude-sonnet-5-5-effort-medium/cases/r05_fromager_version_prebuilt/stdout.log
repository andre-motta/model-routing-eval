{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CfrzWnpo1HfZBfcBWLxre","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01PxefkBL76GavXFkjAxcu7U","name":"Read","input":{"file_path":"/home/alustosa/git/model-routing-eval/.work/agent-eval/2026-10-09-claude-sonnet-5-5-effort-medium/cases/r05_fromager_version_prebuilt/src/fromager/packagesettings/_pbi.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":15573,"cache_read_input_tokens":10397,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":15573},"output_tokens":21,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"12d1b6e1-2731-4546-8651-45406c69c8d4","uuid":"d20dfb0d-b7f6-4ce2-9871-c413f25a3dbd","timestamp":"2026-10-09T16:38:47.206Z","request_id":"req_011CfrzWnWCkrLXhd8UUKHp2","wire_tool_inputs":{"toolu_01PxefkBL76GavXFkjAxcu7U":{"file_path":"/home/alustosa/git/model-routing-eval/.work/agent-eval/2026-10-09-claude-sonnet-5-5-effort-medium/cases/r05_fromager_version_prebuilt/src/fromager/packagesettings/_pbi.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PxefkBL76GavXFkjAxcu7U","type":"tool_result","content":"1\t\"\"\"PackageBuildInfo class and system resource helpers.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport logging\n6\timport os\n7\timport pathlib\n8\timport types\n9\timport typing\n10\tfrom collections.abc import Mapping\n11\t\n12\timport psutil\n13\tfrom packaging.utils import BuildTag, NormalizedName\n14\tfrom packaging.version import Version\n15\t\n16\tfrom .. import overrides, threading_utils\n17\tfrom ._models import (\n18\t    GitOptions,\n19\t    PackageSettings,\n20\t    ProjectOverride,\n21\t    PurlConfig,\n22\t    VariantInfo,\n23\t)\n24\tfrom ._templates import _resolve_template, substitute_template\n25\tfrom ._typedefs import Annotations, PackageVersion, PatchMap, Template, Variant\n26\t\n27\tif typing.TYPE_CHECKING:\n28\t    from .. import build_environment\n29\t    from ._settings import Settings\n30\t\n31\tlogger = logging.getLogger(__name__)\n32\t\n33\t\n34\tdef get_available_memory_gib() -> float:\n35\t    \"\"\"available virtual memory in GiB\"\"\"\n36\t    return psutil.virtual_memory().available / (1024**3)\n37\t\n38\t\n39\tclass PackageBuildInfo:\n40\t    \"\"\"Package build information\n41\t\n42\t    Public API for PackageSettings with i\n43\t    \"\"\"\n44\t\n45\t    def __init__(self, settings: Settings, ps: PackageSettings) -> None:\n46\t        self._variant = typing.cast(Variant, settings.variant)\n47\t        self._patches_dir = settings.patches_dir\n48\t        self._variant_changelog = settings.variant_changelog()\n49\t        self._max_jobs: int | None = settings.max_jobs\n50\t        self._ps = ps\n51\t        self._plugin_module: types.ModuleType | typing.Literal[False] | None = False\n52\t        self._patches: PatchMap | None = None\n53\t        self._annotations: Annotations | None = None\n54\t\n55\t    @property\n56\t    def package(self) -> NormalizedName:\n57\t        \"\"\"Package name\"\"\"\n58\t        return typing.cast(NormalizedName, self._ps.name)\n59\t\n60\t    @property\n61\t    def variant(self) -> Variant:\n62\t        \"\"\"Variant name\"\"\"\n63\t        return self._variant\n64\t\n65\t    @property\n66\t    def purl_config(self) -> PurlConfig | None:\n67\t        \"\"\"Per-package purl configuration for SBOM generation.\"\"\"\n68\t        return self._ps.purl\n69\t\n70\t    @property\n71\t    def annotations(self) -> Annotations:\n72\t        \"\"\"Get Package and variant annotations\n73\t\n74\t        Annotations can be used to attach arbitrary metadata to packages and\n75\t        package variants. The feature is inspired by Kubernetes's\n76\t        annotations. Variant keys have a higher precedence than package keys.\n77\t\n78\t        The prefix ``fromager.`` is reserved for future use by Fromager.\n79\t\n80\t        ::\n81\t\n82\t           annotations:\n83\t             \"downstream.maintainer\": \"Platform Team\"\n84\t           variants:\n85\t             cuda:\n86\t               annotations:\n87\t                 \"downstream.maintainer\": \"CUDA Accelerator Team\"\n88\t        \"\"\"\n89\t        if self._annotations is None:\n90\t            vi = self._ps.variants.get(self.variant)\n91\t            va = vi.annotations if vi is not None else None\n92\t            self._annotations = Annotations(self._ps.annotations, va)\n93\t        return self._annotations\n94\t\n95\t    @property\n96\t    def plugin(self) -> types.ModuleType | None:\n97\t        \"\"\"Get Fromager plugin module\"\"\"\n98\t        if self._plugin_module is False:\n99\t            exts = overrides._get_extensions()\n100\t            try:\n101\t                mod = exts[self.override_module_name].plugin\n102\t                self._plugin_module = typing.cast(types.ModuleType, mod)\n103\t            except KeyError:\n104\t                self._plugin_module = None\n105\t        return self._plugin_module\n106\t\n107\t    def get_all_patches(self) -> PatchMap:\n108\t        \"\"\"Get a mapping of version to list of patches\"\"\"\n109\t\n110\t        if self._patches is None:\n111\t            patches: PatchMap = {}\n112\t            version: Version | None\n113\t\n114\t            # Find unversioned and versioned directories (name + '-' + version)\n115\t            # with patches for the package.\n116\t            dirs_to_scan = []\n117\t            unversioned_dir = self._patches_dir / self.override_module_name\n118\t            if unversioned_dir.exists():\n119\t                dirs_to_scan.append(unversioned_dir)\n120\t            versioned_pattern = f\"{self.override_module_name}-*\"\n121\t            dirs_to_scan.extend(self._patches_dir.glob(versioned_pattern))\n122\t\n123\t            prefix_len = len(self.override_module_name) + 1\n124\t            for patchdir in dirs_to_scan:\n125\t                if patchdir.name == self.override_module_name:\n126\t                    version = None\n127\t                else:\n128\t                    version = Version(patchdir.name[prefix_len:])\n129\t                patches[version] = list(patchdir.glob(\"*.patch\"))\n130\t                # variant-specific patches\n131\t                patches[version].extend(patchdir.joinpath(self.variant).glob(\"*.patch\"))\n132\t                patches[version].sort(key=lambda p: p.name)\n133\t\n134\t            self._patches = patches\n135\t        return self._patches\n136\t\n137\t    def get_patches(self, version: Version) -> list[pathlib.Path]:\n138\t        \"\"\"Get patches for a version (and unversioned patches)\"\"\"\n139\t        # ignore local version for patches\n140\t        version = Version(version.public)\n141\t        patchfiles: list[pathlib.Path] = []\n142\t        patchmap = self.get_all_patches()\n143\t        # unversioned patches\n144\t        patchfiles.extend(patchmap.get(None, []))\n145\t        # version-specific patches\n146\t        patchfiles.extend(patchmap.get(version, []))\n147\t        # sort by basename\n148\t        patchfiles.sort(key=lambda p: p.name)\n149\t        return patchfiles\n150\t\n151\t    @property\n152\t    def has_config(self) -> bool:\n153\t        \"\"\"Does the package have a config file?\"\"\"\n154\t        return self._ps.has_config\n155\t\n156\t    @property\n157\t    def has_customizations(self) -> bool:\n158\t        \"\"\"Does the package have any customizations?\"\"\"\n159\t        return bool(\n160\t            self.has_config or self.plugin is not None or self.get_all_patches()\n161\t        )\n162\t\n163\t    @property\n164\t    def pre_built(self) -> bool:\n165\t        \"\"\"Does the variant use pre-build wheels?\"\"\"\n166\t        vi = self._ps.variants.get(self.variant)\n167\t        if vi is not None:\n168\t            return vi.pre_built\n169\t        return False\n170\t\n171\t    def is_pre_built(self, version: Version | None = None) -> bool:\n172\t        \"\"\"Version-aware pre-built check.\n173\t\n174\t        Resolution order:\n175\t\n176\t        1. Plugin hook ``is_pre_built`` (if version given and hook exists)\n177\t        2. Version-specific YAML setting\n178\t        3. Variant-wide default\n179\t\n180\t        .. versionadded:: 0.90.0\n181\t        \"\"\"\n182\t        vi = self._ps.variants.get(self.variant)\n183\t        if vi is None:\n184\t            return False\n185\t        if version is not None:\n186\t            hook_fn = overrides.find_override_method(self.package, \"is_pre_built\")\n187\t            if hook_fn is not None:\n188\t                result = overrides.invoke(\n189\t                    hook_fn, version=version, variant=self.variant\n190\t                )\n191\t                if result is not None:\n192\t                    return bool(result)\n193\t            pv = typing.cast(PackageVersion, version)\n194\t            vs = vi.versions.get(pv)\n195\t            if vs is not None and vs.pre_built is not None:\n196\t                return vs.pre_built\n197\t        return vi.pre_built\n198\t\n199\t    @property\n200\t    def wheel_server_url(self) -> str | None:\n201\t        \"\"\"Alternative package index for pre-build wheel\"\"\"\n202\t        vi = self._ps.variants.get(self.variant)\n203\t        if vi is not None and vi.wheel_server_url is not None:\n204\t            return str(vi.wheel_server_url)\n205\t        return None\n206\t\n207\t    def get_wheel_server_url(self, version: Version | None = None) -> str | None:\n208\t        \"\"\"Version-aware wheel server URL.\n209\t\n210\t        Returns the version-specific URL if defined, otherwise\n211\t        falls back to the variant-wide default.\n212\t\n213\t        .. versionadded:: 0.90.0\n214\t        \"\"\"\n215\t        vi = self._ps.variants.get(self.variant)\n216\t        if vi is None:\n217\t            return None\n218\t        if version is not None:\n219\t            pv = typing.cast(PackageVersion, version)\n220\t            vs = vi.versions.get(pv)\n221\t            if vs is not None and vs.wheel_server_url is not None:\n222\t                return str(vs.wheel_server_url)\n223\t        return str(vi.wheel_server_url) if vi.wheel_server_url is not None else None\n224\t\n225\t    @property\n226\t    def override_module_name(self) -> str:\n227\t        \"\"\"Override module name from package name\"\"\"\n228\t        return self._ps.override_module_name\n229\t\n230\t    def download_source_url(\n231\t        self,\n232\t        version: Version | str | None = None,\n233\t        default: str | None = None,\n234\t        *,\n235\t        resolve_template: bool = True,\n236\t    ) -> str | None:\n237\t        \"\"\"sdist download URL\"\"\"\n238\t        if version is not None and isinstance(version, str):\n239\t            version = Version(version)\n240\t        template = self._ps.download_source.url\n241\t        if template is None and default:\n242\t            template = typing.cast(Template, default)\n243\t        if template and resolve_template:\n244\t            return _resolve_template(template, self.package, version)\n245\t        elif template:\n246\t            return str(template)\n247\t        else:\n248\t            return None\n249\t\n250\t    def download_source_destination_filename(\n251\t        self,\n252\t        version: Version | str | None = None,\n253\t        default: str | None = None,\n254\t        *,\n255\t        resolve_template: bool = True,\n256\t    ) -> str | None:\n257\t        \"\"\"Rename sdist to dest filename\"\"\"\n258\t        if version is not None and isinstance(version, str):\n259\t            version = Version(version)\n260\t        template = self._ps.download_source.destination_filename\n261\t        if template is None and default:\n262\t            template = typing.cast(Template, default)\n263\t        if template and resolve_template:\n264\t            return _resolve_template(template, self.package, version)\n265\t        elif template:\n266\t            return str(template)\n267\t        else:\n268\t            return None\n269\t\n270\t    def resolver_sdist_server_url(self, default: str) -> str:\n271\t        \"\"\"Package index server URL for resolving package versions\"\"\"\n272\t        url = self._ps.resolver_dist.sdist_server_url\n273\t        if url is None:\n274\t            url = default\n275\t        return url\n276\t\n277\t    @property\n278\t    def resolver_include_wheels(self) -> bool:\n279\t        \"\"\"Include wheels when resolving package versions?\"\"\"\n280\t        return self._ps.resolver_dist.include_wheels\n281\t\n282\t    @property\n283\t    def resolver_include_sdists(self) -> bool:\n284\t        \"\"\"Include sdists when resolving package versions?\"\"\"\n285\t        return self._ps.resolver_dist.include_sdists\n286\t\n287\t    @property\n288\t    def resolver_ignore_platform(self) -> bool:\n289\t        \"\"\"Ignore the platform when resolving with wheels?\"\"\"\n290\t        return self._ps.resolver_dist.ignore_platform\n291\t\n292\t    @property\n293\t    def resolver_min_release_age(self) -> int | None:\n294\t        \"\"\"Per-package release-age cooldown override in days.\n295\t\n296\t        Returns None (inherit global), 0 (disabled), or a positive integer\n297\t        (override days). The caller is responsible for converting to a\n298\t        :class:`~fromager.candidate.Cooldown` instance.\n299\t        \"\"\"\n300\t        return self._ps.resolver_dist.min_release_age\n301\t\n302\t    @property\n303\t    def use_pypi_org_metadata(self) -> bool:\n304\t        \"\"\"Can use metadata from pypi.org JSON / Simple API?\n305\t\n306\t        By default, packages with customizations do not use public\n307\t        pypi.org metadata.\n308\t        \"\"\"\n309\t        ps = self._ps\n310\t        flag = ps.resolver_dist.use_pypi_org_metadata\n311\t        if flag is not None:\n312\t            # flag is set\n313\t            return flag\n314\t        # return True if package does not have any customizations\n315\t        return not self.has_customizations\n316\t\n317\t    def build_dir(self, sdist_root_dir: pathlib.Path) -> pathlib.Path:\n318\t        \"\"\"Build directory for package (e.g. subdirectory)\"\"\"\n319\t        build_dir = self._ps.build_dir\n320\t        if build_dir is not None:\n321\t            # ensure that absolute build_dir path from settings is converted to a relative path\n322\t            relative_build_dir = build_dir.relative_to(build_dir.anchor)\n323\t            return sdist_root_dir / relative_build_dir\n324\t        return sdist_root_dir\n325\t\n326\t    def get_changelog(self, version: Version) -> list[str]:\n327\t        \"\"\"Get changelog for a version\"\"\"\n328\t        # ignore local version for changelog entries\n329\t        version = Version(version.public)\n330\t        pv = typing.cast(PackageVersion, version)\n331\t        variant_changelog = self._variant_changelog\n332\t        package_changelog = self._ps.changelog.get(pv, [])\n333\t        return variant_changelog + package_changelog\n334\t\n335\t    def build_tag(self, version: Version) -> BuildTag:\n336\t        \"\"\"Build tag for version's changelog and this variant\n337\t\n338\t        .. versionchanged 0.54.0::\n339\t\n340\t           Fromager ignores local version suffix of a package to determinate\n341\t           the build tag from changelog, e.g. version `1.0.3+local.suffix`\n342\t           uses `1.0.3`.\n343\t        \"\"\"\n344\t        if self.is_pre_built(version):\n345\t            return ()\n346\t        pv = typing.cast(PackageVersion, version)\n347\t        release = len(self.get_changelog(pv))\n348\t        if release == 0:\n349\t            return ()\n350\t        # suffix = \".\" + self.variant.replace(\"-\", \"_\")\n351\t        suffix = \"\"\n352\t        return release, suffix\n353\t\n354\t    def get_extra_environ(\n355\t        self,\n356\t        *,\n357\t        template_env: dict[str, str] | None = None,\n358\t        build_env: build_environment.BuildEnvironment | None = None,\n359\t        version: Version | None = None,\n360\t    ) -> dict[str, str]:\n361\t        \"\"\"Get extra environment variables for a variant\n362\t\n363\t        1. parallel jobs: ``MAKEFLAGS``, ``MAX_JOBS``, ``CMAKE_BUILD_PARALLEL_LEVEL``\n364\t        2. PATH and VIRTUAL_ENV from ``build_env`` (if given)\n365\t        3. package's env settings\n366\t        4. package variant's env settings\n367\t\n368\t        `template_env` defaults to `os.environ`.\n369\t        \"\"\"\n370\t        if template_env is None:\n371\t            template_env = os.environ.copy()\n372\t        else:\n373\t            template_env = template_env.copy()\n374\t\n375\t        if version is not None:\n376\t            template_env[\"__version__\"] = str(version)\n377\t        else:\n378\t            # Prevent a stray __version__ in os.environ from being\n379\t            # silently used when the real version is unknown.\n380\t            template_env.pop(\"__version__\", None)\n381\t\n382\t        # configure max jobs settings, settings depend on package, available\n383\t        # CPU cores, and available virtual memory.\n384\t        jobs = self.parallel_jobs()\n385\t        extra_environ: dict[str, str] = {\n386\t            \"MAKEFLAGS\": f\"{template_env.get('MAKEFLAGS', '')} -j{jobs}\".strip(),\n387\t            \"CMAKE_BUILD_PARALLEL_LEVEL\": str(jobs),\n388\t            \"MAX_JOBS\": str(jobs),\n389\t        }\n390\t\n391\t        # make MAX_JOBS available to substitution\n392\t        template_env.update(extra_environ)\n393\t\n394\t        # add VIRTUAL_ENV and update PATH, so templates can use the values\n395\t        if build_env is not None:\n396\t            venv_environ = build_env.get_venv_environ(template_env=template_env)\n397\t            template_env.update(venv_environ)\n398\t            extra_environ.update(venv_environ)\n399\t\n400\t        # chain entries so variant entries can reference general entries\n401\t        entries = list(self._ps.env.items())\n402\t        vi = self._ps.variants.get(self.variant)\n403\t        if vi is not None:\n404\t            entries.extend(vi.env.items())\n405\t\n406\t        for key, value in entries:\n407\t            value = substitute_template(value, template_env)\n408\t            extra_environ[key] = value\n409\t            # subsequent key-value pairs can depend on previously vars.\n410\t            template_env[key] = value\n411\t\n412\t        return extra_environ\n413\t\n414\t    def parallel_jobs(self) -> int:\n415\t        \"\"\"How many parallel jobs?\"\"\"\n416\t        # adjust by CPU cores, at least 1\n417\t        cpu_cores_per_job = self._ps.build_options.cpu_cores_per_job\n418\t        cpu_count = threading_utils.get_cpu_count()\n419\t        max_num_job_cores = int(max(1, cpu_count // cpu_cores_per_job))\n420\t        logger.debug(\n421\t            f\"{self.package}: {max_num_job_cores=}, {cpu_cores_per_job=}, {cpu_count=}\"\n422\t        )\n423\t\n424\t        # adjust by memory consumption per job, at least 1\n425\t        memory_per_job_gb = self._ps.build_options.memory_per_job_gb\n426\t        free_memory = get_available_memory_gib()\n427\t        max_num_jobs_memory = int(max(1.0, free_memory // memory_per_job_gb))\n428\t        logger.debug(\n429\t            f\"{self.package}: {max_num_jobs_memory=}, {memory_per_job_gb=}, {free_memory=:0.1f} GiB\"\n430\t        )\n431\t\n432\t        # limit by smallest amount of CPU, memory, and --jobs parameter\n433\t        max_jobs = cpu_count if self._max_jobs is None else self._max_jobs\n434\t        parallel_builds = min(max_num_job_cores, max_num_jobs_memory, max_jobs)\n435\t\n436\t        logger.debug(\n437\t            f\"{self.package}: parallel builds {parallel_builds=} \"\n438\t            f\"({free_memory=:0.1f} GiB, {cpu_count=}, {max_jobs=})\"\n439\t        )\n440\t\n441\t        return parallel_builds\n442\t\n443\t    @property\n444\t    def build_ext_parallel(self) -> bool:\n445\t        \"\"\"Configure [build_ext]parallel for setuptools?\"\"\"\n446\t        return self._ps.build_options.build_ext_parallel\n447\t\n448\t    @property\n449\t    def config_settings(self) -> dict[str, str | list[str]]:\n450\t        return self._ps.config_settings\n451\t\n452\t    @property\n453\t    def git_options(self) -> GitOptions:\n454\t        \"\"\"Git repository cloning options\"\"\"\n455\t        return self._ps.git_options\n456\t\n457\t    @property\n458\t    def project_override(self) -> ProjectOverride:\n459\t        return self._ps.project_override\n460\t\n461\t    @property\n462\t    def exclusive_build(self) -> bool:\n463\t        return self._ps.build_options.exclusive_build\n464\t\n465\t    @property\n466\t    def variants(self) -> Mapping[Variant, VariantInfo]:\n467\t        \"\"\"Get the variant configuration for the current package\"\"\"\n468\t        return self._ps.variants\n469\t\n470\t    def serialize(self, **kwargs: typing.Any) -> dict[str, typing.Any]:\n471\t        return self._ps.serialize(**kwargs)\n472\t"}]},"parent_tool_use_id":null,"session_id":"12d1b6e1-2731-4546-8651-45406c69c8d4","uuid":"a3f58372-1a99-449f-be0e-a7e96a4d58cc","timestamp":"2026-10-09T16:38:47.271Z","tool_use_result":{"type":"text","file":{"filePath":"/home/alustosa/git/model-routing-eval/.work/agent-eval/2026-10-09-claude-sonnet-5-5-effort-medium/cases/r05_fromager_version_prebuilt/src/fromager/packagesettings/_pbi.py","content":"\"\"\"PackageBuildInfo class and system resource helpers.\"\"\"\n\nfrom __future__ import annotations\n\nimport logging\nimport os\nimport pathlib\nimport types\nimport typing\nfrom collections.abc import Mapping\n\nimport psutil\nfrom packaging.utils import BuildTag, NormalizedName\nfrom packaging.version import Version\n\nfrom .. import overrides, threading_utils\nfrom ._models import (\n    GitOptions,\n    PackageSettings,\n    ProjectOverride,\n    PurlConfig,\n    VariantInfo,\n)\nfrom ._templates import _resolve_template, substitute_template\nfrom ._typedefs import Annotations, PackageVersion, PatchMap, Template, Variant\n\nif typing.TYPE_CHECKING:\n    from .. import build_environment\n    from ._settings import Settings\n\nlogger = logging.getLogger(__name__)\n\n\ndef get_available_memory_gib() -> float:\n    \"\"\"available virtual memory in GiB\"\"\"\n    return psutil.virtual_memory().available / (1024**3)\n\n\nclass PackageBuildInfo:\n    \"\"\"Package build information\n\n    Public API for PackageSettings with i\n    \"\"\"\n\n    def __init__(self, settings: Settings, ps: PackageSettings) -> None:\n        self._variant = typing.cast(Variant, settings.variant)\n        self._patches_dir = settings.patches_dir\n        self._variant_changelog = settings.variant_changelog()\n        self._max_jobs: int | None = settings.max_jobs\n        self._ps = ps\n        self._plugin_module: types.ModuleType | typing.Literal[False] | None = False\n        self._patches: PatchMap | None = None\n        self._annotations: Annotations | None = None\n\n    @property\n    def package(self) -> NormalizedName:\n        \"\"\"Package name\"\"\"\n        return typing.cast(NormalizedName, self._ps.name)\n\n    @property\n    def variant(self) -> Variant:\n        \"\"\"Variant name\"\"\"\n        return self._variant\n\n    @property\n    def purl_config(self) -> PurlConfig | None:\n        \"\"\"Per-package purl configuration for SBOM generation.\"\"\"\n        return self._ps.purl\n\n    @property\n    def annotations(self) -> Annotations:\n        \"\"\"Get Package and variant annotations\n\n        Annotations can be used to attach arbitrary metadata to packages and\n        package variants. The feature is inspired by Kubernetes's\n        annotations. Variant keys have a higher precedence than package keys.\n\n        The prefix ``fromager.`` is reserved for future use by Fromager.\n\n        ::\n\n           annotations:\n             \"downstream.maintainer\": \"Platform Team\"\n           variants:\n             cuda:\n               annotations:\n                 \"downstream.maintainer\": \"CUDA Accelerator Team\"\n        \"\"\"\n        if self._annotations is None:\n            vi = self._ps.variants.get(self.variant)\n            va = vi.annotations if vi is not None else None\n            self._annotations = Annotations(self._ps.annotations, va)\n        return self._annotations\n\n    @property\n    def plugin(self) -> types.ModuleType | None:\n        \"\"\"Get Fromager plugin module\"\"\"\n        if self._plugin_module is False:\n            exts = overrides._get_extensions()\n            try:\n                mod = exts[self.override_module_name].plugin\n                self._plugin_module = typing.cast(types.ModuleType, mod)\n            except KeyError:\n                self._plugin_module = None\n        return self._plugin_module\n\n    def get_all_patches(self) -> PatchMap:\n        \"\"\"Get a mapping of version to list of patches\"\"\"\n\n        if self._patches is None:\n            patches: PatchMap = {}\n            version: Version | None\n\n            # Find unversioned and versioned directories (name + '-' + version)\n            # with patches for the package.\n            dirs_to_scan = []\n            unversioned_dir = self._patches_dir / self.override_module_name\n            if unversioned_dir.exists():\n                dirs_to_scan.append(unversioned_dir)\n            versioned_pattern = f\"{self.override_module_name}-*\"\n            dirs_to_scan.extend(self._patches_dir.glob(versioned_pattern))\n\n            prefix_len = len(self.override_module_name) + 1\n            for patchdir in dirs_to_scan:\n                if patchdir.name == self.override_module_name:\n                    version = None\n                else:\n                    version = Version(patchdir.name[prefix_len:])\n                patches[version] = list(patchdir.glob(\"*.patch\"))\n                # variant-specific patches\n                patches[version].extend(patchdir.joinpath(self.variant).glob(\"*.patch\"))\n                patches[version].sort(key=lambda p: p.name)\n\n            self._patches = patches\n        return self._patches\n\n    def get_patches(self, version: Version) -> list[pathlib.Path]:\n        \"\"\"Get patches for a version (and unversioned patches)\"\"\"\n        # ignore local version for patches\n        version = Version(version.public)\n        patchfiles: list[pathlib.Path] = []\n        patchmap = self.get_all_patches()\n        # unversioned patches\n        patchfiles.extend(patchmap.get(None, []))\n        # version-specific patches\n        patchfiles.extend(patchmap.get(version, []))\n        # sort by basename\n        patchfiles.sort(key=lambda p: p.name)\n        return patchfiles\n\n    @property\n    def has_config(self) -> bool:\n        \"\"\"Does the package have a config file?\"\"\"\n        return self._ps.has_config\n\n    @property\n    def has_customizations(self) -> bool:\n        \"\"\"Does the package have any customizations?\"\"\"\n        return bool(\n            self.has_config or self.plugin is not None or self.get_all_patches()\n        )\n\n    @property\n    def pre_built(self) -> bool:\n        \"\"\"Does the variant use pre-build wheels?\"\"\"\n        vi = self._ps.variants.get(self.variant)\n        if vi is not None:\n            return vi.pre_built\n        return False\n\n    def is_pre_built(self, version: Version | None = None) -> bool:\n        \"\"\"Version-aware pre-built check.\n\n        Resolution order:\n\n        1. Plugin hook ``is_pre_built`` (if version given and hook exists)\n        2. Version-specific YAML setting\n        3. Variant-wide default\n\n        .. versionadded:: 0.90.0\n        \"\"\"\n        vi = self._ps.variants.get(self.variant)\n        if vi is None:\n            return False\n        if version is not None:\n            hook_fn = overrides.find_override_method(self.package, \"is_pre_built\")\n            if hook_fn is not None:\n                result = overrides.invoke(\n                    hook_fn, version=version, variant=self.variant\n                )\n                if result is not None:\n                    return bool(result)\n            pv = typing.cast(PackageVersion, version)\n            vs = vi.versions.get(pv)\n            if vs is not None and vs.pre_built is not None:\n                return vs.pre_built\n        return vi.pre_built\n\n    @property\n    def wheel_server_url(self) -> str | None:\n        \"\"\"Alternative package index for pre-build wheel\"\"\"\n        vi = self._ps.variants.get(self.variant)\n        if vi is not None and vi.wheel_server_url is not None:\n            return str(vi.wheel_server_url)\n        return None\n\n    def get_wheel_server_url(self, version: Version | None = None) -> str | None:\n        \"\"\"Version-aware wheel server URL.\n\n        Returns the version-specific URL if defined, otherwise\n        falls back to the variant-wide default.\n\n        .. versionadded:: 0.90.0\n        \"\"\"\n        vi = self._ps.variants.get(self.variant)\n        if vi is None:\n            return None\n        if version is not None:\n            pv = typing.cast(PackageVersion, version)\n            vs = vi.versions.get(pv)\n            if vs is not None and vs.wheel_server_url is not None:\n                return str(vs.wheel_server_url)\n        return str(vi.wheel_server_url) if vi.wheel_server_url is not None else None\n\n    @property\n    def override_module_name(self) -> str:\n        \"\"\"Override module name from package name\"\"\"\n        return self._ps.override_module_name\n\n    def download_source_url(\n        self,\n        version: Version | str | None = None,\n        default: str | None = None,\n        *,\n        resolve_template: bool = True,\n    ) -> str | None:\n        \"\"\"sdist download URL\"\"\"\n        if version is not None and isinstance(version, str):\n            version = Version(version)\n        template = self._ps.download_source.url\n        if template is None and default:\n            template = typing.cast(Template, default)\n        if template and resolve_template:\n            return _resolve_template(template, self.package, version)\n        elif template:\n            return str(template)\n        else:\n            return None\n\n    def download_source_destination_filename(\n        self,\n        version: Version | str | None = None,\n        default: str | None = None,\n        *,\n        resolve_template: bool = True,\n    ) -> str | None:\n        \"\"\"Rename sdist to dest filename\"\"\"\n        if version is not None and isinstance(version, str):\n            version = Version(version)\n        template = self._ps.download_source.destination_filename\n        if template is None and default:\n            template = typing.cast(Template, default)\n        if template and resolve_template:\n            return _resolve_template(template, self.package, version)\n        elif template:\n            return str(template)\n        else:\n            return None\n\n    def resolver_sdist_server_url(self, default: str) -> str:\n        \"\"\"Package index server URL for resolving package versions\"\"\"\n        url = self._ps.resolver_dist.sdist_server_url\n        if url is None:\n            url = default\n        return url\n\n    @property\n    def resolver_include_wheels(self) -> bool:\n        \"\"\"Include wheels when resolving package versions?\"\"\"\n        return self._ps.resolver_dist.include_wheels\n\n    @property\n    def resolver_include_sdists(self) -> bool:\n        \"\"\"Include sdists when resolving package versions?\"\"\"\n        return self._ps.resolver_dist.include_sdists\n\n    @property\n    def resolver_ignore_platform(self) -> bool:\n        \"\"\"Ignore the platform when resolving with wheels?\"\"\"\n        return self._ps.resolver_dist.ignore_platform\n\n    @property\n    def resolver_min_release_age(self) -> int | None:\n        \"\"\"Per-package release-age cooldown override in days.\n\n        Returns None (inherit global), 0 (disabled), or a positive integer\n        (override days). The caller is responsible for converting to a\n        :class:`~fromager.candidate.Cooldown` instance.\n        \"\"\"\n        return self._ps.resolver_dist.min_release_age\n\n    @property\n    def use_pypi_org_metadata(self) -> bool:\n        \"\"\"Can use metadata from pypi.org JSON / Simple API?\n\n        By default, packages with customizations do not use public\n        pypi.org metadata.\n        \"\"\"\n        ps = self._ps\n        flag = ps.resolver_dist.use_pypi_org_metadata\n        if flag is not None:\n            # flag is set\n            return flag\n        # return True if package does not have any customizations\n        return not self.has_customizations\n\n    def build_dir(self, sdist_root_dir: pathlib.Path) -> pathlib.Path:\n        \"\"\"Build directory for package (e.g. subdirectory)\"\"\"\n        build_dir = self._ps.build_dir\n        if build_dir is not None:\n            # ensure that absolute build_dir path from settings is converted to a relative path\n            relative_build_dir = build_dir.relative_to(build_dir.anchor)\n            return sdist_root_dir / relative_build_dir\n        return sdist_root_dir\n\n    def get_changelog(self, version: Version) -> list[str]:\n        \"\"\"Get changelog for a version\"\"\"\n        # ignore local version for changelog entries\n        version = Version(version.public)\n        pv = typing.cast(PackageVersion, version)\n        variant_changelog = self._variant_changelog\n        package_changelog = self._ps.changelog.get(pv, [])\n        return variant_changelog + package_changelog\n\n    def build_tag(self, version: Version) -> BuildTag:\n        \"\"\"Build tag for version's changelog and this variant\n\n        .. versionchanged 0.54.0::\n\n           Fromager ignores local version suffix of a package to determinate\n           the build tag from changelog, e.g. version `1.0.3+local.suffix`\n           uses `1.0.3`.\n        \"\"\"\n        if self.is_pre_built(version):\n            return ()\n        pv = typing.cast(PackageVersion, version)\n        release = len(self.get_changelog(pv))\n        if release == 0:\n            return ()\n        # suffix = \".\" + self.variant.replace(\"-\", \"_\")\n        suffix = \"\"\n        return release, suffix\n\n    def get_extra_environ(\n        self,\n        *,\n        template_env: dict[str, str] | None = None,\n        build_env: build_environment.BuildEnvironment | None = None,\n        version: Version | None = None,\n    ) -> dict[str, str]:\n        \"\"\"Get extra environment variables for a variant\n\n        1. parallel jobs: ``MAKEFLAGS``, ``MAX_JOBS``, ``CMAKE_BUILD_PARALLEL_LEVEL``\n        2. PATH and VIRTUAL_ENV from ``build_env`` (if given)\n        3. package's env settings\n        4. package variant's env settings\n\n        `template_env` defaults to `os.environ`.\n        \"\"\"\n        if template_env is None:\n            template_env = os.environ.copy()\n        else:\n            template_env = template_env.copy()\n\n        if version is not None:\n            template_env[\"__version__\"] = str(version)\n        else:\n            # Prevent a stray __version__ in os.environ from being\n            # silently used when the real version is unknown.\n            template_env.pop(\"__version__\", None)\n\n        # configure max jobs settings, settings depend on package, available\n        # CPU cores, and available virtual memory.\n        jobs = self.parallel_jobs()\n        extra_environ: dict[str, str] = {\n            \"MAKEFLAGS\": f\"{template_env.get('MAKEFLAGS', '')} -j{jobs}\".strip(),\n            \"CMAKE_BUILD_PARALLEL_LEVEL\": str(jobs),\n            \"MAX_JOBS\": str(jobs),\n        }\n\n        # make MAX_JOBS available to substitution\n        template_env.update(extra_environ)\n\n        # add VIRTUAL_ENV and update PATH, so templates can use the values\n        if build_env is not None:\n            venv_environ = build_env.get_venv_environ(template_env=template_env)\n            template_env.update(venv_environ)\n            extra_environ.update(venv_environ)\n\n        # chain entries so variant entries can reference general entries\n        entries = list(self._ps.env.items())\n        vi = self._ps.variants.get(self.variant)\n        if vi is not None:\n            entries.extend(vi.env.items())\n\n        for key, value in entries:\n            value = substitute_template(value, template_env)\n            extra_environ[key] = value\n            # subsequent key-value pairs can depend on previously vars.\n            template_env[key] = value\n\n        return extra_environ\n\n    def parallel_jobs(self) -> int:\n        \"\"\"How many parallel jobs?\"\"\"\n        # adjust by CPU cores, at least 1\n        cpu_cores_per_job = self._ps.build_options.cpu_cores_per_job\n        cpu_count = threading_utils.get_cpu_count()\n        max_num_job_cores = int(max(1, cpu_count // cpu_cores_per_job))\n        logger.debug(\n            f\"{self.package}: {max_num_job_cores=}, {cpu_cores_per_job=}, {cpu_count=}\"\n        )\n\n        # adjust by memory consumption per job, at least 1\n        memory_per_job_gb = self._ps.build_options.memory_per_job_gb\n        free_memory = get_available_memory_gib()\n        max_num_jobs_memory = int(max(1.0, free_memory // memory_per_job_gb))\n        logger.debug(\n            f\"{self.package}: {max_num_jobs_memory=}, {memory_per_job_gb=}, {free_memory=:0.1f} GiB\"\n        )\n\n        # limit by smallest amount of CPU, memory, and --jobs parameter\n        max_jobs = cpu_count if self._max_jobs is None else self._max_jobs\n        parallel_builds = min(max_num_job_cores, max_num_jobs_memory, max_jobs)\n\n        logger.debug(\n            f\"{self.package}: parallel builds {parallel_builds=} \"\n            f\"({free_memory=:0.1f} GiB, {cpu_count=}, {max_jobs=})\"\n        )\n\n        return parallel_builds\n\n    @property\n    def build_ext_parallel(self) -> bool:\n        \"\"\"Configure [build_ext]parallel for setuptools?\"\"\"\n        return self._ps.build_options.build_ext_parallel\n\n    @property\n    def config_settings(self) -> dict[str, str | list[str]]:\n        return self._ps.config_settings\n\n    @property\n    def git_options(self) -> GitOptions:\n        \"\"\"Git repository cloning options\"\"\"\n        return self._ps.git_options\n\n    @property\n    def project_override(self) -> ProjectOverride:\n        return self._ps.project_override\n\n    @property\n    def exclusive_build(self) -> bool:\n        return self._ps.build_options.exclusive_build\n\n    @property\n    def variants(self) -> Mapping[Variant, VariantInfo]:\n        \"\"\"Get the variant configuration for the current package\"\"\"\n        return self._ps.variants\n\n    def serialize(self, **kwargs: typing.Any) -> dict[str, typing.Any]:\n        return self._ps.serialize(**kwargs)\n","numLines":472,"startLine":1,"totalLines":472}},"tool_result_meta":[{"id":"toolu_01PxefkBL76GavXFkjAxcu7U","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
