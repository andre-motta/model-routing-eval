\")\n    assert hook.call_args.kwargs == {\n        \"version\": Version(\"2.8.0\"),\n        \"variant\": \"cpu\",\n    }\n\n    with patch(\"fromager.overrides.find_and_invoke\", return_value=False):\n        assert pbi.is_pre_built(Version(\"2.9.0\")) is False\n\n    with patch(\"fromager.overrides.find_and_invoke\", return_value=None):\n        assert pbi.is_pre_built(Version(\"2.9.0\")) is True\n        assert pbi.is_pre_built(Version(\"2.8.0\")) is False\n\n\ndef test_default_is_pre_built_defers() -> None:\n    assert _pbi._default_is_pre_built(version=Version(\"1.0\"), variant=\"cpu\") is None\n\n\ndef test_variant_versions_none_or_omitted() -> None:\n    assert VariantInfo.model_validate({\"versions\": None}).versions == {}\n    assert VariantInfo.model_validate({}).versions == {}\n\n\ndef test_build_tag_version_specific_prebuilt(''',1)\nopen(p,'w').write(s)\nEOF\nsed -n 1,40p tests/test_packagesettings.py | grep -a \"import\\|^ *[A-Za-z_]*,$\" | head -40"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":18369,"cache_read_input_tokens":80078,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":18369},"output_tokens":3,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"12d1b6e1-2731-4546-8651-45406c69c8d4","uuid":"18b9865d-708e-4924-833b-01a5fc051267","timestamp":"2026-10-09T16:39:53.769Z","request_id":"req_011CfrzbG1ni7JxVGRWDAikR","wire_tool_inputs":{"toolu_01LCtpi6QFGEGmcmSLirEbUU":{"command":"cd /home/alustosa/git/model-routing-eval/.work/agent-eval/2026-10-09-claude-sonnet-5-5-effort-medium/cases/r05_fromager_version_prebuilt; python3 - <<'EOF' > /dev/null 2>&1\np='tests/test_packagesettings.py'\ns=open(p).read()\ns=s.replace('''def test_build_tag_version_specific_prebuilt(''','''def test_version_specific_ig