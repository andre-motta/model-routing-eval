c, path)\n        return doc\n    if name == \"replace\":\n        return _replace(doc, path, copy.deepcopy(_field(op, \"value\")))\n    if name == \"test\":\n        expected = _field(op, \"value\")\n        if not _equal(_resolve_tokens(doc, path), expected):\n            raise PatchError(\"test failed\")\n        return doc\n\n    src = _parse_pointer(_field(op, \"from\", str))\n    if name == \"copy\":\n        return _add(doc, path, copy.deepcopy(_resolve_tokens(doc, src)))\n    # move\n    _resolve_tokens(doc, src)\n    if len(src) < len(path) and path[: len(src)] == src:\n        raise PatchError(\"cannot move a value into one of its own children\")\n    if src == path:\n        return doc\n    value = _remove(doc, src) if src else doc\n    if not src:\n        # moving the root onto a non-prefixed path is impossible (root is a prefix of all)\n        raise PatchError(\"cannot move the document root\")\n    return _add(doc, path, value)\n\n\ndef apply_patch(doc, patch, in_place=False):\n    if not isinstance(patch, list):\n        raise PatchError(\"patch must be a list of operations\")\n    work = copy.deepcopy(doc)\n    for op in patch:\n        work = _apply_op(work, op)\n    if in_place:\n        if isinstance(doc, dict) and isinstance(work, dict):\n            doc.clear()\n            doc.update(work)\n            return doc\n        if isinstance(doc, list) and isinstance(work, list):\n            doc[:] = work\n            return doc\n    return work\n","structuredPatch":[{"oldStart":77,"oldLines":9,"newStart":77,"newLines":11,"lines":["         )","     if isinstance(a, (dict, list)) or isinstance(b, (dict, list)):","         return False","-    return type(a) in (int, float) and type(b) in (int, float) and a == b or (","-        type(a) is type(b) and a == b","-    )","+    if isinstance(b, (dict, list)):","+        return False","+    if isinstance(a, (int, float)) and isinstance(b, (int, float)):","+        return a == b","+    return type(a) is ty