1200 in 16\", 60 Hz [Built-in]\n                        󰍹 Display  1920x1080 in 24\", 144 Hz [External]\n                        󰍹 Display  3440x1440 in 34\", 100 Hz [External]\n                         DE  KDE Plasma 6.7.4\n                         WM  KWin\n                       \n                         ● ● ● ● ● ● ● ●\n💡 gd — go to definition of symbol under cursor\n\nexport/__init__.py\nexport/core.py\nhooks/subagent_stop.py\ninput.yaml\ntests/test_export.py\nimport csv\nimport io\nimport json\nfrom xml.sax.saxutils import escape\n\n\nclass UnknownFormat(ValueError):\n    pass\n\n\ndef _extension(fmt):\n    if fmt == \"csv\":\n        return \".csv\"\n    elif fmt == \"json\":\n        return \".json\"\n    elif fmt == \"xml\":\n        return \".xml\"\n    raise UnknownFormat(fmt)\n\n\ndef export_records(records, fmt):\n    \"\"\"records: list of dicts with identical keys. Returns bytes.\"\"\"\n    if fmt == \"csv\":\n        buf = io.StringIO()\n        if records:\n            w = csv.DictWriter(buf, fieldnames=list(records[0].keys()), lineterminator=\"\\n\")\n            w.writeheader()\n            w.writerows(records)\n        return buf.getvalue().encode()\n    elif fmt == \"json\":\n        return json.dumps(records, indent=2, sort_keys=True).encode() + b\"\\n\"\n    elif fmt == \"xml\":\n        parts = [\"<records>\"]\n        for r in records:\n            parts.append(\"  <record>\")\n            for k, v in r.items():\n                parts.append(f\"    <{k}>{escape(str(v))}</{k}>\")\n            parts.append(\"  </record>\")\n        parts.append(\"</records>\")\n        return (\"\\n\".join(parts) + \"\\n\").encode()\n    raise UnknownFormat(fmt)\n\n\ndef export_to_file(records, fmt, path):\n    if fmt not in (\"csv\", \"json\", \"xml\"):\n        raise UnknownFormat(fmt)\n    path = str(path)\n    if not path.endswith(_extension(fmt)):\n        path += _extension(fmt)\n    with open(path, \"wb\") as f:\n        f.write(export_records(records,