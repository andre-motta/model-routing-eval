self.retries:\n                    raise\n                time.sleep(delay)\n                delay *= 2\n\n    def get_many(self, urls):\n        out = []\n        for u in urls:\n            try:\n                out.append(self.get(u))\n            except Exception as e:\n                out.append(FetchError(u, e))\n        return out\n\n    def close(self):\n        self.closed = True\n\n    def __enter__(self):\n        return self\n\n    def __exit__(self, *exc):\n        self.close()\n","userModified":false},"tool_result_meta":[{"id":"toolu_01NkgW73Ax9AasgsKpH8muMt","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
