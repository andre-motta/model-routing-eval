 1\n        if attempts[\"n\"] < 3:\n            raise TransientError(\"try again\")\n        return b\"ok\"\n\n    c = Client(transport=flaky, retries=3)\n    assert c.get(\"u\") == b\"ok\" and c.calls == 3\n\n\ndef test_summarize():\n    c = Client()\n    assert aggregate.summarize(c, [\"http://x/1\", \"http://x/404\"]) == {\n        \"ok\": 1, \"failed\": [\"http://x/404\"], \"bytes\": len(b\"payload for http://x/1\")}\n","userModified":false},"tool_result_meta":[{"id":"toolu_01T3j7why4JJsHy9mbEscftF","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
