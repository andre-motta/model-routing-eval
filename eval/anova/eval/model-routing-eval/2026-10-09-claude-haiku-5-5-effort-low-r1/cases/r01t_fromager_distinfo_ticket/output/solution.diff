+def _wheel_metadata_path(url: str) -> str:
+    """Get the path of the METADATA file in the root .dist-info directory of a wheel.
+
+    The wheel filename is {name}-{version}(-{build})?-{python}-{abi}-{platform}.whl
+    and the root .dist-info directory is named {name}-{version}.dist-info.
+    """
+    filename = urllib.parse.unquote(posixpath.basename(urllib.parse.urlparse(url).path))
+    parts = filename.split("-")
+    if not filename.endswith(".whl") or len(parts) < 5:
+        raise ValueError(f"Cannot parse wheel filename from URL: {url}")
+    return f"{parts[0]}-{parts[1]}.dist-info/METADATA"
+
+
