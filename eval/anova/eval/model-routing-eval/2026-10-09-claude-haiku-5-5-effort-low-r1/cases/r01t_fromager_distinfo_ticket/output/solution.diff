+@patch("fromager.candidate.session")
+def test_get_metadata_ignores_vendored_dist_info(mock_session: typing.Any) -> None:
+    """Test that a vendored .dist-info listed before the root one is not used."""
+    # Arrange
+    vendored = b"Metadata-Version: 2.1\nName: vendored\nVersion: 9.9.9\n"
+    root = b"Metadata-Version: 2.1\nName: my-pkg\nVersion: 1.2.3\n"
+    wheel = _make_wheel(
+        {
+            "my_pkg/_vendor/vendored-9.9.9.dist-info/METADATA": vendored,
+            "my_pkg-1.2.3.dist-info/METADATA": root,
+        }
+    )
+    mock_session.get.return_value = Mock(content=wheel)
+    wheel_url = "https://pkg.test/my_pkg-1.2.3-py3-none-any.whl"
+
+    # Act
+    metadata = get_metadata_for_wheel(wheel_url)
+
+    # Assert
+    assert metadata.name == "my-pkg"
+    assert str(metadata.version) == "1.2.3"
+
+
+@patch("fromager.candidate.session")
+def test_get_metadata_uses_name_and_version_from_url(
+    mock_session: typing.Any,
+) -> None:
+    """Test that the dist-info directory is derived from the wheel filename."""
+    # Arrange
+    wheel = _make_wheel(
+        {
+            "other-1.0.0.dist-info/METADATA": b"Metadata-Version: 2.1\nName: other\nVersion: 1.0.0\n",
+            "my_pkg-2.0.0.dist-info/METADATA": b"Metadata-Version: 2.1\nName: my-pkg\nVersion: 2.0.0\n",
+        }
+    )
+    mock_session.get.return_value = Mock(content=wheel)
+    wheel_url = "https://pkg.test/my_pkg-2.0.0-1-py3-none-any.whl#sha256=abc"
+
+    # Act
+    metadata = get_metadata_for_wheel(wheel_url)
+
+    # Assert
+    assert metadata.name == "my-pkg"
+    assert str(metadata.version) == "2.0.0"
+
+
+@patch("fromager.candidate.session")
+def test_get_metadata_ignores_nested_dist_info(mock_session: typing.Any) -> None:
+    """Test that a .dist-info nested below the root is not used as wheel metadata."""
+    # Arrange
+    wheel = _make_wheel(
+        {
+            "my_pkg/_vendor/my_pkg-1.2.3.dist-info/METADATA": b"Metadata-Version: 2.1\nName: wrong\nVersion: 0.0.1\n",
+        }
+    )
+    mock_session.get.return_value = Mock(content=wheel)
+    wheel_url = "https://pkg.test/my_pkg-1.2.3-py3-none-any.whl"
+
+    # Act / Assert
+    with pytest.raises(ValueError, match="Could not find my_pkg-1.2.3.dist-info"):
