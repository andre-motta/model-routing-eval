tes_out\": tot_bytes, \"events\": tot_n})\n    return out\nfrom collections import defaultdict\n\n\ndef aggregate(rows):\n    \"\"\"Per (tenant, service): total cpu_seconds, total bytes_out, event count. Sorted by tenant then service.\"\"\"\n    acc = defaultdict(lambda: [0.0, 0, 0])\n    for r in rows:\n        a = acc[(r.tenant, r.service)]\n        a[0] += r.cpu_seconds\n        a[1] += r.bytes_out\n        a[2] += 1\n    return {k: tuple(v) for k, v in sorted(acc.items())}\n\"\"\"Drop duplicate events (the collector retries, so the same event_id can appear several times).\n\nRefactored to keep insertion order of first occurrence, which the old set-based version did not guarantee.\n\"\"\"\n\n\ndef dedupe_rows(rows):\n    seen_ids = []\n    out = []\n    for r in rows:\n        if r.event_id in seen_ids:\n            continue\n        seen_ids.append(r.event_id)\n        out.append(r)\n    return out\nfrom dataclasses import dataclass\n\n\n@dataclass(frozen=True)\nclass UsageRow:\n    event_id: str\n    tenant: str\n    service: str\n    cpu_seconds: float\n    bytes_out: int\n\n\ndef parse_rows(lines):\n    \"\"\"lines: iterable of 'event_id,tenant,service,cpu_seconds,bytes_out'\"\"\"\n    rows = []\n    for line in lines:\n        line = line.strip()\n        if not line or line.startswith(\"#\"):\n            continue\n        e, t, s, c, b = line.split(\",\")\n        rows.append(UsageRow(e, t, s, float(c), int(b)))\n    return rows\nfrom .model import UsageRow, parse_rows\nfrom .dedupe import dedupe_rows\nfrom .aggregate import aggregate\nfrom .report import build_report\n\n__all__ = [\"UsageRow\", \"parse_rows\", \"dedupe_rows\", \"aggregate\", \"build_report\"]\n# reporting\n\nNightly usage report. `python -m pytest` runs the tests.","is_error":false}]},"parent_tool_use_id":null,"session_id":"54523f15-7a55-40d7-a1a3-2f5d4f3a68a2","uuid":"df9b27dc-3ed8-40c7-befc-e9219b73c6e6","timestamp":"2026-10-09T17:09:05.554Z","tool_use_result":{"stdout":"               