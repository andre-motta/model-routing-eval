  )","+        provider = resolver.PyPIProvider(include_sdists=True)","+        with caplog.at_level(logging.INFO, logger=\"fromager.resolver\"):","+            resolver.find_all_matching_from_provider(","+                provider,","+                Requirement(\"test-pkg\"),","+                max_age_cutoff=max_age_cutoff,","+                age_fallback=resolver.AgeFallback.ALL,","+            )","+    all_levels = [r.levelno for r in caplog.records if \"older than\" in r.message]","+    assert all_levels == [logging.WARNING]","+","+    caplog.clear()","+    with requests_mock.Mocker() as r:","+        r.get(","+            \"https://pypi.org/simple/test-pkg/\",","+            json=_cooldown_json_response,","+            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},","+        )","+        provider = resolver.PyPIProvider(include_sdists=True)","+        with caplog.at_level(logging.INFO, logger=\"fromager.resolver\"):","+            resolver.find_all_matching_from_provider(","+                provider,","+                Requirement(\"test-pkg\"),","+                max_age_cutoff=max_age_cutoff,","+                age_fallback=resolver.AgeFallback.NEWEST,","+            )","+    newest_levels = [r.levelno for r in caplog.records if \"older than\" in r.message]","+    assert newest_levels == [logging.INFO]","+","+","+def test_max_release_age_pinned_constraint_skips_age_filter(","+    caplog: pytest.LogCaptureFixture,","+) -> None:","+    \"\"\"An exact == constraint keeps candidates that the age window would drop.\"\"\"","+    max_age_cutoff = _BOOTSTRAP_TIME - datetime.timedelta(days=30)","+    constraints = context.Constraints()","+    constraints.add_constraint(\"test-pkg==1.2.2\")","+    with requests_mock.Mocker() as r:","+        r.get(","+            \"https://pypi.org/simple/test-pkg/\",","+            json=_cooldown_json_response,","+            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},","+        )","+        provider = resolver.PyPIProvider(","+            include_sdists=True, constraints=constraints","+        )","+        with caplog.at_level(logging.INFO, logger=\"fromager.resolver\"):","+            results = resolver.find_all_matching_from_provider(","+                provider, Requirement(\"test-pkg\"), max_age_cutoff=max_age_cutoff","+            )","+","+    versions = [str(v) for _, v in results]","+    assert versions == [\"2.0.0\", \"1.3.2\", \"1.2.2\"]","+    assert (","+        \"test-pkg: skipping age filter for pinned constraint (3 candidate(s))\"","+        in caplog.text","+    )","+    assert \"published within\" not in caplog.text","+","+","+def test_max_release_age_pinned_constraint_outside_window_not_empty() -> None:","+    \"\"\"A pin to a version older than the window still resolves in NEWEST mode.\"\"\"","+    max_age_cutoff = _BOOTSTRAP_TIME + datetime.timedelta(days=1)","+    constraints = context.Constraints()","+    constraints.add_constraint(\"test-pkg==1.2.2\")","+    with requests_mock.Mocker() as r:","+        r.get(","+            \"https://pypi.org/simple/test-pkg/\",","+            json=_cooldown_json_response,","+            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},","+        )","+        provider = resolver.PyPIProvider(","+            include_sdists=True, constraints=constraints","+        )","+        results = resolver.find_all_matching_from_provider(","+            provider,","+            Requirement(\"test-pkg\"),","+            max_age_cutoff=max_age_cutoff,","+            age_fallback=resolver.AgeFallback.NEWEST,","+        )","+","+    versions = [str(v) for _, v in results]","+    assert \"1.2.2\" in versions","+","+","+def test_max_release_age_range_constraint_still_filtered() -> None:","+    \"\"\"A range constraint (not ==) is still subject to the age window.\"\"\"","+    max_age_cutoff = _BOOTSTRAP_TIME - datetime.timedelta(days=30)","+    constraints = context.Constraints()","+    constraints.add_constraint(\"test-pkg>=1.0\")","+    with requests_mock.Mocker() as r:","+        r.get(","+            \"https://pypi.org/simple/test-pkg/\",","+            json=_cooldown_json_response,","+            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},","+        )","+        provider = resolver.PyPIProvider(","+            include_sdists=True, constraints=constraints","+        )","+        results = resolver.find_all_matching_from_provider(","+            provider, Requirement(\"test-pkg\"), max_age_cutoff=max_age_cutoff","+        )","+","+    versions = [str(v) for _, v in results]","+    assert versions == [\"2.0.0\", \"1.3.2\"]","+","+"," def test_max_release_age_candidates_without_upload_time_pass_through() -> None:","     \"\"\"Candidates without upload_time are not filtered out by max-release-age.\"\"\"","     no_timestamp_response = {"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"tool_result_meta":[{"id":"toolu_015WwZSksp42DTRgFPUyetBs","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
