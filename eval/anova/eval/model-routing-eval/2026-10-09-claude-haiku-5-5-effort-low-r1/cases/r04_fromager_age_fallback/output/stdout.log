,","+                    len(filtered),","+                    req,","+                    max_age_days,","+                )","+            if filtered:","+                candidates_list = filtered","+            elif age_fallback is AgeFallback.ALL:","+                logger.warning(","+                    \"%s: all %d candidate(s) of %s are older than %d days, \"","+                    \"keeping all to avoid empty resolution\",","+                    req.name,","+                    len(candidates_list),","+                    req,","+                    max_age_days,","+                )","+            elif age_fallback is AgeFallback.NEWEST:","+                # Candidates are sorted highest version first.","+                if candidates_list:","+                    logger.info(","+                        \"%s: all %d candidate(s) of %s are older than %d days, \"","+                        \"falling back to newest version %s\",","+                        req.name,","+                        len(candidates_list),","+                        req,","+                        max_age_days,","+                        candidates_list[0].version,","+                    )","+                    candidates_list = candidates_list[:1]","+            else:","+                logger.info(","+                    \"%s: all %d candidate(s) of %s are older than %d days\",","+                    req.name,","+                    len(candidates_list),","+                    req,","+                    max_age_days,","+                )","+                candidates_list = []"," ","     # Convert candidates to list of (url, version) tuples","     # Candidates are sorted by version (highest first) by BaseProvider.find_matches()"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"tool_result_meta":[{"id":"toolu_015AsA444eEgCVSdeBu3kCsB","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
