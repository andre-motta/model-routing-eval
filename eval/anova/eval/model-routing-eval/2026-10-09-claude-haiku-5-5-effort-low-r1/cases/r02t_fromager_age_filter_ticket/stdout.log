f test_max_release_age_filters_old_versions(\ntests/test_cooldown.py:712:    \"\"\"Versions older than max-release-age are filtered out.\"\"\"\ntests/test_cooldown.py:735:def test_max_release_age_keeps_only_recent(\ntests/test_cooldown.py:738:    \"\"\"With a tight max-release-age, only very recent versions survive.\"\"\"\ntests/test_cooldown.py:759:def test_max_release_age_disabled_returns_all() -> None:\ntests/test_cooldown.py:778:def test_max_release_age_all_too_old_keeps_all(\ntests/test_cooldown.py:796:    assert \"keeping all to avoid empty resolution\" in caplog.text\ntests/test_cooldown.py:799:def test_max_release_age_all_too_old_returns_empty_when_fallback_disabled(\ntests/test_cooldown.py:820:    assert \"keeping all to avoid empty resolution\" not in caplog.text\ntests/test_cooldown.py:823:def test_max_release_age_candidates_without_upload_time_pass_through() -> None:\ntests/test_cooldown.py:824:    \"\"\"Candidates without upload_time are not filtered out by max-release-age.\"\"\"\ntests/test_cooldown.py:852:def test_max_release_age_combined_with_cooldown() -> None:\ntests/test_cooldown.py:853:    \"\"\"Both cooldown (min-release-age) and max-release-age work together as a window.\"\"\"\ntests/test_cooldown.py:861:        # Cooldown blocks 2.0.0 (too new), max-release-age blocks 1.2.2 (too old)\ntests/test_cooldown.py:879:    tmp_context.set_max_release_age(30)\ntests/test_cooldown.py:889:    tmp_context.set_max_release_age(30)\ntests/test_cooldown.py:899:    \"\"\"_compute_max_age_cutoff returns None when max_release_age is not set.\"\"\"\nsrc/fromager/context.py:51:        max_release_age: datetime.timedelta | None = None,\nsrc/fromager/context.py:99:        self._max_release_age: datetime.timedelta | None = max_release_age\nsrc/fromager/context.py:102:    def max_release_age(self) -> datetime.timedelta | None:\nsrc/fromager/context.py:103:        return self._max_release_age\nsrc/fromager/context.py:105:    def set_max_release_age(self, days: int) -> 