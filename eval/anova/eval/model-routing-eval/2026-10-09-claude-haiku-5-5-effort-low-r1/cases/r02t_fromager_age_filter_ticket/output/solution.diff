+def test_max_release_age_skipped_for_constrained_package(
+    caplog: pytest.LogCaptureFixture,
+) -> None:
+    """A constraint pins the package past the age window, so the filter is skipped."""
+    # Arrange: every candidate is older than the cutoff, and the fallback is
+    # disabled (multi-version mode). Without the constraint this returns [].
+    max_age_cutoff = _BOOTSTRAP_TIME + datetime.timedelta(days=1)
+    constraint_set = constraints.Constraints()
+    constraint_set.add_constraint("test-pkg==1.2.2")
+    with requests_mock.Mocker() as r:
+        r.get(
+            "https://pypi.org/simple/test-pkg/",
+            json=_cooldown_json_response,
+            headers={"Content-Type": _PYPI_SIMPLE_JSON_CONTENT_TYPE},
+        )
+        provider = resolver.PyPIProvider(
+            include_sdists=True, constraints=constraint_set
+        )
+
+        # Act
+        with caplog.at_level(logging.INFO, logger="fromager.resolver"):
+            results = resolver.find_all_matching_from_provider(
+                provider,
+                Requirement("test-pkg"),
+                max_age_cutoff=max_age_cutoff,
+                fallback_on_empty_age_filter=False,
+            )
+
+    # Assert: the constraint leaves only the pinned version, and the age
+    # filter does not drop it.
+    versions = [str(v) for _, v in results]
+    assert versions == ["1.2.2"]
+    assert "skipping max release age filter" in caplog.text
+    assert "published within" not in caplog.text
+
