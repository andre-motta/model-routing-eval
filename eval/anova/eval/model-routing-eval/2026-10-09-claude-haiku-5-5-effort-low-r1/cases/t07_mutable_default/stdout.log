\n   8     tags: list = field(default_factory=list)\n   9 \n  10 \n  11 class Warehouse:\n  12     def __init__(self, name, stock={}, history=[]):\n  13         self.name = name\n  14         self.stock = stock\n  15         self.history = history\n  16 \n  17     def restock(self, sku, qty, tags=[]):\n  18         item = self.stock.get(sku)\n  19         if item is None:\n  20             item = Item(sku, 0, tags)\n  21             self.stock[sku] = item\n  22         item.qty += qty\n  23         self.history.append((\"restock\", sku, qty))\n  24 \n  25     def ship(self, sku, qty):\n  26         item = self.stock[sku]\n  27         if item.qty < qty:\n  28             raise ValueError(\"insufficient stock\")\n  29         item.qty -= qty\n  30         self.history.append((\"ship\", sku, qty))\n  31 \n  32     def report(self):\n  33         return {sku: item.qty for sku, item in sorted(self.stock.items())}\n---\n   1 from inv.warehouse import Warehouse\n   2 \n   3 \n   4 def test_independent_warehouses():\n   5     a = Warehouse(\"a\")\n   6     a.restock(\"bolt\", 5)\n   7     b = Warehouse(\"b\")\n   8     assert b.report() == {}\n   9     b.restock(\"nut\", 2)\n  10     assert a.report() == {\"bolt\": 5}\n  11     assert len(b.history) == 1","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01CKQGjFbwYSdRA2QQxgyz2n","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
