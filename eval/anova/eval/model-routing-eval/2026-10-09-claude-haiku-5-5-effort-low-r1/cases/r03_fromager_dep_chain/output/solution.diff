+    def _dependency_chain_suffix(self, wi: WorkItem) -> str:
+        """Describe the dependency chain that led to a work item.
+
+        Returns a suffix such as ``" (dependency chain: a==1 -> b==2 -> c>=3)"``
+        built from ``wi.why_snapshot``, ending with the work item's requirement.
+        """
+        chain = [f"{req.name}=={version}" for _, req, version in wi.why_snapshot]
+        chain.append(str(wi.req))
+        return f" (dependency chain: {' -> '.join(chain)})"
+
+    def _enrich_resolution_error(self, item: Phase, err: Exception) -> Exception:
+        """Attach the dependency chain to a resolution error.
+
+        Only ``Resolve`` items with a non-empty ``why_snapshot`` are enriched.
+        Returns a new exception of the same shape with the chain appended to
+        the message. Any other error is returned unchanged.
+        """
+        if not isinstance(item, Resolve) or not item.work_item.why_snapshot:
+            return err
+        suffix = self._dependency_chain_suffix(item.work_item)
+        if isinstance(err, ResolverException):
+            return ResolverException(f"{err}{suffix}")
+        if isinstance(err, RuntimeError):
+            return RuntimeError(f"{err}{suffix}")
+        return RuntimeError(f"{type(err).__name__}: {err}{suffix}")
+
