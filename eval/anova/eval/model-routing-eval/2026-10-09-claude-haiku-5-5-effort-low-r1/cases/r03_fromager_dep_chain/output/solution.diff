+_CHAIN = [
+    (RequirementType.INSTALL, Requirement("its-hub"), Version("1.0")),
+    (RequirementType.INSTALL, Requirement("reward-hub"), Version("2.0")),
+]
+_CHAIN_SUFFIX = " (dependency chain: its-hub==1.0 -> reward-hub==2.0 -> vllm>=0.6)"
+
+
+class TestDependencyChainEnrichment:
+    def test_chain_suffix_lists_why_snapshot_then_requirement(
+        self, tmp_context: WorkContext
+    ) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context)
+        wi = _make_work_item(req="vllm>=0.6", why_snapshot=list(_CHAIN))
+
+        assert bt._dependency_chain_suffix(wi) == _CHAIN_SUFFIX
+
+    def test_top_level_resolve_error_returned_unchanged(
+        self, tmp_context: WorkContext
+    ) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context)
+        item = _make_resolve_item("vllm")
+        err = RuntimeError("resolution failed")
+
+        assert bt._enrich_resolution_error(item, err) is err
+
+    def test_non_resolve_error_returned_unchanged(
+        self, tmp_context: WorkContext
+    ) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context)
+        item = _make_build_item(phase=BootstrapPhase.BUILD)
+        item.work_item.why_snapshot = list(_CHAIN)
+        err = RuntimeError("build failed")
+
+        assert bt._enrich_resolution_error(item, err) is err
+
+    def test_resolver_exception_stays_resolver_exception(
+        self, tmp_context: WorkContext
+    ) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context)
+        item = _make_resolve_item("vllm>=0.6", why_snapshot=list(_CHAIN))
+        err = ResolverException("no candidates")
+
+        enriched = bt._enrich_resolution_error(item, err)
+
+        assert type(enriched) is ResolverException
+        assert str(enriched) == "no candidates" + _CHAIN_SUFFIX
+
+    def test_runtime_error_stays_runtime_error(
+        self, tmp_context: WorkContext
+    ) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context)
+        item = _make_resolve_item("vllm>=0.6", why_snapshot=list(_CHAIN))
+        err = RuntimeError("resolution failed")
+
+        enriched = bt._enrich_resolution_error(item, err)
+
+        assert type(enriched) is RuntimeError
+        assert str(enriched) == "resolution failed" + _CHAIN_SUFFIX
+
+    def test_other_error_becomes_runtime_error_with_type_name(
+        self, tmp_context: WorkContext
+    ) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context)
+        item = _make_resolve_item("vllm>=0.6", why_snapshot=list(_CHAIN))
+        err = ValueError("bad specifier")
+
+        enriched = bt._enrich_resolution_error(item, err)
+
+        assert type(enriched) is RuntimeError
+        assert str(enriched) == "ValueError: bad specifier" + _CHAIN_SUFFIX
+
+    def test_normal_mode_raise_keeps_original_as_context(
+        self, tmp_context: WorkContext
+    ) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context)
+        item = _make_resolve_item("vllm>=0.6", why_snapshot=list(_CHAIN))
+        err = RuntimeError("Unable to resolve")
+
+        with pytest.raises(RuntimeError) as exc_info:
+            try:
+                raise err
+            except RuntimeError:
+                bt._handle_phase_error(item, err)
+
+        raised = exc_info.value
+        assert str(raised) == "Unable to resolve" + _CHAIN_SUFFIX
+        assert raised.__context__ is err
+        assert raised.__cause__ is None
+
+    def test_test_mode_records_enriched_error(
+        self, tmp_context: WorkContext
+    ) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context, test_mode=True)
+        item = _make_resolve_item("vllm>=0.6", why_snapshot=list(_CHAIN))
+        err = RuntimeError("Unable to resolve")
+
+        with patch.object(bt, "record_test_mode_failure") as mock_record:
+            result = bt._handle_phase_error(item, err)
+
+        assert result == []
+        recorded_err = mock_record.call_args.args[2]
+        assert str(recorded_err) == "Unable to resolve" + _CHAIN_SUFFIX
+
+    def test_multiple_versions_records_enriched_error(
+        self, tmp_context: WorkContext
+    ) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context, multiple_versions=True)
+        item = _make_resolve_item("vllm>=0.6", why_snapshot=list(_CHAIN))
+        err = ResolverException("no candidates")
+
+        result = bt._handle_phase_error(item, err)
+
+        assert result == []
+        key = (canonicalize_name("vllm"), "unresolved")
+        recorded_err = bt._failed_versions[key]
+        assert type(recorded_err) is ResolverException
+        assert str(recorded_err) == "no candidates" + _CHAIN_SUFFIX
+
