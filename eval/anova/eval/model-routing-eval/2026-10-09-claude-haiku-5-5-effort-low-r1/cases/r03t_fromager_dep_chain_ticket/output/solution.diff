index 51dc541..ce041df 100644
--- a/src/fromager/bootstrapper/_resolve.py
+++ b/src/fromager/bootstrapper/_resolve.py
@@ -6,6 +6,7 @@ import typing
 from packaging.requirements import Requirement
 from packaging.utils import canonicalize_name
 from packaging.version import Version
+from resolvelib.resolvers import ResolverException
 
 from .. import bootstrap_requirement_resolver
 from ..log import req_ctxvar_context
@@ -88,7 +89,18 @@ class Resolve(Phase):
         assert self.bg_future is not None
         # bg_future.result() blocks until the background resolution completes,
         # then returns the result or re-raises any exception from the background.
-        resolved_versions = self.bg_future.result()
+        try:
+            resolved_versions = self.bg_future.result()
+        except ResolverException as err:
+            # The error is logged under the active top-level requirement, so
+            # name the broken arc (parent -> this requirement) and the chain.
+            if not self.work_item.why_snapshot:
+                raise
+            parent = self.work_item.why_snapshot[-1][1].name
+            chain = " -> ".join(req.name for _, req, _ in self.work_item.why_snapshot)
+            raise ResolverException(
+                f"{err} (required by {parent}, dependency chain: {chain})"
+            ) from err
         if not resolved_versions:
             raise RuntimeError(
                 f"Could not resolve any versions for {self.work_item.req}"
