+    def test_resolver_error_names_broken_parent(self, tmp_context: WorkContext) -> None:
+        """A resolution failure names the parent arc and the full chain, not the top-level req."""
+        # Arrange
+        bt = bootstrapper.Bootstrapper(tmp_context)
+        why = [
+            (RequirementType.TOP_LEVEL, Requirement("its-hub"), Version("1.0")),
+            (RequirementType.INSTALL, Requirement("reward-hub"), Version("2.0")),
+            (RequirementType.INSTALL, Requirement("vllm"), Version("3.0")),
+        ]
+        item = _make_resolve_item(
+            req="flashinfer-python==0.6.8.post1",
+            req_type=RequirementType.INSTALL,
+            why_snapshot=why,
+        )
+        future: concurrent.futures.Future[typing.Any] = concurrent.futures.Future()
+        future.set_exception(
+            ResolverException(
+                "Unable to resolve requirement specifier flashinfer-python==0.6.8.post1"
+            )
+        )
+        item.bg_future = future
+
+        # Act
+        with pytest.raises(ResolverException) as exc_info:
+            item.run(bt)
+
+        # Assert
+        message = str(exc_info.value)
+        assert "required by vllm" in message
+        assert "dependency chain: its-hub -> reward-hub -> vllm" in message
+        assert isinstance(exc_info.value.__cause__, ResolverException)
+
     def test_multiple_versions(self, tmp_context: WorkContext) -> None:
         bt = bootstrapper.Bootstrapper(tmp_context, multiple_versions=True)
         item = _make_resolve_item()
