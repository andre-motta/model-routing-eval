{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LWPBgwfUPZUe8kEvF6zFLL","type":"tool_result","content":"1\t\"\"\"Requirement resolution for bootstrap process.\n2\t\n3\tHandles PyPI and graph-based resolution strategies.\n4\tGit URL resolution stays in Bootstrapper (orchestration concern).\n5\t\"\"\"\n6\t\n7\tfrom __future__ import annotations\n8\t\n9\timport logging\n10\timport threading\n11\timport typing\n12\t\n13\tfrom packaging.requirements import Requirement\n14\tfrom packaging.utils import NormalizedName, canonicalize_name\n15\tfrom packaging.version import Version\n16\t\n17\tfrom . import finders, resolver, sources, wheels\n18\tfrom .dependency_graph import DependencyGraph\n19\tfrom .requirements_file import RequirementType\n20\t\n21\tif typing.TYPE_CHECKING:\n22\t    from . import context\n23\t\n24\tlogger = logging.getLogger(__name__)\n25\t\n26\t\n27\tclass BootstrapRequirementResolver:\n28\t    \"\"\"Resolve package requirements from PyPI or dependency graph during bootstrap.\n29\t\n30\t    Single Responsibility: Coordinate resolution strategies for bootstrap process.\n31\t    Reason to Change: Resolution algorithm or provider priorities change.\n32\t\n33\t    Resolution strategies (in order):\n34\t    1. Previous dependency graph (if available)\n35\t    2. PyPI lookup (via existing sources/resolver modules)\n36\t\n37\t    Git URL resolution is NOT handled here - that stays in Bootstrapper\n38\t    because it requires BuildEnvironment and build dependencies.\n39\t    \"\"\"\n40\t\n41\t    def __init__(\n42\t        self,\n43\t        ctx: context.WorkContext,\n44\t        prev_graph: DependencyGraph | None = None,\n45\t        multiple_versions: bool = False,\n46\t        cache_wheel_server_url: str = \"\",\n47\t    ) -> None:\n48\t        \"\"\"Initialize requirement resolver.\n49\t\n50\t        Args:\n51\t            ctx: Work context with constraints and settings\n52\t            prev_graph: Optional previous dependency graph for caching\n53\t            multiple_versions: If ``True`` and no results are found through\n54\t                any other approach, takes the latest candidate from the\n55\t                cache server, ignoring the age filters.  In all other\n56\t                cases, returns an empty list when no candidates are found.\n57\t            cache_wheel_server_url: URL of the remote wheel cache server.\n58\t                Used as a fallback when age filtering produces no candidates.\n59\t        \"\"\"\n60\t        self.ctx = ctx\n61\t        self.prev_graph = prev_graph\n62\t        self.multiple_versions = multiple_versions\n63\t        self.cache_wheel_server_url = cache_wheel_server_url\n64\t        # All known versions for a package, accumulated across resolution\n65\t        # contexts.  Versions discovered via different specifiers or req_types\n66\t        # are merged so that later lookups see the widest set.\n67\t        # Key: (normalized_name, pre_built)\n68\t        # Value: {version: url}\n69\t        self._known_versions: dict[tuple[NormalizedName, bool], dict[Version, str]] = {}\n70\t        # Requirement rules already resolved from network/graph.\n71\t        # Key: (str(req), pre_built)\n72\t        # Prevents redundant network calls for the same specifier.\n73\t        self._resolved_rules: set[tuple[str, bool]] = set()\n74\t        # Protects _known_versions and _resolved_rules for thread safety.\n75\t        self._lock = threading.Lock()\n76\t\n77\t    def resolve(\n78\t        self,\n79\t        req: Requirement,\n80\t        req_type: RequirementType,\n81\t        parent_req: Requirement | None = None,\n82\t        pre_built: bool | None = None,\n83\t        return_all_versions: bool = False,\n84\t    ) -> list[tuple[str, Version]]:\n85\t        \"\"\"Resolve package requirement to matching version(s).\n86\t\n87\t        Uses a two-step strategy:\n88\t        1. If this requirement rule has not been resolved before, fetch\n89\t           versions from the network (or previous graph) and extend the\n90\t           package-level known-versions cache.\n91\t        2. Filter all known versions for the package by the current\n92\t           requirement specifier.\n93\t\n94\t        This ensures that versions discovered in one context (e.g.,\n95\t        top-level with cooldown bypass) are visible to later lookups\n96\t        with different specifiers for the same package.\n97\t\n98\t        Args:\n99\t            req: Package requirement\n100\t            req_type: Type of requirement\n101\t            parent_req: Parent requirement from dependency chain\n102\t            pre_built: Optional override to force prebuilt (True) or source (False).\n103\t                If None (default), uses package build info to determine.\n104\t            return_all_versions: If True, return all matching versions. If False,\n105\t                return only the highest matching version.\n106\t\n107\t        Returns:\n108\t            List of (url, version) tuples sorted by version (highest first).\n109\t            Contains one item when return_all_versions=False, or all matching\n110\t            versions when return_all_versions=True.\n111\t\n112\t        Raises:\n113\t            ValueError: If req contains a git URL and pre_built is False\n114\t                (git URL source resolution must be handled by Bootstrapper)\n115\t        \"\"\"\n116\t        # Determine pre_built if not specified (needed for cache key and URL guard)\n117\t        if pre_built is None:\n118\t            pbi = self.ctx.package_build_info(req)\n119\t            pre_built = pbi.pre_built\n120\t\n121\t        # Check session cache BEFORE the git URL guard so that background\n122\t        # threads can retrieve pre-cached git URL resolutions (populated by\n123\t        # Bootstrapper.resolve_versions() on the main thread before bootstrap()\n124\t        # is called) without hitting the ValueError.\n125\t        cached_result = self.get_cached_resolution(req, pre_built)\n126\t        if cached_result is not None:\n127\t            logger.debug(f\"resolved {req} from cache\")\n128\t            return list(cached_result) if return_all_versions else [cached_result[0]]\n129\t\n130\t        # Git URL source resolution must be handled by Bootstrapper.\n131\t        # But git URL prebuilt resolution is allowed - we look for wheels on PyPI\n132\t        # (test mode fallback uses this path).\n133\t        if req.url and not pre_built:\n134\t            raise ValueError(\n135\t                f\"Git URL requirements must be handled by Bootstrapper: {req}\"\n136\t            )\n137\t\n138\t        rule_key = (str(req), pre_built)\n139\t\n140\t        with self._lock:\n141\t            if rule_key not in self._resolved_rules:\n142\t                # Rule not seen before — resolve from graph or network and\n143\t                # extend the package-level known-versions cache.\n144\t                self._resolve_and_extend(req, req_type, pre_built, parent_req)\n145\t                self._resolved_rules.add(rule_key)\n146\t            else:\n147\t                logger.debug(f\"rule already resolved: {req}\")\n148\t\n149\t            # Filter all known versions by the current requirement specifier.\n150\t            matching = self._get_matching_versions(req, pre_built)\n151\t\n152\t        if not matching:\n153\t            return []\n154\t        if return_all_versions:\n155\t            return matching\n156\t        return [matching[0]]\n157\t\n158\t    def get_cached_resolution(\n159\t        self,\n160\t        req: Requirement,\n161\t        pre_built: bool,\n162\t    ) -> list[tuple[str, Version]] | None:\n163\t        \"\"\"Return cached matching versions if this requirement was already resolved.\n164\t\n165\t        Returns ``None`` if the requirement has not been resolved yet, allowing\n166\t        callers to distinguish between \"no matching versions\" and \"not yet resolved\".\n167\t\n168\t        Used by background threads to retrieve pre-cached git URL resolutions\n169\t        populated by the main thread before entering the parallel section.\n170\t\n171\t        Args:\n172\t            req: Package requirement\n173\t            pre_built: Whether looking for prebuilt or source resolution\n174\t\n175\t        Returns:\n176\t            List of (url, version) tuples if previously resolved, None otherwise.\n177\t        \"\"\"\n178\t        rule_key = (str(req), pre_built)\n179\t        with self._lock:\n180\t            if rule_key in self._resolved_rules:\n181\t                return self._get_matching_versions(req, pre_built)\n182\t        return None\n183\t\n184\t    def _resolve_and_extend(\n185\t        self,\n186\t        req: Requirement,\n187\t        req_type: RequirementType,\n188\t        pre_built: bool,\n189\t        parent_req: Requirement | None,\n190\t    ) -> None:\n191\t        \"\"\"Resolve versions from graph/network and extend known versions cache.\"\"\"\n192\t        # Try previous dependency graph\n193\t        cached_resolution = self._resolve_from_graph(\n194\t            req=req,\n195\t            req_type=req_type,\n196\t            pre_built=pre_built,\n197\t            parent_req=parent_req,\n198\t        )\n199\t\n200\t        if cached_resolution and not req.url:\n201\t            logger.debug(\n202\t                f\"resolved from previous bootstrap: {len(cached_resolution)} version(s)\"\n203\t            )\n204\t            results = cached_resolution\n205\t        elif pre_built:\n206\t            # Resolve prebuilt wheel\n207\t            wheel_server_urls = wheels.get_wheel_server_urls(\n208\t                self.ctx, req, cache_wheel_server_url=resolver.PYPI_SERVER_URL\n209\t            )\n210\t            results = wheels.resolve_all_prebuilt_wheels(\n211\t                ctx=self.ctx,\n212\t                req=req,\n213\t                wheel_server_urls=wheel_server_urls,\n214\t                req_type=req_type,\n215\t            )\n216\t        else:\n217\t            # Resolve source (sdist)\n218\t            provider = sources.get_source_provider(\n219\t                ctx=self.ctx,\n220\t                req=req,\n221\t                sdist_server_url=resolver.PYPI_SERVER_URL,\n222\t                req_type=req_type,\n223\t            )\n224\t            max_age_cutoff = resolver._compute_max_age_cutoff(self.ctx)\n225\t            results = resolver.find_all_matching_from_provider(\n226\t                provider,\n227\t                req,\n228\t                max_age_cutoff=max_age_cutoff,\n229\t                fallback_on_empty_age_filter=not self.multiple_versions,\n230\t            )\n231\t\n232\t            if not results and self.multiple_versions and self.cache_wheel_server_url:\n233\t                logger.info(\n234\t                    \"no results found with normal resolution, \"\n235\t                    \"falling back to the cache server %s\",\n236\t                    self.cache_wheel_server_url,\n237\t                )\n238\t                results = self._resolve_from_cache_server(req)\n239\t\n240\t            if not results:\n241\t                logger.warning(\n242\t                    \"resolver returned no results \"\n243\t                    \"(wheel server URL %s, %s version mode)\",\n244\t                    self.cache_wheel_server_url or \"(none)\",\n245\t                    \"multiple\" if self.multiple_versions else \"single\",\n246\t                )\n247\t\n248\t        if results:\n249\t            self._extend_known_versions(req, pre_built, results)\n250\t\n251\t    def _resolve_from_cache_server(self, req: Requirement) -> list[tuple[str, Version]]:\n252\t        \"\"\"Fall back to the remote wheel cache server for a cached version.\n253\t\n254\t        When age filtering removes all candidates in multi-version mode,\n255\t        queries the remote cache server for the newest available wheel.\n256\t        Returns at most one version so that transitive dependencies are\n257\t        re-processed without rebuilding every old version.\n258\t        \"\"\"\n259\t        logger.info(\n260\t            \"checking cache server %s for existing build\",\n261\t            self.cache_wheel_server_url,\n262\t        )\n263\t        best: tuple[str, Version] | None = None\n264\t        for include_sdists, include_wheels in [(False, True), (True, False)]:\n265\t            try:\n266\t                provider = finders.PyPICacheProvider(\n267\t                    cache_server_url=self.cache_wheel_server_url,\n268\t                    constraints=self.ctx.constraints,\n269\t                    include_sdists=include_sdists,\n270\t                    include_wheels=include_wheels,\n271\t                )\n272\t                results = resolver.find_all_matching_from_provider(provider, req)\n273\t                if results:\n274\t                    url, version = results[0]\n275\t                    if best is None or version > best[1]:\n276\t                        best = (url, version)\n277\t            except Exception as err:\n278\t                logger.warning(\n279\t                    \"error checking cache server %s: %s\",\n280\t                    self.cache_wheel_server_url,\n281\t                    err,\n282\t                )\n283\t        if best is not None:\n284\t            logger.info(\"found version %s on cache server\", best[1])\n285\t            return [best]\n286\t        return []\n287\t\n288\t    def get_matching_versions(\n289\t        self,\n290\t        req: Requirement,\n291\t        pre_built: bool,\n292\t    ) -> list[tuple[str, Version]]:\n293\t        \"\"\"Filter known versions by requirement specifier (thread-safe).\n294\t\n295\t        Returns all known versions of the package that satisfy the\n296\t        requirement's version specifier, sorted highest-first.\n297\t\n298\t        Args:\n299\t            req: Package requirement with version specifier\n300\t            pre_built: Whether looking for prebuilt or source resolution\n301\t\n302\t        Returns:\n303\t            List of (url, version) tuples matching the specifier.\n304\t        \"\"\"\n305\t        with self._lock:\n306\t            return self._get_matching_versions(req, pre_built)\n307\t\n308\t    def _get_matching_versions(\n309\t        self,\n310\t        req: Requirement,\n311\t        pre_built: bool,\n312\t    ) -> list[tuple[str, Version]]:\n313\t        \"\"\"Filter known versions (caller must hold ``self._lock``).\"\"\"\n314\t        key = (canonicalize_name(req.name), pre_built)\n315\t        versions = self._known_versions.get(key, {})\n316\t        matching = [\n317\t            (url, version)\n318\t            for version, url in versions.items()\n319\t            if version in req.specifier\n320\t        ]\n321\t        matching.sort(key=lambda x: x[1], reverse=True)\n322\t        return matching\n323\t\n324\t    def extend_known_versions(\n325\t        self,\n326\t        req: Requirement,\n327\t        pre_built: bool,\n328\t        result: list[tuple[str, Version]],\n329\t    ) -> None:\n330\t        \"\"\"Extend the known-versions cache and mark the rule as resolved (thread-safe).\n331\t\n332\t        Merges new versions into the package-level cache. When a version\n333\t        already exists, a non-empty URL takes precedence over an empty one\n334\t        (graph-resolved placeholders are replaced by real download URLs).\n335\t\n336\t        Used by Bootstrapper to cache git URL resolutions that are\n337\t        handled externally (outside this resolver).\n338\t\n339\t        Args:\n340\t            req: Package requirement (used for name and rule tracking)\n341\t            pre_built: Whether this is a prebuilt or source resolution\n342\t            result: List of (url, version) tuples to add\n343\t        \"\"\"\n344\t        with self._lock:\n345\t            self._extend_known_versions(req, pre_built, result)\n346\t\n347\t    def _extend_known_versions(\n348\t        self,\n349\t        req: Requirement,\n350\t        pre_built: bool,\n351\t        result: list[tuple[str, Version]],\n352\t    ) -> None:\n353\t        \"\"\"Extend known versions (caller must hold ``self._lock``).\"\"\"\n354\t        key = (canonicalize_name(req.name), pre_built)\n355\t        versions = self._known_versions.setdefault(key, {})\n356\t        for url, version in result:\n357\t            if version not in versions or (url and not versions[version]):\n358\t                versions[version] = url\n359\t        self._resolved_rules.add((str(req), pre_built))\n360\t\n361\t    def _resolve_from_graph(\n362\t        self,\n363\t        req: Requirement,\n364\t        req_type: RequirementType,\n365\t        pre_built: bool,\n366\t        parent_req: Requirement | None,\n367\t    ) -> list[tuple[str, Version]] | None:\n368\t        \"\"\"Resolve from previous dependency graph.\n369\t\n370\t        Extracted from Bootstrapper._resolve_from_graph().\n371\t\n372\t        Args:\n373\t            req: Package requirement\n374\t            req_type: Type of requirement\n375\t            pre_built: Whether to look for pre-built packages\n376\t            parent_req: Parent requirement for graph traversal\n377\t\n378\t        Returns:\n379\t            List of (url, version) tuples if found in graph, None otherwise\n380\t        \"\"\"\n381\t        if not self.prev_graph:\n382\t            return None\n383\t\n384\t        seen_version: set[str] = set()\n385\t\n386\t        # First perform resolution using the top level reqs before looking at history\n387\t        possible_versions_in_top_level: list[tuple[str, Version]] = []\n388\t        for (\n389\t            top_level_edge\n390\t        ) in self.ctx.dependency_graph.get_root_node().get_outgoing_edges(\n391\t            req.name, RequirementType.TOP_LEVEL\n392\t        ):\n393\t            possible_versions_in_top_level.append(\n394\t                (\n395\t                    top_level_edge.destination_node.download_url,\n396\t                    top_level_edge.destination_node.version,\n397\t                )\n398\t            )\n399\t            seen_version.add(str(top_level_edge.destination_node.version))\n400\t\n401\t        resolver_result = self._resolve_from_version_source(\n402\t            possible_versions_in_top_level, req\n403\t        )\n404\t        if resolver_result:\n405\t            return resolver_result\n406\t\n407\t        # Only if there is nothing in top level reqs, resolve using history\n408\t        possible_versions_from_graph: list[tuple[str, Version]] = []\n409\t        # Check all nodes which have the same parent name irrespective of the parent's version\n410\t        for parent_node in self.prev_graph.get_nodes_by_name(\n411\t            parent_req.name if parent_req else None\n412\t        ):\n413\t            # If the edge matches the current req and type then it is a possible candidate.\n414\t            # Filtering on type might not be necessary, but we are being safe here. This will\n415\t            # for sure ensure that bootstrap takes the same route as it did in the previous one.\n416\t            # If we don't filter by type then it might pick up a different version from a different\n417\t            # type that should have appeared much later in the resolution process.\n418\t            for edge in parent_node.get_outgoing_edges(req.name, req_type):\n419\t                if (\n420\t                    edge.destination_node.pre_built == pre_built\n421\t                    and str(edge.destination_node.version) not in seen_version\n422\t                ):\n423\t                    possible_versions_from_graph.append(\n424\t                        (\n425\t                            edge.destination_node.download_url,\n426\t                            edge.destination_node.version,\n427\t                        )\n428\t                    )\n429\t                    seen_version.add(str(edge.destination_node.version))\n430\t\n431\t        resolver_result = self._resolve_from_version_source(\n432\t            possible_versions_from_graph, req\n433\t        )\n434\t        if resolver_result:\n435\t            return resolver_result\n436\t\n437\t        # Fallback: search by package name across the entire previous graph,\n438\t        # ignoring parent and req_type.  This handles cases where a dependency\n439\t        # is encountered via a new parent or a different req_type that did not\n440\t        # exist in the previous graph (#958).\n441\t        # NOTE: This fallback ignores both parent and req_type filters.\n442\t        # It may pick a version from a different parent or dependency type\n443\t        # than the original bootstrap order, but this is preferable to\n444\t        # falling through to PyPI and pulling an unpinned version.\n445\t        possible_versions_by_name: list[tuple[str, Version]] = []\n446\t        for node in self.prev_graph.get_nodes_by_name(req.name):\n447\t            if node.pre_built == pre_built and str(node.version) not in seen_version:\n448\t                possible_versions_by_name.append((node.download_url, node.version))\n449\t                seen_version.add(str(node.version))\n450\t\n451\t        if possible_versions_by_name:\n452\t            logger.debug(\n453\t                \"%s: name-based fallback found versions in previous graph: %s\",\n454\t                req.name,\n455\t                [str(v) for _, v in possible_versions_by_name],\n456\t            )\n457\t        else:\n458\t            logger.debug(\n459\t                \"%s: no versions found in previous graph by name either\",\n460\t                req.name,\n461\t            )\n462\t\n463\t        return self._resolve_from_version_source(possible_versions_by_name, req)\n464\t\n465\t    def _resolve_from_version_source(\n466\t        self,\n467\t        version_source: list[tuple[str, Version]],\n468\t        req: Requirement,\n469\t    ) -> list[tuple[str, Version]] | None:\n470\t        \"\"\"Filter and return all matching versions from candidates.\n471\t\n472\t        Extracted from Bootstrapper._resolve_from_version_source().\n473\t\n474\t        Args:\n475\t            version_source: List of (url, version) candidates\n476\t            req: Package requirement with version specifier\n477\t\n478\t        Returns:\n479\t            List of (url, version) tuples for all matches, None if no matches\n480\t        \"\"\"\n481\t        if not version_source:\n482\t            return None\n483\t        try:\n484\t            # No need to pass req type to enable caching since we are already using the graph as our cache.\n485\t            # Do not cache candidates.\n486\t            provider = resolver.GenericProvider(\n487\t                version_source=lambda identifier: version_source,\n488\t                constraints=self.ctx.constraints,\n489\t                use_resolver_cache=False,\n490\t            )\n491\t            # find_all_matching_from_provider now returns all matching candidates\n492\t            return resolver.find_all_matching_from_provider(provider, req)\n493\t        except Exception as err:\n494\t            logger.debug(f\"could not resolve {req} from {version_source}: {err}\")\n495\t            return None\n496\t"}]},"parent_tool_use_id":null,"session_id":"35f433c2-958b-4c74-a970-a281494a8aa9","uuid":"a7e7bfe5-db0e-43ca-9fbf-2167b7de0d66","timestamp":"2026-10-09T16:56:55.369Z","tool_use_result":{"type":"text","file":{"filePath":"/home/alustosa/git/model-routing-eval/.work/agent-eval/2026-10-09-claude-haiku-5-5-effort-low-r1/cases/r03t_fromager_dep_chain_ticket/src/fromager/bootstrap_requirement_resolver.py","content":"\"\"\"Requirement resolution for bootstrap process.\n\nHandles PyPI and graph-based resolution strategies.\nGit URL resolution stays in Bootstrapper (orchestration concern).\n\"\"\"\n\nfrom __future__ import annotations\n\nimport logging\nimport threading\nimport typing\n\nfrom packaging.requirements import Requirement\nfrom packaging.utils import NormalizedName, canonicalize_name\nfrom packaging.version import Version\n\nfrom . import finders, resolver, sources, wheels\nfrom .dependency_graph import DependencyGraph\nfrom .requirements_file import RequirementType\n\nif typing.TYPE_CHECKING:\n    from . import context\n\nlogger = logging.getLogger(__name__)\n\n\nclass BootstrapRequirementResolver:\n    \"\"\"Resolve package requirements from PyPI or dependency graph during bootstrap.\n\n    Single Responsibility: Coordinate resolution strategies for bootstrap process.\n    Reason to Change: Resolution algorithm or provider priorities change.\n\n    Resolution strategies (in order):\n    1. Previous dependency graph (if available)\n    2. PyPI lookup (via existing sources/resolver modules)\n\n    Git URL resolution is NOT handled here - that stays in Bootstrapper\n    because it requires BuildEnvironment and build dependencies.\n    \"\"\"\n\n    def __init__(\n        self,\n        ctx: context.WorkContext,\n        prev_graph: DependencyGraph | None = None,\n        multiple_versions: bool = False,\n        cache_wheel_server_url: str = \"\",\n    ) -> None:\n        \"\"\"Initialize requirement resolver.\n\n        Args:\n            ctx: Work context with constraints and settings\n            prev_graph: Optional previous dependency graph for caching\n            multiple_versions: If ``True`` and no results are found through\n                any other approach, takes the latest candidate from the\n                cache server, ignoring the age filters.  In all other\n                cases, returns an empty list when no candidates are found.\n            cache_wheel_server_url: URL of the remote wheel cache server.\n                Used as a fallback when age filtering produces no candidates.\n        \"\"\"\n        self.ctx = ctx\n        self.prev_graph = prev_graph\n        self.multiple_versions = multiple_versions\n        self.cache_wheel_server_url = cache_wheel_server_url\n        # All known versions for a package, accumulated across resolution\n        # contexts.  Versions discovered via different specifiers or req_types\n        # are merged so that later lookups see the widest set.\n        # Key: (normalized_name, pre_built)\n        # Value: {version: url}\n        self._known_versions: dict[tuple[NormalizedName, bool], dict[Version, str]] = {}\n        # Requirement rules already resolved from network/graph.\n        # Key: (str(req), pre_built)\n        # Prevents redundant network calls for the same specifier.\n        self._resolved_rules: set[tuple[str, bool]] = set()\n        # Protects _known_versions and _resolved_rules for thread safety.\n        self._lock = threading.Lock()\n\n    def resolve(\n        self,\n        req: Requirement,\n        req_type: RequirementType,\n        parent_req: Requirement | None = None,\n        pre_built: bool | None = None,\n        return_all_versions: bool = False,\n    ) -> list[tuple[str, Version]]:\n        \"\"\"Resolve package requirement to matching version(s).\n\n        Uses a two-step strategy:\n        1. If this requirement rule has not been resolved before, fetch\n           versions from the network (or previous graph) and extend the\n           package-level known-versions cache.\n        2. Filter all known versions for the package by the current\n           requirement specifier.\n\n        This ensures that versions discovered in one context (e.g.,\n        top-level with cooldown bypass) are visible to later lookups\n        with different specifiers for the same package.\n\n        Args:\n            req: Package requirement\n            req_type: Type of requirement\n            parent_req: Parent requirement from dependency chain\n            pre_built: Optional override to force prebuilt (True) or source (False).\n                If None (default), uses package build info to determine.\n            return_all_versions: If True, return all matching versions. If False,\n                return only the highest matching version.\n\n        Returns:\n            List of (url, version) tuples sorted by version (highest first).\n            Contains one item when return_all_versions=False, or all matching\n            versions when return_all_versions=True.\n\n        Raises:\n            ValueError: If req contains a git URL and pre_built is False\n                (git URL source resolution must be handled by Bootstrapper)\n        \"\"\"\n        # Determine pre_built if not specified (needed for cache key and URL guard)\n        if pre_built is None:\n            pbi = self.ctx.package_build_info(req)\n            pre_built = pbi.pre_built\n\n        # Check session cache BEFORE the git URL guard so that background\n        # threads can retrieve pre-cached git URL resolutions (populated by\n        # Bootstrapper.resolve_versions() on the main thread before bootstrap()\n        # is called) without hitting the ValueError.\n        cached_result = self.get_cached_resolution(req, pre_built)\n        if cached_result is not None:\n            logger.debug(f\"resolved {req} from cache\")\n            return list(cached_result) if return_all_versions else [cached_result[0]]\n\n        # Git URL source resolution must be handled by Bootstrapper.\n        # But git URL prebuilt resolution is allowed - we look for wheels on PyPI\n        # (test mode fallback uses this path).\n        if req.url and not pre_built:\n            raise ValueError(\n                f\"Git URL requirements must be handled by Bootstrapper: {req}\"\n            )\n\n        rule_key = (str(req), pre_built)\n\n        with self._lock:\n            if rule_key not in self._resolved_rules:\n                # Rule not seen before — resolve from graph or network and\n                # extend the package-level known-versions cache.\n                self._resolve_and_extend(req, req_type, pre_built, parent_req)\n                self._resolved_rules.add(rule_key)\n            else:\n                logger.debug(f\"rule already resolved: {req}\")\n\n            # Filter all known versions by the current requirement specifier.\n            matching = self._get_matching_versions(req, pre_built)\n\n        if not matching:\n            return []\n        if return_all_versions:\n            return matching\n        return [matching[0]]\n\n    def get_cached_resolution(\n        self,\n        req: Requirement,\n        pre_built: bool,\n    ) -> list[tuple[str, Version]] | None:\n        \"\"\"Return cached matching versions if this requirement was already resolved.\n\n        Returns ``None`` if the requirement has not been resolved yet, allowing\n        callers to distinguish between \"no matching versions\" and \"not yet resolved\".\n\n        Used by background threads to retrieve pre-cached git URL resolutions\n        populated by the main thread before entering the parallel section.\n\n        Args:\n            req: Package requirement\n            pre_built: Whether looking for prebuilt or source resolution\n\n        Returns:\n            List of (url, version) tuples if previously resolved, None otherwise.\n        \"\"\"\n        rule_key = (str(req), pre_built)\n        with self._lock:\n            if rule_key in self._resolved_rules:\n                return self._get_matching_versions(req, pre_built)\n        return None\n\n    def _resolve_and_extend(\n        self,\n        req: Requirement,\n        req_type: RequirementType,\n        pre_built: bool,\n        parent_req: Requirement | None,\n    ) -> None:\n        \"\"\"Resolve versions from graph/network and extend known versions cache.\"\"\"\n        # Try previous dependency graph\n        cached_resolution = self._resolve_from_graph(\n            req=req,\n            req_type=req_type,\n            pre_built=pre_built,\n            parent_req=parent_req,\n        )\n\n        if cached_resolution and not req.url:\n            logger.debug(\n                f\"resolved from previous bootstrap: {len(cached_resolution)} version(s)\"\n            )\n            results = cached_resolution\n        elif pre_built:\n            # Resolve prebuilt wheel\n            wheel_server_urls = wheels.get_wheel_server_urls(\n                self.ctx, req, cache_wheel_server_url=resolver.PYPI_SERVER_URL\n            )\n            results = wheels.resolve_all_prebuilt_wheels(\n                ctx=self.ctx,\n                req=req,\n                wheel_server_urls=wheel_server_urls,\n                req_type=req_type,\n            )\n        else:\n            # Resolve source (sdist)\n            provider = sources.get_source_provider(\n                ctx=self.ctx,\n                req=req,\n                sdist_server_url=resolver.PYPI_SERVER_URL,\n                req_type=req_type,\n            )\n            max_age_cutoff = resolver._compute_max_age_cutoff(self.ctx)\n            results = resolver.find_all_matching_from_provider(\n                provider,\n                req,\n                max_age_cutoff=max_age_cutoff,\n                fallback_on_empty_age_filter=not self.multiple_versions,\n            )\n\n            if not results and self.multiple_versions and self.cache_wheel_server_url:\n                logger.info(\n                    \"no results found with normal resolution, \"\n                    \"falling back to the cache server %s\",\n                    self.cache_wheel_server_url,\n                )\n                results = self._resolve_from_cache_server(req)\n\n            if not results:\n                logger.warning(\n                    \"resolver returned no results \"\n                    \"(wheel server URL %s, %s version mode)\",\n                    self.cache_wheel_server_url or \"(none)\",\n                    \"multiple\" if self.multiple_versions else \"single\",\n                )\n\n        if results:\n            self._extend_known_versions(req, pre_built, results)\n\n    def _resolve_from_cache_server(self, req: Requirement) -> list[tuple[str, Version]]:\n        \"\"\"Fall back to the remote wheel cache server for a cached version.\n\n        When age filtering removes all candidates in multi-version mode,\n        queries the remote cache server for the newest available wheel.\n        Returns at most one version so that transitive dependencies are\n        re-processed without rebuilding every old version.\n        \"\"\"\n        logger.info(\n            \"checking cache server %s for existing build\",\n            self.cache_wheel_server_url,\n        )\n        best: tuple[str, Version] | None = None\n        for include_sdists, include_wheels in [(False, True), (True, False)]:\n            try:\n                provider = finders.PyPICacheProvider(\n                    cache_server_url=self.cache_wheel_server_url,\n                    constraints=self.ctx.constraints,\n                    include_sdists=include_sdists,\n                    include_wheels=include_wheels,\n                )\n                results = resolver.find_all_matching_from_provider(provider, req)\n                if results:\n                    url, version = results[0]\n                    if best is None or version > best[1]:\n                        best = (url, version)\n            except Exception as err:\n                logger.warning(\n                    \"error checking cache server %s: %s\",\n                    self.cache_wheel_server_url,\n                    err,\n                )\n        if best is not None:\n            logger.info(\"found version %s on cache server\", best[1])\n            return [best]\n        return []\n\n    def get_matching_versions(\n        self,\n        req: Requirement,\n        pre_built: bool,\n    ) -> list[tuple[str, Version]]:\n        \"\"\"Filter known versions by requirement specifier (thread-safe).\n\n        Returns all known versions of the package that satisfy the\n        requirement's version specifier, sorted highest-first.\n\n        Args:\n            req: Package requirement with version specifier\n            pre_built: Whether looking for prebuilt or source resolution\n\n        Returns:\n            List of (url, version) tuples matching the specifier.\n        \"\"\"\n        with self._lock:\n            return self._get_matching_versions(req, pre_built)\n\n    def _get_matching_versions(\n        self,\n        req: Requirement,\n        pre_built: bool,\n    ) -> list[tuple[str, Version]]:\n        \"\"\"Filter known versions (caller must hold ``self._lock``).\"\"\"\n        key = (canonicalize_name(req.name), pre_built)\n        versions = self._known_versions.get(key, {})\n        matching = [\n            (url, version)\n            for version, url in versions.items()\n            if version in req.specifier\n        ]\n        matching.sort(key=lambda x: x[1], reverse=True)\n        return matching\n\n    def extend_known_versions(\n        self,\n        req: Requirement,\n        pre_built: bool,\n        result: list[tuple[str, Version]],\n    ) -> None:\n        \"\"\"Extend the known-versions cache and mark the rule as resolved (thread-safe).\n\n        Merges new versions into the package-level cache. When a version\n        already exists, a non-empty URL takes precedence over an empty one\n        (graph-resolved placeholders are replaced by real download URLs).\n\n        Used by Bootstrapper to cache git URL resolutions that are\n        handled externally (outside this resolver).\n\n        Args:\n            req: Package requirement (used for name and rule tracking)\n            pre_built: Whether this is a prebuilt or source resolution\n            result: List of (url, version) tuples to add\n        \"\"\"\n        with self._lock:\n            self._extend_known_versions(req, pre_built, result)\n\n    def _extend_known_versions(\n        self,\n        req: Requirement,\n        pre_built: bool,\n        result: list[tuple[str, Version]],\n    ) -> None:\n        \"\"\"Extend known versions (caller must hold ``self._lock``).\"\"\"\n        key = (canonicalize_name(req.name), pre_built)\n        versions = self._known_versions.setdefault(key, {})\n        for url, version in result:\n            if version not in versions or (url and not versions[version]):\n                versions[version] = url\n        self._resolved_rules.add((str(req), pre_built))\n\n    def _resolve_from_graph(\n        self,\n        req: Requirement,\n        req_type: RequirementType,\n        pre_built: bool,\n        parent_req: Requirement | None,\n    ) -> list[tuple[str, Version]] | None:\n        \"\"\"Resolve from previous dependency graph.\n\n        Extracted from Bootstrapper._resolve_from_graph().\n\n        Args:\n            req: Package requirement\n            req_type: Type of requirement\n            pre_built: Whether to look for pre-built packages\n            parent_req: Parent requirement for graph traversal\n\n        Returns:\n            List of (url, version) tuples if found in graph, None otherwise\n        \"\"\"\n        if not self.prev_graph:\n            return None\n\n        seen_version: set[str] = set()\n\n        # First perform resolution using the top level reqs before looking at history\n        possible_versions_in_top_level: list[tuple[str, Version]] = []\n        for (\n            top_level_edge\n        ) in self.ctx.dependency_graph.get_root_node().get_outgoing_edges(\n            req.name, RequirementType.TOP_LEVEL\n        ):\n            possible_versions_in_top_level.append(\n                (\n                    top_level_edge.destination_node.download_url,\n                    top_level_edge.destination_node.version,\n                )\n            )\n            seen_version.add(str(top_level_edge.destination_node.version))\n\n        resolver_result = self._resolve_from_version_source(\n            possible_versions_in_top_level, req\n        )\n        if resolver_result:\n            return resolver_result\n\n        # Only if there is nothing in top level reqs, resolve using history\n        possible_versions_from_graph: list[tuple[str, Version]] = []\n        # Check all nodes which have the same parent name irrespective of the parent's version\n        for parent_node in self.prev_graph.get_nodes_by_name(\n            parent_req.name if parent_req else None\n        ):\n            # If the edge matches the current req and type then it is a possible candidate.\n            # Filtering on type might not be necessary, but we are being safe here. This will\n            # for sure ensure that bootstrap takes the same route as it did in the previous one.\n            # If we don't filter by type then it might pick up a different version from a different\n            # type that should have appeared much later in the resolution process.\n            for edge in parent_node.get_outgoing_edges(req.name, req_type):\n                if (\n                    edge.destination_node.pre_built == pre_built\n                    and str(edge.destination_node.version) not in seen_version\n                ):\n                    possible_versions_from_graph.append(\n                        (\n                            edge.destination_node.download_url,\n                            edge.destination_node.version,\n                        )\n                    )\n                    seen_version.add(str(edge.destination_node.version))\n\n        resolver_result = self._resolve_from_version_source(\n            possible_versions_from_graph, req\n        )\n        if resolver_result:\n            return resolver_result\n\n        # Fallback: search by package name across the entire previous graph,\n        # ignoring parent and req_type.  This handles cases where a dependency\n        # is encountered via a new parent or a different req_type that did not\n        # exist in the previous graph (#958).\n        # NOTE: This fallback ignores both parent and req_type filters.\n        # It may pick a version from a different parent or dependency type\n        # than the original bootstrap order, but this is preferable to\n        # falling through to PyPI and pulling an unpinned version.\n        possible_versions_by_name: list[tuple[str, Version]] = []\n        for node in self.prev_graph.get_nodes_by_name(req.name):\n            if node.pre_built == pre_built and str(node.version) not in seen_version:\n                possible_versions_by_name.append((node.download_url, node.version))\n                seen_version.add(str(node.version))\n\n        if possible_versions_by_name:\n            logger.debug(\n                \"%s: name-based fallback found versions in previous graph: %s\",\n                req.name,\n                [str(v) for _, v in possible_versions_by_name],\n            )\n        else:\n            logger.debug(\n                \"%s: no versions found in previous graph by name either\",\n                req.name,\n            )\n\n        return self._resolve_from_version_source(possible_versions_by_name, req)\n\n    def _resolve_from_version_source(\n        self,\n        version_source: list[tuple[str, Version]],\n        req: Requirement,\n    ) -> list[tuple[str, Version]] | None:\n        \"\"\"Filter and return all matching versions from candidates.\n\n        Extracted from Bootstrapper._resolve_from_version_source().\n\n        Args:\n            version_source: List of (url, version) candidates\n            req: Package requirement with version specifier\n\n        Returns:\n            List of (url, version) tuples for all matches, None if no matches\n        \"\"\"\n        if not version_source:\n            return None\n        try:\n            # No need to pass req type to enable caching since we are already using the graph as our cache.\n            # Do not cache candidates.\n            provider = resolver.GenericProvider(\n                version_source=lambda identifier: version_source,\n                constraints=self.ctx.constraints,\n                use_resolver_cache=False,\n            )\n            # find_all_matching_from_provider now returns all matching candidates\n            return resolver.find_all_matching_from_provider(provider, req)\n        except Exception as err:\n            logger.debug(f\"could not resolve {req} from {version_source}: {err}\")\n            return None\n","numLines":496,"startLine":1,"totalLines":496}},"tool_result_meta":[{"id":"toolu_01LWPBgwfUPZUe8kEvF6zFLL","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
