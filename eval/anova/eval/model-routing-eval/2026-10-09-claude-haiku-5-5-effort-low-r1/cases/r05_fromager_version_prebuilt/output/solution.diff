+def test_is_pre_built_hook_overrides_yaml(
+    testdata_context: context.WorkContext,
+) -> None:
+    """A non-None is_pre_built hook result wins over YAML, in either direction."""
+    calls: list[tuple[Version, str]] = []
+
+    def hook(*, version: Version, variant: str) -> bool | None:
+        calls.append((version, variant))
+        if version == Version("2.8.0"):
+            return True  # YAML says False
+        if version == Version("2.9.0"):
+            return False  # YAML says True
+        return None  # defer to YAML
+
+    pbi = testdata_context.settings.package_build_info(TEST_PKG)
+    with patch("fromager.overrides.find_override_method", return_value=hook):
+        assert pbi.is_pre_built(Version("2.8.0")) is True
+        assert pbi.is_pre_built(Version("2.9.0")) is False
+        assert pbi.is_pre_built(Version("3.0.0")) is False
+    assert calls == [
+        (Version("2.8.0"), "cpu"),
+        (Version("2.9.0"), "cpu"),
+        (Version("3.0.0"), "cpu"),
+    ]
+
