+    assert pbi.is_pre_built(Version("2.9.0+cpu")) is True
+    assert pbi.is_pre_built(Version("2.8.0+cpu")) is False
+    assert pbi.get_wheel_server_url(Version("2.9.0+cpu")) == (
+        "https://mirror.test/simple"
+    )
+    assert pbi.get_wheel_server_url(Version("2.8.0+cpu")) == (
+        "https://wheel.test/simple"
+    )
