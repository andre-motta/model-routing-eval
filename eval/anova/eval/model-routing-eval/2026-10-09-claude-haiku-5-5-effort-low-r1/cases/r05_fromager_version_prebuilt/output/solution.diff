+def _re_resolve_url(
+    ctx: context.WorkContext,
+    req: Requirement,
+    req_type: RequirementType,
+    resolved_version: Version,
+    pre_built: bool,
+    cache_wheel_server_url: str | None,
+) -> str | None:
+    """Find the download URL for one version and build kind.
+
+    RESOLVE picks URLs before the version is known, so version-specific
+    ``pre_built`` and ``wheel_server_url`` settings are applied here.
+    The requirement is pinned to *resolved_version* so the URL matches it.
+
+    Returns ``None`` if no matching artifact is found.
+
+    .. versionadded:: 0.95.0
+    """
+    pinned = Requirement(f"{req.name}=={resolved_version}")
+    if pre_built:
+        wheel_server_urls = wheels.get_wheel_server_urls(
+            ctx,
+            pinned,
+            cache_wheel_server_url=cache_wheel_server_url,
+            version=resolved_version,
+        )
+        try:
+            url, _ = wheels.resolve_prebuilt_wheel(
+                ctx=ctx,
+                req=pinned,
+                wheel_server_urls=wheel_server_urls,
+                req_type=req_type,
+            )
+        except ExceptionGroup:
+            return None
+        return str(url)
+
+    pbi = ctx.package_build_info(req)
+    provider = sources.get_source_provider(
+        ctx=ctx,
+        req=pinned,
+        sdist_server_url=pbi.resolver_sdist_server_url(resolver.PYPI_SERVER_URL),
+        req_type=req_type,
+    )
+    results = resolver.find_all_matching_from_provider(provider, pinned)
+    if not results:
+        return None
+    url, _ = results[0]
+    return url
