ent(\n606\t        self, tmp_context: WorkContext\n607\t    ) -> None:\n608\t        bt = bootstrapper.Bootstrapper(tmp_context, sdist_only=True)\n609\t        bt.why = []\n610\t        item = _make_start_item(req_type=RequirementType.INSTALL)\n611\t\n612\t        item.run(bt)\n613\t\n614\t        assert item.work_item.build_sdist_only is True\n615\t\n616\t    def test_sdist_only_not_set_for_build_requirement(\n617\t        self, tmp_context: WorkContext\n618\t    ) -> None:\n619\t        bt = bootstrapper.Bootstrapper(tmp_context, sdist_only=True)\n620\t        bt.why = []\n621\t        item = _make_start_item(req_type=RequirementType.BUILD_SYSTEM)\n622\t\n623\t        item.run(bt)\n624\t\n625\t        assert item.work_item.build_sdist_only is False\n626\t\n627\t    def test_marks_as_seen(self, tmp_context: WorkContext) -> None:\n628\t        bt = bootstrapper.Bootstrapper(tmp_context)\n629\t        bt.why = []\n630\t        item = _make_start_item()\n631\t        wi = item.work_item\n632\t        assert wi.resolved_version is not None\n633\t\n634\t        assert not bt.has_been_seen(wi.req, wi.resolved_version)\n635\t        item.run(bt)\n636\t        assert bt.has_been_seen(wi.req, wi.resolved_version)\n637\t\n638\t    def test_sets_pbi_pre_built_before_prepare_source(\n639\t        self, tmp_context: WorkContext\n640\t    ) -> None:\n641\t        \"\"\"pbi_pre_built is set on work_item before PrepareSource is constructed.\"\"\"\n642\t        bt = bootstrapper.Bootstrapper(tmp_context)\n643\t        bt.why = []\n644\t        item = _make_start_item()\n645\t\n646\t        with patch.object(\n647\t            tmp_context,\n648\t            \"package_build_info\",\n649\t            return_value=Mock(pre_built=True, is_pre_built=Mock(return_value=True)),\n650\t        ):\n651\t            result = item.run(bt)\n652\t\n653\t        assert len(result) == 1\n654\t        assert isinstance(result[0], PrepareSource)\n655\t        assert result[0].work_item.pbi_pre_built i