{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Bf8qNWvEhh3NZyW29BbA5u","type":"tool_result","content":"1\t\"\"\"Tests for PEP 658 metadata support.\"\"\"\n2\t\n3\timport typing\n4\tfrom unittest.mock import Mock, patch\n5\t\n6\tfrom packaging.version import Version\n7\t\n8\tfrom fromager.candidate import Candidate, get_metadata_for_wheel\n9\t\n10\t\n11\tclass TestPEP658Support:\n12\t    \"\"\"Test PEP 658 metadata support in fromager.\"\"\"\n13\t\n14\t    def test_candidate_with_metadata_url(self) -> None:\n15\t        \"\"\"Test that Candidate can be created with a metadata URL.\"\"\"\n16\t        candidate = Candidate(\n17\t            name=\"test-package\",\n18\t            version=Version(\"1.0.0\"),\n19\t            url=\"https://example.com/test-package-1.0.0-py3-none-any.whl\",\n20\t            has_metadata=True,\n21\t        )\n22\t\n23\t        assert (\n24\t            candidate.metadata_url\n25\t            == \"https://example.com/test-package-1.0.0-py3-none-any.whl.metadata\"\n26\t        )\n27\t\n28\t    def test_candidate_without_metadata_url(self) -> None:\n29\t        \"\"\"Test that Candidate works without metadata URL (legacy behavior).\"\"\"\n30\t        candidate = Candidate(\n31\t            name=\"test-package\",\n32\t            version=Version(\"1.0.0\"),\n33\t            url=\"https://example.com/test-package-1.0.0-py3-none-any.whl\",\n34\t        )\n35\t\n36\t        assert candidate.metadata_url is None\n37\t\n38\t    @patch(\"fromager.candidate.session\")\n39\t    def test_get_metadata_with_pep658_success(self, mock_session: typing.Any) -> None:\n40\t        \"\"\"Test successful metadata retrieval via PEP 658 endpoint.\"\"\"\n41\t        # Mock the metadata response\n42\t        mock_response = Mock()\n43\t        mock_response.content = b\"\"\"Metadata-Version: 2.1\n44\tName: test-package\n45\tVersion: 1.0.0\n46\tSummary: A test package\n47\tRequires-Dist: requests >= 2.0.0\n48\t\"\"\"\n49\t        mock_response.raise_for_status.return_value = None\n50\t        mock_session.get.return_value = mock_response\n51\t\n52\t        wheel_url = \"https://example.com/test-package-1.0.0-py3-none-any.whl\"\n53\t        metadata_url = (\n54\t            \"https://example.com/test-package-1.0.0-py3-none-any.whl.metadata\"\n55\t        )\n56\t\n57\t        metadata = get_metadata_for_wheel(wheel_url, metadata_url)\n58\t\n59\t        # Verify the metadata was parsed correctly\n60\t        assert metadata.name == \"test-package\"\n61\t        assert str(metadata.version) == \"1.0.0\"\n62\t        assert metadata.summary == \"A test package\"\n63\t        assert metadata.requires_dist is not None\n64\t        assert any(str(req) == \"requests>=2.0.0\" for req in metadata.requires_dist)\n65\t\n66\t        # Verify only the metadata URL was called, not the wheel URL\n67\t        mock_session.get.assert_called_once_with(metadata_url)\n68\t\n69\t    @patch(\"fromager.candidate.session\")\n70\t    def test_get_metadata_pep658_fallback_behavior(\n71\t        self, mock_session: typing.Any\n72\t    ) -> None:\n73\t        \"\"\"Test that PEP 658 is tried first, then falls back to wheel download.\"\"\"\n74\t        # Mock that metadata URL fails, then wheel URL succeeds\n75\t        responses = []\n76\t\n77\t        def side_effect(url: str) -> typing.Any:\n78\t            if url.endswith(\".metadata\"):\n79\t                # First call - metadata request fails\n80\t                mock_response = Mock()\n81\t                mock_response.raise_for_status.side_effect = Exception(\"404 Not Found\")\n82\t                responses.append((\"metadata\", url))\n83\t                return mock_response\n84\t            else:\n85\t                # Second call - wheel request\n86\t                responses.append((\"wheel\", url))\n87\t                raise Exception(\"Wheel parsing intentionally mocked to fail\")\n88\t\n89\t        mock_session.get.side_effect = side_effect\n90\t\n91\t        wheel_url = \"https://example.com/test-package-1.0.0-py3-none-any.whl\"\n92\t        metadata_url = (\n93\t            \"https://example.com/test-package-1.0.0-py3-none-any.whl.metadata\"\n94\t        )\n95\t\n96\t        # This should raise an exception during wheel parsing, but we can verify the order\n97\t        try:\n98\t            get_metadata_for_wheel(wheel_url, metadata_url)\n99\t        except Exception:\n100\t            pass  # Expected to fail during wheel parsing mock\n101\t\n102\t        # Verify that both URLs were called in the correct order\n103\t        assert len(responses) == 2\n104\t        assert responses[0] == (\"metadata\", metadata_url)\n105\t        assert responses[1] == (\"wheel\", wheel_url)\n106\t        assert mock_session.get.call_count == 2\n107\t\n108\t    @patch(\"fromager.candidate.session\")\n109\t    def test_get_metadata_without_pep658_behavior(\n110\t        self, mock_session: typing.Any\n111\t    ) -> None:\n112\t        \"\"\"Test that without PEP 658 metadata URL, only wheel URL is called.\"\"\"\n113\t        # Mock wheel request\n114\t        responses = []\n115\t\n116\t        def side_effect(url: str) -> typing.Any:\n117\t            responses.append((\"wheel\", url))\n118\t            raise Exception(\"Wheel parsing intentionally mocked to fail\")\n119\t\n120\t        mock_session.get.side_effect = side_effect\n121\t\n122\t        wheel_url = \"https://example.com/test-package-1.0.0-py3-none-any.whl\"\n123\t\n124\t        # This should raise an exception during wheel parsing, but we can verify the behavior\n125\t        try:\n126\t            get_metadata_for_wheel(wheel_url, metadata_url=None)\n127\t        except Exception:\n128\t            pass  # Expected to fail during wheel parsing mock\n129\t\n130\t        # Verify that only the wheel URL was called\n131\t        assert len(responses) == 1\n132\t        assert responses[0] == (\"wheel\", wheel_url)\n133\t        mock_session.get.assert_called_once_with(wheel_url)\n134\t\n135\t    def test_candidate_repr_with_metadata_url(self) -> None:\n136\t        \"\"\"Test that Candidate representation includes metadata URL info.\"\"\"\n137\t        candidate = Candidate(\n138\t            name=\"test-package\",\n139\t            version=Version(\"1.0.0\"),\n140\t            url=\"https://example.com/test-package-1.0.0-py3-none-any.whl\",\n141\t            has_metadata=True,\n142\t        )\n143\t\n144\t        # The candidate should have the metadata URL attribute\n145\t        assert hasattr(candidate, \"metadata_url\")\n146\t        assert (\n147\t            candidate.metadata_url\n148\t            == \"https://example.com/test-package-1.0.0-py3-none-any.whl.metadata\"\n149\t        )\n150\t\n151\t    def test_metadata_url_construction(self) -> None:\n152\t        \"\"\"Test that metadata URLs are constructed correctly.\"\"\"\n153\t        base_url = (\n154\t            \"https://pypi.org/simple/test-package/test-package-1.0.0-py3-none-any.whl\"\n155\t        )\n156\t        expected_metadata_url = base_url + \".metadata\"\n157\t\n158\t        # This tests the expected pattern for PEP 658 metadata URLs\n159\t        assert expected_metadata_url.endswith(\".whl.metadata\")\n160\t        assert expected_metadata_url.startswith(\"https://\")\n161\t\n162\t    def test_pep658_integration_with_resolver(self) -> None:\n163\t        \"\"\"Test that PEP 658 metadata URLs are properly handled by the candidate system.\"\"\"\n164\t        # Test the basic integration of metadata URLs with candidates\n165\t        candidate_with_metadata = Candidate(\n166\t            name=\"test-package\",\n167\t            version=Version(\"1.0.0\"),\n168\t            url=\"https://example.com/test.whl\",\n169\t            has_metadata=True,\n170\t        )\n171\t\n172\t        candidate_without_metadata = Candidate(\n173\t            name=\"test-package\",\n174\t            version=Version(\"1.0.0\"),\n175\t            url=\"https://example.com/test.whl\",\n176\t        )\n177\t\n178\t        assert (\n179\t            candidate_with_metadata.metadata_url\n180\t            == \"https://example.com/test.whl.metadata\"\n181\t        )\n182\t\n183\t        # Verify PEP 658 metadata URL handling\n184\t        assert (\n185\t            candidate_with_metadata.metadata_url\n186\t            == \"https://example.com/test.whl.metadata\"\n187\t        )\n188\t        assert candidate_without_metadata.metadata_url is None\n189\t\n190\t        # Both should have the same basic properties\n191\t        assert candidate_with_metadata.name == candidate_without_metadata.name\n192\t        assert candidate_with_metadata.version == candidate_without_metadata.version\n193\t        assert candidate_with_metadata.url == candidate_without_metadata.url\n194\t"}]},"parent_tool_use_id":null,"session_id":"bb586e58-4115-4292-b161-9d13f431fb36","uuid":"a752b97a-d3b4-4f15-ab00-49a7305b8d5e","timestamp":"2026-10-09T16:51:45.070Z","tool_use_result":{"type":"text","file":{"filePath":"/home/alustosa/git/model-routing-eval/.work/agent-eval/2026-10-09-claude-haiku-5-5-effort-low-r1/cases/r01_fromager_distinfo/tests/test_pep658_support.py","content":"\"\"\"Tests for PEP 658 metadata support.\"\"\"\n\nimport typing\nfrom unittest.mock import Mock, patch\n\nfrom packaging.version import Version\n\nfrom fromager.candidate import Candidate, get_metadata_for_wheel\n\n\nclass TestPEP658Support:\n    \"\"\"Test PEP 658 metadata support in fromager.\"\"\"\n\n    def test_candidate_with_metadata_url(self) -> None:\n        \"\"\"Test that Candidate can be created with a metadata URL.\"\"\"\n        candidate = Candidate(\n            name=\"test-package\",\n            version=Version(\"1.0.0\"),\n            url=\"https://example.com/test-package-1.0.0-py3-none-any.whl\",\n            has_metadata=True,\n        )\n\n        assert (\n            candidate.metadata_url\n            == \"https://example.com/test-package-1.0.0-py3-none-any.whl.metadata\"\n        )\n\n    def test_candidate_without_metadata_url(self) -> None:\n        \"\"\"Test that Candidate works without metadata URL (legacy behavior).\"\"\"\n        candidate = Candidate(\n            name=\"test-package\",\n            version=Version(\"1.0.0\"),\n            url=\"https://example.com/test-package-1.0.0-py3-none-any.whl\",\n        )\n\n        assert candidate.metadata_url is None\n\n    @patch(\"fromager.candidate.session\")\n    def test_get_metadata_with_pep658_success(self, mock_session: typing.Any) -> None:\n        \"\"\"Test successful metadata retrieval via PEP 658 endpoint.\"\"\"\n        # Mock the metadata response\n        mock_response = Mock()\n        mock_response.content = b\"\"\"Metadata-Version: 2.1\nName: test-package\nVersion: 1.0.0\nSummary: A test package\nRequires-Dist: requests >= 2.0.0\n\"\"\"\n        mock_response.raise_for_status.return_value = None\n        mock_session.get.return_value = mock_response\n\n        wheel_url = \"https://example.com/test-package-1.0.0-py3-none-any.whl\"\n        metadata_url = (\n            \"https://example.com/test-package-1.0.0-py3-none-any.whl.metadata\"\n        )\n\n        metadata = get_metadata_for_wheel(wheel_url, metadata_url)\n\n        # Verify the metadata was parsed correctly\n        assert metadata.name == \"test-package\"\n        assert str(metadata.version) == \"1.0.0\"\n        assert metadata.summary == \"A test package\"\n        assert metadata.requires_dist is not None\n        assert any(str(req) == \"requests>=2.0.0\" for req in metadata.requires_dist)\n\n        # Verify only the metadata URL was called, not the wheel URL\n        mock_session.get.assert_called_once_with(metadata_url)\n\n    @patch(\"fromager.candidate.session\")\n    def test_get_metadata_pep658_fallback_behavior(\n        self, mock_session: typing.Any\n    ) -> None:\n        \"\"\"Test that PEP 658 is tried first, then falls back to wheel download.\"\"\"\n        # Mock that metadata URL fails, then wheel URL succeeds\n        responses = []\n\n        def side_effect(url: str) -> typing.Any:\n            if url.endswith(\".metadata\"):\n                # First call - metadata request fails\n                mock_response = Mock()\n                mock_response.raise_for_status.side_effect = Exception(\"404 Not Found\")\n                responses.append((\"metadata\", url))\n                return mock_response\n            else:\n                # Second call - wheel request\n                responses.append((\"wheel\", url))\n                raise Exception(\"Wheel parsing intentionally mocked to fail\")\n\n        mock_session.get.side_effect = side_effect\n\n        wheel_url = \"https://example.com/test-package-1.0.0-py3-none-any.whl\"\n        metadata_url = (\n            \"https://example.com/test-package-1.0.0-py3-none-any.whl.metadata\"\n        )\n\n        # This should raise an exception during wheel parsing, but we can verify the order\n        try:\n            get_metadata_for_wheel(wheel_url, metadata_url)\n        except Exception:\n            pass  # Expected to fail during wheel parsing mock\n\n        # Verify that both URLs were called in the correct order\n        assert len(responses) == 2\n        assert responses[0] == (\"metadata\", metadata_url)\n        assert responses[1] == (\"wheel\", wheel_url)\n        assert mock_session.get.call_count == 2\n\n    @patch(\"fromager.candidate.session\")\n    def test_get_metadata_without_pep658_behavior(\n        self, mock_session: typing.Any\n    ) -> None:\n        \"\"\"Test that without PEP 658 metadata URL, only wheel URL is called.\"\"\"\n        # Mock wheel request\n        responses = []\n\n        def side_effect(url: str) -> typing.Any:\n            responses.append((\"wheel\", url))\n            raise Exception(\"Wheel parsing intentionally mocked to fail\")\n\n        mock_session.get.side_effect = side_effect\n\n        wheel_url = \"https://example.com/test-package-1.0.0-py3-none-any.whl\"\n\n        # This should raise an exception during wheel parsing, but we can verify the behavior\n        try:\n            get_metadata_for_wheel(wheel_url, metadata_url=None)\n        except Exception:\n            pass  # Expected to fail during wheel parsing mock\n\n        # Verify that only the wheel URL was called\n        assert len(responses) == 1\n        assert responses[0] == (\"wheel\", wheel_url)\n        mock_session.get.assert_called_once_with(wheel_url)\n\n    def test_candidate_repr_with_metadata_url(self) -> None:\n        \"\"\"Test that Candidate representation includes metadata URL info.\"\"\"\n        candidate = Candidate(\n            name=\"test-package\",\n            version=Version(\"1.0.0\"),\n            url=\"https://example.com/test-package-1.0.0-py3-none-any.whl\",\n            has_metadata=True,\n        )\n\n        # The candidate should have the metadata URL attribute\n        assert hasattr(candidate, \"metadata_url\")\n        assert (\n            candidate.metadata_url\n            == \"https://example.com/test-package-1.0.0-py3-none-any.whl.metadata\"\n        )\n\n    def test_metadata_url_construction(self) -> None:\n        \"\"\"Test that metadata URLs are constructed correctly.\"\"\"\n        base_url = (\n            \"https://pypi.org/simple/test-package/test-package-1.0.0-py3-none-any.whl\"\n        )\n        expected_metadata_url = base_url + \".metadata\"\n\n        # This tests the expected pattern for PEP 658 metadata URLs\n        assert expected_metadata_url.endswith(\".whl.metadata\")\n        assert expected_metadata_url.startswith(\"https://\")\n\n    def test_pep658_integration_with_resolver(self) -> None:\n        \"\"\"Test that PEP 658 metadata URLs are properly handled by the candidate system.\"\"\"\n        # Test the basic integration of metadata URLs with candidates\n        candidate_with_metadata = Candidate(\n            name=\"test-package\",\n            version=Version(\"1