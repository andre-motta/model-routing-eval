 import datetime
 import re
 import typing
+import unittest.mock
 
 import pytest
 import requests_mock
@@ -1278,3 +1279,59 @@ def test_cli_package_resolver(
     assert "- PyPI versions: 1.2.2, 1.3.1+local, 1.3.2, 2.0.0a1" in result.stdout
     assert "- only wheels on PyPI: 1.3.1+local, 2.0.0a1" in result.stdout
     assert "- missing from Fromager: 1.3.1+local, 2.0.0a1" in result.stdout
+
+
+def _age_filter_provider(
+    constraint: str | None, caplog: pytest.LogCaptureFixture
+) -> tuple[unittest.mock.Mock, datetime.datetime]:
+    now = datetime.datetime.now(datetime.UTC)
+    old = [
+        resolver.Candidate(
+            name="boto3",
+            version=Version(v),
+            url=f"https://pkg.test/boto3-{v}.tar.gz",
+            upload_time=now - datetime.timedelta(days=400),
+        )
+        for v in ("1.35.88", "1.35.80")
+    ]
+    constraints_ = constraints.Constraints()
+    if constraint:
+        constraints_.add_constraint(constraint)
+    provider = unittest.mock.Mock()
+    provider.identify.return_value = "boto3"
+    provider.find_matches.return_value = old
+    provider.constraints = constraints_
+    caplog.set_level("INFO")
+    return provider, now - datetime.timedelta(days=30)
+
+
+@pytest.mark.parametrize("fallback", [True, False])
+def test_age_filter_skipped_for_constrained_package(
+    fallback: bool, caplog: pytest.LogCaptureFixture
+) -> None:
+    provider, cutoff = _age_filter_provider("boto3==1.35.88", caplog)
+
+    result = resolver.find_all_matching_from_provider(
+        provider,
+        Requirement("boto3"),
+        max_age_cutoff=cutoff,
+        fallback_on_empty_age_filter=fallback,
+    )
+
+    assert [str(v) for _, v in result] == ["1.35.88", "1.35.80"]
+    assert "keeping all to avoid empty resolution" not in caplog.text
+
+
+def test_age_filter_without_fallback_still_empties_unconstrained(
+    caplog: pytest.LogCaptureFixture,
+) -> None:
+    provider, cutoff = _age_filter_provider(None, caplog)
+
+    result = resolver.find_all_matching_from_provider(
+        provider,
+        Requirement("boto3"),
+        max_age_cutoff=cutoff,
+        fallback_on_empty_age_filter=False,
+    )
+
+    assert result == []
