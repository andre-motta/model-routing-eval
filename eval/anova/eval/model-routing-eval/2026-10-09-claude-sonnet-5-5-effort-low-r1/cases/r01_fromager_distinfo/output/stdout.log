ame}\\nVersion: 1.0\\n\".encode()\n\n\ndef test_wheel_metadata_path_ignores_query_and_fragment() -> None:\n    url = \"https://pkg.test/files/MarkupSafe-3.0.2-py3-none-any.whl?x=1#sha256=ab\"\n    assert _wheel_metadata_path(url) == \"MarkupSafe-3.0.2.dist-info/METADATA\"\n\n\n@patch(\"fromager.candidate.session\")\ndef test_get_metadata_ignores_vendored_dist_info(mock_session: typing.Any) -> None:\n    wheel = _make_wheel(\n        {\n            \"pkg/_vendor/other-2.0.dist-info/METADATA\": _metadata(\"other\"),\n            \"Pkg-1.0.dist-info/METADATA\": _metadata(\"Pkg\"),\n        }\n    )\n    mock_session.get.return_value = Mock(content=wheel)\n    metadata = get_metadata_for_wheel(\"https://pkg.test/Pkg-1.0-py3-none-any.whl\")\n    assert metadata.name == \"Pkg\"\n\n\n@patch(\"fromager.candidate.session\")\ndef test_get_metadata_missing_member(mock_session: typing.Any) -> None:\n    wheel = _make_wheel({\"pkg/_vendor/other-2.0.dist-info/METADATA\": _metadata(\"o\")})\n    mock_session.get.return_value = Mock(content=wheel)\n    with pytest.raises(ValueError, match=\"Could not find METADATA\"):\n        get_metadata_for_wheel(\"https://pkg.test/pkg-1.0-py3-none-any.whl\")\nEOF\nsed -i 's/^import typing$/import io\\nimport typing\\nimport zipfile/; s/^from unittest.mock import Mock, patch$/from unittest.mock import Mock, patch\\n\\nimport pytest/; s/import Candidate, get_metadata_for_wheel/import Candidate, _wheel_metadata_path, get_metadata_for_wheel/' tests/test_pep658_support.py\n.venv/bin/python -m ruff format src tests >/dev/null 2>&1; .venv/bin/python -m ruff check --fix src tests 2>&1 | tail -5\n.venv/bin/python -m pytest -o addopts=\"\" tests -q -x 2>&1 | tail -8"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4553,"cache_read_input_tokens":51389,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4553},"output_to