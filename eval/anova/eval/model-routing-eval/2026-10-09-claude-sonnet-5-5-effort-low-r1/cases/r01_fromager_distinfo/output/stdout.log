uld not find METADATA file in wheel: {wheel_filename}\"\n            ) from None\n        return parse_metadata(metadata_content, validate=validate)\n\n\ndef get_pyproject_contents(sdist_root_dir: pathlib.Path) -> dict[str, typing.Any]:\n    pyproject_toml_filename = sdist_root_dir / \"pyproject.toml\"","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01UDDw9Pd2uKGk7Ze3CRcu4B","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
