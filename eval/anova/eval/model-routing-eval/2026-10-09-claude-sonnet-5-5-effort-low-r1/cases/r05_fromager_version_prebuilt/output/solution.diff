+def test_version_specific_lookup_ignores_local_version(
+    testdata_context: context.WorkContext,
+) -> None:
+    """A local version segment does not hide version-specific settings."""
+    pbi = testdata_context.settings.package_build_info(TEST_PKG)
+    assert pbi.is_pre_built(Version("2.9.0+cpu")) is True
+    assert pbi.is_pre_built(Version("2.8.0+cpu")) is False
+    assert pbi.get_wheel_server_url(Version("2.9.0+cpu")) == (
+        "https://mirror.test/simple"
+    )
+
+
+def test_is_pre_built_hook_only_called_with_version(
+    testdata_context: context.WorkContext,
+) -> None:
+    """The hook wins over YAML, and is skipped without a version."""
+    pbi = testdata_context.settings.package_build_info(TEST_PKG)
+    with patch(
+        "fromager.overrides.find_and_invoke", return_value=True
+    ) as find_and_invoke:
+        assert pbi.is_pre_built() is False
+        assert pbi.pre_built is False
+        find_and_invoke.assert_not_called()
+        assert pbi.is_pre_built(Version("2.8.0+cpu")) is True
+        find_and_invoke.assert_called_once()
+        assert find_and_invoke.call_args.kwargs == {
+            "version": Version("2.8.0"),
+            "variant": "cpu",
+        }
