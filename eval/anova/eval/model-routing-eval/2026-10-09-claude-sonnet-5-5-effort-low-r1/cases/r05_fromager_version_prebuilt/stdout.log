tstrapper._start._re_resolve_url\",\n                return_value=\"https://wheels.test/testpkg-1.0.whl\",\n            ) as re_resolve,\n        ):\n            item.run(bt)\n\n        re_resolve.assert_called_once()\n        assert item.work_item.source_url == \"https://wheels.test/testpkg-1.0.whl\"\n        node = tmp_context.dependency_graph.nodes[\n            f\"{canonicalize_name('testpkg')}==1.0\"\n        ]\n        assert node.download_url == \"https://wheels.test/testpkg-1.0.whl\"\n\n    def test_re_resolve_failure_keeps_url(\n        self, tmp_context: WorkContext, caplog: pytest.LogCaptureFixture\n    ) -> None:\n        bt = bootstrapper.Bootstrapper(tmp_context)\n        bt.why = []\n        item = _make_start_item()\n        original = item.work_item.source_url\n        with (\n            patch.object(\n                tmp_context, \"package_build_info\", return_value=self._pbi(False, True)\n            ),\n            patch(\"fromager.bootstrapper._start._re_resolve_url\", return_value=None),\n            caplog.at_level(logging.WARNING),\n        ):\n            item.run(bt)\n\n        assert item.work_item.source_url == original\n        assert \"could not re-resolve\" in caplog.text\n\n    def test_wheel_server_change_re_resolves_prebuilt(\n        self, tmp_context: WorkContext\n    ) -> None:\n        bt = bootstrapper.Bootstrapper(tmp_context)\n        bt.why = []\n        item = _make_start_item()\n        pbi = self._pbi(\n            True, True, default=\"https://a.test/simple\", version=\"https://b.test/simple\"\n        )\n        with (\n            patch.object(tmp_context, \"package_build_info\", return_value=pbi),\n            patch(\n                \"fromager.bootstrapper._start._re_resolve_url\", return_value=\"u\"\n            ) as re_resolve,\n        ):\n            item.run(bt)\n        re_resolve.assert_called_once()\n\n    def test_no_re_resolve_when_unchanged(self, tmp_context: WorkContext) -> None:\n        bt = bootstrapper.Bootstrapper(tmp_context)\n        bt.why = []\n        item = _make_start_item()\n        with (\n            patch.object(\n                tmp_context, \"package_build_info\", return_value=self._pbi(False, False)\n            ),\n            patch(\"fromager.bootstrapper._start._re_resolve_url\") as re_resolve,\n        ):\n            item.run(bt)\n        re_resolve.assert_not_called()\n\n    def test_second_parent_edge_recorded_when_seen(\n        self, tmp_context: WorkContext\n    ) -> None:\n        bt = bootstrapper.Bootstrapper(tmp_context)\n        bt.why = []\n        pbi = self._pbi(True, False)\n        with (\n            patch.object(tmp_context, \"package_build_info\", return_value=pbi),\n            patch(\n                \"fromager.bootstrapper._start._re_resolve_url\", return_value=\"u\"\n            ) as re_resolve,\n        ):\n            _make_start_item().run(bt)\n            second = _make_start_item()\n            assert second.run(bt) == []\n        assert re_resolve.call_count == 2\n        assert second.work_item.source_url == \"u\"\n\n    def test_re_resolve_url_prebuilt(self, tmp_context: WorkContext) -> None:\n        with (\n            patch(\n                \"fromager.wheels.get_wheel_server_urls\", return_value=[\"https://w.test\"]\n            ) as get_urls,\n            patch(\n                \"fromager.wheels.resolve_prebuilt_wheel\",\n                return_value=(\"https://w.test/p-1.0.whl\", Version(\"1.0\")),\n            ) as resolve,\n        ):\n            url = _re_resolve_url(\n                tmp_context,\n                Requirement(\"testpkg>=0.5\"),\n                RequirementType.INSTALL,\n                Version(\"1.0+cpu\"),\n                True,\n                \"https://cache.test\",\n            )\n        assert url == \"https://w.test/p-1.0.whl\"\n        assert get_urls.call_args.kwargs[\"version\"] == Version(\"1.0+cpu\")\n        assert str(resolve.call_args.kwargs[\"req\"]) == \"testpkg==1.0+cpu\"\n\n    def test_re_resolve_url_prebuilt_not_found(self, tmp_context: WorkContext) -> None:\n        with (\n            patch(\"fromager.wheels.get_wheel_server_urls\", return_value=[\"u\"]),\n            patch(\n                \"fromager.wheels.resolve_prebuilt_wheel\",\n                side_effect=ExceptionGroup(\"none\", [ValueError(\"x\")]),\n            ),\n        ):\n            assert (\n                _re_resolve_url(\n                    tmp_context,\n                    Requirement(\"testpkg\"),\n                    RequirementType.INSTALL,\n                    Version(\"1.0\"),\n                    True,\n                    None,\n                )\n                is None\n            )\n\n    def test_re_resolve_url_source(self, tmp_context: WorkContext) -> None:\n        with (\n            patch(\"fromager.sources.get_source_provider\") as provider,\n            patch(\n                \"fromager.resolver.find_all_matching_from_provider\",\n                return_value=[(\"https://s.test/p-1.0.tar.gz\", Version(\"1.0\"))],\n            ),\n        ):\n            args = (\n                tmp_context,\n                Requirement(\"testpkg\"),\n                RequirementType.INSTALL,\n                Version(\"1.0\"),\n                False,\n                None,\n            )\n            assert _re_resolve_url(*args) == \"https://s.test/p-1.0.tar.gz\"\n        provider.assert_called_once()\n\n        with (\n            patch(\"fromager.sources.get_source_provider\"),\n            patch(\n                \"fromager.resolver.find_all_matching_from_provider\", return_value=[]\n            ),\n        ):\n            assert _re_resolve_url(*args) is None\n\n''',1)\nopen(p,'w').write(s)\nEOF\n.venv/bin/python -m pytest -o addopts=\"\" tests/test_packagesettings.py tests/test_bootstrapper_iterative.py -q 2>&1 | tail -30 | sed 's/\\x1b\\[[0-9;]*m//g' > /tmp/t.txt"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequen