+def test_resolve_error_names_failing_requirement_and_parent(
+    tmp_context: WorkContext,
+) -> None:
+    """Resolution errors name the failing package and its parent, not the context."""
+    req = Requirement("vllm==0.1")
+    parent_req = Requirement("reward-hub==1.0")
+    resolver = BootstrapRequirementResolver(tmp_context)
+
+    with patch.object(
+        resolver, "_resolve_and_extend", side_effect=ResolverException("no match")
+    ):
+        with pytest.raises(ResolverException) as excinfo:
+            resolver.resolve(
+                req=req,
+                req_type=RequirementType.INSTALL,
+                parent_req=parent_req,
+                pre_built=False,
+            )
+
+    msg = str(excinfo.value)
+    assert "vllm" in msg
+    assert "required by reward-hub==1.0" in msg
+    assert "no match" in msg
