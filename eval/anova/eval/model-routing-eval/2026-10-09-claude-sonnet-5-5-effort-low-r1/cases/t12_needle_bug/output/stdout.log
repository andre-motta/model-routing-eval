14.pyc b/billing/__pycache__/totals.cpython-314.pyc\nindex 858e67e..ea0c9ee 100644\nBinary files a/billing/__pycache__/totals.cpython-314.pyc and b/billing/__pycache__/totals.cpython-314.pyc differ\ndiff --git a/billing/totals.py b/billing/totals.py\nindex 7865b14..dd2d64d 100644\n--- a/billing/totals.py\n+++ b/billing/totals.py\n@@ -14,10 +14,5 @@ def line_totals(inv: Invoice) -> list[Decimal]:\n \n def invoice_total(inv: Invoice) -> Decimal:\n     \"\"\"Amount charged: sum of lines after discount, plus tax on that sum.\"\"\"\n-    gross = sum((li.unit_price * li.qty for li in inv.lines), Decimal(\"0\"))\n-    discount_amount = Decimal(\"0\")\n-    for li in inv.lines:\n-        if li.discount is not None:\n-            discount_amount += li.unit_price * li.qty * li.discount.percent / Decimal(100)\n-    net = round_money(gross - discount_amount)\n+    net = sum(line_totals(inv), Decimal(\"0\"))\n     return round_money(net + tax_for(net, inv.tax_rule))","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_017pTvnKK19xZDP228y4fuMP","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011Cfs61maYEpVwzUXFwJbTM","type":"message","role":"assistant","content":[{"type":"text","text":"I fixed the off-by-one-cent totals, and the full suite passes (4 tests). I didn't run the new test against the old code, but the arithmetic in its comment shows the old code gives 0.14 where the lines sum to 0.15.\n\n**Root cause:** `invoice_total()` in `billing/totals.py` and the PDF disagreed on when to round. The PDF prints `line_totals()`, which rounds each discounted line to cents. `invoice_total()` instead subtracted the unrounded discounts from the gross and rounded once at the end. When a line's discount leaves a fractional cent, the per-line rounding and the single final rounding can land a cent apart. That only happens on invoices with discounts, and only some of them. Nothing raised an error, which is why the logs were clean.\n\n**Fix:** `invoice_total()` now sums `line_totals(inv)`, so the charged total matches the printed lines. Tax is computed on that sum as before. The public API and signatures are unchanged.\n\n**Test:** I added `test_total_matches_rounded_line_items_with_discounts` in `tests/test_billing.py`. It uses three lines of 0.05 at 10% off. Each line prints 0.05, so the total must be 0.15. The old code would have charged 0.14.\n\n`round_money` is still imported in `totals.py` and still used. The `__pycache__` .pyc files are tracked in git and show up as modified."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4889,"cache_read_input_tokens":49640,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4889},"output_tokens":465,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"471293a6-2da0-4d08-86af-530770aad3bd","uuid":"72174b14-8eab-4128-8ea9-0317efbaf167","t