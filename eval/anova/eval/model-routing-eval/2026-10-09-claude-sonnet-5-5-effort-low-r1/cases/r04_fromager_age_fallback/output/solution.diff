+class AgeFallback(enum.Enum):
+    """What to do when max-release-age filtering removes every candidate."""
+
+    ALL = "all"
+    """Keep every candidate."""
+
+    NEWEST = "newest"
+    """Keep only the newest candidate."""
+
+    NONE = "none"
+    """Return an empty list."""
+
+
+def _is_pinned(provider: BaseProvider, req: Requirement) -> bool:
+    """Return True if the constraint for ``req`` is a single exact ``==`` pin."""
+    constraint = provider.constraints.get_constraint(req.name)
+    if constraint is None:
+        return False
+    specs = list(constraint.specifier)
+    return (
+        len(specs) == 1
+        and specs[0].operator == "=="
+        and not specs[0].version.endswith(".*")
+    )
+
