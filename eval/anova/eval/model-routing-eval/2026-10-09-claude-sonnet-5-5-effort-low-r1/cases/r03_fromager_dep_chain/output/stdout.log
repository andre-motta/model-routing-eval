olution_error(item, err)\n\n        assert type(result) is expected_type\n        assert str(result) == prefix + bt._dependency_chain_suffix(item.work_item)\n\n    def test_enrich_unchanged_for_top_level(self, tmp_context: WorkContext) -> None:\n        bt = bootstrapper.Bootstrapper(tmp_context)\n        err = RuntimeError(\"bad\")\n\n        assert bt._enrich_resolution_error(_make_resolve_item(), err) is err\n\n    def test_enrich_unchanged_for_other_phase(self, tmp_context: WorkContext) -> None:\n        bt = bootstrapper.Bootstrapper(tmp_context)\n        item = _make_build_item(phase=BootstrapPhase.PREPARE_SOURCE)\n        item.work_item.why_snapshot = self._chain_item().work_item.why_snapshot\n        err = RuntimeError(\"bad\")\n\n        assert bt._enrich_resolution_error(item, err) is err\n\n    def test_normal_mode_raises_enriched_without_cause(\n        self, tmp_context: WorkContext\n    ) -> None:\n        bt = bootstrapper.Bootstrapper(tmp_context)\n        err = RuntimeError(\"bad\")\n\n        with pytest.raises(RuntimeError, match=\"dependency chain: its-hub\") as exc:\n            try:\n                raise err\n            except RuntimeError:\n                bt._handle_phase_error(self._chain_item(), err)\n\n        assert exc.value is not err\n        assert exc.value.__cause__ is None\n        assert exc.value.__context__ is err\n\n    def test_test_mode_records_enriched(self, tmp_context: WorkContext) -> None:\n        bt = bootstrapper.Bootstrapper(tmp_context, test_mode=True)\n\n        assert bt._handle_phase_error(self._chain_item(), RuntimeError(\"bad\")) == []\n\n        assert \"dependency chain: its-hub\" in str(bt.failed_packages[0][\"exception_message\"])\n\n    def test_multiple_versions_records_enriched(\n        self, tmp_context: WorkContext\n    ) -> None:\n        bt = bootstrapper.Bootstrapper(tmp_context, multiple_versions=True)\n\n        bt._handle_phase_error(self._chain_item(), RuntimeError(\"bad\"))\n\n        recorded = next(iter(bt._failed_versions.values()))\n        assert \"dependency chain: its-hub\" in str(recorded)\n\n'''\ns=s.replace(anchor,new+anchor,1)\nopen(p,'w').write(s)\nE\ngrep -n \"def record_test_mode_failure\" -A25 src/fromager/bootstrapper/_bootstrapper.py | grep -n \"exception\\|append\" ; .venv/bin/python -m pytest -o addopts=\"\" tests/test_bootstrapper_iterative.py -q 2>&1 | tail -15"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":10683,"cache_read_input_tokens":37487,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10683},"output_tokens":36,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"83b43240-bc5a-4cf5-8310-d7ef3096da1e","uuid":"c983c5ff-f22d-41ee-a54e-dd2fb5133429","timestamp":"2026-10-09T17:43:41.155Z","request_id":"req_011Cfs5THEZbjLyK6uNQgG3U","wire_tool_inputs":{"toolu_01XxThtwzHcfdY6McCmCq4C6":{"command":"cd /home/alustosa/git/model-routing-eval/.work/agent-eval/2026-10-09-claude-sonnet-5-5-effort-low-r1/cases/r03_fromager_dep_chain; python3 - <<'E'\np='tests/test_bootstrapper_iterative.py'\ns=open(p).read()\ns=s.replace(\"import pytest\\n\",\"import pytest\\nimport resolvelib.resolvers\\n\",1)\nanchor=\"    # -- Build phase errors in test mode --\\n\"\nnew='''    # -- Dependency chain enrichment --\n\n    @staticmethod\n    def _chain_item() -> Resolve:\n        return _make_resolve_item(\n            req=\"flashinfer-python==0.6.8\",\n            why_snapshot=[\n                (RequirementType.TOP_LEVEL, Requirement(\"its-hub\"), Version(\"1.0\")),\n                (RequirementType.INSTALL, Requirement(\"vllm\"), Version(\"0.9\")),\n            ],\n        )\n\n    def test_chain_suffix(self, tmp_context: WorkContext) -> None:\n        bt = bootstrapper.Bootstrapper(tmp_context)\n      