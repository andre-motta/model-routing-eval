+    @staticmethod
+    def _chain_item() -> Resolve:
+        return _make_resolve_item(
+            req="flashinfer-python==0.6.8",
+            why_snapshot=[
+                (RequirementType.TOP_LEVEL, Requirement("its-hub"), Version("1.0")),
+                (RequirementType.INSTALL, Requirement("vllm"), Version("0.9")),
+            ],
+        )
+
+    def test_chain_suffix(self, tmp_context: WorkContext) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context)
+        item = self._chain_item()
+
+        assert bt._dependency_chain_suffix(item.work_item) == (
+            " (dependency chain: its-hub==1.0 -> vllm==0.9 -> flashinfer-python==0.6.8)"
+        )
+
+    @pytest.mark.parametrize(
+        "err,expected_type,prefix",
+        [
+            (resolvelib.resolvers.ResolverException("bad"), resolvelib.resolvers.ResolverException, "bad"),
+            (RuntimeError("bad"), RuntimeError, "bad"),
+            (ValueError("bad"), RuntimeError, "ValueError: bad"),
+        ],
+    )
+    def test_enrich_resolution_error_types(
+        self,
+        tmp_context: WorkContext,
+        err: Exception,
+        expected_type: type[Exception],
+        prefix: str,
+    ) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context)
+        item = self._chain_item()
+
+        result = bt._enrich_resolution_error(item, err)
+
+        assert type(result) is expected_type
+        assert str(result) == prefix + bt._dependency_chain_suffix(item.work_item)
+
+    def test_enrich_unchanged_for_top_level(self, tmp_context: WorkContext) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context)
