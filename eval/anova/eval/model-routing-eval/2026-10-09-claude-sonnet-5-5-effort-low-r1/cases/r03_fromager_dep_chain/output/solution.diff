+    def _dependency_chain_suffix(self, wi: WorkItem) -> str:
+        """Return a message suffix describing the chain leading to ``wi``."""
+        chain = [f"{req.name}=={version}" for _, req, version in wi.why_snapshot]
+        chain.append(str(wi.req))
+        return f" (dependency chain: {' -> '.join(chain)})"
+
+    def _enrich_resolution_error(self, item: Phase, err: Exception) -> Exception:
+        """Append the dependency chain to resolution errors of indirect deps.
+
+        Returns ``err`` unchanged for other phases and top-level requirements.
+        """
+        if not isinstance(item, Resolve) or not item.work_item.why_snapshot:
+            return err
+        message = f"{err}{self._dependency_chain_suffix(item.work_item)}"
+        if isinstance(err, resolvelib.resolvers.ResolverException):
+            return resolvelib.resolvers.ResolverException(message)
+        if isinstance(err, RuntimeError):
+            return RuntimeError(message)
+        return RuntimeError(f"{type(err).__name__}: {message}")
+
