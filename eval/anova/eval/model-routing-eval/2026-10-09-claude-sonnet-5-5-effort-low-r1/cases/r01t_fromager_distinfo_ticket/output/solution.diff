 """Tests for PEP 658 metadata support."""
 
+import io
 import typing
+import zipfile
 from unittest.mock import Mock, patch
 
+import pytest
 from packaging.version import Version
 
 from fromager.candidate import Candidate, get_metadata_for_wheel
@@ -191,3 +194,40 @@ Requires-Dist: requests >= 2.0.0
         assert candidate_with_metadata.name == candidate_without_metadata.name
         assert candidate_with_metadata.version == candidate_without_metadata.version
         assert candidate_with_metadata.url == candidate_without_metadata.url
+
+
+def _make_wheel(entries: dict[str, str]) -> bytes:
+    buf = io.BytesIO()
+    with zipfile.ZipFile(buf, "w") as z:
+        for name, content in entries.items():
+            z.writestr(name, content)
+    return buf.getvalue()
+
+
+@patch("fromager.candidate.session")
+def test_get_metadata_ignores_vendored_dist_info(mock_session: typing.Any) -> None:
+    template = "Metadata-Version: 2.1\nName: {}\nVersion: {}\n"
+    wheel = _make_wheel(
+        {
+            "pkg/_vendor/other-2.0.dist-info/METADATA": template.format("other", "2.0"),
+            "other-2.0.dist-info/METADATA": template.format("other", "2.0"),
+            "pkg-1.0.dist-info/METADATA": template.format("pkg", "1.0"),
+        }
+    )
+    mock_session.get.return_value = Mock(content=wheel)
+
+    metadata = get_metadata_for_wheel("https://pkg.test/pkg-1.0-py3-none-any.whl")
+
+    assert metadata.name == "pkg"
+    assert str(metadata.version) == "1.0"
+
+
+@patch("fromager.candidate.session")
+def test_get_metadata_ignores_nested_dist_info_only(mock_session: typing.Any) -> None:
+    wheel = _make_wheel(
+        {"v/other-2.0.dist-info/METADATA": "Metadata-Version: 2.1\nName: o\nVersion: 2\n"}
+    )
+    mock_session.get.return_value = Mock(content=wheel)
+
+    with pytest.raises(ValueError, match="Could not find METADATA"):
+        get_metadata_for_wheel("https://pkg.test/pkg-1.0-py3-none-any.whl")
