+def _filter_dist_info(url: str, names: list[str]) -> list[str]:
+    """Keep METADATA paths whose dist-info dir matches the wheel filename."""
+    filename = unquote(urlparse(url).path.rsplit("/", 1)[-1])
+    try:
+        dist_name, dist_version, _, _ = parse_wheel_filename(filename)
+    except InvalidWheelFilename:
+        return []
+    return [
+        n
+        for n in names
+        if _split_dist_info(n.split("/", 1)[0]) == (dist_name, dist_version)
+    ]
+
+
+def _split_dist_info(dirname: str) -> tuple[NormalizedName, Version | None] | None:
+    stem = dirname.removesuffix(".dist-info")
+    name, _, version = stem.partition("-")
+    try:
+        return canonicalize_name(name), Version(version)
+    except InvalidVersion:
+        return None
+
