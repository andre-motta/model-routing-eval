m.partition(\"-\")\n    try:\n        return canonicalize_name(name), Version(version)\n    except InvalidVersion:\n        return None\n\n\ndef get_metadata_for_wheel(''',1)\ns=s.replace('''from zipfile import ZipFile\n''','''from urllib.parse import unquote, urlparse\nfrom zipfile import ZipFile\n''')\ns=s.replace('''from packaging.utils import BuildTag, canonicalize_name\nfrom packaging.version import Version''','''from packaging.utils import (\n    BuildTag,\n    InvalidWheelFilename,\n    NormalizedName,\n    canonicalize_name,\n    parse_wheel_filename,\n)\nfrom packaging.version import InvalidVersion, Version''')\nopen(p,'w').write(s)\nE\ncat >> tests/test_pep658_support.py <<'E'\n\n\ndef _make_wheel(entries: dict[str, str]) -> bytes:\n    buf = io.BytesIO()\n    with zipfile.ZipFile(buf, \"w\") as z:\n        for name, content in entries.items():\n            z.writestr(name, content)\n    return buf.getvalue()\n\n\n@patch(\"fromager.candidate.session\")\ndef test_get_metadata_ignores_vendored_dist_info(mock_session: typing.Any) -> None:\n    template = \"Metadata-Version: 2.1\\nName: {}\\nVersion: {}\\n\"\n    wheel = _make_wheel(\n        {\n            \"pkg/_vendor/other-2.0.dist-info/METADATA\": template.format(\"other\", \"2.0\"),\n            \"other-2.0.dist-info/METADATA\": template.format(\"other\", \"2.0\"),\n            \"pkg-1.0.dist-info/METADATA\": template.format(\"pkg\", \"1.0\"),\n        }\n    )\n    mock_session.get.return_value = Mock(content=wheel)\n\n    metadata = get_metadata_for_wheel(\"https://pkg.test/pkg-1.0-py3-none-any.whl\")\n\n    assert metadata.name == \"pkg\"\n    assert str(metadata.version) == \"1.0\"\n\n\n@patch(\"fromager.candidate.session\")\ndef test_get_metadata_ignores_nested_dist_info_only(mock_session: typing.Any) -> None:\n    wheel = _make_wheel(\n        {\"v/other-2.0.dist-info/METADATA\": \"Metadata-Version: 2.1\\nName: o\\nVersion: 2\\n\"}\n    )\n    mock_session.get.return_value = Mock(content=wheel)\n\n