+_CHAIN = [
+    (RequirementType.TOP_LEVEL, Requirement("its-hub"), Version("1.0")),
+    (RequirementType.INSTALL, Requirement("reward-hub"), Version("2.0")),
+]
+_SUFFIX = " (dependency chain: its-hub==1.0 -> reward-hub==2.0 -> vllm>=0.6)"
+
+
+class TestResolutionErrorEnrichment:
+    def test_chain_suffix(self, tmp_context: WorkContext) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context)
+        item = _make_resolve_item("vllm>=0.6", why_snapshot=_CHAIN)
+
+        assert bt._dependency_chain_suffix(item.work_item) == _SUFFIX
+
+    @pytest.mark.parametrize(
+        "err,expected_type,expected_msg",
+        [
+            (ResolverException("boom"), ResolverException, "boom" + _SUFFIX),
+            (RuntimeError("boom"), RuntimeError, "boom" + _SUFFIX),
+            (ValueError("boom"), RuntimeError, "ValueError: boom" + _SUFFIX),
+        ],
+    )
+    def test_enrich_indirect_resolve(
+        self,
+        tmp_context: WorkContext,
+        err: Exception,
+        expected_type: type[Exception],
+        expected_msg: str,
+    ) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context)
+        item = _make_resolve_item("vllm>=0.6", why_snapshot=_CHAIN)
+
+        result = bt._enrich_resolution_error(item, err)
+
+        assert type(result) is expected_type
+        assert str(result) == expected_msg
+
+    def test_enrich_top_level_unchanged(self, tmp_context: WorkContext) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context)
+        err = RuntimeError("boom")
+
+        assert bt._enrich_resolution_error(_make_resolve_item(), err) is err
+
+    def test_enrich_other_phase_unchanged(self, tmp_context: WorkContext) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context)
+        item = _make_build_item(phase=BootstrapPhase.BUILD)
+        item.work_item.why_snapshot = list(_CHAIN)
+        err = RuntimeError("boom")
+
+        assert bt._enrich_resolution_error(item, err) is err
+
+    def test_normal_mode_raises_enriched_without_cause(
+        self, tmp_context: WorkContext
+    ) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context)
+        item = _make_resolve_item("vllm>=0.6", why_snapshot=_CHAIN)
+        err = ResolverException("boom")
+
+        with pytest.raises(ResolverException) as excinfo:
+            try:
+                raise err
+            except ResolverException:
+                bt._handle_phase_error(item, err)
+
+        assert str(excinfo.value) == "boom" + _SUFFIX
+        assert excinfo.value.__context__ is err
+        assert excinfo.value.__cause__ is None
+
+    def test_test_mode_records_enriched(self, tmp_context: WorkContext) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context, test_mode=True)
+        item = _make_resolve_item("vllm>=0.6", why_snapshot=_CHAIN)
+
+        bt._handle_phase_error(item, ResolverException("boom"))
+
+        assert _SUFFIX in str(bt.failed_packages[0]["exception_message"])
+
+    def test_multiple_versions_records_enriched(
+        self, tmp_context: WorkContext
+    ) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context, multiple_versions=True)
+        item = _make_resolve_item("vllm>=0.6", why_snapshot=_CHAIN)
+
+        with patch.object(bt, "_record_failed_version") as record:
+            bt._handle_phase_error(item, ResolverException("boom"))
+
+        assert str(record.call_args.args[2]) == "boom" + _SUFFIX
+
+
 class TestIterativeBootstrapLoop:
