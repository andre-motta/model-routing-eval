ilt fallback for build-related phases\n1164\t        if self.test_mode:\n1165\t            if (\n1166\t                isinstance(item, PrepareSource | PrepareBuild | Build)\n1167\t                and not wi.pbi_pre_built\n1168\t            ):\n1169\t                assert wi.resolved_version is not None\n1170\t                fallback = self._handle_test_mode_failure(\n1171\t                    req=wi.req,\n1172\t                    resolved_version=wi.resolved_version,\n1173\t                    req_type=wi.req_type,\n1174\t                    build_error=err,\n1175\t                )\n1176\t                if fallback is not None:\n1177\t                    wi.build_result = fallback\n1178\t                    return [ProcessInstallDeps(wi)]\n1179\t            self.record_test_mode_failure(\n1180\t                wi.req, str(wi.resolved_version), err, \"bootstrap\"\n1181\t            )\n1182\t            return []\n1183\t\n1184\t        # Multiple versions mode: record failure, remove from graph, continue\n1185\t        if self.multiple_versions:\n1186\t            assert wi.resolved_version is not None\n1187\t            pkg_name = canonicalize_name(wi.req.name)\n1188\t            self._record_failed_version(\n1189\t                wi.req,\n1190\t                str(wi.resolved_version),\n1191\t                err,\n1192\t                f\"failed during {type(item).phase} phase\",\n1193\t            )\n1194\t            self.ctx.dependency_graph.remove_dependency(pkg_name, wi.resolved_version)\n1195\t            self._seen_requirements.discard(\n1196\t                self._resolved_key(wi.req, wi.resolved_version, \"sdist\")\n1197\t            )\n1198\t            self._seen_requirements.discard(\n1199\t                self._resolved_key(wi.req, wi.resolved_version, \"wheel\")\n1200\t            )\n1201\t            self.ctx.write_to_graph_to_file()\n1202\t            return []\n1203\t\n1204\t        # Normal mode: fail-fast\n1205\t        raise\n1206\t\n1207\t