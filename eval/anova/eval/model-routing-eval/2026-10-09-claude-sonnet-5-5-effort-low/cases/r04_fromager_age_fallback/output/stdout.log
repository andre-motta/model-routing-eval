  assert not [r for r in caplog.records if r.levelno >= logging.WARNING]\n\n\ndef test_max_release_age_fallback_all_is_default(\n    caplog: pytest.LogCaptureFixture,\n) -> None:\n    \"\"\"AgeFallback.ALL is the default and warns.\"\"\"\n    results = _run_age_filter(caplog)\n    assert len(results) == 3\n    assert any(\n        r.levelno == logging.WARNING and \"keeping all to avoid empty\" in r.message\n        for r in caplog.records\n    )\n\n\ndef test_max_release_age_pinned_constraint_skips_filter(\n    caplog: pytest.LogCaptureFixture,\n) -> None:\n    \"\"\"A single == constraint skips age filtering, even with AgeFallback.NONE.\"\"\"\n    results = _run_age_filter(\n        caplog,\n        constraint=\"test-pkg==1.2.2\",\n        age_fallback=resolver.AgeFallback.NONE,\n    )\n    assert [str(v) for _, v in results] == [\"1.2.2\"]\n    assert (\n        \"test-pkg: skipping age filter for pinned constraint (1 candidate(s))\"\n        in caplog.text\n    )\n    assert \"older than\" not in caplog.text\n\n\ndef test_max_release_age_range_constraint_still_filtered(\n    caplog: pytest.LogCaptureFixture,\n) -> None:\n    \"\"\"Range constraints are age-filtered like unconstrained packages.\"\"\"\n    results = _run_age_filter(\n        caplog,\n        constraint=\"test-pkg>=1.0\",\n        age_fallback=resolver.AgeFallback.NONE,\n    )\n    assert results == []\n    assert \"skipping age filter\" not in caplog.text\n\n\n'''\ns=s.replace(marker,new+marker,1)\nopen(p,'w').write(s)\n\np='tests/test_bootstrap_requirement_resolver.py'\ns=open(p).read()\ns=s.replace(\"from fromager.dependency_graph import DependencyGraph\\n\",\"from fromager.dependency_graph import DependencyGraph\\nfrom fromager.resolver import AgeFallback\\n\",1)\ns+='''\n\n@pytest.mark.parametrize(\n    \"multiple_versions,expected\",\n    [(True, AgeFallback.NEWEST), (False, AgeFallback.ALL)],\n)\ndef test_resolve_age_fallback_by_mode(\n    tmp_context: WorkContext,\n    multiple_versions: bool,\n    expected: AgeFallback,\n) -> None:\n    \"\"\"Multi-version mode falls back to the newest version, single keeps all.\"\"\"\n    brr = BootstrapRequirementResolver(tmp_context, multiple_versions=multiple_versions)\n\n    with (\n        patch.object(brr, \"_resolve_from_graph\", return_value=None),\n        patch(\"fromager.bootstrap_requirement_resolver.sources.get_source_provider\"),\n        patch(\n            \"fromager.bootstrap_requirement_resolver.resolver\"\n            \".find_all_matching_from_provider\",\n            return_value=[(\"url\", Version(\"1.0\"))],\n        ) as mock_find,\n    ):\n        brr.resolve(\n            Requirement(\"testpkg\"),\n            RequirementType.INSTALL,\n            parent_req=None,\n            pre_built=False,\n        )\n\n    assert mock_find.call_args.kwargs[\"age_fallback\"] is expected\n'''\ns=s.replace(\"from unittest.mock import MagicMock, patch\\n\\n\",\"from unittest.mock import MagicMock, patch\\n\\nimport pytest\\n\",1)\nopen(p,'w').write(s)\nEOF\ngrep -n \"def add_constraint\\|def load\" src/fromager/constraints.py\n.venv/bin/python -m pytest -o addopts=\"\" tests/test_cooldown.py tests/test_bootstrap_requirement_resolver.py tests/test_resolver.py -q 2>&1 | tail -15"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":10908,"cache_read_input_tokens":49790,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10908},"output_tokens":35,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"138b1989-bee0-46a2-9b0d-3726253c380a","uuid":"6483083b-6c47-413a-b575-fb88b9ac3b2d","timestamp":"2026-10-09T15:58:51.300Z","request_id":"req_011CfrwTZ2AEtdJo6HwKcw3o","wire_tool_inputs":{"toolu_01JquRMvABAqWwRHYRdRNvLS":{"command":"cd /home/alustosa/git/model-routing-eval/.wo