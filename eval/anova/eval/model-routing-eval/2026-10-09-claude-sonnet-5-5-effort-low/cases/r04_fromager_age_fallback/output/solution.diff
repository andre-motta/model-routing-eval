+def test_max_release_age_fallback_newest_keeps_newest(
+    caplog: pytest.LogCaptureFixture,
+) -> None:
+    """AgeFallback.NEWEST keeps only the newest candidate."""
+    results = _run_age_filter(caplog, age_fallback=resolver.AgeFallback.NEWEST)
+    assert [str(v) for _, v in results] == ["2.0.0"]
+    assert "falling back to newest version 2.0.0" in caplog.text
+    assert "keeping all to avoid empty resolution" not in caplog.text
+    assert not [r for r in caplog.records if r.levelno >= logging.WARNING]
+
+
+def test_max_release_age_fallback_all_is_default(
+    caplog: pytest.LogCaptureFixture,
+) -> None:
+    """AgeFallback.ALL is the default and warns."""
+    results = _run_age_filter(caplog)
+    assert len(results) == 3
+    assert any(
+        r.levelno == logging.WARNING and "keeping all to avoid empty" in r.message
+        for r in caplog.records
+    )
+
+
+def test_max_release_age_pinned_constraint_skips_filter(
+    caplog: pytest.LogCaptureFixture,
+) -> None:
+    """A single == constraint skips age filtering, even with AgeFallback.NONE."""
+    results = _run_age_filter(
+        caplog,
+        constraint="test-pkg==1.2.2",
+        age_fallback=resolver.AgeFallback.NONE,
+    )
+    assert [str(v) for _, v in results] == ["1.2.2"]
+    assert (
+        "test-pkg: skipping age filter for pinned constraint (1 candidate(s))"
+        in caplog.text
+    )
+    assert "older than" not in caplog.text
+
+
+def test_max_release_age_range_constraint_still_filtered(
