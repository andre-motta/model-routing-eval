+class AgeFallback(enum.Enum):
+    """What to keep when max-release-age filtering removes every candidate."""
+
+    ALL = "all"
+    """Keep every candidate and log a warning."""
+
+    NEWEST = "newest"
+    """Keep only the newest candidate."""
+
+    NONE = "none"
+    """Return an empty list."""
+
+
+def _is_pinned(constraint: Requirement | None) -> bool:
+    """Return True if the constraint is a single ``==`` specifier."""
+    if constraint is None:
+        return False
+    specs = list(constraint.specifier)
+    return len(specs) == 1 and specs[0].operator == "=="
+
