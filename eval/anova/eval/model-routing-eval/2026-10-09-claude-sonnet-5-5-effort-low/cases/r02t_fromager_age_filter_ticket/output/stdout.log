{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01K3szfrMHixYFtBYUxzxqme","type":"tool_result","content":"660\t    )\n661\t    ctx.wheel_server_url = local_server_url\n662\t\n663\t    no_timestamp_response = {\n664\t        \"meta\": {\"api-version\": \"1.1\"},\n665\t        \"name\": \"test-pkg\",\n666\t        \"files\": [\n667\t            {\n668\t                \"filename\": \"test_pkg-1.3.2-py3-none-any.whl\",\n669\t                \"url\": f\"{local_server_url}test-pkg/test_pkg-1.3.2-py3-none-any.whl\",\n670\t                \"hashes\": {\"sha256\": \"bbb\"},\n671\t                # no upload-time — as served by fromager's local PEP 503 server\n672\t            },\n673\t        ],\n674\t    }\n675\t    with caplog.at_level(logging.WARNING, logger=\"fromager.resolver\"):\n676\t        with requests_mock.Mocker() as r:\n677\t            r.get(\n678\t                f\"{local_server_url}test-pkg/\",\n679\t                json=no_timestamp_response,\n680\t                headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n681\t            )\n682\t            results = wheels.resolve_all_prebuilt_wheels(\n683\t                ctx=ctx,\n684\t                req=Requirement(\"test-pkg\"),\n685\t                wheel_server_urls=[local_server_url],\n686\t            )\n687\t\n688\t    assert len(results) == 1\n689\t    _, version = results[0]\n690\t    assert str(version) == \"1.3.2\"\n691\t    assert \"cooldown check skipped\" in caplog.text\n692\t\n693\t\n694\t# ---------------------------------------------------------------------------\n695\t# max-release-age tests\n696\t# ---------------------------------------------------------------------------\n697\t\n698\t# Uses the same _cooldown_json_response fixture:\n699\t#   2.0.0  uploaded 2026-03-24 →  2 days old\n700\t#   1.3.2  uploaded 2026-03-15 → 11 days old\n701\t#   1.2.2  uploaded 2026-01-01 → 84 days old\n702\t# _BOOTSTRAP_TIME = 2026-03-26\n703\t\n704\t# max_age_cutoff = bootstrap_time - max_release_age\n705\t# With 30 days: cutoff = 2026-02-24 → keeps 2.0.0 and 1.3.2, filters 1.2.2\n706\t# With 5 days:  cutoff = 2026-03-21 → keeps only 2.0.0\n707\t\n708\t\n709\tdef test_max_release_age_filters_old_versions(\n710\t    caplog: pytest.LogCaptureFixture,\n711\t) -> None:\n712\t    \"\"\"Versions older than max-release-age are filtered out.\"\"\"\n713\t    max_age_cutoff = _BOOTSTRAP_TIME - datetime.timedelta(days=30)\n714\t    with requests_mock.Mocker() as r:\n715\t        r.get(\n716\t            \"https://pypi.org/simple/test-pkg/\",\n717\t            json=_cooldown_json_response,\n718\t            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n719\t        )\n720\t        provider = resolver.PyPIProvider(include_sdists=True)\n721\t        with caplog.at_level(logging.INFO, logger=\"fromager.resolver\"):\n722\t            results = resolver.find_all_matching_from_provider(\n723\t                provider, Requirement(\"test-pkg\"), max_age_cutoff=max_age_cutoff\n724\t            )\n725\t\n726\t    versions = [str(v) for _, v in results]\n727\t    assert \"2.0.0\" in versions\n728\t    assert \"1.3.2\" in versions\n729\t    assert \"1.2.2\" not in versions\n730\t    assert \"found 3 candidate(s)\" in caplog.text\n731\t    assert \"have 2 candidate(s)\" in caplog.text\n732\t    assert \"published within\" in caplog.text\n733\t\n734\t\n735\tdef test_max_release_age_keeps_only_recent(\n736\t    caplog: pytest.LogCaptureFixture,\n737\t) -> None:\n738\t    \"\"\"With a tight max-release-age, only very recent versions survive.\"\"\"\n739\t    max_age_cutoff = _BOOTSTRAP_TIME - datetime.timedelta(days=5)\n740\t    with requests_mock.Mocker() as r:\n741\t        r.get(\n742\t            \"https://pypi.org/simple/test-pkg/\",\n743\t            json=_cooldown_json_response,\n744\t            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n745\t        )\n746\t        provider = resolver.PyPIProvider(include_sdists=True)\n747\t        with caplog.at_level(logging.INFO, logger=\"fromager.resolver\"):\n748\t            results = resolver.find_all_matching_from_provider(\n749\t                provider, Requirement(\"test-pkg\"), max_age_cutoff=max_age_cutoff\n750\t            )\n751\t\n752\t    versions = [str(v) for _, v in results]\n753\t    assert versions == [\"2.0.0\"]\n754\t    assert \"found 3 candidate(s)\" in caplog.text\n755\t    assert \"have 1 candidate(s)\" in caplog.text\n756\t    assert \"published within\" in caplog.text\n757\t\n758\t\n759\tdef test_max_release_age_disabled_returns_all() -> None:\n760\t    \"\"\"When max_age_cutoff is None, all versions are returned.\"\"\"\n761\t    with requests_mock.Mocker() as r:\n762\t        r.get(\n763\t            \"https://pypi.org/simple/test-pkg/\",\n764\t            json=_cooldown_json_response,\n765\t            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n766\t        )\n767\t        provider = resolver.PyPIProvider(include_sdists=True)\n768\t        results = resolver.find_all_matching_from_provider(\n769\t            provider, Requirement(\"test-pkg\"), max_age_cutoff=None\n770\t        )\n771\t\n772\t    versions = [str(v) for _, v in results]\n773\t    assert \"2.0.0\" in versions\n774\t    assert \"1.3.2\" in versions\n775\t    assert \"1.2.2\" in versions\n776\t\n777\t\n778\tdef test_max_release_age_all_too_old_keeps_all(\n779\t    caplog: pytest.LogCaptureFixture,\n780\t) -> None:\n781\t    \"\"\"When all versions are older than cutoff, keep all candidates and warn.\"\"\"\n782\t    max_age_cutoff = _BOOTSTRAP_TIME + datetime.timedelta(days=1)\n783\t    with requests_mock.Mocker() as r:\n784\t        r.get(\n785\t            \"https://pypi.org/simple/test-pkg/\",\n786\t            json=_cooldown_json_response,\n787\t            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n788\t        )\n789\t        provider = resolver.PyPIProvider(include_sdists=True)\n790\t        with caplog.at_level(logging.WARNING, logger=\"fromager.resolver\"):\n791\t            results = resolver.find_all_matching_from_provider(\n792\t                provider, Requirement(\"test-pkg\"), max_age_cutoff=max_age_cutoff\n793\t            )\n794\t    versions = [str(v) for _, v in results]\n795\t    assert versions == [\"2.0.0\", \"1.3.2\", \"1.2.2\"]\n796\t    assert \"keeping all to avoid empty resolution\" in caplog.text\n797\t\n798\t\n799\tdef test_max_release_age_all_too_old_returns_empty_when_fallback_disabled(\n800\t    caplog: pytest.LogCaptureFixture,\n801\t) -> None:\n802\t    \"\"\"When fallback is disabled and all versions are too old, return empty list.\"\"\"\n803\t    max_age_cutoff = _BOOTSTRAP_TIME + datetime.timedelta(days=1)\n804\t    with requests_mock.Mocker() as r:\n805\t        r.get(\n806\t            \"https://pypi.org/simple/test-pkg/\",\n807\t            json=_cooldown_json_response,\n808\t            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n809\t        )\n810\t        provider = resolver.PyPIProvider(include_sdists=True)\n811\t        with caplog.at_level(logging.INFO, logger=\"fromager.resolver\"):\n812\t            results = resolver.find_all_matching_from_provider(\n813\t                provider,\n814\t                Requirement(\"test-pkg\"),\n815\t                max_age_cutoff=max_age_cutoff,\n816\t                fallback_on_empty_age_filter=False,\n817\t            )\n818\t    assert results == []\n819\t    assert \"all 3 candidate(s)\" in caplog.text"}]},"parent_tool_use_id":null,"session_id":"ae5cc280-7d28-40ae-a8ce-0bccc8a4e867","uuid":"610f2c7d-9a42-4e24-890a-601cf50c6c1f","timestamp":"2026-10-09T15:54:40.355Z","tool_use_result":{"type":"text","file":{"filePath":"/home/alustosa/git/model-routing-eval/.work/agent-eval/2026-10-09-claude-sonnet-5-5-effort-low/cases/r02t_fromager_age_filter_ticket/tests/test_cooldown.py","content":"    )\n    ctx.wheel_server_url = local_server_url\n\n    no_timestamp_response = {\n        \"meta\": {\"api-version\": \"1.1\"},\n        \"name\": \"test-pkg\",\n        \"files\": [\n            {\n                \"filename\": \"test_pkg-1.3.2-py3-none-any.whl\",\n                \"url\": f\"{local_server_url}test-pkg/test_pkg-1.3.2-py3-none-any.whl\",\n                \"hashes\": {\"sha256\": \"bbb\"},\n                # no upload-time — as served by fromager's local PEP 503 server\n            },\n        ],\n    }\n    with caplog.at_level(logging.WARNING, logger=\"fromager.resolver\"):\n        with requests_mock.Mocker() as r:\n            r.get(\n                f\"{local_server_url}test-pkg/\",\n                json=no_timestamp_response,\n                headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n            )\n            results = wheels.resolve_all_prebuilt_wheels(\n                ctx=ctx,\n                req=Requirement(\"test-pkg\"),\n                wheel_server_urls=[local_server_url],\n            )\n\n    assert len(results) == 1\n    _, version = results[0]\n    assert str(version) == \"1.3.2\"\n    assert \"cooldown check skipped\" in caplog.text\n\n\n# ---------------------------------------------------------------------------\n# max-release-age tests\n# ---------------------------------------------------------------------------\n\n# Uses the same _cooldown_json_response fixture:\n#   2.0.0  uploaded 2026-03-24 →  2 days old\n#   1.3.2  uploaded 2026-03-15 → 11 days old\n#   1.2.2  uploaded 2026-01-01 → 84 days old\n# _BOOTSTRAP_TIME = 2026-03-26\n\n# max_age_cutoff = bootstrap_time - max_release_age\n# With 30 days: cutoff = 2026-02-24 → keeps 2.0.0 and 1.3.2, filters 1.2.2\n# With 5 days:  cutoff = 2026-03-21 → keeps only 2.0.0\n\n\ndef test_max_release_age_filters_old_versions(\n    caplog: pytest.LogCaptureFixture,\n) -> None:\n    \"\"\"Versions older than max-release-age are filtered out.\"\"\"\n    max_age_cutoff = _BOOTSTRAP_TIME - datetime.timedelta(days=30)\n    with requests_mock.Mocker() as r:\n        r.get(\n            \"https://pypi.org/simple/test-pkg/\",\n            json=_cooldown_json_response,\n            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n        )\n        provider = resolver.PyPIProvider(include_sdists=True)\n        with caplog.at_level(logging.INFO, logger=\"fromager.resolver\"):\n            results = resolver.find_all_matching_from_provider(\n                provider, Requirement(\"test-pkg\"), max_age_cutoff=max_age_cutoff\n            )\n\n    versions = [str(v) for _, v in results]\n    assert \"2.0.0\" in versions\n    assert \"1.3.2\" in versions\n    assert \"1.2.2\" not in versions\n    assert \"found 3 candidate(s)\" in caplog.text\n    assert \"have 2 candidate(s)\" in caplog.text\n    assert \"published within\" in caplog.text\n\n\ndef test_max_release_age_keeps_only_recent(\n    caplog: pytest.LogCaptureFixture,\n) -> None:\n    \"\"\"With a tight max-release-age, only very recent versions survive.\"\"\"\n    max_age_cutoff = _BOOTSTRAP_TIME - datetime.timedelta(days=5)\n    with requests_mock.Mocker() as r:\n        r.get(\n            \"https://pypi.org/simple/test-pkg/\",\n            json=_cooldown_json_response,\n            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n        )\n        provider = resolver.PyPIProvider(include_sdists=True)\n        with caplog.at_level(logging.INFO, logger=\"fromager.resolver\"):\n            results = resolver.find_all_matching_from_provider(\n                provider, Requirement(\"test-pkg\"), max_age_cutoff=max_age_cutoff\n            )\n\n    versions = [str(v) for _, v in results]\n    assert versions == [\"2.0.0\"]\n    assert \"found 3 candidate(s)\" in caplog.text\n    assert \"have 1 candidate(s)\" in caplog.text\n    assert \"published within\" in caplog.text\n\n\ndef test_max_release_age_disabled_returns_all() -> None:\n    \"\"\"When max_age_cutoff is None, all versions are returned.\"\"\"\n    with requests_mock.Mocker() as r:\n        r.get(\n            \"https://pypi.org/simple/test-pkg/\",\n            json=_cooldown_json_response,\n            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n        )\n        provider = resolver.PyPIProvider(include_sdists=True)\n        results = resolver.find_all_matching_from_provider(\n            provider, Requirement(\"test-pkg\"), max_age_cutoff=None\n        )\n\n    versions = [str(v) for _, v in results]\n    assert \"2.0.0\" in versions\n    assert \"1.3.2\" in versions\n    assert \"1.2.2\" in versions\n\n\ndef test_max_release_age_all_too_old_keeps_all(\n    caplog: pytest.LogCaptureFixture,\n) -> None:\n    \"\"\"When all versions are older than cutoff, keep all candidates and warn.\"\"\"\n    max_age_cutoff = _BOOTSTRAP_TIME + datetime.timedelta(days=1)\n    with requests_mock.Mocker() as r:\n        r.get(\n            \"https://pypi.org/simple/test-pkg/\",\n            json=_cooldown_json_response,\n            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n        )\n        provider = resolver.PyPIProvider(include_sdists=True)\n        with caplog.at_level(logging.WARNING, logger=\"fromager.resolver\"):\n            results = resolver.find_all_matching_from_provider(\n                provider, Requirement(\"test-pkg\"), max_age_cutoff=max_age_cutoff\n            )\n    versions = [str(v) for _, v in results]\n    assert versions == [\"2.0.0\", \"1.3.2\", \"1.2.2\"]\n    assert \"keeping all to avoid empty resolution\" in caplog.text\n\n\ndef test_max_release_age_all_too_old_returns_empty_when_fallback_disabled(\n    caplog: pytest.LogCaptureFixture,\n) -> None:\n    \"\"\"When fallback is disabled and all versions are too old, return empty list.\"\"\"\n    max_age_cutoff = _BOOTSTRAP_TIME + datetime.timedelta(days=1)\n    with requests_mock.Mocker() as r:\n        r.get(\n            \"https://pypi.org/simple/test-pkg/\",\n            json=_cooldown_json_response,\n            headers={\"Content-Type\": _PYPI_SIMPLE_