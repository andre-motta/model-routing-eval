text,\n) -> None:\n    pbi = testdata_context.settings.package_build_info(TEST_PKG)\n    calls: list[Version] = []\n\n    def hook_true(*, version: Version, variant: Variant) -> bool:\n        calls.append(version)\n        return True\n\n    with patch(\"fromager.overrides.find_override_method\", return_value=hook_true):\n        assert pbi.is_pre_built() is False\n        assert pbi.pre_built is False\n        assert calls == []\n        # non-None hook result wins over YAML (2.8.0 is source in YAML)\n        assert pbi.is_pre_built(Version(\"2.8.0+cpu\")) is True\n        assert calls == [Version(\"2.8.0\")]\n\n    def hook_none(*, version: Version, variant: Variant) -> None:\n        return None\n\n    with patch(\"fromager.overrides.find_override_method\", return_value=hook_none):\n        # None defers to YAML\n        assert pbi.is_pre_built(Version(\"2.9.0\")) is True\n        assert pbi.is_pre_built(Version(\"2.8.0\")) is False\n\n\n@pytest.mark.parametrize(\"data\", [{\"versions\": None}, {\"versions\": {}}, {}])\ndef test_variant_versions_none_is_empty(data: dict[str, typing.Any]) -> None:\n    assert VariantInfo.model_validate(data).versions == {}\n\n\n'''+s[b:]\nopen(p,'w').write(s)\nEOF\ngrep -n \"^class.*Variant\" src/fromager/packagesettings/_models.py; sed -n 12,27p tests/test_packagesettings.py"}}}
