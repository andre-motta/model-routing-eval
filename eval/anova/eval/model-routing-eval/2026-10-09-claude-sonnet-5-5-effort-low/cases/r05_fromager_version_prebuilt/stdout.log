e=req_type,\n            )\n        except ExceptionGroup:\n            return None\n        return str(url)\n\n    provider = sources.get_source_provider(\n        ctx=ctx,\n        req=pinned_req,\n        sdist_server_url=resolver.PYPI_SERVER_URL,\n        req_type=req_type,\n    )\n    results = resolver.find_all_matching_from_provider(provider, pinned_req)\n    if not results:\n        return None\n    return str(results[0][0])\n''')\nold_start=s.index('        # Add to graph (skip')\nold_end=s.index('        wi.build_sdist_only =')\ns=s[:old_start]+'''        # The version is known now, so version-specific pre_built and\n        # wheel_server_url settings can differ from what Resolve used.\n        pbi = bt.ctx.package_build_info(wi.req)\n        wi.pbi_pre_built = pbi.is_pre_built(wi.resolved_version)\n        if wi.pbi_pre_built != pbi.pre_built or (\n            wi.pbi_pre_built\n            and pbi.get_wheel_server_url(wi.resolved_version) != pbi.wheel_server_url\n        ):\n            logger.info(\n                f\"re-resolving {wi.req} {wi.resolved_version} \"\n                f\"(pre_built={wi.pbi_pre_built}) for version-specific settings\"\n            )\n            new_url = _re_resolve_url(\n                bt.ctx,\n                wi.req,\n                wi.req_type,\n                wi.resolved_version,\n                wi.pbi_pre_built,\n                bt.cache_wheel_server_url,\n            )\n            if new_url is None:\n                logger.warning(\n                    f\"could not re-resolve {wi.req} {wi.resolved_version}, \"\n                    f\"keeping {wi.source_url}\"\n                )\n            else:\n                wi.source_url = new_url\n\n        # Add to graph (skip TOP_LEVEL, already added in _resolve_and_add_top_level)\n        if wi.req_type != RequirementType.TOP_LEVEL:\n            bt.add_to_graph(\n                wi.req,\n                wi.req_type,\n                wi.resolved_version,\n                wi.source_url,\n                wi.parent,\n            )\n\n'''+s[old_end:]\ns=s.replace('''        # Must set pbi_pre_built before constructing PrepareSource so that\n        # PrepareSource.background_work() immediately sees the correct value.\n        pbi = bt.ctx.package_build_info(wi.req)\n        wi.pbi_pre_built = pbi.is_pre_built(wi.resolved_version)\n''','''        # pbi_pre_built was set above, before constructing PrepareSource, so\n        # PrepareSource.background_work() immediately sees the correct value.\n''')\nopen(p,'w').write(s)\n\np='docs/concepts/package-settings.rst'\ns=open(p).read()\ns=s.replace('''See :doc:`/reference/config-reference` for the full field reference.''','''Version-specific ``pre_built`` and ``wheel_server_url`` overrides under\n``variants.<variant>.versions.<version>`` take precedence over the variant\ndefaults.  Local version segments are ignored (``2.8.0+cpu`` matches the\nkey ``2.8.0``).  The ``is_pre_built`` override hook, if defined, is\nconsulted first when a version is given.  The bootstrapper re-resolves the\ndownload URL once the version is known when these settings differ from the\nvariant defaults.\n\n.. versionadded:: 0.95.0\n   Local version segments are stripped for version-specific lookups.\n\nSee :doc:`/reference/config-reference` for the full field reference.''',1)\nopen(p,'w').write(s)\n\np='docs/concepts/hooks-and-overrides.rst'\ns=open(p).read()\ns=s.replace('''See :doc:`/reference/hooks` for the complete list of hooks and their\narguments.\n\nGlobal Hooks''','''See :doc:`/reference/hooks` for the complete list of hooks and their\narguments.\n\nThe ``is_pre_built`` override is called with ``version`` and ``variant``\nonly for version-specific lookups.  Returning ``None`` defers to the\nversion-specific and variant settings in the YAML file; any other value\nwins.  Local version segments are stripped from ``version``.  The\nbootstrapper re-resolves the download URL when the result differs from the\nvariant 