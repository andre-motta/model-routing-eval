m .. import overrides, threading_utils\n17:from ._models import (\n24:from ._templates import _resolve_template, substitute_template\n25:from ._typedefs import Annotations, PackageVersion, PatchMap, Template, Variant\n34:def get_available_memory_gib() -> float:\n45:    def __init__(self, settings: Settings, ps: PackageSettings) -> None:\n56:    def package(self) -> NormalizedName:\n61:    def variant(self) -> Variant:\n66:    def purl_config(self) -> PurlConfig | None:\n71:    def annotations(self) -> Annotations:\n96:    def plugin(self) -> types.ModuleType | None:\n107:    def get_all_patches(self) -> PatchMap:\n112:            version: Version | None\n128:                    version = Version(patchdir.name[prefix_len:])\n137:    def get_patches(self, version: Version) -> list[pathlib.Path]:\n140:        version = Version(version.public)\n152:    def has_config(self) -> bool:\n157:    def has_customizations(self) -> bool:\n164:    def pre_built(self) -> bool:\n168:            return vi.pre_built\n171:    def is_pre_built(self, version: Version | None = None) -> bool:\n172:        \"\"\"Version-aware pre-built check.\n176:        1. Plugin hook ``is_pre_built`` (if version given and hook exists)\n177:        2. Version-specific YAML setting\n180:        .. versionadded:: 0.90.0\n186:            hook_fn = overrides.find_override_method(self.package, \"is_pre_built\")\n193:            pv = typing.cast(PackageVersion, version)\n195:            if vs is not None and vs.pre_built is not None:\n196:                return vs.pre_built\n197:        return vi.pre_built\n200:    def wheel_server_url(self) -> str | None:\n203:        if vi is not None and vi.wheel_server_url is not None:\n204:            return str(vi.wheel_server_url)\n207:    def get_wheel_server_url(self, version: Version | None = None) -> str | None:\n208:        \"\"\"Version-aware wheel server URL.\n213:        .. versionadded:: 0.90.0\n219:            pv = typing.cast(PackageVersion, version)\n221:            if vs is not None and vs.wheel_server_url is not None:\n222:                return str(vs.wheel_server_url)\n223:        return str(vi.wheel_server_url) if vi.wheel_server_url is not None else None\n226:    def override_module_name(self) -> str:\n230:    def download_source_url(\n232:        version: Version | str | None = None,\n239:            version = Version(version)\n250:    def download_source_destination_filename(\n252:        version: Version | str | None = None,\n259:            version = Version(version)\n270:    def resolver_sdist_server_url(self, default: str) -> str:\n278:    def resolver_include_wheels(self) -> bool:\n283:    def resolver_include_sdists(self) -> bool:\n288:    def resolver_ignore_platform(self) -> bool:\n293:    def resolver_min_release_age(self) -> int | None:\n303:    def use_pypi_org_metadata(self) -> bool:\n317:    def build_dir(self, sdist_root_dir: pathlib.Path) -> pathlib.Path:\n326:    def get_changelog(self, version: Version) -> list[str]:\n329:        version = Version(version.public)\n330:        pv = typing.cast(PackageVersion, version)\n335:    def build_tag(self, version: Version) -> BuildTag:\n344:        if self.is_pre_built(version):\n346:        pv = typing.cast(PackageVersion, version)\n354:    def get_extra_environ(\n359:        version: Version | None = None,\n414:    def parallel_jobs(self) -> int:\n444:    def build_ext_parallel(self) -> bool:\n449:    def config_settings(self) -> dict[str, str | list[str]]:\n453:    def git_options(self) -> GitOptions:\n458:    def project_override(self) -> ProjectOverride:\n462:    def exclusive_build(self) -> bool:\n466:    def variants(self) -> Mapping[Variant, VariantInfo]:\n470:    def serialize(self, **kwargs: typing.Any) -> dict[str, typing.Any]:\n458:    specific package versions.  When a field is ``None``, the\n465:      versions:\n490:      versions:\n514:    versions: Mapping[PackageVersion, VersionSpecificSettings] = Field(\n529:    @pydantic.field_validator(\"versions\", mode=\"before\")\n531:    def before_none_versions(\n536:        \"\"\"Coerce ``None`` to empty dict for bare ``versions:`` YAML key.\"\"\"\nfrom __future__ import annotations\n\nimport logging\nimport typing\n\nfrom ..requirements_file import RequirementType\nfrom ._phase import Phase\nfrom ._prepare_source import PrepareSource\nfrom ._types import BootstrapPhase\n\nif typing.TYPE_CHECKING:\n    from ._bootstrapper import Bootstrapper\n\nlogger = logging.getLogger(__name__)\n\n\nclass Start(Phase):\n    \"\"\"Record a resolved requirement in the dependency graph and deduplicate.\n\n    Adds the ``(parent → req)`` edge to the dependency graph, then checks\n    whether this ``(req, version)`` pair has already been processed.  Duplicate\n    requirements are silently dropped; new ones proceed to source preparation.\n    ``tracks_why`` is ``False`` so graph additions happen before the why-stack\n    is updated.\n\n    Next phase: ``PrepareSource`` (new requirement) or ``[]`` (already seen).\n    \"\"\"\n\n    phase: typing.ClassVar[BootstrapPhase] = BootstrapPhase.START\n    tracks_why: typing.ClassVar[bool] = False\n\n    def run(self, bt: Bootstrapper) -> list[Phase]:\n        \"\"\"START phase: add to graph, check if already seen.\n\n        _track_why is a no-op for this phase (tracks_why is False),\n        matching the original behavior where graph addition and\n        seen-check happen before pushing onto the why stack.\n\n        Returns:\n            Empty list if already seen (nothing to do).\n            [PrepareSource] if this is new work.\n        \"\"\"\n        wi = self.work_item\n        assert wi.resolved_version is not None\n        assert wi.source_url is not None\n\n        # Add to graph (skip TOP_LEVEL, already added in _resolve_and_add_top_level)\n        if wi.req_type != RequirementType.TOP_LEVEL:\n            bt.add_to_graph(\n                wi.req,\n                wi.req_type,\n                wi.resolved_version,\n        