e_prebuilt_wheel\",\n                return_value=(\"https://wheels.test/pkg-1.0.whl\", Version(\"1.0\")),\n            ) as resolve,\n        ):\n            url = _re_resolve_url(\n                tmp_context,\n                Requirement(\"testpkg\"),\n                RequirementType.INSTALL,\n                Version(\"1.0\"),\n                True,\n                None,\n            )\n        assert url == \"https://wheels.test/pkg-1.0.whl\"\n        assert get_urls.call_args.kwargs[\"version\"] == Version(\"1.0\")\n        assert str(resolve.call_args.kwargs[\"req\"]) == \"testpkg==1.0\"\n\n    def test_prebuilt_returns_none_on_exception_group(\n        self, tmp_context: WorkContext\n    ) -> None:\n        with (\n            patch(\"fromager.wheels.get_wheel_server_urls\", return_value=[\"u\"]),\n            patch(\n                \"fromager.wheels.resolve_prebuilt_wheel\",\n                side_effect=ExceptionGroup(\"x\", [ValueError(\"no\")]),\n            ),\n        ):\n            url = _re_resolve_url(\n                tmp_context,\n                Requirement(\"testpkg\"),\n                RequirementType.INSTALL,\n                Version(\"1.0\"),\n                True,\n                None,\n            )\n        assert url is None\n\n    def test_source_returns_first_match_or_none(\n        self, tmp_context: WorkContext\n    ) -> None:\n        with (\n            patch(\"fromager.sources.get_source_provider\"),\n            patch(\n                \"fromager.resolver.find_all_matching_from_provider\",\n                return_value=[(\"https://pypi.test/testpkg-1.0.tar.gz\", Version(\"1.0\"))],\n            ),\n        ):\n            args = (\n                tmp_context,\n                Requirement(\"testpkg\"),\n                RequirementType.INSTALL,\n                Version(\"1.0\"),\n                False,\n                None,\n            )\n            assert _re_resolve_url(*args) == \"https://pypi.test/testpkg-1.0.tar.gz\"\n        with (\n            patch(\"fromager.sources.get_source_provider\"),\n            patch(\n                \"fromager.resolver.find_all_matching_from_provider\", return_value=[]\n            ),\n        ):\n            assert _re_resolve_url(*args) is None\n\n\nclass TestPhaseStartReResolve:\n    def _pbi(self, pre_built: bool, ws_url: str | None = None) -> Mock:\n        pbi = Mock()\n        pbi.pre_built = False\n        pbi.wheel_server_url = None\n        pbi.is_pre_built.return_value = pre_built\n        pbi.get_wheel_server_url.return_value = ws_url\n        pbi.exclusive_build = False\n        return pbi\n\n    def test_re_resolves_before_graph_and_seen_check(\n        self, tmp_context: WorkContext\n    ) -> None:\n        bt = bootstrapper.Bootstrapper(tmp_context)\n        bt.why = []\n        item = _make_start_item(req_type=RequirementType.INSTALL)\n        with (\n            patch.object(\n                WorkContext, \"package_build_info\", return_value=self._pbi(True)\n            ),\n            patch(\n                \"fromager.bootstrapper._start._re_resolve_url\",\n                return_value=\"https://wheels.test/testpkg-1.0.whl\",\n            ) as re_resolve,\n        ):\n            item.run(bt)\n            # second parent of an already-seen package still gets re-resolved\n            item2 = _make_start_item(req_type=RequirementType.INSTALL)\n            assert item2.run(bt) == []\n        assert re_resolve.call_count == 2\n        assert item.work_item.source_url == \"https://wheels.test/testpkg-1.0.whl\"\n        node = tmp_context.dependency_graph.nodes[\n            f\"{canonicalize_name('testpkg')}==1.0\"\n        ]\n        assert node.download_url == \"https://wheels.test/testpkg-1.0.whl\"\n\n    def test_keeps_url_and_warns_when_not_resolved(\n        self, tmp_context: WorkContext, caplog: pytest.LogCaptureFixture\n    ) -> None:\n        bt = bootstrapper.Bootstrapper(tmp_context)\n        bt.why = []\n        item = _make_start_item()\n        with (\n            caplog.at_level(logging.WARNING),\n            patch.object(\n                WorkContext, \"package_build_info\", return_value=self._pbi(True)\n            ),\n            patch(\"fromager.bootstrapper._start._re_resolve_url\", return_value=None),\n        ):\n            item.run(bt)\n        assert item.work_item.source_url == \"https://pypi.org/testpkg-1.0.tar.gz\"\n        assert any(r.levelno == logging.WARNING for r in caplog.records)\n\n    def test_re_resolves_on_version_specific_wheel_server(\n        self, tmp_context: WorkContext\n    ) -> None:\n        bt = bootstrapper.Bootstrapper(tmp_context)\n        bt.why = []\n        item = _make_start_item()\n        pbi = self._pbi(True, \"https://mirror.test/simple\")\n        pbi.pre_built = True\n        pbi.wheel_server_url = \"https://wheel.test/simple\"\n        with (\n            patch.object(WorkContext, \"package_build_info\", return_value=pbi),\n            patch(\n                \"fromager.bootstrapper._start._re_resolve_url\", return_value=\"u\"\n            ) as re_resolve,\n        ):\n            item.run(bt)\n        re_resolve.assert_called_once()\n\n    def test_no_re_resolve_when_settings_match(self, tmp_context: WorkContext) -> None:\n        bt = bootstrapper.Bootstrapper(tmp_context)\n        bt.why = []\n        item = _make_start_item()\n        with (\n            patch.object(\n                WorkContext, \"package_build_info\", return_value=self._pbi(False)\n            ),\n            patch(\"fromager.bootstrapper._start._re_resolve_url\") as re_resolve,\n        ):\n            item.run(bt)\n        re_resolve.assert_not_called()\n\n\nclass TestPhaseStart:\n''',1)\ns=s.replace('class TestReReResolveUrl','class TestReResolveUrl')\ns=s.replace('from fromager.bootstrapper._start import Start','from fromager.bootstrapper._start import Start, _re_resolve_url')\nopen(p,'w').write(s)\nEOF\nsed -i 's/    if versions is not None or True:\\n//' t