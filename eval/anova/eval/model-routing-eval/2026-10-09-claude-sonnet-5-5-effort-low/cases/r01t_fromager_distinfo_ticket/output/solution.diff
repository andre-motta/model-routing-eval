+def _matches_dist_info(dirname: str, name: NormalizedName, version: Version) -> bool:
+    """Check if a ``{name}-{version}.dist-info`` directory is for name and version."""
+    stem = dirname.removesuffix(".dist-info")
+    dist_name, _, dist_version = stem.rpartition("-")
+    try:
+        return canonicalize_name(dist_name) == name and Version(dist_version) == version
+    except InvalidVersion:
+        return False
+
