-                return Metadata.from_email(metadata_content, validate=validate)
+        # Only consider root-level dist-info directories. Wheels may bundle
+        # dist-info directories of vendored packages in subdirectories.
+        names = [
+            n
+            for n in z.namelist()
+            if n.endswith(".dist-info/METADATA") and n.count("/") == 1
+        ]
+        if len(names) > 1:
+            wheel_name, wheel_version, _, _ = parse_wheel_filename(
+                urlparse(url).path.rsplit("/", 1)[-1]
+            )
+            names = [
+                n
+                for n in names
+                if _matches_dist_info(n.split("/", 1)[0], wheel_name, wheel_version)
+            ]
+        if names:
+            # Parse metadata directly using packaging.metadata.Metadata
+            # (avoiding circular import with dependencies module)
+            return Metadata.from_email(z.read(names[0]), validate=validate)
 
     # If we didn't find the metadata, raise an error
     raise ValueError(f"Could not find METADATA file in wheel: {url}")
