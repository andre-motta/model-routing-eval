+def test_total_matches_sum_of_printed_lines_with_discounts():
+    # Each line rounds to 0.03 on the PDF (0.025 half-up), so the total must be 0.06,
+    # not the 0.05 that rounding only once on the summed discount would give.
+    inv = build_invoice("A4", [
+        ("x", "0.05", 1, percent_off("HALF", "50")),
+        ("y", "0.05", 1, percent_off("HALF", "50")),
+    ])
+    assert line_totals(inv) == [Decimal("0.03"), Decimal("0.03")]
+    assert invoice_total(inv) == sum(line_totals(inv)) == Decimal("0.06")
+
+
+def test_total_matches_sum_of_printed_lines_with_discounts_and_tax():
+    inv = build_invoice("A5", [
+        ("x", "0.05", 1, percent_off("HALF", "50")),
+        ("y", "0.05", 1, percent_off("HALF", "50")),
+    ], TaxRule("DE", Decimal("0.19")))
+    net = sum(line_totals(inv), Decimal("0"))
+    assert invoice_total(inv) == net + (net * Decimal("0.19")).quantize(Decimal("0.01"))
