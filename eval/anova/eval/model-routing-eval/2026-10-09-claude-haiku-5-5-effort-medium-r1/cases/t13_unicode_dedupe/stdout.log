set(), []","+    \"\"\"records: list of dicts with 'name' and 'email'. Returns survivors in first-seen order.","+","+    A record is dropped if its name or email key matches any earlier record,","+    including records that were themselves dropped. Matching is therefore","+    transitive, so each record's keys are added to the seen set either way.","+    \"\"\"","+    seen, out = set(), []","     for r in records:","-        nk, ek = name_key(r[\"name\"]), email_key(r[\"email\"])","-        if nk in seen_names or ek in seen_emails:","-            continue","-        seen_names.add(nk)","-        seen_emails.add(ek)","-        out.append(r)","+        keys = {(\"name\", name_key(r[\"name\"])), (\"email\", email_key(r[\"email\"]))}","+        if not keys & seen:","+            out.append(r)","+        seen |= keys","     return out"]}],"originalFile":"import re\n\n_WS = re.compile(r\"\\s+\")\n\n\ndef email_key(email):\n    return email.strip().lower()\n\n\ndef name_key(name):\n    \"\"\"Key for matching names: lower-case, single spaces, no accents.\"\"\"\n    s = _WS.sub(\" \", name.strip()).lower()\n    # strip common accents\n    for a, b in ((\"é\", \"e\"), (\"è\", \"e\"), (\"á\", \"a\"), (\"ó\", \"o\"), (\"ü\", \"u\"), (\"ö\", \"o\"), (\"ä\", \"a\"), (\"ñ\", \"n\")):\n        s = s.replace(a, b)\n    return s\n\n\ndef dedupe(records):\n    \"\"\"records: list of dicts with 'name' and 'email'. Returns survivors in first-seen order.\"\"\"\n    seen_names, seen_emails, out = set(), set(), []\n    for r in records:\n        nk, ek = name_key(r[\"name\"]), email_key(r[\"email\"])\n        if nk in seen_names or ek in seen_emails:\n            continue\n        seen_names.add(nk)\n        seen_emails.add(ek)\n        out.append(r)\n    return out\n","userModified":false},"tool_result_meta":[{"id":"toolu_018RffUxWtWKDUTADfLd2wwY","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
