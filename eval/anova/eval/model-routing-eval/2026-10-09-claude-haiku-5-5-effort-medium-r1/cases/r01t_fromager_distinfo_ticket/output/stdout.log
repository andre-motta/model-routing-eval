   \"vendored_pkg-9.9.dist-info/METADATA\",\n                \"Metadata-Version: 2.1\\nName: vendored-pkg\\nVersion: 9.9\\n\",\n            )\n        mock_session.get.return_value = Mock(content=buf.getvalue())\n        wheel_url = \"https://pkg.test/test_package-1.0.0-py3-none-any.whl\"\n\n        # Act / Assert\n        with pytest.raises(ValueError, match=\"Could not find METADATA\"):\n            get_metadata_for_wheel(wheel_url)\n\n    def test_candidate_repr_with_metadata_url(self) -> None:"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2509,"cache_read_input_tokens":50038,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2509},"output_tokens":8,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"fe8fab40-faa6-4884-aeca-443de8cf10f5","uuid":"7d4a0b20-c65f-42a6-9722-faa35327f6dc","timestamp":"2026-10-09T17:13:10.046Z","request_id":"req_011Cfs38UAPBNUHzp9AWoz2n","wire_tool_inputs":{"toolu_01QqpdTQGiSuVkCdkuFNpqYk":{"file_path":"/home/alustosa/git/model-routing-eval/.work/agent-eval/2026-10-09-claude-haiku-5-5-effort-medium-r1/cases/r01t_fromager_distinfo_ticket/tests/test_pep658_support.py","old_string":"    def test_candidate_repr_with_metadata_url(self) -> None:","new_string":"    @patch(\"fromager.candidate.session\")\n    def test_get_metadata_ignores_vendored_dist_info(\n        self, mock_session: typing.Any\n    ) -> None:\n        \"\"\"Test that the wheel's own METADATA is used, not a vendored package's.\"\"\"\n        # Arrange: the vendored dist-info comes first in the archive\n        buf = BytesIO()\n        with ZipFile(buf, \"w\") as z:\n            z.writestr(\n                \"vendored_pkg-9.9.dist-info/METADATA\",\n                \"Metadata-Version: 2.1\\nName: vendored-pkg\\nVersion: 9.9\\