+    @patch("fromager.candidate.session")
+    def test_get_metadata_ignores_vendored_dist_info(
+        self, mock_session: typing.Any
+    ) -> None:
+        """Test that the wheel's own METADATA is used, not a vendored package's."""
+        # Arrange: the vendored dist-info comes first in the archive
+        buf = BytesIO()
+        with ZipFile(buf, "w") as z:
+            z.writestr(
+                "vendored_pkg-9.9.dist-info/METADATA",
+                "Metadata-Version: 2.1\nName: vendored-pkg\nVersion: 9.9\n",
+            )
+            z.writestr(
+                "test_package-1.0.0.dist-info/METADATA",
+                "Metadata-Version: 2.1\nName: test-package\nVersion: 1.0.0\n",
+            )
+        mock_session.get.return_value = Mock(content=buf.getvalue())
+        wheel_url = "https://pkg.test/test_package-1.0.0-py3-none-any.whl"
+
+        # Act
+        metadata = get_metadata_for_wheel(wheel_url)
+
+        # Assert
+        assert metadata.name == "test-package"
+        assert str(metadata.version) == "1.0.0"
+
