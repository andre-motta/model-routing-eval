+def test_max_release_age_skips_constrained_package(
+    caplog: pytest.LogCaptureFixture,
+) -> None:
+    """A constrained package is exempt from max-release-age filtering."""
+    # The constraint pins the only matching version to 1.2.2, which is
+    # older than the 5-day window and would be filtered out otherwise.
+    max_age_cutoff = _BOOTSTRAP_TIME - datetime.timedelta(days=5)
+    constraint_set = constraints.Constraints()
+    constraint_set.add_constraint("test-pkg==1.2.2")
+    with requests_mock.Mocker() as r:
+        r.get(
+            "https://pypi.org/simple/test-pkg/",
+            json=_cooldown_json_response,
+            headers={"Content-Type": _PYPI_SIMPLE_JSON_CONTENT_TYPE},
+        )
+        provider = resolver.PyPIProvider(
+            include_sdists=True, constraints=constraint_set
+        )
+        with caplog.at_level(logging.INFO, logger="fromager.resolver"):
+            results = resolver.find_all_matching_from_provider(
+                provider, Requirement("test-pkg"), max_age_cutoff=max_age_cutoff
+            )
+
+    versions = [str(v) for _, v in results]
+    assert versions == ["1.2.2"]
+    assert (
+        "test-pkg: skipping age filter for constrained package (1 candidate(s))"
+        in caplog.text
+    )
+    assert "keeping all to avoid empty resolution" not in caplog.text
+
+
+def test_max_release_age_filters_unconstrained_package(
+    caplog: pytest.LogCaptureFixture,
+) -> None:
+    """An unconstrained package is still filtered by max-release-age."""
+    max_age_cutoff = _BOOTSTRAP_TIME - datetime.timedelta(days=5)
+    with requests_mock.Mocker() as r:
+        r.get(
+            "https://pypi.org/simple/test-pkg/",
+            json=_cooldown_json_response,
+            headers={"Content-Type": _PYPI_SIMPLE_JSON_CONTENT_TYPE},
+        )
+        provider = resolver.PyPIProvider(include_sdists=True)
+        with caplog.at_level(logging.INFO, logger="fromager.resolver"):
+            results = resolver.find_all_matching_from_provider(
+                provider, Requirement("test-pkg"), max_age_cutoff=max_age_cutoff
+            )
+
+    versions = [str(v) for _, v in results]
+    assert versions == ["2.0.0"]
+    assert "skipping age filter for constrained package" not in caplog.text
+    assert "have 1 candidate(s)" in caplog.text
+
+
