_cutoff = _compute_max_age_cutoff(ctx)\n109:    results = find_all_matching_from_provider(\n110:        provider, req, max_age_cutoff=max_age_cutoff\n130:    \"\"\"Lookup resolver provider to resolve package versions\"\"\"\n135:        constraints=ctx.constraints,\n151:def resolve_package_cooldown(\n156:    \"\"\"Compute the effective cooldown for a single package.\n159:        ctx: The current work context (provides the global cooldown).\n160:        req: The package requirement being resolved.\n164:        The cooldown to pass to the provider, or ``None`` if disabled.\n167:        if ctx.cooldown is not None:\n168:            logger.info(\"cooldown bypassed as the top-level requirement uses == pin\")\n171:    per_package_days = ctx.package_build_info(req).resolver_min_release_age\n172:    global_cooldown = ctx.cooldown\n173:    if per_package_days is None:\n174:        return global_cooldown\n175:    if per_package_days == 0:\n177:    # Per-package positive override: inherit bootstrap_time from global so all\n180:        global_cooldown.bootstrap_time\n181:        if global_cooldown is not None\n185:        min_age=datetime.timedelta(days=per_package_days),\n190:def _compute_max_age_cutoff(\n193:    \"\"\"Compute the cutoff time for max release age filtering.\n196:    Uses the cooldown's bootstrap_time for consistency across a single run.\n198:    if ctx.max_release_age is None:\n201:        ctx.cooldown.bootstrap_time\n202:        if ctx.cooldown is not None\n205:    return bootstrap_time - ctx.max_release_age\n236:def find_all_matching_from_provider(\n239:    max_age_cutoff: datetime.datetime | None = None,\n240:    fallback_on_empty_age_filter: bool = True,\n250:        max_age_cutoff: If set, reject candidates published before this time.\n253:        fallback_on_empty_age_filter: If ``True`` (default), keep all\n254:            candidates when age filtering would produce an empty result.\n283:        constraint = provider.constraints.get_constraint(req.name)\n287:            f\"Unable to resolve requirement specifier {req} with constraint {constraint} using {provider_desc}: {original_msg}\"\n293:    if max_age_cutoff is not None:\n300:        max_age_days = (datetime.datetime.now(datetime.UTC) - max_age_cutoff).days\n304:            if c.upload_time is None or c.upload_time >= max_age_cutoff\n313:                max_age_days,\n317:        elif fallback_on_empty_age_filter:\n324:                max_age_days,\n332:                max_age_days,\n350:    \"\"\"Fetch and filter package candidates from a PyPI-compatible server.\n352:    Filters the project's package list by: project status, filename\n353:    validity, package type (sdist/wheel), yanked status, Python version\n367:        package = client.get_project_page(project)\n374:            \"failed to fetch package index from %s: %s\",\n380:    # PEP 792 package status\n381:    match package.status:\n383:            logger.debug(\"no package status\")\n385:            logger.debug(\"project %r is active: %s\", project, package.status_reason)\n390:                package.status,\n391:                package.status_reason,\n395:                f\"project {project!r} is quarantined: {package.status_reason}\"\n401:                package.status,\n402:                package.status_reason,\n405:    for dp in package.packages:\n413:            or dp.package_type is None\n434:        if dp.package_type not in {\"sdist\", \"wheel\"}:\n439:                    dp.package_type,\n484:            if dp.package_type == \"sdist\":\n562:    _cooldown_unsupported_warned: typing.ClassVar[set[str]] = set()\n567:        constraints: Constraints | None = None,\n570:        cooldown: Cooldown | None = None,\n573:        self.constraints = constraints or Constraints()\n577:        # cooldown specific settings\n578:        self.cooldown = cooldown\n582:        # When a cooldown is active and this is False, the cooldown check is\n598:        This is used in error messages to indicate what resolver was being used.\n675:        allow_prerelease = self.constraints.allow_prerelease(requirement.name) or bool(\n687:        if not self.constraints.is_satisfied_by(requirement.name, candidate.version):\n689:                c = self.constraints.get_constraint(requirement.name)\n691:                    f\"{requirement.name}: skipping {candidate.version} due to constraint {c}\"\n697:    def is_blocked_by_cooldown(self, candidate: Candidate) -> bool:\n698:        \"\"\"Return True if the candidate is rejected by the release-age cooldown.\"\"\"\n700:        # a cooldown is not specified...\n701:        if self.cooldown is None:\n708:                # Warn once per package name across all provider instances.\n709:                if candidate.name not in BaseProvider._cooldown_unsupported_warned:\n710:                    BaseProvider._cooldown_unsupported_warned.add(candidate.name)\n712:                        \"release-age cooldown cannot be enforced — upload \"\n714:                        \"cooldown check skipped\",\n720:            # Fail closed: we cannot verify the age of this candidate, so reject it.\n723:                    \"skipping %s — upload_time unknown, required for cooldown\",\n728:        # cooldowns are enabled, and this candidate has a valid upload timestamp\n731:        cutoff = self.cooldown.bootstrap_time - self.cooldown.min_age\n735:                age = self.cooldown.bootstrap_time - candidate.upload_time\n737:                    \"skipping %s uploaded %s ago (cooldown: %s)\",\n739:                    age,\n740:                    self.cooldown.min_age,\n790:    def _get_no_match_error_message(\n793:        \"\"\"Generate an error message when no candidates are found.\n818:        # Apply cooldown filtering after specifier/constraint validation\n819:        blocked = [c for c in candidates if self.is_blocked_by_cooldown(c)]\n825:                \"cooldown blocked %d version(s): %s\",\n831:                self._get_no_match_error_message(identifier