@@ -0,0 +1,11 @@
+"""Built-in export formats.
+
+Every module in this package is imported on load, so any Exporter decorated
+with ``@register`` is available without editing the registry or core.
+"""
+
+import importlib
+import pkgutil
+
+for _module in pkgutil.iter_modules(__path__):
+    importlib.import_module(f"{__name__}.{_module.name}")
diff --git a/export/formats/csv_format.py b/export/formats/csv_format.py
new file mode 100644
index 0000000..e89c35a
--- /dev/null
+++ b/export/formats/csv_format.py
@@ -0,0 +1,19 @@
+import csv
+import io
+
+from ..base import Exporter
+from ..registry import register
+
+
+@register
+class CsvExporter(Exporter):
+    name = "csv"
+    extension = ".csv"
+
+    def dump(self, records):
+        buf = io.StringIO()
+        if records:
+            w = csv.DictWriter(buf, fieldnames=list(records[0].keys()), lineterminator="\n")
+            w.writeheader()
+            w.writerows(records)
+        return buf.getvalue().encode()
