{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011Cfs3eBWMcBgyUFB6Ha7Fy","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01MGP4HejbqUJ5wN8B3Srm4K","name":"Read","input":{"file_path":"/home/alustosa/git/model-routing-eval/.work/agent-eval/2026-10-09-claude-haiku-5-5-effort-medium-r1/cases/r04_fromager_age_fallback/src/fromager/resolver.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7678,"cache_read_input_tokens":26347,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":7678},"output_tokens":2,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"8e69fa9a-75ee-4abb-882a-eba058cff68b","uuid":"fc087cbb-e326-4d75-8893-7cd39ba71796","timestamp":"2026-10-09T17:19:47.123Z","request_id":"req_011Cfs3eAoSL6wvPod5j3c8Q","wire_tool_inputs":{"toolu_01MGP4HejbqUJ5wN8B3Srm4K":{"file_path":"/home/alustosa/git/model-routing-eval/.work/agent-eval/2026-10-09-claude-haiku-5-5-effort-medium-r1/cases/r04_fromager_age_fallback/src/fromager/resolver.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MGP4HejbqUJ5wN8B3Srm4K","type":"tool_result","content":"1\t# Based on https://github.com/sarugaku/resolvelib/blob/main/examples/pypi_wheel_provider.py\n2\t#\n3\t# Modified to look at sdists instead of wheels and to avoid trying to\n4\t# resolve any dependencies.\n5\t#\n6\tfrom __future__ import annotations\n7\t\n8\timport datetime\n9\timport functools\n10\timport logging\n11\timport os\n12\timport re\n13\timport typing\n14\tfrom collections.abc import Iterable\n15\tfrom operator import attrgetter\n16\tfrom platform import python_version\n17\tfrom urllib.parse import quote, urlparse\n18\t\n19\timport pypi_simple\n20\timport resolvelib\n21\tfrom packaging.requirements import Requirement\n22\tfrom packaging.specifiers import InvalidSpecifier, SpecifierSet\n23\tfrom packaging.tags import Tag, sys_tags\n24\tfrom packaging.utils import (\n25\t    BuildTag,\n26\t    canonicalize_name,\n27\t    parse_wheel_filename,\n28\t)\n29\tfrom packaging.version import Version\n30\tfrom requests.models import Response\n31\tfrom resolvelib.resolvers import RequirementInformation\n32\t\n33\tfrom . import overrides\n34\tfrom .candidate import Candidate, Cooldown\n35\tfrom .constraints import Constraints\n36\tfrom .downloads import extract_filename_from_url as extract_filename_from_url\n37\tfrom .extras_provider import ExtrasProvider\n38\tfrom .http_retry import RETRYABLE_EXCEPTIONS, retry_on_exception\n39\tfrom .request_session import session\n40\tfrom .requirements_file import RequirementType\n41\tfrom .versionmap import VersionMap\n42\t\n43\tif typing.TYPE_CHECKING:\n44\t    from . import context\n45\t\n46\t\n47\tlogger = logging.getLogger(__name__)\n48\t\n49\tPYTHON_VERSION = Version(python_version())\n50\tDEBUG_RESOLVER = os.environ.get(\"DEBUG_RESOLVER\", \"\")\n51\tPYPI_SERVER_URL = \"https://pypi.org/simple\"\n52\tGITHUB_URL = \"https://github.com\"\n53\t\n54\t# all supported tags\n55\tSUPPORTED_TAGS: frozenset[Tag] = frozenset(sys_tags())\n56\t# same, but ignore the platform for 'ignore_platform' flag\n57\tIGNORE_PLATFORM: str = \"ignore\"\n58\tSUPPORTED_TAGS_IGNORE_PLATFORM: frozenset[Tag] = frozenset(\n59\t    Tag(t.interpreter, t.abi, IGNORE_PLATFORM) for t in SUPPORTED_TAGS\n60\t)\n61\t\n62\t\n63\t@functools.lru_cache(maxsize=200)\n64\tdef match_py_req(py_req: str, *, python_version: Version = PYTHON_VERSION) -> bool:\n65\t    \"\"\"Python version requirement lookup with LRU cache\n66\t\n67\t    Raises InvalidSpecifier on error\n68\t\n69\t    SpecifierSet parsing and matching takes a non-trivial amount of time. A\n70\t    bootstrap run can spend over 10% of its time in parsing and matching\n71\t    Python version requirements.\n72\t\n73\t    This function caches the result of SpecifierSet parsing and contains\n74\t    operation for Python version requirement. Most packages share similar\n75\t    constraints, e.g. ``>= 3.10``.\n76\t    \"\"\"\n77\t    return python_version in SpecifierSet(py_req)\n78\t\n79\t\n80\tdef resolve(\n81\t    *,\n82\t    ctx: context.WorkContext,\n83\t    req: Requirement,\n84\t    sdist_server_url: str,\n85\t    include_sdists: bool = True,\n86\t    include_wheels: bool = True,\n87\t    req_type: RequirementType | None = None,\n88\t    ignore_platform: bool = False,\n89\t) -> tuple[str, Version]:\n90\t    \"\"\"Resolve requirement and return the best matching version.\n91\t\n92\t    Returns (url, version) tuple for the highest matching version.\n93\t    \"\"\"\n94\t    # Create the (reusable) resolver.\n95\t    provider = overrides.find_and_invoke(\n96\t        req.name,\n97\t        \"get_resolver_provider\",\n98\t        default_resolver_provider,\n99\t        ctx=ctx,\n100\t        req=req,\n101\t        include_sdists=include_sdists,\n102\t        include_wheels=include_wheels,\n103\t        sdist_server_url=sdist_server_url,\n104\t        req_type=req_type,\n105\t        ignore_platform=ignore_platform,\n106\t    )\n107\t    provider.cooldown = resolve_package_cooldown(ctx, req, req_type=req_type)\n108\t    max_age_cutoff = _compute_max_age_cutoff(ctx)\n109\t    results = find_all_matching_from_provider(\n110\t        provider, req, max_age_cutoff=max_age_cutoff\n111\t    )\n112\t    return results[0]\n113\t\n114\t\n115\tdef default_resolver_provider(\n116\t    ctx: context.WorkContext,\n117\t    req: Requirement,\n118\t    sdist_server_url: str,\n119\t    include_sdists: bool,\n120\t    include_wheels: bool,\n121\t    req_type: RequirementType | None = None,\n122\t    ignore_platform: bool = False,\n123\t) -> (\n124\t    PyPIProvider\n125\t    | GenericProvider\n126\t    | GitHubTagProvider\n127\t    | GitLabTagProvider\n128\t    | VersionMapProvider\n129\t):\n130\t    \"\"\"Lookup resolver provider to resolve package versions\"\"\"\n131\t    return PyPIProvider(\n132\t        include_sdists=include_sdists,\n133\t        include_wheels=include_wheels,\n134\t        sdist_server_url=sdist_server_url,\n135\t        constraints=ctx.constraints,\n136\t        req_type=req_type,\n137\t        ignore_platform=ignore_platform,\n138\t    )\n139\t\n140\t\n141\tdef _has_equality_pin(req: Requirement) -> bool:\n142\t    \"\"\"Return True if the requirement has a single exact ``==`` pin.\n143\t\n144\t    Rejects wildcard pins (``==1.*``) and compound specifiers (``==1,>2``)\n145\t    which are not true exact version pins.\n146\t    \"\"\"\n147\t    specs = list(req.specifier)\n148\t    return len(specs) == 1 and specs[0].operator == \"==\" and \"*\" not in specs[0].version\n149\t\n150\t\n151\tdef resolve_package_cooldown(\n152\t    ctx: context.WorkContext,\n153\t    req: Requirement,\n154\t    req_type: RequirementType | None = None,\n155\t) -> Cooldown | None:\n156\t    \"\"\"Compute the effective cooldown for a single package.\n157\t\n158\t    Args:\n159\t        ctx: The current work context (provides the global cooldown).\n160\t        req: The package requirement being resolved.\n161\t        req_type: The requirement type (top-level, install, etc.).\n162\t\n163\t    Returns:\n164\t        The cooldown to pass to the provider, or ``None`` if disabled.\n165\t    \"\"\"\n166\t    if req_type == RequirementType.TOP_LEVEL and _has_equality_pin(req):\n167\t        if ctx.cooldown is not None:\n168\t            logger.info(\"cooldown bypassed as the top-level requirement uses == pin\")\n169\t        return None\n170\t\n171\t    per_package_days = ctx.package_build_info(req).resolver_min_release_age\n172\t    global_cooldown = ctx.cooldown\n173\t    if per_package_days is None:\n174\t        return global_cooldown\n175\t    if per_package_days == 0:\n176\t        return None\n177\t    # Per-package positive override: inherit bootstrap_time from global so all\n178\t    # resolutions in a single run share the same fixed cutoff point.\n179\t    bootstrap_time = (\n180\t        global_cooldown.bootstrap_time\n181\t        if global_cooldown is not None\n182\t        else datetime.datetime.now(datetime.UTC)\n183\t    )\n184\t    return Cooldown(\n185\t        min_age=datetime.timedelta(days=per_package_days),\n186\t        bootstrap_time=bootstrap_time,\n187\t    )\n188\t\n189\t\n190\tdef _compute_max_age_cutoff(\n191\t    ctx: context.WorkContext,\n192\t) -> datetime.datetime | None:\n193\t    \"\"\"Compute the cutoff time for max release age filtering.\n194\t\n195\t    Returns the oldest acceptable upload time, or None if disabled.\n196\t    Uses the cooldown's bootstrap_time for consistency across a single run.\n197\t    \"\"\"\n198\t    if ctx.max_release_age is None:\n199\t        return None\n200\t    bootstrap_time = (\n201\t        ctx.cooldown.bootstrap_time\n202\t        if ctx.cooldown is not None\n203\t        else datetime.datetime.now(datetime.UTC)\n204\t    )\n205\t    return bootstrap_time - ctx.max_release_age\n206\t\n207\t\n208\tclass LogReporter(resolvelib.BaseReporter):\n209\t    \"\"\"Report resolution events\n210\t\n211\t    Implements part of the BaseReporter API to log a few events related to\n212\t    resolving requirements.\n213\t\n214\t    \"\"\"\n215\t\n216\t    def __init__(self, req: Requirement):\n217\t        self.req = req\n218\t        super().__init__()\n219\t\n220\t    def _report(self, msg: str, *args: typing.Any) -> None:\n221\t        logger.info(msg, *args)\n222\t\n223\t    def starting(self) -> None:\n224\t        self._report(\"looking for candidates for %r\", self.req)\n225\t\n226\t    def rejecting_candidate(self, criterion: typing.Any, candidate: typing.Any) -> None:\n227\t        self._report(\"resolver rejecting candidate %s: %s\", candidate, criterion)\n228\t\n229\t    def pinning(self, candidate: typing.Any) -> None:\n230\t        self._report(\"selecting %s\", candidate)\n231\t\n232\t    def ending(self, state: typing.Any) -> None:\n233\t        self._report(\"successfully resolved %r\", self.req)\n234\t\n235\t\n236\tdef find_all_matching_from_provider(\n237\t    provider: BaseProvider,\n238\t    req: Requirement,\n239\t    max_age_cutoff: datetime.datetime | None = None,\n240\t    fallback_on_empty_age_filter: bool = True,\n241\t) -> list[tuple[str, Version]]:\n242\t    \"\"\"Find all matching candidates from provider without full dependency resolution.\n243\t\n244\t    This function collects ALL candidates that match the requirement, rather than\n245\t    performing full dependency resolution to find a single best candidate.\n246\t\n247\t    Args:\n248\t        provider: The provider to query for candidates.\n249\t        req: The requirement to match.\n250\t        max_age_cutoff: If set, reject candidates published before this time.\n251\t            If all candidates are older than the cutoff, all are kept and\n252\t            a warning is emitted to avoid empty resolution.\n253\t        fallback_on_empty_age_filter: If ``True`` (default), keep all\n254\t            candidates when age filtering would produce an empty result.\n255\t            If ``False``, return an empty list instead, allowing the\n256\t            caller to implement its own fallback strategy.\n257\t\n258\t    Returns list of (url, version) tuples sorted by version (highest first).\n259\t\n260\t    IMPORTANT: This bypasses resolvelib's full resolver to collect all matching\n261\t    candidates. This is safe ONLY because BaseProvider.get_dependencies() returns\n262\t    an empty list (no transitive dependencies to resolve). The empty incompatibilities\n263\t    dict means no version is ever excluded based on conflicts.\n264\t\n265\t    If get_dependencies() is ever extended to return actual dependencies, this\n266\t    function must be revisited to use resolvelib's full resolution algorithm\n267\t    (Resolver.resolve()) to properly handle dependency conflicts and backtracking.\n268\t    \"\"\"\n269\t    # Get all matching candidates directly from provider\n270\t    # instead of using resolvelib's resolver which picks just one\n271\t    identifier = provider.identify(req)\n272\t    try:\n273\t        # Bypass resolvelib's resolver to collect all matching candidates rather than\n274\t        # just the single best one. This is safe because get_dependencies() returns []\n275\t        # (no transitive deps to resolve). If get_dependencies() is ever extended,\n276\t        # this must be revisited to use resolvelib's full resolution.\n277\t        candidates = provider.find_matches(\n278\t            identifier=identifier,\n279\t            requirements={identifier: [req]},\n280\t            incompatibilities={},  # Empty - safe only because no transitive deps\n281\t        )\n282\t    except resolvelib.resolvers.ResolverException as err:\n283\t        constraint = provider.constraints.get_constraint(req.name)\n284\t        provider_desc = provider.get_provider_description()\n285\t        original_msg = str(err)\n286\t        raise resolvelib.resolvers.ResolverException(\n287\t            f\"Unable to resolve requirement specifier {req} with constraint {constraint} using {provider_desc}: {original_msg}\"\n288\t        ) from err\n289\t\n290\t    # Materialize candidates so we can iterate more than once if filtering\n291\t    candidates_list = list(candidates)\n292\t\n293\t    if max_age_cutoff is not None:\n294\t        logger.info(\n295\t            \"%s: found %d candidate(s) matching %s\",\n296\t            req.name,\n297\t            len(candidates_list),\n298\t            req,\n299\t        )\n300\t        max_age_days = (datetime.datetime.now(datetime.UTC) - max_age_cutoff).days\n301\t        filtered = [\n302\t            c\n303\t            for c in candidates_list\n304\t            if c.upload_time is None or c.upload_time >= max_age_cutoff\n305\t        ]\n306\t        dropped = len(candidates_list) - len(filtered)\n307\t        if dropped:\n308\t            logger.info(\n309\t                \"%s: have %d candidate(s) of %s published within %d days\",\n310\t                req.name,\n311\t                len(filtered),\n312\t                req,\n313\t                max_age_days,\n314\t            )\n315\t        if filtered:\n316\t            candidates_list = filtered\n317\t        elif fallback_on_empty_age_filter:\n318\t            logger.warning(\n319\t                \"%s: all %d candidate(s) of %s are older than %d days, \"\n320\t                \"keeping all to avoid empty resolution\",\n321\t                req.name,\n322\t                len(candidates_list),\n323\t                req,\n324\t                max_age_days,\n325\t            )\n326\t        else:\n327\t            logger.info(\n328\t                \"%s: all %d candidate(s) of %s are older than %d days\",\n329\t                req.name,\n330\t                len(candidates_list),\n331\t                req,\n332\t                max_age_days,\n333\t            )\n334\t            candidates_list = []\n335\t\n336\t    # Convert candidates to list of (url, version) tuples\n337\t    # Candidates are sorted by version (highest first) by BaseProvider.find_matches()\n338\t    # which calls sorted(candidates, key=attrgetter(\"version\", \"build_tag\"), reverse=True)\n339\t    return [(c.url, c.version) for c in candidates_list]\n340\t\n341\t\n342\tdef get_project_from_pypi(\n343\t    project: str,\n344\t    extras: typing.Iterable[str],\n345\t    sdist_server_url: str,\n346\t    ignore_platform: bool = False,\n347\t    *,\n348\t    override_download_url: str | None = None,\n349\t) -> Candidates:\n350\t    \"\"\"Fetch and filter package candidates from a PyPI-compatible server.\n351\t\n352\t    Filters the project's package list by: project status, filename\n353\t    validity, package type (sdist/wheel), yanked status, Python version\n354\t    compatibility, and platform tags. Can substitute\n355\t    ``override_download_url`` into each candidate's URL.\n356\t    \"\"\"\n357\t    found_candidates: set[str] = set()\n358\t    ignored_candidates: set[str] = set()\n359\t    logger.debug(\"%s: getting available versions from %s\", project, sdist_server_url)\n360\t\n361\t    client = pypi_simple.PyPISimple(\n362\t        endpoint=sdist_server_url,\n363\t        session=session,\n364\t        accept=pypi_simple.ACCEPT_JSON_PREFERRED,\n365\t    )\n366\t    try:\n367\t        package = client.get_project_page(project)\n368\t    except pypi_simple.errors.NoSuchProjectError as e:\n369\t        raise resolvelib.resolvers.ResolverException(\n370\t            f\"project {project} not found on {sdist_server_url}\"\n371\t        ) from e\n372\t    except Exception as e:\n373\t        logger.debug(\n374\t            \"failed to fetch package index from %s: %s\",\n375\t            sdist_server_url,\n376\t            e,\n377\t        )\n378\t        raise\n379\t\n380\t    # PEP 792 package status\n381\t    match package.status:\n382\t        case None:\n383\t            logger.debug(\"no package status\")\n384\t        case pypi_simple.ProjectStatus.ACTIVE:\n385\t            logger.debug(\"project %r is active: %s\", project, package.status_reason)\n386\t        case pypi_simple.ProjectStatus.DEPRECATED | pypi_simple.ProjectStatus.ARCHIVED:\n387\t            logger.warning(\n388\t                \"project %r is no longer active: %r: %s\",\n389\t                project,\n390\t                package.status,\n391\t                package.status_reason,\n392\t            )\n393\t        case pypi_simple.ProjectStatus.QUARANTINED:\n394\t            raise ValueError(\n395\t                f\"project {project!r} is quarantined: {package.status_reason}\"\n396\t            )\n397\t        case _:\n398\t            logger.warning(\n399\t                \"project %r has unknown status %r: %s\",\n400\t                project,\n401\t                package.status,\n402\t                package.status_reason,\n403\t            )\n404\t\n405\t    for dp in package.packages:\n406\t        found_candidates.add(dp.filename)\n407\t        if DEBUG_RESOLVER:\n408\t            logger.debug(\"candidate %r -> %r==%r\", dp.url, dp.filename, dp.version)\n409\t\n410\t        if (\n411\t            dp.project is None\n412\t            or dp.version is None\n413\t            or dp.package_type is None\n414\t            or len(dp.project) != len(project)\n415\t        ):\n416\t            # Legacy file names that pypi_simple does not understand,\n417\t            # pypi_simple sets one or all fields to None.\n418\t            #\n419\t            # Look for and ignore cases like `cffi-1.0.2-2.tar.gz` which\n420\t            # produces the name `cffi-1-0-2`. We can't just compare the\n421\t            # names directly because of case and punctuation changes in\n422\t            # making names canonical and the way requirements are\n423\t            # expressed and there seems to be *no* way of producing sdist\n424\t            # filenames consistently, so we compare the length for this\n425\t            # case.\n426\t            if DEBUG_RESOLVER:\n427\t                logger.debug(\n428\t                    \"skipping %r because 'pypi_simple' could not parse it or it's an invalid name\",\n429\t                    dp.filename,\n430\t                )\n431\t            ignored_candidates.add(dp.filename)\n432\t            continue\n433\t\n434\t        if dp.package_type not in {\"sdist\", \"wheel\"}:\n435\t            if DEBUG_RESOLVER:\n436\t                logger.debug(\n437\t                    \"skipping %r because it's not an sdist or wheel, got %r\",\n438\t                    dp.filename,\n439\t                    dp.package_type,\n440\t                )\n441\t            ignored_candidates.add(dp.filename)\n442\t            continue\n443\t\n444\t        # PEP 592: Skip items that were yanked\n445\t        if dp.is_yanked:\n446\t            if DEBUG_RESOLVER:\n447\t                logger.debug(\n448\t                    \"skipping %s because it was yanked (%s)\",\n449\t                    dp.filename,\n450\t                    dp.yanked_reason,\n451\t                )\n452\t            ignored_candidates.add(dp.filename)\n453\t            continue\n454\t\n455\t        # Skip items that need a different Python version\n456\t        if dp.requires_python:\n457\t            try:\n458\t                matched_py: bool = match_py_req(dp.requires_python)\n459\t            except InvalidSpecifier as err:\n460\t                # Ignore files with invalid python specifiers\n461\t                # e.g. shellingham has files with \">= '2.7'\"\n462\t                if DEBUG_RESOLVER:\n463\t                    logger.debug(\n464\t                        \"skipping %r because of an invalid python version specifier %r: %s\",\n465\t                        dp.filename,\n466\t                        dp.requires_python,\n467\t                        err,\n468\t                    )\n469\t                ignored_candidates.add(dp.filename)\n470\t                continue\n471\t            if not matched_py:\n472\t                if DEBUG_RESOLVER:\n473\t                    logger.debug(\n474\t                        \"skipping %r because of python version %r\",\n475\t                        dp.filename,\n476\t                        dp.requires_python,\n477\t                    )\n478\t                ignored_candidates.add(dp.filename)\n479\t                continue\n480\t\n481\t        # TODO: Handle compatibility tags?\n482\t\n483\t        try:\n484\t            if dp.package_type == \"sdist\":\n485\t                is_sdist = True\n486\t                name: str = dp.project\n487\t                version: Version = Version(dp.version)\n488\t                tags: frozenset[Tag] = frozenset()\n489\t                build_tag: BuildTag = ()\n490\t            else:\n491\t                is_sdist = False\n492\t                name, version, build_tag, tags = parse_wheel_filename(dp.filename)\n493\t        except Exception as err:\n494\t            # Ignore files with invalid versions\n495\t            if DEBUG_RESOLVER:\n496\t                logger.debug(\"could not determine version for %r: %s\", dp.filename, err)\n497\t            ignored_candidates.add(dp.filename)\n498\t            continue\n499\t\n500\t        if tags:\n501\t            # FIXME: This doesn't take into account precedence of\n502\t            # the supported tags for best fit.\n503\t            matching_tags = SUPPORTED_TAGS.intersection(tags)\n504\t            if not matching_tags and ignore_platform:\n505\t                if DEBUG_RESOLVER:\n506\t                    logger.debug(\"ignoring platform for %r\", dp.filename)\n507\t                ignore_platform_tags: frozenset[Tag] = frozenset(\n508\t                    Tag(t.interpreter, t.abi, IGNORE_PLATFORM) for t in tags\n509\t                )\n510\t                matching_tags = SUPPORTED_TAGS_IGNORE_PLATFORM.intersection(\n511\t                    ignore_platform_tags\n512\t                )\n513\t            if not matching_tags:\n514\t                if DEBUG_RESOLVER:\n515\t                    logger.debug(\"ignoring %r with tags %r\", dp.filename, tags)\n516\t                ignored_candidates.add(dp.filename)\n517\t                continue\n518\t\n519\t        if override_download_url is None:\n520\t            url = dp.url\n521\t        else:\n522\t            url = override_download_url.format(version=version)\n523\t\n524\t        upload_time = dp.upload_time\n525\t        if upload_time is not None:\n526\t            upload_time = upload_time.astimezone(datetime.UTC)\n527\t\n528\t        c = Candidate(\n529\t            name=name,\n530\t            version=version,\n531\t            url=url,\n532\t            extras=tuple(sorted(extras)),\n533\t            is_sdist=is_sdist,\n534\t            build_tag=build_tag,\n535\t            has_metadata=bool(dp.has_metadata),\n536\t            upload_time=upload_time,\n537\t        )\n538\t        if DEBUG_RESOLVER:\n539\t            logger.debug(\"candidate %s (%s) %s\", dp.filename, c, dp.url)\n540\t        yield c\n541\t\n542\t    if not found_candidates:\n543\t        logger.info(\"found no candidate files at %s\", sdist_server_url)\n544\t    elif ignored_candidates == found_candidates:\n545\t        logger.info(\"ignored all candidate files at %s\", sdist_server_url)\n546\t\n547\t\n548\ttype RequirementsMap = typing.Mapping[str, typing.Iterable[Requirement]]\n549\ttype Candidates = typing.Iterable[Candidate]\n550\ttype CandidatesMap = typing.Mapping[str, Candidates]\n551\t# {identifier: [cls, cachekey]: list[candidates]}}\n552\ttype ResolverCache = dict[str, dict[tuple[type[ExtrasProvider], str], list[Candidate]]]\n553\ttype VersionSource = typing.Callable[\n554\t    [str],\n555\t    typing.Iterable[Candidate | tuple[str, str | Version]],\n556\t]\n557\t\n558\t\n559\tclass BaseProvider(ExtrasProvider):\n560\t    resolver_cache: typing.ClassVar[ResolverCache] = {}\n561\t    provider_description: typing.ClassVar[str]\n562\t    _cooldown_unsupported_warned: typing.ClassVar[set[str]] = set()\n563\t\n564\t    def __init__(\n565\t        self,\n566\t        *,\n567\t        constraints: Constraints | None = None,\n568\t        req_type: RequirementType | None = None,\n569\t        use_resolver_cache: bool = True,\n570\t        cooldown: Cooldown | None = None,\n571\t    ):\n572\t        super().__init__()\n573\t        self.constraints = constraints or Constraints()\n574\t        self.req_type = req_type\n575\t        self.use_cache_candidates = use_resolver_cache\n576\t\n577\t        # cooldown specific settings\n578\t        self.cooldown = cooldown\n579\t        # Does this provider supply upload timestamps for candidates?\n580\t        # Defaults to False (safe/unknown). Subclasses that reliably populate\n581\t        # upload_time on every candidate should set this to True in their __init__.\n582\t        # When a cooldown is active and this is False, the cooldown check is\n583\t        # skipped with a warning rather than failing closed.\n584\t        self.supports_upload_time: bool = False\n585\t\n586\t    @property\n587\t    def cache_key(self) -> str:\n588\t        \"\"\"Return cache key for the provider\n589\t\n590\t        The cache key must be unique for each provider configuration, e.g.\n591\t        PyPI URL, GitHub org + repo, ...\n592\t        \"\"\"\n593\t        raise NotImplementedError()\n594\t\n595\t    def get_provider_description(self) -> str:\n596\t        \"\"\"Return a human-readable description of the provider type\n597\t\n598\t        This is used in error messages to indicate what resolver was being used.\n599\t        The ClassVar `provider_description` must be set by each subclass.\n600\t        If it contains format placeholders like {self.attr}, it will be formatted\n601\t        with the instance. Strings without placeholders are returned unchanged.\n602\t        \"\"\"\n603\t        return self.provider_description.format(self=self)\n604\t\n605\t    def find_candidates(self, identifier: str) -> Candidates:\n606\t        \"\"\"Find unfiltered candidates\"\"\"\n607\t        raise NotImplementedError()\n608\t\n609\t    def identify(self, requirement_or_candidate: Requirement | Candidate) -> str:\n610\t        return canonicalize_name(requirement_or_candidate.name)\n611\t\n612\t    @classmethod\n613\t    def clear_cache(cls, identifier: str | None = None) -> None:\n614\t        \"\"\"Clear global resolver cache\n615\t\n616\t        ``None`` clears all caches, an ``identifier`` string clears the\n617\t        cache for an identifier. Raises :exc:`KeyError` for unknown\n618\t        identifiers.\n619\t        \"\"\"\n620\t        if identifier is None:\n621\t            cls.resolver_cache.clear()\n622\t        else:\n623\t            cls.resolver_cache.pop(canonicalize_name(identifier))\n624\t\n625\t    def get_extras_for(\n626\t        self,\n627\t        requirement_or_candidate: Requirement | Candidate,\n628\t    ) -> typing.Iterable[str]:\n629\t        # Extras is a set, which is not hashable\n630\t        if requirement_or_candidate.extras:\n631\t            return tuple(sorted(requirement_or_candidate.extras))\n632\t        return tuple()\n633\t\n634\t    def get_base_requirement(self, candidate: Candidate) -> Requirement:\n635\t        return Requirement(f\"{candidate.name}=={candidate.version}\")\n636\t\n637\t    def validate_candidate(\n638\t        self,\n639\t        identifier: str,\n640\t        requirements: RequirementsMap,\n641\t        incompatibilities: CandidatesMap,\n642\t        candidate: Candidate,\n643\t    ) -> bool:\n644\t        identifier_reqs = list(requirements.get(identifier, []))\n645\t        bad_versions = {c.version for c in incompatibilities.get(identifier, [])}\n646\t        # Skip versions that are known bad\n647\t        if candidate.version in bad_versions:\n648\t            if DEBUG_RESOLVER:\n649\t                logger.debug(\n650\t                    f\"{identifier}: skipping bad version {candidate.version} from {bad_versions}\"\n651\t                )\n652\t            return False\n653\t        for r in identifier_reqs:\n654\t            if self.is_satisfied_by(requirement=r, candidate=candidate):\n655\t                return True\n656\t        return False\n657\t\n658\t    def get_preference(\n659\t        self,\n660\t        identifier: str,\n661\t        resolutions: typing.Mapping[str, Candidate],\n662\t        candidates: CandidatesMap,\n663\t        information: typing.Mapping[\n664\t            str, typing.Iterable[RequirementInformation[Requirement, Candidate]]\n665\t        ],\n666\t        backtrack_causes: typing.Sequence[\n667\t            RequirementInformation[Requirement, Candidate]\n668\t        ],\n669\t    ) -> int:\n670\t        return sum(1 for _ in candidates[identifier])\n671\t\n672\t    def is_satisfied_by(self, requirement: Requirement, candidate: Candidate) -> bool:\n673\t        if canonicalize_name(requirement.name) != candidate.name:\n674\t            return False\n675\t        allow_prerelease = self.constraints.allow_prerelease(requirement.name) or bool(\n676\t            requirement.specifier.prereleases\n677\t        )\n678\t        if not requirement.specifier.contains(\n679\t            candidate.version, prereleases=allow_prerelease\n680\t        ):\n681\t            if DEBUG_RESOLVER:\n682\t                logger.debug(\n683\t                    f\"{requirement.name}: skipping candidate version {candidate.version} because it does not match {requirement.specifier}\"\n684\t                )\n685\t            return False\n686\t\n687\t        if not self.constraints.is_satisfied_by(requirement.name, candidate.version):\n688\t            if DEBUG_RESOLVER:\n689\t                c = self.constraints.get_constraint(requirement.name)\n690\t                logger.debug(\n691\t                    f\"{requirement.name}: skipping {candidate.version} due to constraint {c}\"\n692\t                )\n693\t            return False\n694\t\n695\t        return True\n696\t\n697\t    def is_blocked_by_cooldown(self, candidate: Candidate) -> bool:\n698\t        \"\"\"Return True if the candidate is rejected by the release-age cooldown.\"\"\"\n699\t\n700\t        # a cooldown is not specified...\n701\t        if self.cooldown is None:\n702\t            return False\n703\t\n704\t        # the target candidate doesn't provide a valid upload timestamp\n705\t        if candidate.upload_time is None:\n706\t            if not self.supports_upload_time:\n707\t                # this provider does not yet support timestamp retrieval (e.g. GitHub).\n708\t                # Warn once per package name across all provider instances.\n709\t                if candidate.name not in BaseProvider._cooldown_unsupported_warned:\n710\t                    BaseProvider._cooldown_unsupported_warned.add(candidate.name)\n711\t                    logger.warning(\n712\t                        \"release-age cooldown cannot be enforced — upload \"\n713\t                        \"timestamp support is not yet implemented for %s; \"\n714\t                        \"cooldown check skipped\",\n715\t                        self.get_provider_description(),\n716\t                    )\n717\t                return False\n718\t            # this provider is expected to supply timestamps,\n719\t            # but this candidate is missing one.\n720\t            # Fail closed: we cannot verify the age of this candidate, so reject it.\n721\t            if DEBUG_RESOLVER:\n722\t                logger.debug(\n723\t                    \"skipping %s — upload_time unknown, required for cooldown\",\n724\t                    candidate.version,\n725\t                )\n726\t            return True\n727\t\n728\t        # cooldowns are enabled, and this candidate has a valid upload timestamp\n729\t        # so we can do the math to determine whether or not the candidate should\n730\t        # be blocked/skipped\n731\t        cutoff = self.cooldown.bootstrap_time - self.cooldown.min_age\n732\t        if candidate.upload_time > cutoff:\n733\t            # if this candidate is \"too new\", block/skip it\n734\t            if DEBUG_RESOLVER:\n735\t                age = self.cooldown.bootstrap_time - candidate.upload_time\n736\t                logger.debug(\n737\t                    \"skipping %s uploaded %s ago (cooldown: %s)\",\n738\t                    candidate.version,\n739\t                    age,\n740\t                    self.cooldown.min_age,\n741\t                )\n742\t            return True\n743\t        return False\n744\t\n745\t    def get_dependencies(self, candidate: Candidate) -> list[Requirement]:\n746\t        # return candidate.dependencies\n747\t        return []\n748\t\n749\t    def _get_cached_candidates(self, identifier: str) -> list[Candidate]:\n750\t        \"\"\"Get list of cached candidates for identifier and provider\n751\t\n752\t        The method always returns a list. If the cache did not have an entry\n753\t        before, a new empty list is stored in the cache and returned to the\n754\t        caller. The caller can mutate the list in place to update the cache.\n755\t        \"\"\"\n756\t        cls = type(self)\n757\t        provider_cache = cls.resolver_cache.setdefault(identifier, {})\n758\t        candidate_cache = provider_cache.setdefault((cls, self.cache_key), [])\n759\t        return candidate_cache\n760\t\n761\t    def _find_cached_candidates(self, identifier: str) -> Candidates:\n762\t        \"\"\"Find candidates with caching\"\"\"\n763\t        cached_candidates: list[Candidate] = []\n764\t        if self.use_cache_candidates:\n765\t            cached_candidates = self._get_cached_candidates(identifier)\n766\t            if cached_candidates:\n767\t                logger.debug(\n768\t                    \"%s: use %i cached candidates\",\n769\t                    identifier,\n770\t                    len(cached_candidates),\n771\t                )\n772\t                return cached_candidates\n773\t        candidates = list(self.find_candidates(identifier))\n774\t        if self.use_cache_candidates:\n775\t            # mutate list object in-place\n776\t            cached_candidates[:] = candidates\n777\t            logger.debug(\n778\t                \"%s: cache %i unfiltered candidates\",\n779\t                identifier,\n780\t                len(candidates),\n781\t            )\n782\t        else:\n783\t            logger.debug(\n784\t                \"%s: got %i unfiltered candidates, ignoring cache\",\n785\t                identifier,\n786\t                len(candidates),\n787\t            )\n788\t        return candidates\n789\t\n790\t    def _get_no_match_error_message(\n791\t        self, identifier: str, requirements: RequirementsMap\n792\t    ) -> str:\n793\t        \"\"\"Generate an error message when no candidates are found.\n794\t\n795\t        Subclasses should override this to provide provider-specific error details.\n796\t        \"\"\"\n797\t        reqs = requirements.get(identifier, [])\n798\t        if reqs:\n799\t            r = next(iter(reqs))\n800\t            return f\"found no match for {r} using {self.get_provider_description()}\"\n801\t        return f\"found no match for identifier {identifier} using {self.get_provider_description()}\"\n802\t\n803\t    def find_matches(\n804\t        self,\n805\t        identifier: str,\n806\t        requirements: RequirementsMap,\n807\t        incompatibilities: CandidatesMap,\n808\t    ) -> Candidates:\n809\t        \"\"\"Find matching candidates, sorted by version and build tag\"\"\"\n810\t        unfiltered_candidates = self._find_cached_candidates(identifier)\n811\t        candidates = [\n812\t            candidate\n813\t            for candidate in unfiltered_candidates\n814\t            if self.validate_candidate(\n815\t                identifier, requirements, incompatibilities, candidate\n816\t            )\n817\t        ]\n818\t        # Apply cooldown filtering after specifier/constraint validation\n819\t        blocked = [c for c in candidates if self.is_blocked_by_cooldown(c)]\n820\t        if blocked:\n821\t            for b in blocked:\n822\t                candidates.remove(b)\n823\t            versions = \", \".join(str(b.version) for b in blocked)\n824\t            logger.info(\n825\t                \"cooldown blocked %d version(s): %s\",\n826\t                len(blocked),\n827\t                versions,\n828\t            )\n829\t        if not candidates:\n830\t            raise resolvelib.resolvers.ResolverException(\n831\t                self._get_no_match_error_message(identifier, requirements)\n832\t            )\n833\t        return sorted(candidates, key=attrgetter(\"version\", \"build_tag\"), reverse=True)\n834\t\n835\t\n836\tclass PyPIProvider(BaseProvider):\n837\t    \"\"\"Lookup package and versions from a simple Python index (PyPI)\n838\t\n839\t    The ``override_download_url`` parameter supports the string template variable:\n840\t    * version (Version object)\n841\t    \"\"\"\n842\t\n843\t    provider_description: typing.ClassVar[str] = (\n844\t        \"PyPI resolver (searching at {self.sdist_server_url})\"\n845\t    )\n846\t\n847\t    def __init__(\n848\t        self,\n849\t        include_sdists: bool = True,\n850\t        include_wheels: bool = True,\n851\t        sdist_server_url: str = \"https://pypi.org/simple/\",\n852\t        constraints: Constraints | None = None,\n853\t        req_type: RequirementType | None = None,\n854\t        ignore_platform: bool = False,\n855\t        *,\n856\t        use_resolver_cache: bool = True,\n857\t        override_download_url: str | None = None,\n858\t        cooldown: Cooldown | None = None,\n859\t        supports_upload_time: bool | None = None,\n860\t    ):\n861\t        super().__init__(\n862\t            constraints=constraints,\n863\t            req_type=req_type,\n864\t            use_resolver_cache=use_resolver_cache,\n865\t            cooldown=cooldown,\n866\t        )\n867\t\n868\t        # Only pypi.org reliably supports PEP 691 upload timestamps.\n869\t        # Default to True for pypi.org, False for all other indexes.\n870\t        if supports_upload_time is None:\n871\t            supports_upload_time = sdist_server_url.startswith(PYPI_SERVER_URL)\n872\t        self.supports_upload_time = supports_upload_time\n873\t        self.include_sdists = include_sdists\n874\t        self.include_wheels = include_wheels\n875\t        self.sdist_server_url = sdist_server_url\n876\t        self.ignore_platform = ignore_platform\n877\t        self.override_download_url = override_download_url\n878\t\n879\t    @property\n880\t    def cache_key(self) -> str:\n881\t        # ignore platform parameter changes behavior of find_candidates()\n882\t        key = self.sdist_server_url\n883\t        if self.override_download_url is not None:\n884\t            key = f\"{key}+{self.override_download_url}\"\n885\t        if self.ignore_platform:\n886\t            key = f\"{key}+ignore_platform\"\n887\t        return key\n888\t\n889\t    def find_candidates(self, identifier: str) -> Candidates:\n890\t        return get_project_from_pypi(\n891\t            identifier,\n892\t            extras=set(),\n893\t            sdist_server_url=self.sdist_server_url,\n894\t            ignore_platform=self.ignore_platform,\n895\t            override_download_url=self.override_download_url,\n896\t        )\n897\t\n898\t    def validate_candidate(\n899\t        self,\n900\t        identifier: str,\n901\t        requirements: RequirementsMap,\n902\t        incompatibilities: CandidatesMap,\n903\t        candidate: Candidate,\n904\t    ) -> bool:\n905\t        if not super().validate_candidate(\n906\t            identifier, requirements, incompatibilities, candidate\n907\t        ):\n908\t            return False\n909\t        # Only include sdists if we're asked to\n910\t        if candidate.is_sdist and not self.include_sdists:\n911\t            if DEBUG_RESOLVER:\n912\t                logger.debug(\n913\t                    f\"{identifier}: skipping {candidate} because it is an sdist\"\n914\t                )\n915\t            return False\n916\t        # Only include wheels if we're asked to\n917\t        if not candidate.is_sdist and not self.include_wheels:\n918\t            if DEBUG_RESOLVER:\n919\t                logger.debug(\n920\t                    f\"{identifier}: skipping {candidate} because it is a wheel\"\n921\t                )\n922\t            return False\n923\t        return True\n924\t\n925\t    def _get_no_match_error_message(\n926\t        self, identifier: str, requirements: RequirementsMap\n927\t    ) -> str:\n928\t        \"\"\"Generate a PyPI-specific error message with file type and pre-release details.\"\"\"\n929\t        r = next(iter(requirements[identifier]))\n930\t\n931\t        # Determine if pre-releases are allowed\n932\t        req_allows_prerelease = bool(r.specifier) and bool(r.specifier.prereleases)\n933\t        allow_prerelease = (\n934\t            self.constraints.allow_prerelease(r.name) or req_allows_prerelease\n935\t        )\n936\t        prerelease_info = \"including\" if allow_prerelease else \"ignoring\"\n937\t\n938\t        # Determine the file type that was allowed\n939\t        if self.include_sdists and self.include_wheels:\n940\t            file_type_info = \"any file type\"\n941\t        elif self.include_sdists:\n942\t            file_type_info = \"sdists\"\n943\t        else:\n944\t            file_type_info = \"wheels\"\n945\t\n946\t        # If a cooldown is active, check whether it's responsible for the\n947\t        # failure so we can give a more actionable error message.\n948\t        if self.cooldown is not None:\n949\t            cutoff = self.cooldown.bootstrap_time - self.cooldown.min_age\n950\t            all_candidates = list(self._find_cached_candidates(identifier))\n951\t            missing_time = [c for c in all_candidates if c.upload_time is None]\n952\t            cooldown_blocked = [\n953\t                c\n954\t                for c in all_candidates\n955\t                if c.upload_time is not None and c.upload_time > cutoff\n956\t            ]\n957\t            if missing_time and not cooldown_blocked:\n958\t                return (\n959\t                    f\"found {len(missing_time)} candidate(s) for {r} but none have \"\n960\t                    f\"upload timestamp metadata; {self.sdist_server_url!r} may not \"\n961\t                    f\"support PEP 691 (JSON API), which is required to enforce the \"\n962\t                    f\"{self.cooldown.min_age.days}-day release-age cooldown\"\n963\t                )\n964\t            if cooldown_blocked:\n965\t                oldest_days = min(\n966\t                    (self.cooldown.bootstrap_time - c.upload_time).days\n967\t                    for c in cooldown_blocked\n968\t                    if c.upload_time is not None\n969\t                )\n970\t                return (\n971\t                    f\"found {len(cooldown_blocked)} candidate(s) for {r} but all \"\n972\t                    f\"were published within the last {self.cooldown.min_age.days} days \"\n973\t                    f\"(release-age cooldown; oldest is {oldest_days} day(s) old)\"\n974\t                )\n975\t\n976\t        return (\n977\t            f\"found no match for {r} using {self.get_provider_description()}, \"\n978\t            f\"searching for {file_type_info}, {prerelease_info} pre-release versions\"\n979\t        )\n980\t\n981\t    def find_matches(\n982\t        self,\n983\t        identifier: str,\n984\t        requirements: RequirementsMap,\n985\t        incompatibilities: CandidatesMap,\n986\t    ) -> Candidates:\n987\t        return super().find_matches(identifier, requirements, incompatibilities)\n988\t\n989\t\n990\tclass MatchFunction(typing.Protocol):\n991\t    def __call__(self, identifier: str, item: str) -> Version | None:\n992\t        pass\n993\t\n994\t\n995\tclass GenericProvider(BaseProvider):\n996\t    \"\"\"Lookup package and version by using a callback\"\"\"\n997\t\n998\t    def __init__(\n999\t        self,\n1000\t        version_source: VersionSource,\n1001\t        constraints: Constraints | None = None,\n1002\t        req_type: RequirementType | None = None,\n1003\t        matcher: MatchFunction | re.Pattern | None = None,\n1004\t        *,\n1005\t        # generic provider does not implement caching\n1006\t        use_resolver_cache: bool = False,\n1007\t        cooldown: Cooldown | None = None,\n1008\t    ):\n1009\t        super().__init__(\n1010\t            constraints=constraints,\n1011\t            req_type=req_type,\n1012\t            use_resolver_cache=use_resolver_cache,\n1013\t            cooldown=cooldown,\n1014\t        )\n1015\t        self._version_source = version_source\n1016\t        if matcher is None:\n1017\t            self._match_function = self._default_match_function\n1018\t        elif isinstance(matcher, re.Pattern):\n1019\t            self._match_function = functools.partial(\n1020\t                self._re_match_function, regex=matcher\n1021\t            )\n1022\t        else:\n1023\t            self._match_function = matcher\n1024\t\n1025\t    def _default_match_function(self, identifier: str, item: str) -> Version | None:\n1026\t        try:\n1027\t            return Version(item)\n1028\t        except Exception as err:\n1029\t            logger.debug(f\"{identifier}: could not parse version from {item}: {err}\")\n1030\t            return None\n1031\t\n1032\t    def _re_match_function(\n1033\t        self, identifier: str, item: str, *, regex: re.Pattern\n1034\t    ) -> Version | None:\n1035\t        mo = regex.match(item)\n1036\t        if mo is None:\n1037\t            logger.debug(\n1038\t                f\"{identifier}: tag {item} does not match pattern {regex.pattern}\"\n1039\t            )\n1040\t            return None\n1041\t        value = mo.group(1)\n1042\t        try:\n1043\t            return Version(value)\n1044\t        except Exception as err:\n1045\t            logger.debug(f\"{identifier}: could not parse version from {value}: {err}\")\n1046\t            return None\n1047\t\n1048\t    provider_description: typing.ClassVar[str] = \"custom resolver (GenericProvider)\"\n1049\t\n1050\t    @property\n1051\t    def cache_key(self) -> str:\n1052\t        raise NotImplementedError(\"GenericProvider does not implement caching\")\n1053\t\n1054\t    def find_candidates(self, identifier: typing.Any) -> Candidates:\n1055\t        \"\"\"Find matching candidates from the version source.\n1056\t\n1057\t        Accepts three input formats from _version_source:\n1058\t        1. Candidate objects (used directly)\n1059\t        2. (url, Version) tuples\n1060\t        3. (url, str) tuples (version parsed via _match_function)\n1061\t        \"\"\"\n1062\t        candidates: list[Candidate] = []\n1063\t        version: Version | None\n1064\t        for item in self._version_source(identifier):\n1065\t            if isinstance(item, Candidate):\n1066\t                candidate = item\n1067\t            else:\n1068\t                # TODO: deprecate (url, version_or_string)\n1069\t                url, version_or_string = item\n1070\t                if isinstance(version_or_string, Version):\n1071\t                    version = version_or_string\n1072\t                else:\n1073\t                    match_result = self._match_function(identifier, version_or_string)\n1074\t                    if match_result is None:\n1075\t                        logger.debug(\n1076\t                            f\"{identifier}: match function ignores {version_or_string}\"\n1077\t                        )\n1078\t                        continue\n1079\t                    assert isinstance(match_result, Version)\n1080\t                    version = match_result\n1081\t\n1082\t                candidate = Candidate(name=identifier, version=version, url=url)\n1083\t\n1084\t            candidates.append(candidate)\n1085\t\n1086\t        return candidates\n1087\t\n1088\t\n1089\tclass GitHubTagProvider(GenericProvider):\n1090\t    \"\"\"Lookup tarball and version from GitHub git tags\n1091\t\n1092\t    Assumes that upstream uses version tags `1.2.3` or `v1.2.3`.\n1093\t\n1094\t    The ``override_download_url`` parameter supports the string template variable:\n1095\t    * organization\n1096\t    * repo\n1097\t    * tagname\n1098\t    * version (Version object)\n1099\t    \"\"\"\n1100\t\n1101\t    provider_description: typing.ClassVar[str] = (\n1102\t        \"GitHub tag resolver (repository: {self.organization}/{self.repo})\"\n1103\t    )\n1104\t    host = \"github.com:443\"\n1105\t    api_url = \"https://api.{self.host}/repos/{self.organization}/{self.repo}/tags\"\n1106\t\n1107\t    def __init__(\n1108\t        self,\n1109\t        organization: str,\n1110\t        repo: str,\n1111\t        constraints: Constraints | None = None,\n1112\t        matcher: MatchFunction | re.Pattern | None = None,\n1113\t        *,\n1114\t        req_type: RequirementType | None = None,\n1115\t        use_resolver_cache: bool = True,\n1116\t        override_download_url: str | None = None,\n1117\t        cooldown: Cooldown | None = None,\n1118\t    ):\n1119\t        super().__init__(\n1120\t            constraints=constraints,\n1121\t            req_type=req_type,\n1122\t            use_resolver_cache=use_resolver_cache,\n1123\t            version_source=self._find_tags,\n1124\t            matcher=matcher,\n1125\t            cooldown=cooldown,\n1126\t        )\n1127\t        self.organization = organization\n1128\t        self.repo = repo\n1129\t        self.override_download_url = override_download_url\n1130\t\n1131\t    @property\n1132\t    def cache_key(self) -> str:\n1133\t        key = f\"{self.organization}/{self.repo}\"\n1134\t        if self.override_download_url is not None:\n1135\t            key = f\"{key}+{self.override_download_url}\"\n1136\t        return key\n1137\t\n1138\t    @retry_on_exception(\n1139\t        exceptions=RETRYABLE_EXCEPTIONS,\n1140\t        max_attempts=5,\n1141\t        backoff_factor=1.5,\n1142\t        max_backoff=120.0,\n1143\t    )\n1144\t    def _find_tags(\n1145\t        self,\n1146\t        identifier: str,\n1147\t    ) -> Iterable[Candidate]:\n1148\t        headers = {\"accept\": \"application/vnd.github+json\"}\n1149\t        nexturl = self.api_url.format(self=self)\n1150\t        while nexturl:\n1151\t            resp = session.get(nexturl, headers=headers)\n1152\t            resp.raise_for_status()\n1153\t\n1154\t            for entry in resp.json():\n1155\t                tagname = entry[\"name\"]\n1156\t                version = self._match_function(identifier, tagname)\n1157\t                if version is None:\n1158\t                    logger.debug(f\"{identifier}: match function ignores {tagname}\")\n1159\t                    continue\n1160\t                assert isinstance(version, Version)\n1161\t\n1162\t                if self.override_download_url is None:\n1163\t                    url = entry[\"tarball_url\"]\n1164\t                else:\n1165\t                    url = self.override_download_url.format(\n1166\t                        organization=self.organization,\n1167\t                        repo=self.repo,\n1168\t                        tagname=tagname,\n1169\t                        version=version,\n1170\t                    )\n1171\t\n1172\t                # Github tag API endpoint does not include commit date information.\n1173\t                # It would be too expensive to query every commit API endpoint.\n1174\t                yield Candidate(\n1175\t                    name=identifier,\n1176\t                    version=version,\n1177\t                    url=url,\n1178\t                    remote_tag=tagname,\n1179\t                    remote_commit=entry[\"commit\"][\"sha\"],\n1180\t                    upload_time=None,\n1181\t                )\n1182\t\n1183\t            # pagination links\n1184\t            nexturl = resp.links.get(\"next\", {}).get(\"url\")\n1185\t\n1186\t\n1187\tclass GitLabTagProvider(GenericProvider):\n1188\t    \"\"\"Lookup tarball and version from GitLab git tags\n1189\t\n1190\t    The ``override_download_url`` parameter supports the string template variable:\n1191\t    * hostname\n1192\t    * project_path\n1193\t    * project_name (last component of project_path)\n1194\t    * tagname\n1195\t    * version (Version object)\n1196\t    \"\"\"\n1197\t\n1198\t    provider_description: typing.ClassVar[str] = (\n1199\t        \"GitLab tag resolver (project: {self.server_url}/{self.project_path})\"\n1200\t    )\n1201\t\n1202\t    def __init__(\n1203\t        self,\n1204\t        project_path: str,\n1205\t        server_url: str = \"https://gitlab.com\",\n1206\t        constraints: Constraints | None = None,\n1207\t        matcher: MatchFunction | re.Pattern | None = None,\n1208\t        *,\n1209\t        req_type: RequirementType | None = None,\n1210\t        use_resolver_cache: bool = True,\n1211\t        override_download_url: str | None = None,\n1212\t        cooldown: Cooldown | None = None,\n1213\t    ) -> None:\n1214\t        super().__init__(\n1215\t            constraints=constraints,\n1216\t            req_type=req_type,\n1217\t            use_resolver_cache=use_resolver_cache,\n1218\t            version_source=self._find_tags,\n1219\t            matcher=matcher,\n1220\t            cooldown=cooldown,\n1221\t        )\n1222\t        self.supports_upload_time = True\n1223\t        self.server_url = server_url.rstrip(\"/\")\n1224\t        self.server_hostname = urlparse(server_url).hostname\n1225\t        if not self.server_hostname:\n1226\t            raise ValueError(f\"invalid {server_url=}\")\n1227\t        self.project_path = project_path.lstrip(\"/\")\n1228\t        # URL-encode the project path as required by GitLab API.\n1229\t        # The safe=\"\" parameter tells quote() to encode ALL characters,\n1230\t        # including forward slashes (/), which would otherwise be left\n1231\t        # unencoded. This ensures paths like \"group/subgroup/project\"\n1232\t        # become \"group%2Fsubgroup%2Fproject\" as required by the API.\n1233\t        encoded_path: str = quote(self.project_path, safe=\"\")\n1234\t        self.api_url = (\n1235\t            f\"{self.server_url}/api/v4/projects/{encoded_path}/repository/tags\"\n1236\t        )\n1237\t        self.override_download_url = override_download_url\n1238\t\n1239\t    @property\n1240\t    def cache_key(self) -> str:\n1241\t        key = f\"{self.server_url}/{self.project_path}\"\n1242\t        if self.override_download_url is not None:\n1243\t            key = f\"{key}+{self.override_download_url}\"\n1244\t        return key\n1245\t\n1246\t    @retry_on_exception(\n1247\t        exceptions=RETRYABLE_EXCEPTIONS,\n1248\t        max_attempts=5,\n1249\t        backoff_factor=1.5,\n1250\t        max_backoff=120.0,\n1251\t    )\n1252\t    def _find_tags(\n1253\t        self,\n1254\t        identifier: str,\n1255\t    ) -> Iterable[Candidate]:\n1256\t        nexturl: str = self.api_url\n1257\t        created_at: datetime.datetime | None\n1258\t        project_name = self.project_path.split(\"/\")[-1]\n1259\t        if self.override_download_url is None:\n1260\t            download_template = (\n1261\t                self.server_url\n1262\t                + \"/{project_path}/-/archive/{tagname}/{project_name}-{tagname}.tar.gz\"\n1263\t            )\n1264\t        else:\n1265\t            download_template = self.override_download_url\n1266\t        while nexturl:\n1267\t            resp: Response = session.get(nexturl)\n1268\t            resp.raise_for_status()\n1269\t            for entry in resp.json():\n1270\t                tagname = entry[\"name\"]\n1271\t                version = self._match_function(identifier, tagname)\n1272\t                if version is None:\n1273\t                    logger.debug(f\"{identifier}: match function ignores {tagname}\")\n1274\t                    continue\n1275\t                assert isinstance(version, Version)\n1276\t\n1277\t                url = download_template.format(\n1278\t                    hostname=self.server_hostname,\n1279\t                    project_path=self.project_path,\n1280\t                    project_name=project_name,\n1281\t                    tagname=tagname,\n1282\t                    version=version,\n1283\t                )\n1284\t\n1285\t                # get tag creation time, fall back to commit creation time\n1286\t                created_at_str: str | None = entry.get(\"created_at\")\n1287\t                if created_at_str is None:\n1288\t                    created_at_str = entry[\"commit\"].get(\"created_at\")\n1289\t\n1290\t                if created_at_str is not None:\n1291\t                    created_at = datetime.datetime.fromisoformat(\n1292\t                        created_at_str\n1293\t                    ).astimezone(datetime.UTC)\n1294\t                else:\n1295\t                    created_at = None\n1296\t\n1297\t                yield Candidate(\n1298\t                    name=identifier,\n1299\t                    version=version,\n1300\t                    url=url,\n1301\t                    remote_tag=tagname,\n1302\t                    remote_commit=entry[\"commit\"][\"id\"],\n1303\t                    upload_time=created_at,\n1304\t                )\n1305\t\n1306\t            # GitLab API uses Link headers for pagination\n1307\t            nexturl = resp.links.get(\"next\", {}).get(\"url\")\n1308\t\n1309\t\n1310\tclass VersionMapProvider(BaseProvider):\n1311\t    \"\"\"Lookup package versions from a VersionMap\n1312\t\n1313\t    This provider wraps a VersionMap instance to provide versions and URLs\n1314\t    for package resolution. The VersionMap should contain Version keys mapped\n1315\t    to URL strings.\n1316\t    \"\"\"\n1317\t\n1318\t    provider_description: typing.ClassVar[str] = (\n1319\t        \"VersionMap resolver (package: {self.package_name})\"\n1320\t    )\n1321\t\n1322\t    def __init__(\n1323\t        self,\n1324\t        version_map: VersionMap,\n1325\t        package_name: str | None,\n1326\t        constraints: Constraints | None = None,\n1327\t        *,\n1328\t        req_type: RequirementType | None = None,\n1329\t        use_resolver_cache: bool = True,\n1330\t    ) -> None:\n1331\t        if package_name is None:\n1332\t            use_resolver_cache = False\n1333\t        super().__init__(\n1334\t            constraints=constraints,\n1335\t            req_type=req_type,\n1336\t            use_resolver_cache=use_resolver_cache,\n1337\t        )\n1338\t        self.version_map = version_map\n1339\t        self.package_name = package_name\n1340\t\n1341\t    @property\n1342\t    def cache_key(self) -> str:\n1343\t        if self.package_name is None:\n1344\t            raise ValueError(\"Cannot cache VersionMapProvider without package name\")\n1345\t        return f\"versionmap:{self.package_name}\"\n1346\t\n1347\t    def find_candidates(self, identifier: str) -> Candidates:\n1348\t        \"\"\"Find candidates from the VersionMap\n1349\t\n1350\t        Iterates through all versions in the VersionMap and creates Candidate\n1351\t        objects with the associated URLs.\n1352\t        \"\"\"\n1353\t        candidates: list[Candidate] = []\n1354\t        for version in self.version_map.versions():\n1355\t            url = self.version_map[version]\n1356\t            candidate = Candidate(\n1357\t                name=identifier,\n1358\t                version=version,\n1359\t                url=url,\n1360\t            )\n1361\t            candidates.append(candidate)\n1362\t\n1363\t        return candidates\n1364\t"}]},"parent_tool_use_id":null,"session_id":"8e69fa9a-75ee-4abb-882a-eba058cff68b","uuid":"e02ada96-602d-4b04-a1f0-7b31f9ab90db","timestamp":"2026-10-09T17:19:47.348Z","tool_use_result":{"type":"text","file":{"filePath":"/home/alustosa/git/model-routing-eval/.work/agent-eval/2026-10-09-claude-haiku-5-5-effort-medium-r1/cases/r04_fromager_age_fallback/src/fromager/resolver.py","content":"# Based on https://github.com/sarugaku/resolvelib/blob/main/examples/pypi_wheel_provider.py\n#\n# Modified to look at sdists instead of wheels and to avoid trying to\n# resolve any dependencies.\n#\nfrom __future__ import annotations\n\nimport datetime\nimport functools\nimport logging\nimport os\nimport re\nimport typing\nfrom collections.abc import Iterable\nfrom operator import attrgetter\nfrom platform import python_version\nfrom urllib.parse import quote, urlparse\n\nimport pypi_simple\nimport resolvelib\nfrom packaging.requirements import Requirement\nfrom packaging.specifiers import InvalidSpecifier, SpecifierSet\nfrom packaging.tags import Tag, sys_tags\nfrom packaging.utils import (\n    BuildTag,\n    canonicalize_name,\n    parse_wheel_filename,\n)\nfrom packaging.version import Version\nfrom requests.models import Response\nfrom resolvelib.resolvers import RequirementInformation\n\nfrom . import overrides\nfrom .candidate import Candidate, Cooldown\nfrom .constraints import Constraints\nfrom .downloads import extract_filename_from_url as extract_filename_from_url\nfrom .extras_provider import ExtrasProvider\nfrom .http_retry import RETRYABLE_EXCEPTIONS, retry_on_exception\nfrom .request_session import session\nfrom .requirements_file import RequirementType\nfrom .versionmap import VersionMap\n\nif typing.TYPE_CHECKING:\n    from . import context\n\n\nlogger = logging.getLogger(__name__)\n\nPYTHON_VERSION = Version(python_version())\nDEBUG_RESOLVER = os.environ.get(\"DEBUG_RESOLVER\", \"\")\nPYPI_SERVER_URL = \"https://pypi.org/simple\"\nGITHUB_URL = \"https://github.com\"\n\n# all supported tags\nSUPPORTED_TAGS: frozenset[Tag] = frozenset(sys_tags())\n# same, but ignore the platform for 'ignore_platform' flag\nIGNORE_PLATFORM: str = \"ignore\"\nSUPPORTED_TAGS_IGNORE_PLATFORM: frozenset[Tag] = frozenset(\n    Tag(t.interpreter, t.abi, IGNORE_PLATFORM) for t in SUPPORTED_TAGS\n)\n\n\n@functools.lru_cache(maxsize=200)\ndef match_py_req(py_req: str, *, python_version: Version = PYTHON_VERSION) -> bool:\n    \"\"\"Python version requirement lookup with LRU cache\n\n    Raises InvalidSpecifier on error\n\n    SpecifierSet parsing and matching takes a non-trivial amount of time. A\n    bootstrap run can spend over 10% of its time in parsing and matching\n    Python version requirements.\n\n    This function caches the result of SpecifierSet parsing and contains\n    operation for Python version requirement. Most packages share similar\n    constraints, e.g. ``>= 3.10``.\n    \"\"\"\n    return python_version in SpecifierSet(py_req)\n\n\ndef resolve(\n    *,\n    ctx: context.WorkContext,\n    req: Requirement,\n    sdist_server_url: str,\n    include_sdists: bool = True,\n    include_wheels: bool = True,\n    req_type: RequirementType | None = None,\n    ignore_platform: bool = False,\n) -> tuple[str, Version]:\n    \"\"\"Resolve requirement and return the best matching version.\n\n    Returns (url, version) tuple for the highest matching version.\n    \"\"\"\n    # Create the (reusable) resolver.\n    provider = overrides.find_and_invoke(\n        req.name,\n        \"get_resolver_provider\",\n        default_resolver_provider,\n        ctx=ctx,\n        req=req,\n        include_sdists=include_sdists,\n        include_wheels=include_wheels,\n        sdist_server_url=sdist_server_url,\n        req_type=req_type,\n        ignore_platform=ignore_platform,\n    )\n    provider.cooldown = resolve_package_cooldown(ctx, req, req_type=req_type)\n    max_age_cutoff = _compute_max_age_cutoff(ctx)\n    results = find_all_matching_from_provider(\n        provider, req, max_age_cutoff=max_age_cutoff\n    )\n    return results[0]\n\n\ndef default_resolver_provider(\n    ctx: context.WorkContext,\n    req: Requirement,\n    sdist_server_url: str,\n    include_sdists: bool,\n    include_wheels: bool,\n    req_type: RequirementType | None = None,\n    ignore_platform: bool = False,\n) -> (\n    PyPIProvider\n    | GenericProvider\n    | GitHubTagProvider\n    | GitLabTagProvider\n    | VersionMapProvider\n):\n    \"\"\"Lookup resolver provider to resolve package versions\"\"\"\n    return PyPIProvider(\n        include_sdists=include_sdists,\n        include_wheels=include_wheels,\n        sdist_server_url=sdist_server_url,\n        constraints=ctx.constraints,\n        req_type=req_type,\n        ignore_platform=ignore_platform,\n    )\n\n\ndef _has_equality_pin(req: Requirement) -> bool:\n    \"\"\"Return True if the requirement has a single exact ``==`` pin.\n\n    Rejects wildcard pins (``==1.*``) and compound specifiers (``==1,>2``)\n    which are not true exact version pins.\n    \"\"\"\n    specs = list(req.specifier)\n    return len(specs) == 1 and specs[0].operator == \"==\" and \"*\" not in specs[0].version\n\n\ndef resolve_package_cooldown(\n    ctx: context.WorkContext,\n    req: Requirement,\n    req_type: RequirementType | None = None,\n) -> Cooldown | None:\n    \"\"\"Compute the effective cooldown for a single package.\n\n    Args:\n        ctx: The current work context (provides the global cooldown).\n        req: The package requirement being resolved.\n        req_type: The requirement type (top-level, install, etc.).\n\n    Returns:\n        The cooldown to pass to the provider, or ``None`` if disabled.\n    \"\"\"\n    if req_type == RequirementType.TOP_LEVEL and _has_equality_pin(req):\n        if ctx.cooldown is not None:\n            logger.info(\"cooldown bypassed as the top-level requirement uses == pin\")\n        return None\n\n    per_package_days = ctx.package_build_info(req).resolver_min_release_age\n    global_cooldown = ctx.cooldown\n    if per_package_days is None:\n        return global_cooldown\n    if per_package_days == 0:\n        return None\n    # Per-package positive override: inherit bootstrap_time from global so all\n    # resolutions in a single run share the same fixed cutoff point.\n    bootstrap_time = (\n        global_cooldown.bootstrap_time\n        if global_cooldown is not None\n        else datetime.datetime.now(datetime.UTC)\n    )\n    return Cooldown(\n        min_age=datetime.timedelta(days=per_package_days),\n        bootstrap_time=bootstrap_time,\n    )\n\n\ndef _compute_max_age_cutoff(\n    ctx: context.WorkContext,\n) -> datetime.datetime | None:\n    \"\"\"Compute the cutoff time for max release age filtering.\n\n    Returns the oldest acceptable upload time, or None if disabled.\n    Uses the cooldown's bootstrap_time for consistency across a single run.\n    \"\"\"\n    if ctx.max_release_age is None:\n        return None\n    bootstrap_time = (\n        ctx.cooldown.bootstrap_time\n        if ctx.cooldown is not None\n        else datetime.datetime.now(datetime.UTC)\n    )\n    return bootstrap_time - ctx.max_release_age\n\n\nclass LogReporter(resolvelib.BaseReporter):\n    \"\"\"Report resolution events\n\n    Implements part of the BaseReporter API to log a few events related to\n    resolving requirements.\n\n    \"\"\"\n\n    def __init__(self, req: Requirement):\n        self.req = req\n        super().__init__()\n\n    def _report(self, msg: str, *args: typing.Any) -> None:\n        logger.info(msg, *args)\n\n    def starting(self) -> None:\n        self._report(\"looking for candidates for %r\", self.req)\n\n    def rejecting_candidate(self, criterion: typing.Any, candidate: typing.Any) -> None:\n        self._report(\"resolver rejecting candidate %s: %s\", candidate, criterion)\n\n    def pinning(self, candidate: typing.Any) -> None:\n        self._report(\"selecting %s\", candidate)\n\n    def ending(self, state: typing.Any) -> None:\n        self._report(\"successfully resolved %r\", self.req)\n\n\ndef find_all_matching_from_provider(\n    provider: BaseProvider,\n    req: Requirement,\n    max_age_cutoff: datetime.datetime | None = None,\n    fallback_on_empty_age_filter: bool = True,\n) -> list[tuple[str, Version]]:\n    \"\"\"Find all matching candidates from provider without full dependency resolution.\n\n    This function collects ALL candidates that match the requirement, rather than\n    performing full dependency resolution to find a single best candidate.\n\n    Args:\n        provider: The provider to query for candidates.\n        req: The requirement to match.\n        max_age_cutoff: If set, reject candidates published before this time.\n            If all candidates are older than the cutoff, all are kept and\n            a warning is emitted to avoid empty resolution.\n        fallback_on_empty_age_filter: If ``True`` (default), keep all\n            candidates when age filtering would produce an empty result.\n            If ``False``, return an empty list instead, allowing the\n            caller to implement its own fallback strategy.\n\n    Returns list of (url, version) tuples sorted by version (highest first).\n\n    IMPORTANT: This bypasses resolvelib's full resolver to collect all matching\n    candidates. This is safe ONLY because BaseProvider.get_dependencies() returns\n    an empty list (no transitive dependencies to resolve). The empty incompatibilities\n    dict means no version is ever excluded based on conflicts.\n\n    If get_dependencies() is ever extended to return actual dependencies, this\n    function must be revisited to use resolvelib's full resolution algorithm\n    (Resolver.resolve()) to properly handle dependency conflicts and backtracking.\n    \"\"\"\n    # Get all matching candidates directly from provider\n    # instead of using resolvelib's resolver which picks just one\n    identifier = provider.identify(req)\n    try:\n        # Bypass resolvelib's resolver to collect all matching candidates rather than\n        # just the single best one. This is safe because get_dependencies() returns []\n        # (no transitive deps to resolve). If get_dependencies() is ever extended,\n        # this must be revisited to use resolvelib's full resolution.\n        candidates = provider.find_matches(\n            identifier=identifier,\n            requirements={identifier: [req]},\n            incompatibilities={},  # Empty - safe only because no transitive deps\n        )\n    except resolvelib.resolvers.ResolverException as err:\n        constraint = provider.constraints.get_constraint(req.name)\n        provider_desc = provider.get_provider_description()\n        original_msg = str(err)\n        raise resolvelib.resolvers.ResolverException(\n            f\"Unable to resolve requirement specifier {req} with constraint {constraint} using {provider_desc}: {original_msg}\"\n        ) from err\n\n    # Materialize candidates so we can iterate more than once if filtering\n    candidates_list = list(candidates)\n\n    if max_age_cutoff is not None:\n        logger.info(\n            \"%s: found %d candidate(s) matching %s\",\n            req.name,\n            len(candidates_list),\n            req,\n        )\n        max_age_days = (datetime.datetime.now(datetime.UTC) - max_age_cutoff).days\n        filtered = [\n            c\n            for c in candidates_list\n            if c.upload_time is None or c.upload_time >= max_age_cutoff\n        ]\n        dropped = len(candidates_list) - len(filtered)\n        if dropped:\n            logger.info(\n                \"%s: have %d candidate(s) of %s published within %d days\",\n                req.name,\n                len(filtered),\n                req,\n                max_age_days,\n            )\n        if filtered:\n            candidates_list = filtered\n        elif fallback_on_empty_age_filter:\n            logger.warning(\n                \"%s: all %d candidate(s) of %s are older than %d days, \"\n                \"keeping all to avoid empty resolution\",\n                req.name,\n                len(candidates_list),\n                req,\n                max_age_days,\n            )\n        else:\n            logger.info(\n                \"%s: all %d candidate(s) of %s are older than %d days\",\n                req.name,\n                len(candidates_list),\n                req,\n                max_age_days,\n            )\n            candidates_list = []\n\n    # Convert candidates to list of (url, version) tuples\n    # Candidates are sorted by version (highest first) by BaseProvider.find_matches()\n    # which calls sorted(candidates, key=attrgetter(\"version\", \"build_tag\"), reverse=True)\n    return [(c.url, c.version) for c in candidates_list]\n\n\ndef get_project_from_pypi(\n    project: str,\n    extras: typing.Iterable[str],\n    sdist_server_url: str,\n    ignore_platform: bool = False,\n    *,\n    override_download_url: str | None = None,\n) -> Candidates:\n    \"\"\"Fetch and filter package candidates from a PyPI-compatible server.\n\n    Filters the project's package list by: project status, filename\n    validity, package type (sdist/wheel), yanked status, Python version\n    compatibility, and platform tags. Can substitute\n    ``override_download_url`` into each candidate's URL.\n    \"\"\"\n    found_candidates: set[str] = set()\n    ignored_candidates: set[str] = set()\n    logger.debug(\"%s: getting available versions from %s\", project, sdist_server_url)\n\n    client = pypi_simple.PyPISimple(\n        endpoint=sdist_server_url,\n        session=session,\n        accept=pypi_simple.ACCEPT_JSON_PREFERRED,\n    )\n    try:\n        package = client.get_project_page(project)\n    except pypi_simple.errors.NoSuchProjectError as e:\n        raise resolvelib.resolvers.ResolverException(\n            f\"project {project} not found on {sdist_server_url}\"\n        ) from e\n    except Exception as e:\n        logger.debug(\n            \"failed to fetch package index from %s: %s\",\n            sdist_server_url,\n            e,\n        )\n        raise\n\n    # PEP 792 package status\n    match package.status:\n        case None:\n            logger.debug(\"no package status\")\n        case pypi_simple.ProjectStatus.ACTIVE:\n            logger.debug(\"project %r is active: %s\", project, package.status_reason)\n        case pypi_simple.ProjectStatus.DEPRECATED | pypi_simple.ProjectStatus.ARCHIVED:\n            logger.warning(\n                \"project %r is no longer active: %r: %s\",\n                project,\n                package.status,\n                package.status_reason,\n            )\n        case pypi_simple.ProjectStatus.QUARANTINED:\n            raise ValueError(\n                f\"project {project!r} is quarantined: {package.status_reason}\"\n            )\n        case _:\n            logger.warning(\n                \"project %r has unknown status %r: %s\",\n                project,\n                package.status,\n                package.status_reason,\n            )\n\n    for dp in package.packages:\n        found_candidates.add(dp.filename)\n        if DEBUG_RESOLVER:\n            logger.debug(\"candidate %r -> %r==%r\", dp.url, dp.filename, dp.version)\n\n        if (\n            dp.project is None\n            or dp.version is None\n            or dp.package_type is None\n            or len(dp.project) != len(project)\n        ):\n            # Legacy file names that pypi_simple does not understand,\n            # pypi_simple sets one or all fields to None.\n            #\n            # Look for and ignore cases like `cffi-1.0.2-2.tar.gz` which\n            # produces the name `cffi-1-0-2`. We can't just compare the\n            # names directly because of case and punctuation changes in\n            # making names canonical and the way requirements are\n            # expressed and there seems to be *no* way of producing sdist\n            # filenames consistently, so we compare the length for this\n            # case.\n            if DEBUG_RESOLVER:\n                logger.debug(\n                    \"skipping %r because 'pypi_simple' could not parse it or it's an invalid name\",\n                    dp.filename,\n                )\n            ignored_candidates.add(dp.filename)\n            continue\n\n        if dp.package_type not in {\"sdist\", \"wheel\"}:\n            if DEBUG_RESOLVER:\n                logger.debug(\n                    \"skipping %r because it's not an sdist or wheel, got %r\",\n                    dp.filename,\n                    dp.package_type,\n                )\n            ignored_candidates.add(dp.filename)\n            continue\n\n        # PEP 592: Skip items that were yanked\n        if dp.is_yanked:\n            if DEBUG_RESOLVER:\n                logger.debug(\n                    \"skipping %s because it was yanked (%s)\",\n                    dp.filename,\n                    dp.yanked_reason,\n                )\n            ignored_candidates.add(dp.filename)\n            continue\n\n        # Skip items that need a different Python version\n        if dp.requires_python:\n            try:\n                matched_py: bool = match_py_req(dp.requires_python)\n            except InvalidSpecifier as err:\n                # Ignore files with invalid python specifiers\n                # e.g. shellingham has files with \">= '2.7'\"\n                if DEBUG_RESOLVER:\n                    logger.debug(\n                        \"skipping %r because of an invalid python version specifier %r: %s\",\n                        dp.filename,\n                        dp.requires_python,\n                        err,\n                    )\n                ignored_candidates.add(dp.filename)\n                continue\n            if not matched_py:\n                if DEBUG_RESOLVER:\n                    logger.debug(\n                        \"skipping %r because of python version %r\",\n                        dp.filename,\n                        dp.requires_python,\n                    )\n                ignored_candidates.add(dp.filename)\n                continue\n\n        # TODO: Handle compatibility tags?\n\n        try:\n            if dp.package_type == \"sdist\":\n                is_sdist = True\n                name: str = dp.project\n                version: Version = Version(dp.version)\n                tags: frozenset[Tag] = frozenset()\n                build_tag: BuildTag = ()\n            else:\n                is_sdist = False\n                name, version, build_tag, tags = parse_wheel_filename(dp.filename)\n        except Exception as err:\n            # Ignore files with invalid versions\n            if DEBUG_RESOLVER:\n                logger.debug(\"could not determine version for %r: %s\", dp.filename, err)\n            ignored_candidates.add(dp.filename)\n            continue\n\n        if tags:\n            # FIXME: This doesn't take into account precedence of\n            # the supported tags for best fit.\n            matching_tags = SUPPORTED_TAGS.intersection(tags)\n            if not matching_tags and ignore_platform:\n                if DEBUG_RESOLVER:\n                    logger.debug(\"ignoring platform for %r\", dp.filename)\n                ignore_platform_tags: frozenset[Tag] = frozenset(\n                    Tag(t.interpreter, t.abi, IGNORE_PLATFORM) for t in tags\n                )\n                matching_tags = SUPPORTED_TAGS_IGNORE_PLATFORM.intersection(\n                    ignore_platform_tags\n                )\n            if not matching_tags:\n                if DEBUG_RESOLVER:\n                    logger.debug(\"ignoring %r with tags %r\", dp.filename, tags)\n                ignored_candidates.add(dp.filename)\n                continue\n\n        if override_download_url is None:\n            url = dp.url\n        else:\n            url = override_download_url.format(version=version)\n\n        upload_time = dp.upload_time\n        if upload_time is not None:\n            upload_time = upload_time.astimezone(datetime.UTC)\n\n        c = Candidate(\n            name=name,\n            version=version,\n            url=url,\n            extras=tuple(sorted(extras)),\n            is_sdist=is_sdist,\n            build_tag=build_tag,\n            has_metadata=bool(dp.has_metadata),\n            upload_time=upload_time,\n        )\n        if DEBUG_RESOLVER:\n            logger.debug(\"candidate %s (%s) %s\", dp.filename, c, dp.url)\n        yield c\n\n    if not found_candidates:\n        logger.info(\"found no candidate files at %s\", sdist_server_url)\n    elif ignored_candidates == found_candidates:\n        logger.info(\"ignored all candidate files at %s\", sdist_server_url)\n\n\ntype RequirementsMap = typing.Mapping[str, typing.Iterable[Requirement]]\ntype Candidates = typing.Iterable[Candidate]\ntype CandidatesMap = typing.Mapping[str, Candidates]\n# {identifier: [cls, cachekey]: list[candidates]}}\ntype ResolverCache = dict[str, dict[tuple[type[ExtrasProvider], str], list[Candidate]]]\ntype VersionSource = typing.Callable[\n    [str],\n    typing.Iterable[Candidate | tuple[str, str | Version]],\n]\n\n\nclass BaseProvider(ExtrasProvider):\n    resolver_cache: typing.ClassVar[ResolverCache] = {}\n    provider_description: typing.ClassVar[str]\n    _cooldown_unsupported_warned: typing.ClassVar[set[str]] = set()\n\n    def __init__(\n        self,\n        *,\n        constraints: Constraints | None = None,\n        req_type: RequirementType | None = None,\n        use_resolver_cache: bool = True,\n        cooldown: Cooldown | None = None,\n    ):\n        super().__init__()\n        self.constraints = constraints or Constraints()\n        self.req_type = req_type\n        self.use_cache_candidates = use_resolver_cache\n\n        # cooldown specific settings\n        self.cooldown = cooldown\n        # Does this provider supply upload timestamps for candidates?\n        # Defaults to False (safe/unknown). Subclasses that reliably populate\n        # upload_time on every candidate should set this to True in their __init__.\n        # When a cooldown is active and this is False, the cooldown check is\n        # skipped with a warning rather than failing closed.\n        self.supports_upload_time: bool = False\n\n    @property\n    def cache_key(self) -> str:\n        \"\"\"Return cache key for the provider\n\n        The cache key must be unique for each provider configuration, e.g.\n        PyPI URL, GitHub org + repo, ...\n        \"\"\"\n        raise NotImplementedError()\n\n    def get_provider_description(self) -> str:\n        \"\"\"Return a human-readable description of the provider type\n\n        This is used in error messages to indicate what resolver was being used.\n        The ClassVar `provider_description` must be set by each subclass.\n        If it contains format placeholders like {self.attr}, it will be formatted\n        with the instance. Strings without placeholders are returned unchanged.\n        \"\"\"\n        return self.provider_description.format(self=self)\n\n    def find_candidates(self, identifier: str) -> Candidates:\n        \"\"\"Find unfiltered candidates\"\"\"\n        raise NotImplementedError()\n\n    def identify(self, requirement_or_candidate: Requirement | Candidate) -> str:\n        return canonicalize_name(requirement_or_candidate.name)\n\n    @classmethod\n    def clear_cache(cls, identifier: str | None = None) -> None:\n        \"\"\"Clear global resolver cache\n\n        ``None`` clears all caches, an ``identifier`` string clears the\n        cache for an identifier. Raises :exc:`KeyError` for unknown\n        identifiers.\n        \"\"\"\n        if identifier is None:\n            cls.resolver_cache.clear()\n        else:\n            cls.resolver_cache.pop(canonicalize_name(identifier))\n\n    def get_extras_for(\n        self,\n        requirement_or_candidate: Requirement | Candidate,\n    ) -> typing.Iterable[str]:\n        # Extras is a set, which is not hashable\n        if requirement_or_candidate.extras:\n            return tuple(sorted(requirement_or_candidate.extras))\n        return tuple()\n\n    def get_base_requirement(self, candidate: Candidate) -> Requirement:\n        return Requirement(f\"{candidate.name}=={candidate.version}\")\n\n    def validate_candidate(\n        self,\n        identifier: str,\n        requirements: RequirementsMap,\n        incompatibilities: CandidatesMap,\n        candidate: Candidate,\n    ) -> bool:\n        identifier_reqs = list(requirements.get(identifier, []))\n        bad_versions = {c.version for c in incompatibilities.get(identifier, [])}\n        # Skip versions that are known bad\n        if candidate.version in bad_versions:\n            if DEBUG_RESOLVER:\n                logger.debug(\n                    f\"{identifier}: skipping bad version {candidate.version} from {bad_versions}\"\n                )\n            return False\n        for r in identifier_reqs:\n            if self.is_satisfied_by(requirement=r, candidate=candidate):\n                return True\n        return False\n\n    def get_preference(\n        self,\n        identifier: str,\n        resolutions: typing.Mapping[str, Candidate],\n        candidates: CandidatesMap,\n        information: typing.Mapping[\n            str, typing.Iterable[RequirementInformation[Requirement, Candidate]]\n        ],\n        backtrack_causes: typing.Sequence[\n            RequirementInformation[Requirement, Candidate]\n        ],\n    ) -> int:\n        return sum(1 for _ in candidates[identifier])\n\n    def is_satisfied_by(self, requirement: Requirement, candidate: Candidate) -> bool:\n        if canonicalize_name(requirement.name) != candidate.name:\n            return False\n        allow_prerelease = self.constraints.allow_prerelease(requirement.name) or bool(\n            requirement.specifier.prereleases\n        )\n        if not requirement.specifier.contains(\n            candidate.version, prereleases=allow_prerelease\n        ):\n            if DEBUG_RESOLVER:\n                logger.debug(\n                    f\"{requirement.name}: skipping candidate version {candidate.version} because it does not match {requirement.specifier}\"\n                )\n            return False\n\n        if not self.constraints.is_satisfied_by(requirement.name, candidate.version):\n            if DEBUG_RESOLVER:\n                c = self.constraints.get_constraint(requirement.name)\n                logger.debug(\n                    f\"{requirement.name}: skipping {candidate.version} due to constraint {c}\"\n                )\n            return False\n\n        return True\n\n    def is_blocked_by_cooldown(self, candidate: Candidate) -> bool:\n        \"\"\"Return True if the candidate is rejected by the release-age cooldown.\"\"\"\n\n        # a cooldown is not specified...\n        if self.cooldown is None:\n            return False\n\n        # the target candidate doesn't provide a valid upload timestamp\n        if candidate.upload_time is None:\n            if not self.supports_upload_time:\n                # this provider does not yet support timestamp retrieval (e.g. GitHub).\n                # Warn once per package name across all provider instances.\n                if candidate.name not in BaseProvider._cooldown_unsupported_warned:\n                    BaseProvider._cooldown_unsupported_warned.add(candidate.name)\n                    logger.warning(\n                        \"release-age cooldown cannot be enforced — upload \"\n                        \"timestamp support is not yet implemented for %s; \"\n                        \"cooldown check skipped\",\n                        self.get_provider_description(),\n                    )\n                return False\n            # this provider is expected to supply timestamps,\n            # but this candidate is missing one.\n            # Fail closed: we cannot verify the age of this candidate, so reject it.\n            if DEBUG_RESOLVER:\n                logger.debug(\n                    \"skipping %s — upload_time unknown, required for cooldown\",\n                    candidate.version,\n                )\n            return True\n\n        # cooldowns are enabled, and this candidate has a valid upload timestamp\n        # so we can do the math to determine whether or not the candidate should\n        # be blocked/skipped\n        cutoff = self.cooldown.bootstrap_time - self.cooldown.min_age\n        if candidate.upload_time > cutoff:\n            # if this candidate is \"too new\", block/skip it\n            if DEBUG_RESOLVER:\n                age = self.cooldown.bootstrap_time - candidate.upload_time\n                logger.debug(\n                    \"skipping %s uploaded %s ago (cooldown: %s)\",\n                    candidate.version,\n                    age,\n                    self.cooldown.min_age,\n                )\n            return True\n        return False\n\n    def get_dependencies(self, candidate: Candidate) -> list[Requirement]:\n        # return candidate.dependencies\n        return []\n\n    def _get_cached_candidates(self, identifier: str) -> list[Candidate]:\n        \"\"\"Get list of cached candidates for identifier and provider\n\n        The method always returns a list. If the cache did not have an entry\n        before, a new empty list is stored in the cache and returned to the\n        caller. The caller can mutate the list in place to update the cache.\n        \"\"\"\n        cls = type(self)\n        provider_cache = cls.resolver_cache.setdefault(identifier, {})\n        candidate_cache = provider_cache.setdefault((cls, self.cache_key), [])\n        return candidate_cache\n\n    def _find_cached_candidates(self, identifier: str) -> Candidates:\n        \"\"\"Find candidates with caching\"\"\"\n        cached_candidates: list[Candidate] = []\n        if self.use_cache_candidates:\n            cached_candidates = self._get_cached_candidates(identifier)\n            if cached_candidates:\n                logger.debug(\n                    \"%s: use %i cached candidates\",\n                    identifier,\n                    len(cached_candidates),\n                )\n                return cached_candidates\n        candidates = list(self.find_candidates(identifier))\n        if self.use_cache_candidates:\n            # mutate list object in-place\n            cached_candidates[:] = candidates\n            logger.debug(\n                \"%s: cache %i unfiltered candidates\",\n                identifier,\n                len(candidates),\n            )\n        else:\n            logger.debug(\n                \"%s: got %i unfiltered candidates, ignoring cache\",\n                identifier,\n                len(candidates),\n            )\n        return candidates\n\n    def _get_no_match_error_message(\n        self, identifier: str, requirements: RequirementsMap\n    ) -> str:\n        \"\"\"Generate an error message when no candidates are found.\n\n        Subclasses should override this to provide provider-specific error details.\n        \"\"\"\n        reqs = requirements.get(identifier, [])\n        if reqs:\n            r = next(iter(reqs))\n            return f\"found no match for {r} using {self.get_provider_description()}\"\n        return f\"found no match for identifier {identifier} using {self.get_provider_description()}\"\n\n    def find_matches(\n        self,\n        identifier: str,\n        requirements: RequirementsMap,\n        incompatibilities: CandidatesMap,\n    ) -> Candidates:\n        \"\"\"Find matching candidates, sorted by version and build tag\"\"\"\n        unfiltered_candidates = self._find_cached_candidates(identifier)\n        candidates = [\n            candidate\n            for candidate in unfiltered_candidates\n            if self.validate_candidate(\n                identifier, requirements, incompatibilities, candidate\n            )\n        ]\n        # Apply cooldown filtering after specifier/constraint validation\n        blocked = [c for c in candidates if self.is_blocked_by_cooldown(c)]\n        if blocked:\n            for b in blocked:\n                candidates.remove(b)\n            versions = \", \".join(str(b.version) for b in blocked)\n            logger.info(\n                \"cooldown blocked %d version(s): %s\",\n                len(blocked),\n                versions,\n            )\n        if not candidates:\n            raise resolvelib.resolvers.ResolverException(\n                self._get_no_match_error_message(identifier, requirements)\n            )\n        return sorted(candidates, key=attrgetter(\"version\", \"build_tag\"), reverse=True)\n\n\nclass PyPIProvider(BaseProvider):\n    \"\"\"Lookup package and versions from a simple Python index (PyPI)\n\n    The ``override_download_url`` parameter supports the string template variable:\n    * version (Version object)\n    \"\"\"\n\n    provider_description: typing.ClassVar[str] = (\n        \"PyPI resolver (searching at {self.sdist_server_url})\"\n    )\n\n    def __init__(\n        self,\n        include_sdists: bool = True,\n        include_wheels: bool = True,\n        sdist_server_url: str = \"https://pypi.org/simple/\",\n        constraints: Constraints | None = None,\n        req_type: RequirementType | None = None,\n        ignore_platform: bool = False,\n        *,\n        use_resolver_cache: bool = True,\n        override_download_url: str | None = None,\n        cooldown: Cooldown | None = None,\n        supports_upload_time: bool | None = None,\n    ):\n        super().__init__(\n            constraints=constraints,\n            req_type=req_type,\n            use_resolver_cache=use_resolver_cache,\n            cooldown=cooldown,\n        )\n\n        # Only pypi.org reliably supports PEP 691 upload timestamps.\n        # Default to True for pypi.org, False for all other indexes.\n        if supports_upload_time is None:\n            supports_upload_time = sdist_server_url.startswith(PYPI_SERVER_URL)\n        self.supports_upload_time = supports_upload_time\n        self.include_sdists = include_sdists\n        self.include_wheels = include_wheels\n        self.sdist_server_url = sdist_server_url\n        self.ignore_platform = ignore_platform\n        self.override_download_url = override_download_url\n\n    @property\n    def cache_key(self) -> str:\n        # ignore platform parameter changes behavior of find_candidates()\n        key = self.sdist_server_url\n        if self.override_download_url is not None:\n            key = f\"{key}+{self.override_download_url}\"\n        if self.ignore_platform:\n            key = f\"{key}+ignore_platform\"\n        return key\n\n    def find_candidates(self, identifier: str) -> Candidates:\n        return get_project_from_pypi(\n            identifier,\n            extras=set(),\n            sdist_server_url=self.sdist_server_url,\n            ignore_platform=self.ignore_platform,\n            override_download_url=self.override_download_url,\n        )\n\n    def validate_candidate(\n        self,\n        identifier: str,\n        requirements: RequirementsMap,\n        incompatibilities: CandidatesMap,\n        candidate: Candidate,\n    ) -> bool:\n        if not super().validate_candidate(\n            identifier, requirements, incompatibilities, candidate\n        ):\n            return False\n        # Only include sdists if we're asked to\n        if candidate.is_sdist and not self.include_sdists:\n            if DEBUG_RESOLVER:\n                logger.debug(\n                    f\"{identifier}: skipping {candidate} because it is an sdist\"\n                )\n            return False\n        # Only include wheels if we're asked to\n        if not candidate.is_sdist and not self.include_wheels:\n            if DEBUG_RESOLVER:\n                logger.debug(\n                    f\"{identifier}: skipping {candidate} because it is a wheel\"\n                )\n            return False\n        return True\n\n    def _get_no_match_error_message(\n        self, identifier: str, requirements: RequirementsMap\n    ) -> str:\n        \"\"\"Generate a PyPI-specific error message with file type and pre-release details.\"\"\"\n        r = next(iter(requirements[identifier]))\n\n        # Determine if pre-releases are allowed\n        req_allows_prerelease = bool(r.specifier) and bool(r.specifier.prereleases)\n        allow_prerelease = (\n            self.constraints.allow_prerelease(r.name) or req_allows_prerelease\n        )\n        prerelease_info = \"including\" if allow_prerelease else \"ignoring\"\n\n        # Determine the file type that was allowed\n        if self.include_sdists and self.include_wheels:\n            file_type_info = \"any file type\"\n        elif self.include_sdists:\n            file_type_info = \"sdists\"\n        else:\n            file_type_info = \"wheels\"\n\n        # If a cooldown is active, check whether it's responsible for the\n        # failure so we can give a more actionable error message.\n        if self.cooldown is not None:\n            cutoff = self.cooldown.bootstrap_time - self.cooldown.min_age\n            all_candidates = list(self._find_cached_candidates(identifier))\n            missing_time = [c for c in all_candidates if c.upload_time is None]\n            cooldown_blocked = [\n                c\n                for c in all_candidates\n                if c.upload_time is not None and c.upload_time > cutoff\n            ]\n            if missing_time and not cooldown_blocked:\n                return (\n                    f\"found {len(missing_time)} candidate(s) for {r} but none have \"\n                    f\"upload timestamp metadata; {self.sdist_server_url!r} may not \"\n                    f\"support PEP 691 (JSON API), which is required to enforce the \"\n                    f\"{self.cooldown.min_age.days}-day release-age cooldown\"\n                )\n            if cooldown_blocked:\n                oldest_days = min(\n                    (self.cooldown.bootstrap_time - c.upload_time).days\n                    for c in cooldown_blocked\n                    if c.upload_time is not None\n                )\n                return (\n                    f\"found {len(cooldown_blocked)} candidate(s) for {r} but all \"\n                    f\"were published within the last {self.cooldown.min_age.days} days \"\n                    f\"(release-age cooldown; oldest is {oldest_days} day(s) old)\"\n                )\n\n        return (\n            f\"found no match for {r} using {self.get_provider_description()}, \"\n            f\"searching for {file_type_info}, {prerelease_info} pre-release versions\"\n        )\n\n    def find_matches(\n        self,\n        identifier: str,\n        requirements: RequirementsMap,\n        incompatibilities: CandidatesMap,\n    ) -> Candidates:\n        return super().find_matches(identifier, requirements, incompatibilities)\n\n\nclass MatchFunction(typing.Protocol):\n    def __call__(self, identifier: str, item: str) -> Version | None:\n        pass\n\n\nclass GenericProvider(BaseProvider):\n    \"\"\"Lookup package and version by using a callback\"\"\"\n\n    def __init__(\n        self,\n        version_source: VersionSource,\n        constraints: Constraints | None = None,\n        req_type: RequirementType | None = None,\n        matcher: MatchFunction | re.Pattern | None = None,\n        *,\n        # generic provider does not implement caching\n        use_resolver_cache: bool = False,\n        cooldown: Cooldown | None = None,\n    ):\n        super().__init__(\n            constraints=constraints,\n            req_type=req_type,\n            use_resolver_cache=use_resolver_cache,\n            cooldown=cooldown,\n        )\n        self._version_source = version_source\n        if matcher is None:\n            self._match_function = self._default_match_function\n        elif isinstance(matcher, re.Pattern):\n            self._match_function = functools.partial(\n                self._re_match_function, regex=matcher\n            )\n        else:\n            self._match_function = matcher\n\n    def _default_match_function(self, identifier: str, item: str) -> Version | None:\n        try:\n            return Version(item)\n        except Exception as err:\n            logger.debug(f\"{identifier}: could not parse version from {item}: {err}\")\n            return None\n\n    def _re_match_function(\n        self, identifier: str, item: str, *, regex: re.Pattern\n    ) -> Version | None:\n        mo = regex.match(item)\n        if mo is None:\n            logger.debug(\n                f\"{identifier}: tag {item} does not match pattern {regex.pattern}\"\n            )\n            return None\n        value = mo.group(1)\n        try:\n            return Version(value)\n        except Exception as err:\n            logger.debug(f\"{identifier}: could not parse version from {value}: {err}\")\n            return None\n\n    provider_description: typing.ClassVar[str] = \"custom resolver (GenericProvider)\"\n\n    @property\n    def cache_key(self) -> str:\n        raise NotImplementedError(\"GenericProvider does not implement caching\")\n\n    def find_candidates(self, identifier: typing.Any) -> Candidates:\n        \"\"\"Find matching candidates from the version source.\n\n        Accepts three input formats from _version_source:\n        1. Candidate objects (used directly)\n        2. (url, Version) tuples\n        3. (url, str) tuples (version parsed via _match_function)\n        \"\"\"\n        candidates: list[Candidate] = []\n        version: Version | None\n        for item in self._version_source(identifier):\n            if isinstance(item, Candidate):\n                candidate = item\n            else:\n                # TODO: deprecate (url, version_or_string)\n                url, version_or_string = item\n                if isinstance(version_or_string, Version):\n                    version = version_or_string\n                else:\n                    match_result = self._match_function(identifier, version_or_string)\n                    if match_result is None:\n                        logger.debug(\n                            f\"{identifier}: match function ignores {version_or_string}\"\n                        )\n                        continue\n                    assert isinstance(match_result, Version)\n                    version = match_result\n\n                candidate = Candidate(name=identifier, version=version, url=url)\n\n            candidates.append(candidate)\n\n        return candidates\n\n\nclass GitHubTagProvider(GenericProvider):\n    \"\"\"Lookup tarball and version from GitHub git tags\n\n    Assumes that upstream uses version tags `1.2.3` or `v1.2.3`.\n\n    The ``override_download_url`` parameter supports the string template variable:\n    * organization\n    * repo\n    * tagname\n    * version (Version object)\n    \"\"\"\n\n    provider_description: typing.ClassVar[str] = (\n        \"GitHub tag resolver (repository: {self.organization}/{self.repo})\"\n    )\n    host = \"github.com:443\"\n    api_url = \"https://api.{self.host}/repos/{self.organization}/{self.repo}/tags\"\n\n    def __init__(\n        self,\n        organization: str,\n        repo: str,\n        constraints: Constraints | None = None,\n        matcher: MatchFunction | re.Pattern | None = None,\n        *,\n        req_type: RequirementType | None = None,\n        use_resolver_cache: bool = True,\n        override_download_url: str | None = None,\n        cooldown: Cooldown | None = None,\n    ):\n        super().__init__(\n            constraints=constraints,\n            req_type=req_type,\n            use_resolver_cache=use_resolver_cache,\n            version_source=self._find_tags,\n            matcher=matcher,\n            cooldown=cooldown,\n        )\n        self.organization = organization\n        self.repo = repo\n        self.override_download_url = override_download_url\n\n    @property\n    def cache_key(self) -> str:\n        key = f\"{self.organization}/{self.repo}\"\n        if self.override_download_url is not None:\n            key = f\"{key}+{self.override_download_url}\"\n        return key\n\n    @retry_on_exception(\n        exceptions=RETRYABLE_EXCEPTIONS,\n        max_attempts=5,\n        backoff_factor=1.5,\n        max_backoff=120.0,\n    )\n    def _find_tags(\n        self,\n        identifier: str,\n    ) -> Iterable[Candidate]:\n        headers = {\"accept\": \"application/vnd.github+json\"}\n        nexturl = self.api_url.format(self=self)\n        while nexturl:\n            resp = session.get(nexturl, headers=headers)\n            resp.raise_for_status()\n\n            for entry in resp.json():\n                tagname = entry[\"name\"]\n                version = self._match_function(identifier, tagname)\n                if version is None:\n                    logger.debug(f\"{identifier}: match function ignores {tagname}\")\n                    continue\n                assert isinstance(version, Version)\n\n                if self.override_download_url is None:\n                    url = entry[\"tarball_url\"]\n                else:\n                    url = self.override_download_url.format(\n                        organization=self.organization,\n                        repo=self.repo,\n                        tagname=tagname,\n                        version=version,\n                    )\n\n                # Github tag API endpoint does not include commit date information.\n                # It would be too expensive to query every commit API endpoint.\n                yield Candidate(\n                    name=identifier,\n                    version=version,\n                    url=url,\n                    remote_tag=tagname,\n                    remote_commit=entry[\"commit\"][\"sha\"],\n                    upload_time=None,\n                )\n\n            # pagination links\n            nexturl = resp.links.get(\"next\", {}).get(\"url\")\n\n\nclass GitLabTagProvider(GenericProvider):\n    \"\"\"Lookup tarball and version from GitLab git tags\n\n    The ``override_download_url`` parameter supports the string template variable:\n    * hostname\n    * project_path\n    * project_name (last component of project_path)\n    * tagname\n    * version (Version object)\n    \"\"\"\n\n    provider_description: typing.ClassVar[str] = (\n        \"GitLab tag resolver (project: {self.server_url}/{self.project_path})\"\n    )\n\n    def __init__(\n        self,\n        project_path: str,\n        server_url: str = \"https://gitlab.com\",\n        constraints: Constraints | None = None,\n        matcher: MatchFunction | re.Pattern | None = None,\n        *,\n        req_type: RequirementType | None = None,\n        use_resolver_cache: bool = True,\n        override_download_url: str | None = None,\n        cooldown: Cooldown | None = None,\n    ) -> None:\n        super().__init__(\n            constraints=constraints,\n            req_type=req_type,\n            use_resolver_cache=use_resolver_cache,\n            version_source=self._find_tags,\n            matcher=matcher,\n            cooldown=cooldown,\n        )\n        self.supports_upload_time = True\n        self.server_url = server_url.rstrip(\"/\")\n        self.server_hostname = urlparse(server_url).hostname\n        if not self.server_hostname:\n            raise ValueError(f\"invalid {server_url=}\")\n        self.project_path = project_path.lstrip(\"/\")\n        # URL-encode the project path as required by GitLab API.\n        # The safe=\"\" parameter tells quote() to encode ALL characters,\n        # including forward slashes (/), which would otherwise be left\n        # unencoded. This ensures paths like \"group/subgroup/project\"\n        # become \"group%2Fsubgroup%2Fproject\" as required by the API.\n        encoded_path: str = quote(self.project_path, safe=\"\")\n        self.api_url = (\n            f\"{self.server_url}/api/v4/projects/{encoded_path}/repository/tags\"\n        )\n        self.override_download_url = override_download_url\n\n    @property\n    def cache_key(self) -> str:\n        key = f\"{self.server_url}/{self.project_path}\"\n        if self.override_download_url is not None:\n            key = f\"{key}+{self.override_download_url}\"\n        return key\n\n    @retry_on_exception(\n        exceptions=RETRYABLE_EXCEPTIONS,\n        max_attempts=5,\n        backoff_factor=1.5,\n        max_backoff=120.0,\n    )\n    def _find_tags(\n        self,\n        identifier: str,\n    ) -> Iterable[Candidate]:\n        nexturl: str = self.api_url\n        created_at: datetime.datetime | None\n        project_name = self.project_path.split(\"/\")[-1]\n        if self.override_download_url is None:\n            download_template = (\n                self.server_url\n                + \"/{project_path}/-/archive/{tagname}/{project_name}-{tagname}.tar.gz\"\n            )\n        else:\n            download_template = self.override_download_url\n        while nexturl:\n            resp: Response = session.get(nexturl)\n            resp.raise_for_status()\n            for entry in resp.json():\n                tagname = entry[\"name\"]\n                version = self._match_function(identifier, tagname)\n                if version is None:\n                    logger.debug(f\"{identifier}: match function ignores {tagname}\")\n                    continue\n                assert isinstance(version, Version)\n\n                url = download_template.format(\n                    hostname=self.server_hostname,\n                    project_path=self.project_path,\n                    project_name=project_name,\n                    tagname=tagname,\n                    version=version,\n                )\n\n                # get tag creation time, fall back to commit creation time\n                created_at_str: str | None = entry.get(\"created_at\")\n                if created_at_str is None:\n                    created_at_str = entry[\"commit\"].get(\"created_at\")\n\n                if created_at_str is not None:\n                    created_at = datetime.datetime.fromisoformat(\n                        created_at_str\n                    ).astimezone(datetime.UTC)\n                else:\n                    created_at = None\n\n                yield Candidate(\n                    name=identifier,\n                    version=version,\n                    url=url,\n                    remote_tag=tagname,\n                    remote_commit=entry[\"commit\"][\"id\"],\n                    upload_time=created_at,\n                )\n\n            # GitLab API uses Link headers for pagination\n            nexturl = resp.links.get(\"next\", {}).get(\"url\")\n\n\nclass VersionMapProvider(BaseProvider):\n    \"\"\"Lookup package versions from a VersionMap\n\n    This provider wraps a VersionMap instance to provide versions and URLs\n    for package resolution. The VersionMap should contain Version keys mapped\n    to URL strings.\n    \"\"\"\n\n    provider_description: typing.ClassVar[str] = (\n        \"VersionMap resolver (package: {self.package_name})\"\n    )\n\n    def __init__(\n        self,\n        version_map: VersionMap,\n        package_name: str | None,\n        constraints: Constraints | None = None,\n        *,\n        req_type: RequirementType | None = None,\n        use_resolver_cache: bool = True,\n    ) -> None:\n        if package_name is None:\n            use_resolver_cache = False\n        super().__init__(\n            constraints=constraints,\n            req_type=req_type,\n            use_resolver_cache=use_resolver_cache,\n        )\n        self.version_map = version_map\n        self.package_name = package_name\n\n    @property\n    def cache_key(self) -> str:\n        if self.package_name is None:\n            raise ValueError(\"Cannot cache VersionMapProvider without package name\")\n        return f\"versionmap:{self.package_name}\"\n\n    def find_candidates(self, identifier: str) -> Candidates:\n        \"\"\"Find candidates from the VersionMap\n\n        Iterates through all versions in the VersionMap and creates Candidate\n        objects with the associated URLs.\n        \"\"\"\n        candidates: list[Candidate] = []\n        for version in self.version_map.versions():\n            url = self.version_map[version]\n            candidate = Candidate(\n                name=identifier,\n                version=version,\n                url=url,\n            )\n            candidates.append(candidate)\n\n        return candidates\n","numLines":1364,"startLine":1,"totalLines":1364}},"tool_result_meta":[{"id":"toolu_01MGP4HejbqUJ5wN8B3Srm4K","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
