36\t        When age filtering removes all candidates in multi-version mode,\n237\t        queries the remote cache server for the newest available wheel.\n238\t        Returns at most one version so that transitive dependencies are\n239\t        re-processed without rebuilding every old version.\n240\t        \"\"\"\n241\t        logger.info(\n242\t            \"checking cache server %s for existing build\",\n243\t            self.cache_wheel_server_url,\n244\t        )\n245\t        best: tuple[str, Version] | None = None\n246\t        for include_sdists, include_wheels in [(False, True), (True, False)]:\n247\t            try:\n248\t                provider = finders.PyPICacheProvider(\n249\t                    cache_server_url=self.cache_wheel_server_url,\n250\t                    constraints=self.ctx.constraints,\n251\t                    include_sdists=include_sdists,\n252\t                    include_wheels=include_wheels,\n253\t                )\n254\t                results = resolver.find_all_matching_from_provider(provider, req)\n255\t                if results:\n256\t                    url, version = results[0]\n257\t                    if best is None or version > best[1]:\n258\t                        best = (url, version)\n259\t            except Exception as err:\n260\t                logger.warning(\n261\t                    \"error checking cache server %s: %s\",\n262\t                    self.cache_wheel_server_url,\n263\t                    err,\n264\t                )\n265\t        if best is not None:\n266\t            logger.info(\"found version %s on cache server\", best[1])\n267\t            return [best]\n268\t        return []\n269\t\n270\t    def get_matching_versions(\n271\t        self,\n272\t        req: Requirement,\n273\t        pre_built: bool,\n274\t    ) -> list[tuple[str, Version]]:\n275\t        \"\"\"Filter known versions by requirement specifier (thread-safe).\n276\t\n277\t        Returns all known versions of the package that