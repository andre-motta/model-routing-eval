uto_routes_to_source(\n478\t    mock_resolve: MagicMock,\n479\t    tmp_context: WorkContext,\n480\t) -> None:\n481\t    \"\"\"resolve(pre_built=None) with pbi.pre_built=False routes to source resolution.\"\"\"\n482\t    req = Requirement(\"mypackage>=1.0\")\n483\t\n484\t    # Mock package build info to return pre_built=False\n485\t    mock_pbi = MagicMock()\n486\t    mock_pbi.pre_built = False\n487\t    mock_pbi.resolver_include_sdists = True\n488\t    mock_pbi.resolver_include_wheels = True\n489\t    mock_pbi.resolver_ignore_platform = True\n490\t    mock_pbi.resolver_sdist_server_url = MagicMock(\n491\t        return_value=\"https://pypi.org/simple\"\n492\t    )\n493\t    mock_pbi.resolver_min_release_age = None\n494\t\n495\t    with patch.object(tmp_context, \"package_build_info\", return_value=mock_pbi):\n496\t        resolver = BootstrapRequirementResolver(tmp_context)\n497\t\n498\t        # Mock source resolution to return expected result (as list)\n499\t        mock_resolve.return_value = [\n500\t            (\"https://files.pythonhosted.org/mypackage-2.0.tar.gz\", Version(\"2.0\"))\n501\t        ]\n502\t\n503\t        # Call resolve with pre_built=None (should auto-detect)\n504\t        results = resolver.resolve(\n505\t            req=req,\n506\t            req_type=RequirementType.INSTALL,\n507\t            parent_req=None,\n508\t            pre_built=None,\n509\t        )\n510\t\n511\t        # Verify resolution was called\n512\t        mock_resolve.assert_called_once()\n513\t        assert len(results) == 1\n514\t        url, version = results[0]\n515\t        assert url == \"https://files.pythonhosted.org/mypackage-2.0.tar.gz\"\n516\t        assert version == Version(\"2.0\")\n517\t\n518\t\n519\t@patch(\"fromager.resolver.find_all_matching_from_provider\")"}]},"parent_tool_use_id":null,"session_id":"8e69fa9a-75ee-4abb-882a-eba058cff68b","uuid":"55999c93-0172-464a-9a33-4ec2cea7e238","timestamp":"2026-10-09T17:20:02.855Z","tool_use_result":{"type":"text",