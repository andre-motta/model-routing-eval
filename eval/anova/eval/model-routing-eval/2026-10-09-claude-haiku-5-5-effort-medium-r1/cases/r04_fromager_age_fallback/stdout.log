ces.get_source_provider\",\n            return_value=provider,\n        ),\n    ):\n        r.get(\n            \"https://pypi.org/simple/agefallbackpkg/\",\n            json=_AGE_FALLBACK_INDEX,\n            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n        )\n        results = brr.resolve(\n            Requirement(\"agefallbackpkg>=1.0\"),\n            RequirementType.INSTALL,\n            parent_req=None,\n            pre_built=False,\n            return_all_versions=True,\n        )\n\n    assert [str(v) for _, v in results] == [\"2.0.0\"]\n\n\n@pytest.mark.parametrize(\"multiple_versions\", [True, False])\ndef test_resolve_exact_pin_older_than_window_is_kept(\n    tmp_context: WorkContext,\n    multiple_versions: bool,\n) -> None:\n    \"\"\"An exact pin older than the window still resolves in either version mode.\"\"\"\n    tmp_context.set_max_release_age(30)\n    tmp_context.constraints.add_constraint(\"agefallbackpkg==1.0.0\")\n    brr = BootstrapRequirementResolver(\n        tmp_context, multiple_versions=multiple_versions\n    )\n    provider = PyPIProvider(include_sdists=True, constraints=tmp_context.constraints)\n\n    with (\n        requests_mock.Mocker() as r,\n        patch.object(brr, \"_resolve_from_graph\", return_value=None),\n        patch(\n            \"fromager.bootstrap_requirement_resolver.sources.get_source_provider\",\n            return_value=provider,\n        ),\n    ):\n        r.get(\n            \"https://pypi.org/simple/agefallbackpkg/\",\n            json=_AGE_FALLBACK_INDEX,\n            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n        )\n        results = brr.resolve(\n            Requirement(\"agefallbackpkg==1.0.0\"),\n            RequirementType.INSTALL,\n            parent_req=None,\n            pre_built=False,\n            return_all_versions=True,\n        )\n\n    assert [str(v) for _, v in results] == [\"1.0.0\"]\n"}}}
