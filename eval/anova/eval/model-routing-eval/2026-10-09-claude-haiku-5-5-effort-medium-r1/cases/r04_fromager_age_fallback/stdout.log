rement(\"pbr>=5,<7\"),\n    req_version=Version(\"6\"),\n)\n\nold_graph.add_dependency(\n    parent_name=None,\n    parent_version=None,\n    req_type=RequirementType.TOP_LEVEL,\n    req=Requirement(\"blah\"),\n    req_version=Version(\"1.0.0\"),\n)\n\nold_graph.add_dependency(\n    parent_name=canonicalize_name(\"blah\"),\n    parent_version=Version(\"1.0.0\"),\n    req_type=RequirementType.INSTALL,\n    req=Requirement(\"pbr==5\"),\n    req_version=Version(\"5\"),\n)\n\n\ndef test_resolve_from_graph_no_changes(tmp_context: WorkContext) -> None:","numLines":66,"startLine":1,"totalLines":827}},"tool_result_meta":[{"id":"toolu_013GBQytogRAvDyEUJGVw3nD","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
