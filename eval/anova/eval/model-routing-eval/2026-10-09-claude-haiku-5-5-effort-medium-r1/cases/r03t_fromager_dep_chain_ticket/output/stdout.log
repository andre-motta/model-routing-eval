                parent_name=None,\n163\t                    parent_version=None,\n164\t                    req_type=RequirementType.TOP_LEVEL,\n165\t                    req=req,\n166\t                    req_version=version,\n167\t                    download_url=source_url,\n168\t                    pre_built=pbi.pre_built,\n169\t                    constraint=self.ctx.constraints.get_constraint(req.name),\n170\t                )\n171\t\n172\t            if not results:\n173\t                if self.multiple_versions:\n174\t                    err = RuntimeError(f\"no versions found for {req}\")\n175\t                    self._record_failed_version(\n176\t                        req, \"unresolved\", err, \"no versions resolved, skipping\"\n177\t                    )\n178\t                    if self.test_mode:\n179\t                        self.record_test_mode_failure(req, None, err, \"resolution\")\n180\t                    return None\n181\t                raise RuntimeError(f\"Could not resolve any versions for {req}\")\n182\t\n183\t            # Return first result for backward compatibility\n184\t            return results[0]\n185\t        except Exception as err:\n186\t            if self.multiple_versions:\n187\t                self._record_failed_version(req, \"unresolved\", err, \"failed to resolve\")\n188\t                if self.test_mode:\n189\t                    self.record_test_mode_failure(req, None, err, \"resolution\")\n190\t                return None\n191\t            if not self.test_mode:\n192\t                raise\n193\t            self.record_test_mode_failure(req, None, err, \"resolution\")\n194\t            return None\n195\t\n196\t    def resolve_versions(\n197\t        self,\n198\t        req: Requirement,\n199\t        req_type: RequirementType,\n200\t        parent_req: Requirement | None = None,\n201\t        return_all_versions: bool = False,\n202\t    ) -> list[tuple[str, Version]]:\n203\t        \"\"\"Resolve version(s) of a requirement.\n204\t\n205\t        Returns list of (source URL, version) tuples, sorted by version (highest first).\n206\t\n207\t        Git URL resolution stays in Bootstrapper because it requires\n208\t        build orchestration (BuildEnvironment, build dependencies).\n209\t        Delegates PyPI/graph resolution to BootstrapRequirementResolver.\n210\t\n211\t        Args:\n212\t            req: Package requirement to resolve\n213\t            req_type: Type of requirement\n214\t            parent_req: Explicit parent requirement from dependency chain.\n215\t                Callers must pass this explicitly; do not read ``self.why`` here.\n216\t            return_all_versions: If True, return all matching versions.\n217\t                If False, return only highest version.\n218\t\n219\t        Returns:\n220\t            List of (url, version) tuples. Contains one item when\n221\t            return_all_versions=False, or all matching versions when True.\n222\t        \"\"\"\n223\t        if req.url:\n224\t            if req_type != RequirementType.TOP_LEVEL:\n225\t                raise ValueError(\n226\t                    f\"{req} includes a URL, but is not a top-level dependency\"\n227\t                )\n228\t\n229\t            # Check cache first to avoid re-resolving\n230\t            # Git URLs are always source (not prebuilt)\n231\t            cached_result = self._resolver.get_matching_versions(req, pre_built=False)\n232\t            if cached_result:\n233\t                logger.debug(f\"resolved {req} from cache\")\n234\t                return cached_result if return_all_versions else [cached_result[0]]\n235\t\n236\t            logger.info(\"resolving source via URL, ignoring any plugins\")\n237\t            source_url, resolved_version = self._resolve_version_from_git_url(req=req)\n238\t            # Cache the git URL resolution (always source, not prebuilt)\n239\t            # Store as list for consistency with cache structure\n240\t            result = [(