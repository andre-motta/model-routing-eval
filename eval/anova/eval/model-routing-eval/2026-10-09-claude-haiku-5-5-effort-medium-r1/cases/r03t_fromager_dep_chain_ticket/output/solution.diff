+def test_resolve_failure_names_broken_dependency_arc(tmp_context: WorkContext) -> None:
+    """A failed indirect resolution names the parent that requires it."""
+    # Arrange
+    bt = bootstrapper.Bootstrapper(tmp_context)
+    cause = ResolverException("no candidates match")
+    item = _make_resolve_item(
+        req="flashinfer-python==0.6.8.post1",
+        req_type=RequirementType.INSTALL,
+        why_snapshot=[
+            (RequirementType.TOP_LEVEL, Requirement("its-hub"), Version("1.0")),
+            (RequirementType.INSTALL, Requirement("reward-hub"), Version("2.0")),
+            (RequirementType.INSTALL, Requirement("vllm"), Version("0.9")),
+        ],
+        parent=(Requirement("vllm"), Version("0.9")),
+    )
+
+    # Act
+    with pytest.raises(RuntimeError) as exc_info:
+        bt._handle_phase_error(item, cause)
+
+    # Assert
+    msg = str(exc_info.value)
+    chain = (
+        "its-hub==1.0 -> reward-hub==2.0 -> vllm==0.9 -> flashinfer-python==0.6.8.post1"
+    )
+    assert "required by vllm==0.9" in msg
+    assert chain in msg
+    assert exc_info.value.__cause__ is cause
+
