+def _wheel_bytes(members: dict[str, str]) -> bytes:
+    """Build an in-memory wheel archive from member paths and text contents."""
+    buf = io.BytesIO()
+    with zipfile.ZipFile(buf, "w") as z:
+        for name, content in members.items():
+            z.writestr(name, content)
+    return buf.getvalue()
 
 
