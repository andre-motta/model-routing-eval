ild_dir)\n    backend = get_build_backend(pyproject_toml)\n\n    return pyproject_hooks.BuildBackendHookCaller(\n        source_dir=str(build_dir),\n        build_backend=backend[\"build-backend\"],\n        backend_path=backend[\"backend-path\"],\n        runner=_run_hook_with_extra_environ,\n        python_executable=str(build_env.python),\n    )\n\n\ndef _write_requirements_file(\n    requirements: typing.Iterable[Requirement],\n    filename: pathlib.Path,\n) -> None:\n    with open(filename, \"w\") as f:\n        for r in requirements:\n            f.write(f\"{r}\\n\")\n\n\ndef _read_requirements_file(\n    filename: pathlib.Path,\n) -> set[Requirement]:\n    lines = requirements_file.parse_requirements_file(filename)\n    return set([Requirement(line) for line in lines])\n","structuredPatch":[{"oldStart":475,"oldLines":11,"newStart":475,"newLines":7,"lines":["     Raises:","         ValueError: If no METADATA file is found in the wheel","     \"\"\"","-    # Get dist-info path from wheel filename.","-    # Uses same pattern as wheels.extract_info_from_wheel_file:","-    _, dist_version, _, _ = parse_wheel_filename(wheel_filename.name)","-    dist_name = wheel_filename.name.split(\"-\", 1)[0]","-    metadata_path = f\"{dist_name}-{dist_version}.dist-info/METADATA\"","+    metadata_path = f\"{dist_info_name(wheel_filename.name)}/METADATA\""," ","     with zipfile.ZipFile(wheel_filename) as whl:","         try:"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"tool_result_meta":[{"id":"toolu_012Zv3YLsacamMdiFQKjLE3N","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
