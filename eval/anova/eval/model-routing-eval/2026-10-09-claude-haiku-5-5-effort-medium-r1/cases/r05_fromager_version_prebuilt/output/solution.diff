+def test_version_settings_ignore_local_version(
+    testdata_context: context.WorkContext,
+) -> None:
+    """The local version segment does not affect version-specific lookups."""
+    pbi = testdata_context.settings.package_build_info(TEST_PKG)
+    assert pbi.is_pre_built(Version("2.9.0+cpu")) is True
+    assert pbi.is_pre_built(Version("2.8.0+cpu")) is False
+    assert (
+        pbi.get_wheel_server_url(Version("2.9.0+cpu")) == "https://mirror.test/simple"
+    )
+    assert pbi.get_wheel_server_url(Version("2.8.0+cpu")) == "https://wheel.test/simple"
+
+
+def test_variant_properties_match_unversioned_lookup(
+    testdata_context: context.WorkContext,
+) -> None:
+    """The variant-wide properties are the no-version lookups."""
+    for variant in ("cpu", "rocm"):
+        testdata_context.settings.variant = Variant(variant)
+        pbi = testdata_context.settings.package_build_info(TEST_PKG)
+        assert pbi.pre_built is pbi.is_pre_built()
+        assert pbi.wheel_server_url == pbi.get_wheel_server_url()
+
+
+def _pre_built_hook(result: bool | None) -> typing.Callable[..., bool | None]:
+    """Return an ``is_pre_built`` override hook that always returns *result*."""
+
+    def is_pre_built(*, version: Version, variant: str) -> bool | None:
+        return result
+
+    return is_pre_built
+
+
+def test_is_pre_built_hook_overrides_yaml(
+    testdata_context: context.WorkContext,
+) -> None:
+    """A non-None ``is_pre_built`` hook result wins over the YAML setting."""
+    pbi = testdata_context.settings.package_build_info(TEST_PKG)
+    # 2.9.0 is pre_built=True in the YAML
+    with patch(
+        "fromager.overrides.find_override_method",
+        return_value=_pre_built_hook(False),
+    ):
+        assert pbi.is_pre_built(Version("2.9.0")) is False
+        assert pbi.is_pre_built(Version("2.9.0+cpu")) is False
+
+
+def test_is_pre_built_hook_none_defers_to_yaml(
+    testdata_context: context.WorkContext,
+) -> None:
+    """A ``None`` hook result falls back to the YAML settings."""
+    pbi = testdata_context.settings.package_build_info(TEST_PKG)
+    with patch(
+        "fromager.overrides.find_override_method",
+        return_value=_pre_built_hook(None),
+    ):
+        assert pbi.is_pre_built(Version("2.9.0")) is True
+        assert pbi.is_pre_built(Version("2.8.0")) is False
+
+
+def test_is_pre_built_hook_not_called_without_version(
+    testdata_context: context.WorkContext,
+) -> None:
+    """Without a version, the variant default is returned and no hook runs."""
+    pbi = testdata_context.settings.package_build_info(TEST_PKG)
+    with patch(
+        "fromager.overrides.find_override_method",
+        return_value=_pre_built_hook(True),
+    ) as find_hook:
+        assert pbi.is_pre_built() is False
+        assert pbi.pre_built is False
+    find_hook.assert_not_called()
+
+
+def test_versions_bare_key_is_empty_mapping() -> None:
+    """A bare ``versions:`` key and an omitted key both mean no version settings."""
+    bare = PackageSettings.from_string(
+        TEST_PKG,
+        "variants:\n  cpu:\n    pre_built: true\n    versions:\n",
+    )
+    omitted = PackageSettings.from_string(
+        TEST_PKG,
+        "variants:\n  cpu:\n    pre_built: true\n",
+    )
+    for ps in (bare, omitted):
+        vi = ps.variants["cpu"]
+        assert vi.versions == {}
+        assert vi.pre_built is True
+
