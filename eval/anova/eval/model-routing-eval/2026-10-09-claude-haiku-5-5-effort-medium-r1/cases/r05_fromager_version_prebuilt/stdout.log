ourceBuildResult,\n46\t)\n47\tfrom fromager.bootstrapper._work_item import WorkItem\n48\tfrom fromager.context import WorkContext\n49\tfrom fromager.requirements_file import RequirementType, SourceType\n50\t\n51\t\n52\tdef _make_resolved_future(\n53\t    result: typing.Any,\n54\t) -> concurrent.futures.Future[typing.Any]:\n55\t    \"\"\"Return an already-completed Future carrying *result*.\"\"\"\n56\t    future: concurrent.futures.Future[typing.Any] = concurrent.futures.Future()\n57\t    future.set_result(result)\n58\t    return future\n59\t\n60\t\n61\tdef _make_work_item(\n62\t    req: str = \"testpkg\",\n63\t    req_type: RequirementType = RequirementType.INSTALL,\n64\t    why_snapshot: list | None = None,\n65\t    parent: tuple | None = None,\n66\t    source_url: str | None = None,\n67\t    version: str | None = None,\n68\t    build_env: build_environment.BuildEnvironment | None = None,\n69\t    sdist_root_dir: pathlib.Path | None = None,\n70\t    unpack_dir: pathlib.Path | None = None,\n71\t    build_result: SourceBuildResult | None = None,\n72\t    build_system_deps: set[Requirement] | None = None,\n73\t    build_backend_deps: set[Requirement] | None = None,\n74\t    build_sdist_deps: set[Requirement] | None = None,\n75\t    pbi_pre_built: bool = False,\n76\t    cached_wheel_filename: pathlib.Path | None = None,\n77\t    build_sdist_only: bool = False,\n78\t) -> WorkItem:\n79\t    return WorkItem(\n80\t        req=Requirement(req),\n81\t        req_type=req_type,\n82\t        why_snapshot=why_snapshot or [],\n83\t        parent=parent,\n84\t        source_url=source_url,\n85\t        resolved_version=Version(version) if version else None,\n86\t        build_env=build_env,\n87\t        sdist_root_dir=sdist_root_dir,\n88\t        unpack_dir=unpack_dir,\n89\t        build_result=build_result,\n90\t        build_system_deps=build_system_deps if build_system_deps is not None else set(),\n91\t        build_backend_deps=build_backend_deps\n92\t        if build_backend_deps is not None\n93\t        else set(),\n94\t        build_sdist_deps=build_sdist_deps if build_sdist_deps is not None else set(),\n95\t        pbi_pre_built=pbi_pre_built,\n96\t        cached_wheel_filename=cached_wheel_filename,\n97\t        build_sdist_only=build_sdist_only,\n98\t    )\n99\t\n100\t\n101\tdef _make_resolve_item(\n102\t    req: str = \"testpkg\",\n103\t    req_type: RequirementType = RequirementType.INSTALL,\n104\t    why_snapshot: list | None = None,\n105\t    parent: tuple | None = None,\n106\t) -> Resolve:\n107\t    return Resolve(\n108\t        WorkItem(\n109\t            req=Requirement(req),\n110\t            req_type=req_type,\n111\t            why_snapshot=why_snapshot or [],\n112\t            parent=parent,\n113\t        )\n114\t    )\n115\t\n116\t\n117\tdef _make_start_item(\n118\t    req: str = \"testpkg\",\n119\t    req_type: RequirementType = RequirementType.INSTALL,\n120\t    source_url: str = \"https://pypi.org/testpkg-1.0.tar.gz\",\n121\t    version: str = \"1.0\",\n122\t    why_snapshot: list | None = None,\n123\t    parent: tuple | None = None,\n124\t) -> Start:\n125\t    return Start(\n126\t        WorkItem(\n127\t            req=Requirement(req),\n128\t            req_type=req_type,\n129\t            why_snapshot=why_snapshot or [],\n130\t            parent=parent,\n131\t            source_url=source_url,\n132\t            resolved_version=Version(version),\n133\t        )\n134\t    )\n135\t\n136\t\n137\t_PHASE_TO_CLASS: dict[BootstrapPhase, type[Phase]] = {\n138\t    BootstrapPhase.RESOLVE: Resolve,\n139\t    BootstrapPhase.START: Start,\n140\t    BootstrapPhase.PREPARE_SOURCE: PrepareSource,\n141\t    BootstrapPhase.PREPARE_BUILD: PrepareBuild,\n142\t    BootstrapPhase.BUILD: Build,\n143\t    BootstrapPhase.PROCESS_INSTALL_DEPS: ProcessInstallDeps,\n144\t    BootstrapPhase.COMPLETE: Complete,\n145\t}\n146\t\n147\t\n148\tdef _make_build_item(\n149\t    req: str = \"testpkg\",\n150\t    version: str = \"1.0\","}]},"parent_too