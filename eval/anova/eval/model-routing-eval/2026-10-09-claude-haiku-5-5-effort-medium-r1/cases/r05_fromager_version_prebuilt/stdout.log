in}\"\n            )\n            return []\n        bt.mark_as_seen(wi.req, wi.resolved_version, wi.build_sdist_only)\n\n        logger.info(\n            f\"new {wi.req_type} dependency {wi.req} resolves to {wi.resolved_version}\"\n        )\n\n        # Must set pbi_pre_built before constructing PrepareSource so that\n        # PrepareSource.background_work() immediately sees the correct value.\n        pbi = bt.ctx.package_build_info(wi.req)\n        wi.pbi_pre_built = pbi.is_pre_built(wi.resolved_version)\n        wi.exclusive_build = pbi.exclusive_build\n        return [PrepareSource(wi)]\n----\n461:def get_wheel_server_urls(\n462-    ctx: context.WorkContext,\n463-    req: Requirement,\n464-    *,\n465-    cache_wheel_server_url: str | None,\n466-    version: Version | None = None,\n467-) -> list[str]:\n468-    \"\"\"Build ordered list of wheel server URLs for a package.\n469-\n470-    When *version* is given, version-specific ``wheel_server_url``\n471-    overrides are checked first.\n472-\n473-    .. versionchanged:: 0.90.0\n474-       Added *version* parameter for version-specific URL lookup.\n475-    \"\"\"\n476-    pbi = ctx.package_build_info(req)\n477-    url = pbi.get_wheel_server_url(version)\n478-    wheel_server_urls: list[str] = []\n479-    if url:\n480-        wheel_server_urls.append(url)\n481-    else:\n482-        if ctx.wheel_server_url:\n483-            # local wheel server\n484-            wheel_server_urls.append(ctx.wheel_server_url)\n485-        if cache_wheel_server_url:\n486-            # put cache after local server so we always check local server first\n487-            wheel_server_urls.append(cache_wheel_server_url)\n488-        if not wheel_server_urls:\n489-            raise ValueError(\"no wheel server urls configured\")\n490-    return wheel_server_urls\n491-\n492-\n493-def get_prebuilt_wheel_provider(\n494-    *,\n495-    ctx: context.WorkContext,\n496-    req: Requirement,\n497-    wheel_server_url: str,\n498-    req_type: req