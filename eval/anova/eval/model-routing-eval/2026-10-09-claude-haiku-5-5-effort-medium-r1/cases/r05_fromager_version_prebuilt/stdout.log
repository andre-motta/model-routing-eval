{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SEGcmKucxC8zf7DMwwK9Jb","type":"tool_result","content":"1\t\"\"\"PackageBuildInfo class and system resource helpers.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport logging\n6\timport os\n7\timport pathlib\n8\timport types\n9\timport typing\n10\tfrom collections.abc import Mapping\n11\t\n12\timport psutil\n13\tfrom packaging.utils import BuildTag, NormalizedName\n14\tfrom packaging.version import Version\n15\t\n16\tfrom .. import overrides, threading_utils\n17\tfrom ._models import (\n18\t    GitOptions,\n19\t    PackageSettings,\n20\t    ProjectOverride,\n21\t    PurlConfig,\n22\t    VariantInfo,\n23\t)\n24\tfrom ._templates import _resolve_template, substitute_template\n25\tfrom ._typedefs import Annotations, PackageVersion, PatchMap, Template, Variant\n26\t\n27\tif typing.TYPE_CHECKING:\n28\t    from .. import build_environment\n29\t    from ._settings import Settings\n30\t\n31\tlogger = logging.getLogger(__name__)\n32\t\n33\t\n34\tdef get_available_memory_gib() -> float:\n35\t    \"\"\"available virtual memory in GiB\"\"\"\n36\t    return psutil.virtual_memory().available / (1024**3)\n37\t\n38\t\n39\tclass PackageBuildInfo:\n40\t    \"\"\"Package build information\n41\t\n42\t    Public API for PackageSettings with i\n43\t    \"\"\"\n44\t\n45\t    def __init__(self, settings: Settings, ps: PackageSettings) -> None:\n46\t        self._variant = typing.cast(Variant, settings.variant)\n47\t        self._patches_dir = settings.patches_dir\n48\t        self._variant_changelog = settings.variant_changelog()\n49\t        self._max_jobs: int | None = settings.max_jobs\n50\t        self._ps = ps\n51\t        self._plugin_module: types.ModuleType | typing.Literal[False] | None = False\n52\t        self._patches: PatchMap | None = None\n53\t        self._annotations: Annotations | None = None\n54\t\n55\t    @property\n56\t    def package(self) -> NormalizedName:\n57\t        \"\"\"Package name\"\"\"\n58\t        return typing.cast(NormalizedName, self._ps.name)\n59\t\n60\t    @property\n61\t    def variant(self) -> Variant:\n62\t        \"\"\"Variant name\"\"\"\n63\t        return self._variant\n64\t\n65\t    @property\n66\t    def purl_config(self) -> PurlConfig | None:\n67\t        \"\"\"Per-package purl configuration for SBOM generation.\"\"\"\n68\t        return self._ps.purl\n69\t\n70\t    @property\n71\t    def annotations(self) -> Annotations:\n72\t        \"\"\"Get Package and variant annotations\n73\t\n74\t        Annotations can be used to attach arbitrary metadata to packages and\n75\t        package variants. The feature is inspired by Kubernetes's\n76\t        annotations. Variant keys have a higher precedence than package keys.\n77\t\n78\t        The prefix ``fromager.`` is reserved for future use by Fromager.\n79\t\n80\t        ::\n81\t\n82\t           annotations:\n83\t             \"downstream.maintainer\": \"Platform Team\"\n84\t           variants:\n85\t             cuda:\n86\t               annotations:\n87\t                 \"downstream.maintainer\": \"CUDA Accelerator Team\"\n88\t        \"\"\"\n89\t        if self._annotations is None:\n90\t            vi = self._ps.variants.get(self.variant)\n91\t            va = vi.annotations if vi is not None else None\n92\t            self._annotations = Annotations(self._ps.annotations, va)\n93\t        return self._annotations\n94\t\n95\t    @property\n96\t    def plugin(self) -> types.ModuleType | None:\n97\t        \"\"\"Get Fromager plugin module\"\"\"\n98\t        if self._plugin_module is False:\n99\t            exts = overrides._get_extensions()\n100\t            try:\n101\t                mod = exts[self.override_module_name].plugin\n102\t                self._plugin_module = typing.cast(types.ModuleType, mod)\n103\t            except KeyError:\n104\t                self._plugin_module = None\n105\t        return self._plugin_module\n106\t\n107\t    def get_all_patches(self) -> PatchMap:\n108\t        \"\"\"Get a mapping of version to list of patches\"\"\"\n109\t\n110\t        if self._patches is None:\n111\t            patches: PatchMap = {}\n112\t            version: Version | None\n113\t\n114\t            # Find unversioned and versioned directories (name + '-' + version)\n115\t            # with patches for the package.\n116\t            dirs_to_scan = []\n117\t            unversioned_dir = self._patches_dir / self.override_module_name\n118\t            if unversioned_dir.exists():\n119\t                dirs_to_scan.append(unversioned_dir)\n120\t            versioned_pattern = f\"{self.override_module_name}-*\"\n121\t            dirs_to_scan.extend(self._patches_dir.glob(versioned_pattern))\n122\t\n123\t            prefix_len = len(self.override_module_name) + 1\n124\t            for patchdir in dirs_to_scan:\n125\t                if patchdir.name == self.override_module_name:\n126\t                    version = None\n127\t                else:\n128\t                    version = Version(patchdir.name[prefix_len:])\n129\t                patches[version] = list(patchdir.glob(\"*.patch\"))\n130\t                # variant-specific patches\n131\t                patches[version].extend(patchdir.joinpath(self.variant).glob(\"*.patch\"))\n132\t                patches[version].sort(key=lambda p: p.name)\n133\t\n134\t            self._patches = patches\n135\t        return self._patches\n136\t\n137\t    def get_patches(self, version: Version) -> list[pathlib.Path]:\n138\t        \"\"\"Get patches for a version (and unversioned patches)\"\"\"\n139\t        # ignore local version for patches\n140\t        version = Version(version.public)\n141\t        patchfiles: list[pathlib.Path] = []\n142\t        patchmap = self.get_all_patches()\n143\t        # unversioned patches\n144\t        patchfiles.extend(patchmap.get(None, []))\n145\t        # version-specific patches\n146\t        patchfiles.extend(patchmap.get(version, []))\n147\t        # sort by basename\n148\t        patchfiles.sort(key=lambda p: p.name)\n149\t        return patchfiles\n150\t\n151\t    @property\n152\t    def has_config(self) -> bool:\n153\t        \"\"\"Does the package have a config file?\"\"\"\n154\t        return self._ps.has_config\n155\t\n156\t    @property\n157\t    def has_customizations(self) -> bool:\n158\t        \"\"\"Does the package have any customizations?\"\"\"\n159\t        return bool(\n160\t            self.has_config or self.plugin is not None or self.get_all_patches()\n161\t        )\n162\t\n163\t    @property\n164\t    def pre_built(self) -> bool:\n165\t        \"\"\"Does the variant use pre-build wheels?\"\"\"\n166\t        vi = self._ps.variants.get(self.variant)\n167\t        if vi is not None:\n168\t            return vi.pre_built\n169\t        return False\n170\t\n171\t    def is_pre_built(self, version: Version | None = None) -> bool:\n172\t        \"\"\"Version-aware pre-built check.\n173\t\n174\t        Resolution order:\n175\t\n176\t        1. Plugin hook ``is_pre_built`` (if version given and hook exists)\n177\t        2. Version-specific YAML setting\n178\t        3. Variant-wide default\n179\t\n180\t        .. versionadded:: 0.90.0\n181\t        \"\"\"\n182\t        vi = self._ps.variants.get(self.variant)\n183\t        if vi is None:\n184\t            return False\n185\t        if version is not None:\n186\t            hook_fn = overrides.find_override_method(self.package, \"is_pre_built\")\n187\t            if hook_fn is not None:\n188\t                result = overrides.invoke(\n189\t                    hook_fn, version=version, variant=self.variant\n190\t                )\n191\t                if result is not None:\n192\t                    return bool(result)\n193\t            pv = typing.cast(PackageVersion, version)\n194\t            vs = vi.versions.get(pv)\n195\t            if vs is not None and vs.pre_built is not None:\n196\t                return vs.pre_built\n197\t        return vi.pre_built\n198\t\n199\t    @property\n200\t    def wheel_server_url(self) -> str | None:\n201\t        \"\"\"Alternative package index for pre-build wheel\"\"\"\n202\t        vi = self._ps.variants.get(self.variant)\n203\t        if vi is not None and vi.wheel_server_url is not None:\n204\t            return str(vi.wheel_server_url)\n205\t        return None\n206\t\n207\t    def get_wheel_server_url(self, version: Version | None = None) -> str | None:\n208\t        \"\"\"Version-aware wheel server URL.\n209\t\n210\t        Returns the version-specific URL if defined, otherwise\n211\t        falls back to the variant-wide default.\n212\t\n213\t        .. versionadded:: 0.90.0\n214\t        \"\"\"\n215\t        vi = self._ps.variants.get(self.variant)\n216\t        if vi is None:\n217\t            return None\n218\t        if version is not None:\n219\t            pv = typing.cast(PackageVersion, version)\n220\t            vs = vi.versions.get(pv)\n221\t            if vs is not None and vs.wheel_server_url is not None:\n222\t                return str(vs.wheel_server_url)\n223\t        return str(vi.wheel_server_url) if vi.wheel_server_url is not None else None\n224\t\n225\t    @property\n226\t    def override_module_name(self) -> str:\n227\t        \"\"\"Override module name from package name\"\"\"\n228\t        return self._ps.override_module_name\n229\t\n230\t    def download_source_url(\n231\t        self,\n232\t        version: Version | str | None = None,\n233\t        default: str | None = None,\n234\t        *,\n235\t        resolve_template: bool = True,\n236\t    ) -> str | None:\n237\t        \"\"\"sdist download URL\"\"\"\n238\t        if version is not None and isinstance(version, str):\n239\t            version = Version(version)\n240\t        template = self._ps.download_source.url\n241\t        if template is None and default:\n242\t            template = typing.cast(Template, default)\n243\t        if template and resolve_template:\n244\t            return _resolve_template(template, self.package, version)\n245\t        elif template:\n246\t            return str(template)\n247\t        else:\n248\t            return None\n249\t\n250\t    def download_source_destination_filename(\n251\t        self,\n252\t        version: Version | str | None = None,\n253\t        default: str | None = None,\n254\t        *,\n255\t        resolve_template: bool = True,\n256\t    ) -> str | None:\n257\t        \"\"\"Rename sdist to dest filename\"\"\"\n258\t        if version is not None and isinstance(version, str):\n259\t            version = Version(version)\n260\t        template = self._ps.download_source.destination_filename\n261\t        if template is None and default:\n262\t            template = typing.cast(Template, default)\n263\t        if template and resolve_template:\n264\t            return _resolve_template(template, self.package, version)\n265\t        elif template:\n266\t            return str(template)\n267\t        else:\n268\t            return None\n269\t\n270\t    def resolver_sdist_server_url(self, default: str) -> str:\n271\t        \"\"\"Package index server URL for resolving package versions\"\"\"\n272\t        url = self._ps.resolver_dist.sdist_server_url\n273\t        if url is None:\n274\t            url = default\n275\t        return url\n276\t\n277\t    @property\n278\t    def resolver_include_wheels(self) -> bool:\n279\t        \"\"\"Include wheels when resolving package versions?\"\"\"\n280\t        return self._ps.resolver_dist.include_wheels\n281\t\n282\t    @property\n283\t    def resolver_include_sdists(self) -> bool:\n284\t        \"\"\"Include sdists when resolving package versions?\"\"\"\n285\t        return self._ps.resolver_dist.include_sdists\n286\t\n287\t    @property\n288\t    def resolver_ignore_platform(self) -> bool:\n289\t        \"\"\"Ignore the platform when resolving with wheels?\"\"\"\n290\t        return self._ps.resolver_dist.ignore_platform\n291\t\n292\t    @property\n293\t    def resolver_min_release_age(self) -> int | None:\n294\t        \"\"\"Per-package release-age cooldown override in days.\n295\t\n296\t        Returns None (inherit global), 0 (disabled), or a positive integer\n297\t        (override days). The caller is responsible for converting to a\n298\t        :class:`~fromager.candidate.Cooldown` instance.\n299\t        \"\"\"\n300\t        return self._ps.resolver_dist.min_release_age\n301\t\n302\t    @property\n303\t    def use_pypi_org_metadata(self) -> bool:\n304\t        \"\"\"Can use metadata from pypi.org JSON / Simple API?\n305\t\n306\t        By default, packages with customizations do not use public\n307\t        pypi.org metadata.\n308\t        \"\"\"\n309\t        ps = self._ps\n310\t        flag = ps.resolver_dist.use_pypi_org_metadata\n311\t        if flag is not None:\n312\t            # flag is set\n313\t            return flag\n314\t        # return True if package does not have any customizations\n315\t        return not self.has_customizations\n316\t\n317\t    def build_dir(self, sdist_root_dir: pathlib.Path) -> pathlib.Path:\n318\t        \"\"\"Build directory for package (e.g. subdirectory)\"\"\"\n319\t        build_dir = self._ps.build_dir\n320\t        if build_dir is not None:\n321\t            # ensure that absolute build_dir path from settings is converted to a relative path\n322\t            relative_build_dir = build_dir.relative_to(build_dir.anchor)\n323\t            return sdist_root_dir / relative_build_dir\n324\t        return sdist_root_dir\n325\t\n326\t    def get_changelog(self, version: Version) -> list[str]:\n327\t        \"\"\"Get changelog for a version\"\"\"\n328\t        # ignore local version for changelog entries\n329\t        version = Version(version.public)\n330\t        pv = typing.cast(PackageVersion, version)\n331\t        variant_changelog = self._variant_changelog\n332\t        package_changelog = self._ps.changelog.get(pv, [])\n333\t        return variant_changelog + package_changelog\n334\t\n335\t    def build_tag(self, version: Version) -> BuildTag:\n336\t        \"\"\"Build tag for version's changelog and this variant\n337\t\n338\t        .. versionchanged 0.54.0::\n339\t\n340\t           Fromager ignores local version suffix of a package to determinate\n341\t           the build tag from changelog, e.g. version `1.0.3+local.suffix`\n342\t           uses `1.0.3`.\n343\t        \"\"\"\n344\t        if self.is_pre_built(version):\n345\t            return ()\n346\t        pv = typing.cast(PackageVersion, version)\n347\t        release = len(self.get_changelog(pv))\n348\t        if release == 0:\n349\t            return ()\n350\t        # suffix = \".\" + self.variant.replace(\"-\", \"_\")\n351\t        suffix = \"\"\n352\t        return release, suffix\n353\t\n354\t    def get_extra_environ(\n355\t        self,\n356\t        *,\n357\t        template_env: dict[str, str] | None = None,\n358\t        build_env: build_environment.BuildEnvironment | None = None,\n359\t        version: Version | None = None,\n360\t    ) -> dict[str, str]:\n361\t        \"\"\"Get extra environment variables for a variant\n362\t\n363\t        1. parallel jobs: ``MAKEFLAGS``, ``MAX_JOBS``, ``CMAKE_BUILD_PARALLEL_LEVEL``\n364\t        2. PATH and VIRTUAL_ENV from ``build_env`` (if given)\n365\t        3. package's env settings\n366\t        4. package variant's env settings\n367\t\n368\t        `template_env` defaults to `os.environ`.\n369\t        \"\"\"\n370\t        if template_env is None:\n371\t            template_env = os.environ.copy()\n372\t        else:\n373\t            template_env = template_env.copy()\n374\t\n375\t        if version is not None:\n376\t            template_env[\"__version__\"] = str(version)\n377\t        else:\n378\t            # Prevent a stray __version__ in os.environ from being\n379\t            # silently used when the real version is unknown.\n380\t            template_env.pop(\"__version__\", None)\n381\t\n382\t        # configure max jobs settings, settings depend on package, available\n383\t        # CPU cores, and available virtual memory.\n384\t        jobs = self.parallel_jobs()\n385\t        extra_environ: dict[str, str] = {\n386\t            \"MAKEFLAGS\": f\"{template_env.get('MAKEFLAGS', '')} -j{jobs}\".strip(),\n387\t            \"CMAKE_BUILD_PARALLEL_LEVEL\": str(jobs),\n388\t            \"MAX_JOBS\": str(jobs),\n389\t        }\n390\t\n391\t        # make MAX_JOBS available to substitution\n392\t        template_env.update(extra_environ)\n393\t\n394\t        # add VIRTUAL_ENV and update PATH, so templates can use the values\n395\t        if build_env is not None:\n396\t            venv_environ = build_env.get_venv_environ(template_env=template_env)\n397\t            template_env.update(venv_environ)\n398\t            extra_environ.update(venv_environ)\n399\t\n400\t        # chain entries so variant entries can reference general entries\n401\t        entries = list(self._ps.env.items())\n402\t        vi = self._ps.variants.get(self.variant)\n403\t        if vi is not None:\n404\t            entries.extend(vi.env.items())\n405\t\n406\t        for key, value in entries:\n407\t            value = substitute_template(value, template_env)\n408\t            extra_environ[key] = value\n409\t            # subsequent key-value pairs can depend on previously vars.\n410\t            template_env[key] = value\n411\t\n412\t        return extra_environ\n413\t\n414\t    def parallel_jobs(self) -> int:\n415\t        \"\"\"How many parallel jobs?\"\"\"\n416\t        # adjust by CPU cores, at least 1\n417\t        cpu_cores_per_job = self._ps.build_options.cpu_cores_per_job\n418\t        cpu_count = threading_utils.get_cpu_count()\n419\t        max_num_job_cores = int(max(1, cpu_count // cpu_cores_per_job))\n420\t        logger.debug(\n421\t            f\"{self.package}: {max_num_job_cores=}, {cpu_cores_per_job=}, {cpu_count=}\"\n422\t        )\n423\t\n424\t        # adjust by memory consumption per job, at least 1\n425\t        memory_per_job_gb = self._ps.build_options.memory_per_job_gb\n426\t        free_memory = get_available_memory_gib()\n427\t        max_num_jobs_memory = int(max(1.0, free_memory // memory_per_job_gb))\n428\t        logger.debug(\n429\t            f\"{self.package}: {max_num_jobs_memory=}, {memory_per_job_gb=}, {free_memory=:0.1f} GiB\"\n430\t        )\n431\t\n432\t        # limit by smallest amount of CPU, memory, and --jobs parameter\n433\t        max_jobs = cpu_count if self._max_jobs is None else self._max_jobs\n434\t        parallel_builds = min(max_num_job_cores, max_num_jobs_memory, max_jobs)\n435\t\n436\t        logger.debug(\n437\t            f\"{self.package}: parallel builds {parallel_builds=} \"\n438\t            f\"({free_memory=:0.1f} GiB, {cpu_count=}, {max_jobs=})\"\n439\t        )\n440\t\n441\t        return parallel_builds\n442\t\n443\t    @property\n444\t    def build_ext_parallel(self) -> bool:\n445\t        \"\"\"Configure [build_ext]parallel for setuptools?\"\"\"\n446\t        return self._ps.build_options.build_ext_parallel\n447\t\n448\t    @property\n449\t    def config_settings(self) -> dict[str, str | list[str]]:\n450\t        return self._ps.config_settings\n451\t\n452\t    @property\n453\t    def git_options(self) -> GitOptions:\n454\t        \"\"\"Git repository cloning options\"\"\"\n455\t        return self._ps.git_options\n456\t\n457\t    @property\n458\t    def project_override(self) -> ProjectOverride:\n459\t        return self._ps.project_override\n460\t\n461\t    @property\n462\t    def exclusive_build(self) -> bool:\n463\t        return self._ps.build_options.exclusive_build\n464\t\n465\t    @property\n466\t    def variants(self) -> Mapping[Variant, VariantInfo]:\n467\t        \"\"\"Get the variant configuration for the current package\"\"\"\n468\t        return self._ps.variants\n469\t\n470\t    def serialize(self, **kwargs: typing.Any) -> dict[str, typing.Any]:\n471\t        return self._ps.serialize(**kwargs)\n472\t"}]},"parent_tool_use_id":null,"session_id":"26ae1166-92eb-483a-90db-14bcfd6360d1","uuid":"0e3a66b7-5f8c-4583-9f86-fea2ada86df4","timestamp":"2026-10-09T17:22:13.595Z","tool_use_result":{"type":"text","file":{"filePath":"/home/alustosa/git/model-routing-eval/.work/agent-eval/2026-10-09-claude-haiku-5-5-effort-medium-r1/cases/r05_fromager_version_prebuilt/src/fromager/packagesettings/_pbi.py","content":"\"\"\"PackageBuildInfo class and system resource helpers.\"\"\"\n\nfrom __future__ import annotations\n\nimport logging\nimport os\nimport pathlib\nimport types\nimport typing\nfrom collections.abc import Mapping\n\nimport psutil\nfrom packaging.utils import BuildTag, NormalizedName\nfrom packaging.version import Version\n\nfrom .. import overrides, threading_utils\nfrom ._models import (\n    GitOptions,\n    PackageSettings,\n    ProjectOverride,\n    PurlConfig,\n    VariantInfo,\n)\nfrom ._templates import _resolve_template, substitute_template\nfrom ._typedefs import Annotations, PackageVersion, PatchMap, Template, Variant\n\nif typing.TYPE_CHECKING:\n    from .. import build_environment\n    from ._settings import Settings\n\nlogger = logging.getLogger(__name__)\n\n\ndef get_available_memory_gib() -> float:\n    \"\"\"available virtual memory in GiB\"\"\"\n    return psutil.virtual_memory().available / (1024**3)\n\n\nclass PackageBuildInfo:\n    \"\"\"Package build information\n\n    Public API for PackageSettings with i\n    \"\"\"\n\n    def __init__(self, settings: Settings, ps: PackageSettings) -> None:\n        self._variant = typing.cast(Variant, settings.variant)\n        self._patches_dir = settings.patches_dir\n        self._variant_changelog = settings.variant_changelog()\n        self._max_jobs: int | None = settings.max_jobs\n        self._ps = ps\n        self._plugin_module: types.ModuleType | typing.Literal[False] | None = False\n        self._patches: PatchMap | None = None\n        self._annotations: Annotations | None = None\n\n    @property\n    def package(self) -> NormalizedName:\n        \"\"\"Package name\"\"\"\n        return typing.cast(NormalizedName, self._ps.name)\n\n    @property\n    def variant(self) -> Variant:\n        \"\"\"Variant name\"\"\"\n        return self._variant\n\n    @property\n    def purl_config(self) -> PurlConfig | None:\n        \"\"\"Per-package purl configuration for SBOM generation.\"\"\"\n        return self._ps.purl\n\n    @property\n    def annotations(self) -> Annotations:\n        \"\"\"Get Package and variant annotations\n\n        Annotations can be used to attach arbitrary metadata to packages and\n        package variants. The feature is inspired by Kubernetes's\n        annotations. Variant keys have a higher precedence than package keys.\n\n        The prefix ``fromager.`` is reserved for future use by Fromager.\n\n        ::\n\n           annotations:\n             \"downstream.maintainer\": \"Platform Team\"\n           variants:\n             cuda:\n               annotations:\n                 \"downstream.maintainer\": \"CUDA Accelerator Team\"\n        \"\"\"\n        if self._annotations is None:\n            vi = self._ps.variants.get(self.variant)\n            va = vi.annotations if vi is not None else None\n            self._annotations = Annotations(self._ps.annotations, va)\n        return self._annotations\n\n    @property\n    def plugin(self) -> types.ModuleType | None:\n        \"\"\"Get Fromager plugin module\"\"\"\n        if self._plugin_module is False:\n            exts = overrides._get_extensions()\n            try:\n                mod = exts[self.override_module_name].plugin\n                self._plugin_module = typing.cast(types.ModuleType, mod)\n            except KeyError:\n                self._plugin_module = None\n        return self._plugin_module\n\n    def get_all_patches(self) -> PatchMap:\n        \"\"\"Get a mapping of version to list of patches\"\"\"\n\n        if self._patches is None:\n            patches: PatchMap = {}\n            version: Version | None\n\n            # Find unversioned and versioned directories (name + '-' + version)\n            # with patches for the package.\n            dirs_to_scan = []\n            unversioned_dir = self._patches_dir / self.override_module_name\n            if unversioned_dir.exists():\n                dirs_to_scan.append(unversioned_dir)\n            versioned_pattern = f\"{self.override_module_name}-*\"\n            dirs_to_scan.extend(self._patches_dir.glob(versioned_pattern))\n\n            prefix_len = len(self.override_module_name) + 1\n            for patchdir in dirs_to_scan:\n                if patchdir.name == self.override_module_name:\n                    version = None\n                else:\n                    version = Version(patchdir.name[prefix_len:])\n                patches[version] = list(patchdir.glob(\"*.patch\"))\n                # variant-specific patches\n                patches[version].extend(patchdir.joinpath(self.variant).glob(\"*.patch\"))\n                patches[version].sort(key=lambda p: p.name)\n\n            self._patches = patches\n        return self._patches\n\n    def get_patches(self, version: Version) -> list[pathlib.Path]:\n        \"\"\"Get patches for a version (and unversioned patches)\"\"\"\n        # ignore local version for patches\n        version = Version(version.public)\n        patchfiles: list[pathlib.Path] = []\n        patchmap = self.get_all_patches()\n        # unversioned patches\n        patchfiles.extend(patchmap.get(None, []))\n        # version-specific patches\n        patchfiles.extend(patchmap.get(version, []))\n        # sort by basename\n        patchfiles.sort(key=lambda p: p.name)\n        return patchfiles\n\n    @property\n    def has_config(self) -> bool:\n        \"\"\"Does the package have a config file?\"\"\"\n        return self._ps.has_config\n\n    @property\n    def has_customizations(self) -> bool:\n        \"\"\"Does the package have any customizations?\"\"\"\n        return bool(\n            self.has_config or self.plugin is not None or self.get_all_patches()\n        )\n\n    @property\n    def pre_built(self) -> bool:\n        \"\"\"Does the variant use pre-build wheels?\"\"\"\n        vi = self._ps.variants.get(self.variant)\n        if vi is not None:\n            return vi.pre_built\n        return False\n\n    def is_pre_built(self, version: Version | None = None) -> bool:\n        \"\"\"Version-aware pre-built check.\n\n        Resolution order:\n\n        1. Plugin hook ``is_pre_built`` (if version given and hook exists)\n        2. Version-specific YAML setting\n        3. Variant-wide default\n\n        .. versionadded:: 0.90.0\n        \"\"\"\n        vi = self._ps.variants.get(self.variant)\n        if vi is None:\n            return False\n        if version is not None:\n            hook_fn = overrides.find_override_method(self.package, \"is_pre_built\")\n            if hook_fn is not None:\n                result = overrides.invoke(\n                    hook_fn, version=version, variant=self.variant\n                )\n                if result is not None:\n                    return bool(result)\n            pv = typing.cast(PackageVersion, version)\n            vs = vi.versions.get(pv)\n            if vs is not None and vs.pre_built is not None:\n                return vs.pre_built\n        return vi.pre_built\n\n    @property\n    def wheel_server_url(self) -> str | None:\n        \"\"\"Alternative package index for pre-build wheel\"\"\"\n        vi = self._ps.variants.get(self.variant)\n        if vi is not None and vi.wheel_server_url is not None:\n            return str(vi.wheel_server_url)\n        return None\n\n    def get_wheel_server_url(self, version: Version | None = None) -> str | None:\n        \"\"\"Version-aware wheel server URL.\n\n        Returns the version-specific URL if defined, otherwise\n        falls back to the variant-wide default.\n\n        .. versionadded:: 0.90.0\n        \"\"\"\n        vi = self._ps.variants.get(self.variant)\n        if vi is None:\n            return None\n        if version is not None:\n            pv = typing.cast(PackageVersion, version)\n            vs = vi.versions.get(pv)\n            if vs is not None and vs.wheel_server_url is not None:\n                return str(vs.wheel_server_url)\n        return str(vi.wheel_server_url) if vi.wheel_server_url is not None else None\n\n    @property\n    def override_module_name(self) -> str:\n        \"\"\"Override module name from package name\"\"\"\n        return self._ps.override_module_name\n\n    def download_source_url(\n        self,\n        version: Version | str | None = None,\n        default: str | None = None,\n        *,\n        resolve_template: bool = True,\n    ) -> str | None:\n        \"\"\"sdist download URL\"\"\"\n        if version is not None and isinstance(version, str):\n            version = Version(version)\n        template = self._ps.download_source.url\n        if template is None and default:\n            template = typing.cast(Template, default)\n        if template and resolve_template:\n            return _resolve_template(template, self.package, version)\n        elif template:\n            return str(template)\n        else:\n            return None\n\n    def download_source_destination_filename(\n        self,\n        version: Version | str | None = None,\n        default: str | None = None,\n        *,\n        resolve_template: bool = True,\n    ) -> str | None:\n        \"\"\"Rename sdist to dest filename\"\"\"\n        if version is not None and isinstance(version, str):\n            version = Version(version)\n        template = self._ps.download_source.destination_filename\n        if template is None and default:\n            template = typing.cast(Template, default)\n        if template and resolve_template:\n            return _resolve_template(template, self.package, version)\n        elif template:\n            return str(template)\n        else:\n            return None\n\n    def resolver_sdist_server_url(self, default: str) -> str:\n        \"\"\"Package index server URL for resolving package versions\"\"\"\n        url = self._ps.resolver_dist.sdist_server_url\n        if url is None:\n            url = default\n        return url\n\n    @property\n    def resolver_include_wheels(self) -> bool:\n        \"\"\"Include wheels when resolving package versions?\"\"\"\n        return self._ps.resolver_dist.include_wheels\n\n    @property\n    def resolver_include_sdists(self) -> bool:\n        \"\"\"Include sdists when resolving package versions?\"\"\"\n        return self._ps.resolver_dist.include_sdists\n\n    @property\n    def resolver_ignore_platform(self) -> bool:\n        \"\"\"Ignore the platform when resolving with wheels?\"\"\"\n        return self._ps.resolver_dist.ignore_platform\n\n    @property\n    def resolver_min_release_age(self) -> int | None:\n        \"\"\"Per-package release-age cooldown override in days.\n\n        Returns None (inherit global), 0 (disabled), or a positive integer\n        (override days). The caller is responsible for converting to a\n        :class:`~fromager.candidate.Cooldown` instance.\n        \"\"\"\n        return self._ps.resolver_dist.min_release_age\n\n    @property\n    def use_pypi_org_metadata(self) -> bool:\n        \"\"\"Can use metadata from pypi.org JSON / Simple API?\n\n        By default, packages with customizations do not use public\n        pypi.org metadata.\n        \"\"\"\n        ps = self._ps\n        flag = ps.resolver_dist.use_pypi_org_metadata\n        if flag is not None:\n            # flag is set\n            return flag\n        # return True if package does not have any customizations\n        return not self.has_customizations\n\n    def build_dir(self, sdist_root_dir: pathlib.Path) -> pathlib.Path:\n        \"\"\"Build directory for package (e.g. subdirectory)\"\"\"\n        build_dir = self._ps.build_dir\n        if build_dir is not None:\n            # ensure that absolute build_dir path from settings is converted to a relative path\n            relative_build_dir = build_dir.relative_to(build_dir.anchor)\n            return sdist_root_dir / relative_build_dir\n        return sdist_root_dir\n\n    def get_changelog(self, version: Version) -> list[str]:\n        \"\"\"Get changelog for a version\"\"\"\n        # ignore local version for changelog entries\n        version = Version(version.public)\n        pv = typing.cast(PackageVersion, version)\n        variant_changelog = self._variant_changelog\n        package_changelog = self._ps.changelog.get(pv, [])\n        return variant_changelog + package_changelog\n\n    def build_tag(self, version: Version) -> BuildTag:\n        \"\"\"Build tag for version's changelog and this variant\n\n        .. versionchanged 0.54.0::\n\n           Fromager ignores local version suffix of a package to determinate\n           the build tag from changelog, e.g. version `1.0.3+local.suffix`\n           uses `1.0.3`.\n        \"\"\"\n        if self.is_pre_built(version):\n            return ()\n        pv = typing.cast(PackageVersion, version)\n        release = len(self.get_changelog(pv))\n        if release == 0:\n            return ()\n        # suffix = \".\" + self.variant.replace(\"-\", \"_\")\n        suffix = \"\"\n        return release, suffix\n\n    def get_extra_environ(\n        self,\n        *,\n        template_env: dict[str, str] | None = None,\n        build_env: build_environment.BuildEnvironment | None = None,\n        version: Version | None = None,\n    ) -> dict[str, str]:\n        \"\"\"Get extra environment variables for a variant\n\n        1. parallel jobs: ``MAKEFLAGS``, ``MAX_JOBS``, ``CMAKE_BUILD_PARALLEL_LEVEL``\n        2. PATH and VIRTUAL_ENV from ``build_env`` (if given)\n        3. package's env settings\n        4. package variant's env settings\n\n        `template_env` defaults to `os.environ`.\n        \"\"\"\n        if template_env is None:\n            template_env = os.environ.copy()\n        else:\n            template_env = template_env.copy()\n\n        if version is not None:\n            template_env[\"__version__\"] = str(version)\n        else:\n            # Prevent a stray __version__ in os.environ from being\n            # silently used when the real version is unknown.\n            template_env.pop(\"__version__\", None)\n\n        # configure max jobs settings, settings depend on package, available\n        # CPU cores, and available virtual memory.\n        jobs = self.parallel_jobs()\n        extra_environ: dict[str, str] = {\n            \"MAKEFLAGS\": f\"{template_env.get('MAKEFLAGS', '')} -j{jobs}\".strip(),\n            \"CMAKE_BUILD_PARALLEL_LEVEL\": str(jobs),\n            \"MAX_JOBS\": str(jobs),\n        }\n\n        # make MAX_JOBS available to substitution\n        template_env.update(extra_environ)\n\n        # add VIRTUAL_ENV and update PATH, so templates can use the values\n        if build_env is not None:\n            venv_environ = build_env.get_venv_environ(template_env=template_env)\n            template_env.update(venv_environ)\n            extra_environ.update(venv_environ)\n\n        # chain entries so variant entries can reference general entries\n        entries = list(self._ps.env.items())\n        vi = self._ps.variants.get(self.variant)\n        if vi is not None:\n            entries.extend(vi.env.items())\n\n        for key, value in entries:\n            value = substitute_template(value, template_env)\n            extra_environ[key] = value\n            # subsequent key-value pairs can depend on previously vars.\n            template_env[key] = value\n\n        return extra_environ\n\n    def parallel_jobs(self) -> int:\n        \"\"\"How many parallel jobs?\"\"\"\n        # adjust by CPU cores, at least 1\n        cpu_cores_per_job = self._ps.build_options.cpu_cores_per_job\n        cpu_count = threading_utils.get_cpu_count()\n        max_num_job_cores = int(max(1, cpu_count // cpu_cores_per_job))\n        logger.debug(\n            f\"{self.package}: {max_num_job_cores=}, {cpu_cores_per_job=}, {cpu_count=}\"\n        )\n\n        # adjust by memory consumption per job, at least 1\n        memory_per_job_gb = self._ps.build_options.memory_per_job_gb\n        free_memory = get_available_memory_gib()\n        max_num_jobs_memory = int(max(1.0, free_memory // memory_per_job_gb))\n        logger.debug(\n            f\"{self.package}: {max_num_jobs_memory=}, {memory_per_job_gb=}, {free_memory=:0.1f} GiB\"\n        )\n\n        # limit by smallest amount of CPU, memory, and --jobs parameter\n        max_jobs = cpu_count if self._max_jobs is None else self._max_jobs\n        parallel_builds = min(max_num_job_cores, max_num_jobs_memory, max_jobs)\n\n        logger.debug(\n            f\"{self.package}: parallel builds {parallel_builds=} \"\n            f\"({free_memory=:0.1f} GiB, {cpu_count=}, {max_jobs=})\"\n        )\n\n        return parallel_builds\n\n    @property\n    def build_ext_parallel(self) -> bool:\n        \"\"\"Configure [build_ext]parallel for setuptools?\"\"\"\n        return self._ps.build_options.build_ext_parallel\n\n    @property\n    def config_settings(self) -> dict[str, str | list[str]]:\n        return self._ps.config_settings\n\n    @property\n    def git_options(self) -> GitOptions:\n        \"\"\"Git repository cloning options\"\"\"\n        return self._ps.git_options\n\n    @property\n    def project_override(self) -> ProjectOverride:\n        return self._ps.project_override\n\n    @property\n    def exclusive_build(self) -> bool:\n        return self._ps.build_options.exclusive_build\n\n    @property\n    def variants(self) -> Mapping[Variant, VariantInfo]:\n        \"\"\"Get the variant configuration for the current package\"\"\"\n        return self._ps.variants\n\n    def serialize(self, **kwargs: typing.Any) -> dict[str, typing.Any]:\n        return self._ps.serialize(**kwargs)\n","numLines":472,"startLine":1,"totalLines":472}},"tool_result_meta":[{"id":"toolu_01SEGcmKucxC8zf7DMwwK9Jb","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011Cfs3pyrB3JMyWr1e4LA7Z","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01DZTbWUoi1UNMjNEw8iTCXC","name":"Read","input":{"file_path":"/home/alustosa/git/model-routing-eval/.work/agent-eval/2026-10-09-claude-haiku-5-5-effort-medium-r1/cases/r05_fromager_version_prebuilt/src/fromager/packagesettings/_models.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4773,"cache_read_input_tokens":26755,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4773},"output_tokens":5,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"26ae1166-92eb-483a-90db-14bcfd6360d1","uuid":"16e209e1-c0f4-4c26-9e33-c00e0df1f94d","timestamp":"2026-10-09T17:22:13.851Z","request_id":"req_011Cfs3pyZ5EQPZHJ9Qto5qz","wire_tool_inputs":{"toolu_01DZTbWUoi1UNMjNEw8iTCXC":{"file_path":"/home/alustosa/git/model-routing-eval/.work/agent-eval/2026-10-09-claude-haiku-5-5-effort-medium-r1/cases/r05_fromager_version_prebuilt/src/fromager/packagesettings/_models.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DZTbWUoi1UNMjNEw8iTCXC","type":"tool_result","content":"1\t\"\"\"Pydantic model classes.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport logging\n6\timport os\n7\timport pathlib\n8\timport re\n9\timport typing\n10\tfrom collections.abc import Mapping\n11\t\n12\timport pydantic\n13\timport yaml\n14\tfrom packaging.requirements import Requirement\n15\tfrom packaging.utils import canonicalize_name\n16\tfrom pydantic import AnyUrl, Field, PrivateAttr, StringConstraints\n17\tfrom pydantic_core import core_schema\n18\t\n19\t# from ._resolver import SourceResolver\n20\tfrom ._typedefs import (\n21\t    MODEL_CONFIG,\n22\t    BuildDirectory,\n23\t    EnvVars,\n24\t    Package,\n25\t    PackageVersion,\n26\t    PurlType,\n27\t    RawAnnotations,\n28\t    Template,\n29\t    UpstreamPurl,\n30\t    Variant,\n31\t    VariantChangelog,\n32\t)\n33\t\n34\tlogger = logging.getLogger(__name__)\n35\t\n36\t\n37\tclass SbomSettings(pydantic.BaseModel):\n38\t    \"\"\"Global SBOM generation settings\n39\t\n40\t    ::\n41\t\n42\t      sbom:\n43\t        supplier: \"Organization: ExampleCo\"\n44\t        namespace: \"https://www.example.com\"\n45\t        purl_type: pypi\n46\t        repository_url: \"https://example.com/simple\"\n47\t        creators:\n48\t          - \"Organization: ExampleCo\"\n49\t    \"\"\"\n50\t\n51\t    model_config = MODEL_CONFIG\n52\t\n53\t    supplier: str = \"NOASSERTION\"\n54\t    \"\"\"SPDX supplier field for the wheel package (e.g. ``Organization: ExampleCo``)\"\"\"\n55\t\n56\t    namespace: AnyUrl = AnyUrl(\"https://spdx.org/spdxdocs\")\n57\t    \"\"\"Base URL for the SPDX documentNamespace\"\"\"\n58\t\n59\t    creators: list[str] = Field(default_factory=list)\n60\t    \"\"\"Additional SPDX creator entries (e.g. ``Organization: ExampleCo``)\n61\t\n62\t    The fromager tool creator entry is always added automatically.\n63\t    \"\"\"\n64\t\n65\t    purl_type: PurlType = \"pypi\"\n66\t    \"\"\"Default purl type for all packages (e.g. ``pypi``, ``generic``)\"\"\"\n67\t\n68\t    repository_url: AnyUrl | None = None\n69\t    \"\"\"Default purl ``repository_url`` qualifier for all packages\n70\t\n71\t    When set, this URL is added to every purl as a qualifier\n72\t    (e.g. ``pkg:pypi/flask@2.0?repository_url=https://example.com/simple``).\n73\t    Can be overridden per-package in the package settings file.\n74\t    \"\"\"\n75\t\n76\t\n77\t# Environment variable filter patterns for ExternalCommands.\n78\t# Pattern: starts with letter or underscore, rest is letters/digits/underscores,\n79\t# optionally ending with ``*`` (trailing wildcard).\n80\t# DeleteEnvPattern additionally allows bare ``*`` (catch-all).\n81\tKeepEnvPattern = typing.Annotated[\n82\t    str,\n83\t    StringConstraints(pattern=r\"^[a-zA-Z_][a-zA-Z0-9_]*\\*?$\"),\n84\t]\n85\t\n86\tDeleteEnvPattern = typing.Annotated[\n87\t    str,\n88\t    StringConstraints(pattern=r\"^(\\*|[a-zA-Z_][a-zA-Z0-9_]*\\*?)$\"),\n89\t]\n90\t\n91\t\n92\t# POSIX.1-2024 sec. 8.1: environment variable names consist of uppercase\n93\t# letters, digits, and underscores and do not begin with a digit.  We\n94\t# also accept lowercase letters for portability (common on Linux).\n95\t_POSIX_ENV_KEY_RE = re.compile(r\"[A-Za-z_][A-Za-z0-9_]*\")\n96\t\n97\t\n98\tdef _compile_env_patterns(\n99\t    patterns: tuple[str, ...],\n100\t    *,\n101\t    case_insensitive: bool = False,\n102\t) -> re.Pattern[str]:\n103\t    \"\"\"Compile env filter patterns into a single regex for ``fullmatch``.\n104\t\n105\t    Exact patterns (e.g. ``HOME``) become ``HOME`` and prefix patterns\n106\t    (e.g. ``LC_*``) become ``LC_.*``.  The result is\n107\t    ``HOME|LC_.*|...`` (used with ``fullmatch``).\n108\t\n109\t    *patterns* must be non-empty.\n110\t    \"\"\"\n111\t    parts: list[str] = []\n112\t    for p in patterns:\n113\t        if p.endswith(\"*\"):\n114\t            parts.append(re.escape(p[:-1]) + \".*\")\n115\t        else:\n116\t            parts.append(re.escape(p))\n117\t    flags = re.IGNORECASE if case_insensitive else 0\n118\t    return re.compile(\"|\".join(parts), flags)\n119\t\n120\t\n121\tclass ExternalCommands(pydantic.BaseModel):\n122\t    \"\"\"Environment variable filtering for subprocesses.\n123\t\n124\t    Variables whose keys are not valid POSIX names are always removed.\n125\t    A hard-coded set of variables required for basic subprocess\n126\t    operation (see ``DEFAULT_KEEP_ENV``) is always kept.  User-supplied\n127\t    ``keep_env`` patterns are evaluated before ``delete_env`` patterns.\n128\t\n129\t    ::\n130\t\n131\t      external_commands:\n132\t        keep_env:\n133\t          - \"CARGO_*\"\n134\t        delete_env:\n135\t          - \"CI_TOKEN\"\n136\t          - \"AWS_*\"\n137\t\n138\t    .. versionadded:: 0.92.0\n139\t    \"\"\"\n140\t\n141\t    model_config = MODEL_CONFIG\n142\t\n143\t    DEFAULT_KEEP_ENV: typing.ClassVar[tuple[str, ...]] = (\n144\t        \"HOME\",\n145\t        \"HOSTNAME\",\n146\t        \"LANG\",\n147\t        \"LANGUAGE\",\n148\t        \"LC_*\",\n149\t        \"LOGNAME\",\n150\t        \"NO_COLOR\",\n151\t        \"PATH\",\n152\t        \"SHELL\",\n153\t        \"TEMP\",\n154\t        \"TERM\",\n155\t        \"TMP\",\n156\t        \"TMPDIR\",\n157\t        \"TZ\",\n158\t        \"USER\",\n159\t    )\n160\t    \"\"\"Patterns always kept regardless of user configuration.\"\"\"\n161\t\n162\t    keep_env: list[KeepEnvPattern] = Field(default_factory=list)\n163\t    \"\"\"Allowlist patterns (evaluated before ``delete_env``)\"\"\"\n164\t\n165\t    delete_env: list[DeleteEnvPattern] = Field(default_factory=list)\n166\t    \"\"\"Blocklist patterns (evaluated after ``keep_env``)\"\"\"\n167\t\n168\t    _keep_re: re.Pattern[str] | None = PrivateAttr(default=None)\n169\t    _delete_re: re.Pattern[str] | None = PrivateAttr(default=None)\n170\t\n171\t    @pydantic.model_validator(mode=\"after\")\n172\t    def validate_delete_env(self) -> typing.Self:\n173\t        \"\"\"Validate ``delete_env`` for conflicts and redundancy.\"\"\"\n174\t        if not self.delete_env:\n175\t            return self\n176\t        if \"*\" in self.delete_env and len(self.delete_env) > 1:\n177\t            raise ValueError(\n178\t                \"delete_env: bare '*' must be the only entry, \"\n179\t                \"additional patterns are redundant\"\n180\t            )\n181\t        # Exact string overlap check.  This catches obvious\n182\t        # configuration mistakes (e.g. ``delete_env: [HOME]``) but does\n183\t        # not detect all conflicts — for example ``delete_env: [LC_ALL]``\n184\t        # is not flagged even though ``LC_ALL`` matches the default keep\n185\t        # pattern ``LC_*``.\n186\t        keep = set(self.DEFAULT_KEEP_ENV) | set(self.keep_env)\n187\t        overlap = keep & set(self.delete_env)\n188\t        if overlap:\n189\t            raise ValueError(\n190\t                f\"delete_env overlaps with keep_env / DEFAULT_KEEP_ENV: \"\n191\t                f\"{sorted(overlap)}\"\n192\t            )\n193\t        return self\n194\t\n195\t    def model_post_init(self, __context: typing.Any) -> None:\n196\t        \"\"\"Pydantic post init hook to initialize internal data structures\"\"\"\n197\t        if self.delete_env:\n198\t            self._keep_re = _compile_env_patterns(\n199\t                self.DEFAULT_KEEP_ENV + tuple(self.keep_env)\n200\t            )\n201\t            if \"*\" not in self.delete_env:\n202\t                self._delete_re = _compile_env_patterns(\n203\t                    tuple(self.delete_env), case_insensitive=True\n204\t                )\n205\t\n206\t    def filter_env(self, env: Mapping[str, str]) -> Mapping[str, str]:\n207\t        \"\"\"Filter environment variables by keep/delete patterns.\n208\t\n209\t        Variables whose keys are not valid POSIX names are always\n210\t        removed first.  Of the remaining variables, those matching\n211\t        ``DEFAULT_KEEP_ENV`` or ``keep_env`` are always kept.  Of the\n212\t        rest, those matching ``delete_env`` are removed.  Variables\n213\t        matching neither list are kept.\n214\t        \"\"\"\n215\t        # Remove keys that are not valid POSIX names, e.g. keys with\n216\t        # dashes, dots, spaces, or bash function exports (BASH_FUNC_*%%).\n217\t        env = {k: v for k, v in env.items() if _POSIX_ENV_KEY_RE.fullmatch(k)}\n218\t        # _keep_re is only set in model_post_init when delete_env is\n219\t        # non-empty, so None means no filtering is configured.\n220\t        if self._keep_re is None:\n221\t            return env\n222\t        if self._delete_re is None:\n223\t            # delete_env is [\"*\"]: keep only what matches\n224\t            return {k: v for k, v in env.items() if self._keep_re.fullmatch(k)}\n225\t        return {\n226\t            k: v\n227\t            for k, v in env.items()\n228\t            if self._keep_re.fullmatch(k) or not self._delete_re.fullmatch(k)\n229\t        }\n230\t\n231\t\n232\tclass PurlConfig(pydantic.BaseModel):\n233\t    \"\"\"Per-package purl configuration for SBOM generation.\n234\t\n235\t    Allows overriding individual purl components or specifying an\n236\t    upstream purl for packages sourced from GitHub/GitLab.\n237\t\n238\t    .. versionadded:: 0.81.0\n239\t\n240\t    ::\n241\t\n242\t      purl:\n243\t        type: generic\n244\t        name: custom-name\n245\t        repository_url: \"https://example.com/simple\"\n246\t        upstream: \"pkg:github/org/repo@v1.0.0\"\n247\t    \"\"\"\n248\t\n249\t    model_config = MODEL_CONFIG\n250\t\n251\t    type: PurlType | None = None\n252\t    \"\"\"Override the purl type (e.g. ``generic`` instead of ``pypi``)\"\"\"\n253\t\n254\t    namespace: str | None = None\n255\t    \"\"\"Override the purl namespace component\"\"\"\n256\t\n257\t    name: str | None = None\n258\t    \"\"\"Override the purl name component (defaults to the package name)\"\"\"\n259\t\n260\t    version: str | None = None\n261\t    \"\"\"Override the purl version component (defaults to the resolved version)\"\"\"\n262\t\n263\t    repository_url: AnyUrl | None = None\n264\t    \"\"\"Per-package override for the purl ``repository_url`` qualifier.\n265\t\n266\t    Overrides the global ``sbom.repository_url`` setting for this package.\n267\t    \"\"\"\n268\t\n269\t    upstream: UpstreamPurl | None = None\n270\t    \"\"\"Full purl string identifying the upstream source package.\n271\t\n272\t    When set, this is used as the upstream identity in the SBOM's\n273\t    GENERATED_FROM relationship. Used for packages sourced from\n274\t    GitHub/GitLab rather than PyPI.\n275\t\n276\t    When absent, the upstream purl is auto-derived from the downstream\n277\t    purl without the ``repository_url`` qualifier.\n278\t    \"\"\"\n279\t\n280\t\n281\tclass ResolverDist(pydantic.BaseModel):\n282\t    \"\"\"Packages resolver dist\n283\t\n284\t    ::\n285\t\n286\t      sdist_server_url: https://pypi.org/simple/\n287\t      include_sdists: True\n288\t      include_wheels: False\n289\t      ignore_platform: False\n290\t    \"\"\"\n291\t\n292\t    model_config = MODEL_CONFIG\n293\t\n294\t    sdist_server_url: str | None = None\n295\t    \"\"\"Source distribution download server (default: PyPI)\"\"\"\n296\t\n297\t    include_sdists: bool = True\n298\t    \"\"\"Use sdists to resolve? (default: yes)\"\"\"\n299\t\n300\t    include_wheels: bool = False\n301\t    \"\"\"Use wheels to resolve? (default: no)\"\"\"\n302\t\n303\t    ignore_platform: bool = False\n304\t    \"\"\"Ignore the platform when resolving with wheels? (default: no)\n305\t\n306\t    This option ignores the platform field (OS, CPU arch) when resolving with\n307\t    *include_wheels* enabled.\n308\t\n309\t    .. versionadded:: 0.52\n310\t    \"\"\"\n311\t\n312\t    use_pypi_org_metadata: bool | None = None\n313\t    \"\"\"Can use metadata from pypi.org JSON / Simple API?\n314\t\n315\t    None (default) is for auto-setting. Packages with customizations (config,\n316\t    patches, plugins) don't use pypi.org metadata by default.\n317\t\n318\t    .. versionadded:: 0.70\n319\t    \"\"\"\n320\t\n321\t    min_release_age: int | None = pydantic.Field(default=None, ge=0)\n322\t    \"\"\"Per-package minimum release age override in days.\n323\t\n324\t    None (default): inherit the global ``--min-release-age`` setting.\n325\t    0: disable the release-age cooldown for this package.\n326\t    Positive integer: override the cooldown with this many days.\n327\t\n328\t    .. versionadded:: 0.82\n329\t    \"\"\"\n330\t\n331\t    @pydantic.model_validator(mode=\"after\")\n332\t    def validate_ignore_platform(self) -> typing.Self:\n333\t        if self.ignore_platform and not self.include_wheels:\n334\t            raise ValueError(\n335\t                \"'ignore_platforms' has no effect without 'include_wheels'\"\n336\t            )\n337\t        return self\n338\t\n339\t\n340\tclass DownloadSource(pydantic.BaseModel):\n341\t    \"\"\"Package download source\n342\t\n343\t    Download package sources from an alternative source, e.g. GitHub release.\n344\t\n345\t    ::\n346\t\n347\t        url: https://example.com/package.tar.gz\n348\t        destination_filename: ${dist_name}-${version}.tar.gz\n349\t    \"\"\"\n350\t\n351\t    model_config = MODEL_CONFIG\n352\t\n353\t    url: Template | None = None\n354\t    \"\"\"Source download url (string template)\"\"\"\n355\t\n356\t    destination_filename: Template | None = None\n357\t    \"\"\"Rename file (filename without path)\"\"\"\n358\t\n359\t    @pydantic.field_validator(\"destination_filename\")\n360\t    @classmethod\n361\t    def validate_destination_filename(cls, v: str) -> str:\n362\t        if os.pathsep in v:\n363\t            raise ValueError(f\"must not contain {os.pathsep}\")\n364\t        return v\n365\t\n366\t\n367\tclass BuildOptions(pydantic.BaseModel):\n368\t    \"\"\"Build system options\n369\t\n370\t    ::\n371\t\n372\t        build_ext_parallel: False  # DEPRECATED: ignored, will be removed\n373\t        cpu_cores_per_job: 1\n374\t        memory_per_job_gb: 1.0\n375\t    \"\"\"\n376\t\n377\t    model_config = MODEL_CONFIG\n378\t\n379\t    build_ext_parallel: bool = False\n380\t    \"\"\"Configure `build_ext[parallel]` in `DIST_EXTRA_CONFIG`\n381\t\n382\t    .. deprecated:: 0.72.0\n383\t       This option is deprecated and will be removed in a future release.\n384\t       The parallel build feature for extensions is unsafe due to race conditions.\n385\t       This option is now ignored and will emit a warning if set to True.\n386\t    \"\"\"\n387\t\n388\t    cpu_cores_per_job: int = Field(default=1, ge=1)\n389\t    \"\"\"Scale parallel jobs by available CPU cores\n390\t\n391\t    Examples:\n392\t\n393\t    1: as many parallel jobs as CPU logical cores\n394\t\n395\t    2: allocate 2 cores per job\n396\t    \"\"\"\n397\t\n398\t    memory_per_job_gb: float = Field(default=1.0, ge=0.1)\n399\t    \"\"\"Scale parallel jobs by available virtual memory (without swap)\n400\t\n401\t    Examples:\n402\t\n403\t    0.5: assume each parallel job requires 512 MB virtual memory\n404\t    \"\"\"\n405\t\n406\t    exclusive_build: bool = False\n407\t    \"\"\"If true, this package must be built on its own (not in parallel with other packages). Default: False.\"\"\"\n408\t\n409\t\n410\tclass ProjectOverride(pydantic.BaseModel):\n411\t    \"\"\"Override pyproject.toml settings\n412\t\n413\t    ::\n414\t\n415\t      update_build_requires:\n416\t        - setuptools\n417\t      remove_build_requires:\n418\t        - ninja\n419\t      requires_external:\n420\t        - openssl-libs\n421\t    \"\"\"\n422\t\n423\t    model_config = MODEL_CONFIG\n424\t\n425\t    update_build_requires: list[str] = Field(default_factory=list)\n426\t    \"\"\"Add / update requirements to pyproject.toml `[build-system] requires`\n427\t    \"\"\"\n428\t\n429\t    remove_build_requires: list[Package] = Field(default_factory=list)\n430\t    \"\"\"Remove requirement from pyproject.toml `[build-system] requires`\n431\t    \"\"\"\n432\t\n433\t    requires_external: list[str] = Field(default_factory=list)\n434\t    \"\"\"Add / update Requires-External core metadata field\n435\t\n436\t    Each entry contains a string describing some dependency in the system\n437\t    that the distribution is to be used. See\n438\t    https://packaging.python.org/en/latest/specifications/core-metadata/#requires-external-multiple-use\n439\t\n440\t    .. note::\n441\t       Fromager does not modify ``METADATA`` file, yet. Read the information\n442\t       from an ``importlib.metadata`` distribution with\n443\t       ``tomlkit.loads(dist(pkgname).read_text(\"fromager-build-settings\"))``.\n444\t    \"\"\"\n445\t\n446\t    @pydantic.field_validator(\"update_build_requires\")\n447\t    @classmethod\n448\t    def validate_update_build_requires(cls, v: list[str]) -> list[str]:\n449\t        for reqstr in v:\n450\t            Requirement(reqstr)\n451\t        return v\n452\t\n453\t\n454\tclass VersionSpecificSettings(pydantic.BaseModel):\n455\t    \"\"\"Per-version overrides within a variant.\n456\t\n457\t    Allows overriding ``pre_built`` and ``wheel_server_url`` for\n458\t    specific package versions.  When a field is ``None``, the\n459\t    variant-wide default is used.\n460\t\n461\t    .. versionadded:: 0.90.0\n462\t\n463\t    ::\n464\t\n465\t      versions:\n466\t        \"2.9.0\":\n467\t          pre_built: true\n468\t          wheel_server_url: https://gitlab.example.com/simple\n469\t    \"\"\"\n470\t\n471\t    model_config = MODEL_CONFIG\n472\t\n473\t    wheel_server_url: str | None = None\n474\t    \"\"\"Alternative package index for this version's pre-built wheel\"\"\"\n475\t\n476\t    pre_built: bool | None = None\n477\t    \"\"\"Override pre-built flag for this version (None = inherit variant default)\"\"\"\n478\t\n479\t\n480\tclass VariantInfo(pydantic.BaseModel):\n481\t    \"\"\"Variant information for a package\n482\t\n483\t    ::\n484\t\n485\t      env:\n486\t        VAR1: \"value 1\"\n487\t        VAR2: \"2.0\n488\t      wheel_server_url: https://pypi.org/simple/\n489\t      pre_built: False\n490\t      versions:\n491\t        \"2.9.0\":\n492\t          pre_built: true\n493\t          wheel_server_url: https://gitlab.example.com/simple\n494\t    \"\"\"\n495\t\n496\t    model_config = MODEL_CONFIG\n497\t\n498\t    annotations: RawAnnotations | None = None\n499\t    \"\"\"Arbitrary metadata for variants\n500\t\n501\t    Variant annotation keys have a higher precedence than package\n502\t    annotation keys.\n503\t    \"\"\"\n504\t\n505\t    env: EnvVars = Field(default_factory=dict)\n506\t    \"\"\"Additional env vars (overrides package env vars)\"\"\"\n507\t\n508\t    wheel_server_url: str | None = None\n509\t    \"\"\"Alternative package index for pre-built wheel\"\"\"\n510\t\n511\t    pre_built: bool = False\n512\t    \"\"\"Use pre-built wheel from index server?\"\"\"\n513\t\n514\t    versions: Mapping[PackageVersion, VersionSpecificSettings] = Field(\n515\t        default_factory=dict\n516\t    )\n517\t    \"\"\"Per-version overrides for ``pre_built`` and ``wheel_server_url``.\n518\t\n519\t    Version-specific settings take precedence over variant defaults\n520\t    when present.\n521\t\n522\t    .. versionadded:: 0.90.0\n523\t    \"\"\"\n524\t\n525\t    # TODO\n526\t    # source: SourceResolver | None\n527\t    # \"\"\"Source resolver and downloader\"\"\"\n528\t\n529\t    @pydantic.field_validator(\"versions\", mode=\"before\")\n530\t    @classmethod\n531\t    def before_none_versions(\n532\t        cls,\n533\t        v: dict[str, typing.Any] | None,\n534\t        info: core_schema.ValidationInfo,\n535\t    ) -> dict[str, typing.Any]:\n536\t        \"\"\"Coerce ``None`` to empty dict for bare ``versions:`` YAML key.\"\"\"\n537\t        if v is None:\n538\t            return {}\n539\t        return v\n540\t\n541\t\n542\tclass GitOptions(pydantic.BaseModel):\n543\t    \"\"\"Git repository cloning options\n544\t\n545\t    ::\n546\t\n547\t        submodules: False\n548\t        submodule_paths: []\n549\t    \"\"\"\n550\t\n551\t    model_config = MODEL_CONFIG\n552\t\n553\t    submodules: bool = False\n554\t    \"\"\"Clone git submodules recursively?\n555\t\n556\t    When True, all submodules will be cloned recursively.\n557\t    When False (default), no submodules will be cloned.\n558\t    \"\"\"\n559\t\n560\t    submodule_paths: list[str] = Field(default_factory=list)\n561\t    \"\"\"Clone specific submodule paths only\n562\t\n563\t    If provided, only the specified submodule paths will be cloned.\n564\t    This option takes precedence over the 'submodules' boolean setting.\n565\t\n566\t    Examples:\n567\t    - [\"third-party/openssl\"]\n568\t    - [\"vendor/lib1\", \"vendor/lib2\"]\n569\t    \"\"\"\n570\t\n571\t\n572\t_DictStrAny = dict[str, typing.Any]\n573\t\n574\t\n575\tclass PackageSettings(pydantic.BaseModel):\n576\t    \"\"\"Package settings\n577\t\n578\t    ::\n579\t\n580\t        build_dir: python\n581\t        changelog:\n582\t            \"1.0.1\":\n583\t                - fixed bug\n584\t        env:\n585\t            EGG: spam\n586\t        download_source:\n587\t            url: https://egg.test\n588\t            destination_filename: new_filename\n589\t        resolver_dist:\n590\t            sdist_server_url: https://sdist.test/egg\n591\t            include_sdists: true\n592\t            include_wheels: false\n593\t        build_options:\n594\t            build_ext_parallel: False\n595\t            cpu_cores_per_job: 1\n596\t            memory_per_job_gb: 1.0\n597\t            exclusive_build: False\n598\t        variants:\n599\t            cpu:\n600\t                env:\n601\t                    EGG: spamalot\n602\t                wheel_server_url: https://wheel.test/simple\n603\t            rocm:\n604\t                pre_built: True\n605\t    \"\"\"\n606\t\n607\t    model_config = MODEL_CONFIG\n608\t\n609\t    name: Package\n610\t    \"\"\"Canonicalized package name\"\"\"\n611\t\n612\t    has_config: bool\n613\t    \"\"\"package has override setting\"\"\"\n614\t\n615\t    annotations: RawAnnotations | None = None\n616\t    \"\"\"Arbitrary metadata for a package\"\"\"\n617\t\n618\t    build_dir: BuildDirectory | None = None\n619\t    \"\"\"sub-directory with setup.py or pyproject.toml\"\"\"\n620\t\n621\t    changelog: VariantChangelog = Field(default_factory=dict)\n622\t    \"\"\"Changelog entries\"\"\"\n623\t\n624\t    config_settings: dict[str, str | list[str]] = Field(default_factory=dict)\n625\t    \"\"\"PEP 517 arbitrary configuration for wheel builds\n626\t\n627\t    https://peps.python.org/pep-0517/#config-settings\n628\t\n629\t    ::\n630\t\n631\t       config_settings:\n632\t         setup-args:\n633\t           - \"-Dsystem-freetype=true\"\n634\t           - \"-Dsystem-qhull=true\"\n635\t    \"\"\"\n636\t\n637\t    env: EnvVars = Field(default_factory=dict)\n638\t    \"\"\"Common env var for all variants\"\"\"\n639\t\n640\t    download_source: DownloadSource = Field(default_factory=DownloadSource)\n641\t    \"\"\"Alternative source download settings\"\"\"\n642\t\n643\t    purl: PurlConfig | None = None\n644\t    \"\"\"Purl configuration for SBOM generation.\n645\t\n646\t    A ``PurlConfig`` object with individual field overrides and upstream\n647\t    source identification.\n648\t\n649\t    .. versionchanged:: 0.81.0\n650\t       The *purl* option now requires a valid PURL config object instead of a string.\n651\t    \"\"\"\n652\t\n653\t    resolver_dist: ResolverDist = Field(default_factory=ResolverDist)\n654\t    \"\"\"Resolve distribution version\"\"\"\n655\t\n656\t    build_options: BuildOptions = Field(default_factory=BuildOptions)\n657\t    \"\"\"Build system options\"\"\"\n658\t\n659\t    git_options: GitOptions = Field(default_factory=GitOptions)\n660\t    \"\"\"Git repository cloning options\"\"\"\n661\t\n662\t    project_override: ProjectOverride = Field(default_factory=ProjectOverride)\n663\t    \"\"\"Patch project settings\"\"\"\n664\t\n665\t    # TODO\n666\t    # source: SourceResolver | None\n667\t    # \"\"\"Source resolver and downloader\"\"\"\n668\t\n669\t    variants: Mapping[Variant, VariantInfo] = Field(default_factory=dict)\n670\t    \"\"\"Variant configuration\"\"\"\n671\t\n672\t    @pydantic.field_validator(\n673\t        \"download_source\", \"resolver_dist\", \"git_options\", \"variants\", mode=\"before\"\n674\t    )\n675\t    @classmethod\n676\t    def before_none_dict(\n677\t        cls, v: _DictStrAny | None, info: core_schema.ValidationInfo\n678\t    ) -> _DictStrAny:\n679\t        if v is None:\n680\t            v = {}\n681\t        return v\n682\t\n683\t    @classmethod\n684\t    def from_mapping(\n685\t        cls,\n686\t        package: str | Package,\n687\t        parsed: dict[str, typing.Any],\n688\t        *,\n689\t        source: pathlib.Path | str | None,\n690\t        has_config: bool,\n691\t    ) -> PackageSettings:\n692\t        \"\"\"Load from a dict\"\"\"\n693\t        package = Package(canonicalize_name(package, validate=True))\n694\t        try:\n695\t            return cls(name=package, has_config=has_config, **parsed)\n696\t        except Exception as err:\n697\t            raise RuntimeError(\n698\t                f\"{package}: failed to load settings (source: {source!r}): {err}\"\n699\t            ) from err\n700\t\n701\t    @classmethod\n702\t    def from_string(\n703\t        cls,\n704\t        package: str | Package,\n705\t        raw_yaml: str,\n706\t        *,\n707\t        source: pathlib.Path | str | None = None,\n708\t    ) -> PackageSettings:\n709\t        \"\"\"Load from raw yaml string\"\"\"\n710\t        parsed: typing.Any = yaml.safe_load(raw_yaml)\n711\t        if parsed is None:\n712\t            # empty file\n713\t            parsed = {}\n714\t        elif not isinstance(parsed, Mapping):\n715\t            raise TypeError(\n716\t                f\"{package}: invalid yaml, not a dict (source: {source!r}): {parsed}\"\n717\t            )\n718\t        return cls.from_mapping(package, parsed, source=source, has_config=True)\n719\t\n720\t    @classmethod\n721\t    def from_file(cls, filename: pathlib.Path) -> PackageSettings:\n722\t        \"\"\"Load from file\n723\t\n724\t        Raises :exc:`FileNotFound` when the file is not found.\n725\t        The package name is taken from the stem of the file name.\n726\t        \"\"\"\n727\t        filename = filename.absolute()\n728\t        logger.debug(\"loading package config from %s\", filename)\n729\t        raw_yaml = filename.read_text(encoding=\"utf-8\")\n730\t        return cls.from_string(filename.stem, raw_yaml, source=filename)\n731\t\n732\t    @classmethod\n733\t    def from_default(cls, package: str | Package) -> PackageSettings:\n734\t        \"\"\"Create a default package setting\"\"\"\n735\t        return cls.from_mapping(package, {}, source=\"default\", has_config=False)\n736\t\n737\t    @property\n738\t    def override_module_name(self) -> str:\n739\t        \"\"\"Override module name from package name\"\"\"\n740\t        return self.name.replace(\"-\", \"_\")\n741\t\n742\t    def serialize(\n743\t        self,\n744\t        mode: str = \"python\",\n745\t        exclude_defaults: bool = True,\n746\t        exclude_unset: bool = True,\n747\t        exclude: set[str] | frozenset[str] = frozenset({\"name\", \"has_config\"}),\n748\t        **kwargs: typing.Any,\n749\t    ) -> dict[str, typing.Any]:\n750\t        \"\"\"Serialize package configuration\"\"\"\n751\t        return self.model_dump(\n752\t            mode=mode,\n753\t            # exclude defaults\n754\t            exclude_defaults=exclude_defaults,\n755\t            exclude_unset=exclude_unset,\n756\t            # name and has_config are not serialized\n757\t            exclude=set(exclude),\n758\t            **kwargs,\n759\t        )\n760\t"}]},"parent_tool_use_id":null,"session_id":"26ae1166-92eb-483a-90db-14bcfd6360d1","uuid":"d27c9c77-a154-4a8b-8739-6590de153997","timestamp":"2026-10-09T17:22:13.890Z","tool_use_result":{"type":"text","file":{"filePath":"/home/alustosa/git/model-routing-eval/.work/agent-eval/2026-10-09-claude-haiku-5-5-effort-medium-r1/cases/r05_fromager_version_prebuilt/src/fromager/packagesettings/_models.py","content":"\"\"\"Pydantic model classes.\"\"\"\n\nfrom __future__ import annotations\n\nimport logging\nimport os\nimport pathlib\nimport re\nimport typing\nfrom collections.abc import Mapping\n\nimport pydantic\nimport yaml\nfrom packaging.requirements import Requirement\nfrom packaging.utils import canonicalize_name\nfrom pydantic import AnyUrl, Field, PrivateAttr, StringConstraints\nfrom pydantic_core import core_schema\n\n# from ._resolver import SourceResolver\nfrom ._typedefs import (\n    MODEL_CONFIG,\n    BuildDirectory,\n    EnvVars,\n    Package,\n    PackageVersion,\n    PurlType,\n    RawAnnotations,\n    Template,\n    UpstreamPurl,\n    Variant,\n    VariantChangelog,\n)\n\nlogger = logging.getLogger(__name__)\n\n\nclass SbomSettings(pydantic.BaseModel):\n    \"\"\"Global SBOM generation settings\n\n    ::\n\n      sbom:\n        supplier: \"Organization: ExampleCo\"\n        namespace: \"https://www.example.com\"\n        purl_type: pypi\n        repository_url: \"https://example.com/simple\"\n        creators:\n          - \"Organization: ExampleCo\"\n    \"\"\"\n\n    model_config = MODEL_CONFIG\n\n    supplier: str = \"NOASSERTION\"\n    \"\"\"SPDX supplier field for the wheel package (e.g. ``Organization: ExampleCo``)\"\"\"\n\n    namespace: AnyUrl = AnyUrl(\"https://spdx.org/spdxdocs\")\n    \"\"\"Base URL for the SPDX documentNamespace\"\"\"\n\n    creators: list[str] = Field(default_factory=list)\n    \"\"\"Additional SPDX creator entries (e.g. ``Organization: ExampleCo``)\n\n    The fromager tool creator entry is always added automatically.\n    \"\"\"\n\n    purl_type: PurlType = \"pypi\"\n    \"\"\"Default purl type for all packages (e.g. ``pypi``, ``generic``)\"\"\"\n\n    repository_url: AnyUrl | None = None\n    \"\"\"Default purl ``repository_url`` qualifier for all packages\n\n    When set, this URL is added to every purl as a qualifier\n    (e.g. ``pkg:pypi/flask@2.0?repository_url=https://example.com/simple``).\n    Can be overridden per-package in the package settings file.\n    \"\"\"\n\n\n# Environment variable filter patterns for ExternalCommands.\n# Pattern: starts with letter or underscore, rest is letters/digits/underscores,\n# optionally ending with ``*`` (trailing wildcard).\n# DeleteEnvPattern additionally allows bare ``*`` (catch-all).\nKeepEnvPattern = typing.Annotated[\n    str,\n    StringConstraints(pattern=r\"^[a-zA-Z_][a-zA-Z0-9_]*\\*?$\"),\n]\n\nDeleteEnvPattern = typing.Annotated[\n    str,\n    StringConstraints(pattern=r\"^(\\*|[a-zA-Z_][a-zA-Z0-9_]*\\*?)$\"),\n]\n\n\n# POSIX.1-2024 sec. 8.1: environment variable names consist of uppercase\n# letters, digits, and underscores and do not begin with a digit.  We\n# also accept lowercase letters for portability (common on Linux).\n_POSIX_ENV_KEY_RE = re.compile(r\"[A-Za-z_][A-Za-z0-9_]*\")\n\n\ndef _compile_env_patterns(\n    patterns: tuple[str, ...],\n    *,\n    case_insensitive: bool = False,\n) -> re.Pattern[str]:\n    \"\"\"Compile env filter patterns into a single regex for ``fullmatch``.\n\n    Exact patterns (e.g. ``HOME``) become ``HOME`` and prefix patterns\n    (e.g. ``LC_*``) become ``LC_.*``.  The result is\n    ``HOME|LC_.*|...`` (used with ``fullmatch``).\n\n    *patterns* must be non-empty.\n    \"\"\"\n    parts: list[str] = []\n    for p in patterns:\n        if p.endswith(\"*\"):\n            parts.append(re.escape(p[:-1]) + \".*\")\n        else:\n            parts.append(re.escape(p))\n    flags = re.IGNORECASE if case_insensitive else 0\n    return re.compile(\"|\".join(parts), flags)\n\n\nclass ExternalCommands(pydantic.BaseModel):\n    \"\"\"Environment variable filtering for subprocesses.\n\n    Variables whose keys are not valid POSIX names are always removed.\n    A hard-coded set of variables required for basic subprocess\n    operation (see ``DEFAULT_KEEP_ENV``) is always kept.  User-supplied\n    ``keep_env`` patterns are evaluated before ``delete_env`` patterns.\n\n    ::\n\n      external_commands:\n        keep_env:\n          - \"CARGO_*\"\n        delete_env:\n          - \"CI_TOKEN\"\n          - \"AWS_*\"\n\n    .. versionadded:: 0.92.0\n    \"\"\"\n\n    model_config = MODEL_CONFIG\n\n    DEFAULT_KEEP_ENV: typing.ClassVar[tuple[str, ...]] = (\n        \"HOME\",\n        \"HOSTNAME\",\n        \"LANG\",\n        \"LANGUAGE\",\n        \"LC_*\",\n        \"LOGNAME\",\n        \"NO_COLOR\",\n        \"PATH\",\n        \"SHELL\",\n        \"TEMP\",\n        \"TERM\",\n        \"TMP\",\n        \"TMPDIR\",\n        \"TZ\",\n        \"USER\",\n    )\n    \"\"\"Patterns always kept regardless of user configuration.\"\"\"\n\n    keep_env: list[KeepEnvPattern] = Field(default_factory=list)\n    \"\"\"Allowlist patterns (evaluated before ``delete_env``)\"\"\"\n\n    delete_env: list[DeleteEnvPattern] = Field(default_factory=list)\n    \"\"\"Blocklist patterns (evaluated after ``keep_env``)\"\"\"\n\n    _keep_re: re.Pattern[str] | None = PrivateAttr(default=None)\n    _delete_re: re.Pattern[str] | None = PrivateAttr(default=None)\n\n    @pydantic.model_validator(mode=\"after\")\n    def validate_delete_env(self) -> typing.Self:\n        \"\"\"Validate ``delete_env`` for conflicts and redundancy.\"\"\"\n        if not self.delete_env:\n            return self\n        if \"*\" in self.delete_env and len(self.delete_env) > 1:\n            raise ValueError(\n                \"delete_env: bare '*' must be the only entry, \"\n                \"additional patterns are redundant\"\n            )\n        # Exact string overlap check.  This catches obvious\n        # configuration mistakes (e.g. ``delete_env: [HOME]``) but does\n        # not detect all conflicts — for example ``delete_env: [LC_ALL]``\n        # is not flagged even though ``LC_ALL`` matches the default keep\n        # pattern ``LC_*``.\n        keep = set(self.DEFAULT_KEEP_ENV) | set(self.keep_env)\n        overlap = keep & set(self.delete_env)\n        if overlap:\n            raise ValueError(\n                f\"delete_env overlaps with keep_env / DEFAULT_KEEP_ENV: \"\n                f\"{sorted(overlap)}\"\n            )\n        return self\n\n    def model_post_init(self, __context: typing.Any) -> None:\n        \"\"\"Pydantic post init hook to initialize internal data structures\"\"\"\n        if self.delete_env:\n            self._keep_re = _compile_env_patterns(\n                self.DEFAULT_KEEP_ENV + tuple(self.keep_env)\n            )\n            if \"*\" not in self.delete_env:\n                self._delete_re = _compile_env_patterns(\n                    tuple(self.delete_env), case_insensitive=True\n                )\n\n    def filter_env(self, env: Mapping[str, str]) -> Mapping[str, str]:\n        \"\"\"Filter environment variables by keep/delete patterns.\n\n        Variables whose keys are not valid POSIX names are always\n        removed first.  Of the remaining variables, those matching\n        ``DEFAULT_KEEP_ENV`` or ``keep_env`` are always kept.  Of the\n        rest, those matching ``delete_env`` are removed.  Variables\n        matching neither list are kept.\n        \"\"\"\n        # Remove keys that are not valid POSIX names, e.g. keys with\n        # dashes, dots, spaces, or bash function exports (BASH_FUNC_*%%).\n        env = {k: v for k, v in env.items() if _POSIX_ENV_KEY_RE.fullmatch(k)}\n        # _keep_re is only set in model_post_init when delete_env is\n        # non-empty, so None means no filtering is configured.\n        if self._keep_re is None:\n            return env\n        if self._delete_re is None:\n            # delete_env is [\"*\"]: keep only what matches\n            return {k: v for k, v in env.items() if self._keep_re.fullmatch(k)}\n        return {\n            k: v\n            for k, v in env.items()\n            if self._keep_re.fullmatch(k) or not self._delete_re.fullmatch(k)\n        }\n\n\nclass PurlConfig(pydantic.BaseModel):\n    \"\"\"Per-package purl configuration for SBOM generation.\n\n    Allows overriding individual purl components or specifying an\n    upstream purl for packages sourced from GitHub/GitLab.\n\n    .. versionadded:: 0.81.0\n\n    ::\n\n      purl:\n        type: generic\n        name: custom-name\n        repository_url: \"https://example.com/simple\"\n        upstream: \"pkg:github/org/repo@v1.0.0\"\n    \"\"\"\n\n    model_config = MODEL_CONFIG\n\n    type: PurlType | None = None\n    \"\"\"Override the purl type (e.g. ``generic`` instead of ``pypi``)\"\"\"\n\n    namespace: str | None = None\n    \"\"\"Override the purl namespace component\"\"\"\n\n    name: str | None = None\n    \"\"\"Override the purl name component (defaults to the package name)\"\"\"\n\n    version: str | None = None\n    \"\"\"Override the purl version component (defaults to the resolved version)\"\"\"\n\n    repository_url: AnyUrl | None = None\n    \"\"\"Per-package override for the purl ``repository_url`` qualifier.\n\n    Overrides the global ``sbom.repository_url`` setting for this package.\n    \"\"\"\n\n    upstream: UpstreamPurl | None = None\n    \"\"\"Full purl string identifying the upstream source package.\n\n    When set, this is used as the upstream identity in the SBOM's\n    GENERATED_FROM relationship. Used for packages sourced from\n    GitHub/GitLab rather than PyPI.\n\n    When absent, the upstream purl is auto-derived from the downstream\n    purl without the ``repository_url`` qualifier.\n    \"\"\"\n\n\nclass ResolverDist(pydantic.BaseModel):\n    \"\"\"Packages resolver dist\n\n    ::\n\n      sdist_server_url: https://pypi.org/simple/\n      include_sdists: True\n      include_wheels: False\n      ignore_platform: False\n    \"\"\"\n\n    model_config = MODEL_CONFIG\n\n    sdist_server_url: str | None = None\n    \"\"\"Source distribution download server (default: PyPI)\"\"\"\n\n    include_sdists: bool = True\n    \"\"\"Use sdists to resolve? (default: yes)\"\"\"\n\n    include_wheels: bool = False\n    \"\"\"Use wheels to resolve? (default: no)\"\"\"\n\n    ignore_platform: bool = False\n    \"\"\"Ignore the platform when resolving with wheels? (default: no)\n\n    This option ignores the platform field (OS, CPU arch) when resolving with\n    *include_wheels* enabled.\n\n    .. versionadded:: 0.52\n    \"\"\"\n\n    use_pypi_org_metadata: bool | None = None\n    \"\"\"Can use metadata from pypi.org JSON / Simple API?\n\n    None (default) is for auto-setting. Packages with customizations (config,\n    patches, plugins) don't use pypi.org metadata by default.\n\n    .. versionadded:: 0.70\n    \"\"\"\n\n    min_release_age: int | None = pydantic.Field(default=None, ge=0)\n    \"\"\"Per-package minimum release age override in days.\n\n    None (default): inherit the global ``--min-release-age`` setting.\n    0: disable the release-age cooldown for this package.\n    Positive integer: override the cooldown with this many days.\n\n    .. versionadded:: 0.82\n    \"\"\"\n\n    @pydantic.model_validator(mode=\"after\")\n    def validate_ignore_platform(self) -> typing.Self:\n        if self.ignore_platform and not self.include_wheels:\n            raise ValueError(\n                \"'ignore_platforms' has no effect without 'include_wheels'\"\n            )\n        return self\n\n\nclass DownloadSource(pydantic.BaseModel):\n    \"\"\"Package download source\n\n    Download package sources from an alternative source, e.g. GitHub release.\n\n    ::\n\n        url: https://example.com/package.tar.gz\n        destination_filename: ${dist_name}-${version}.tar.gz\n    \"\"\"\n\n    model_config = MODEL_CONFIG\n\n    url: Template | None = None\n    \"\"\"Source download url (string template)\"\"\"\n\n    destination_filename: Template | None = None\n    \"\"\"Rename file (filename without path)\"\"\"\n\n    @pydantic.field_validator(\"destination_filename\")\n    @classmethod\n    def validate_destination_filename(cls, v: str) -> str:\n        if os.pathsep in v:\n            raise ValueError(f\"must not contain {os.pathsep}\")\n        return v\n\n\nclass BuildOptions(pydantic.BaseModel):\n    \"\"\"Build system options\n\n    ::\n\n        build_ext_parallel: False  # DEPRECATED: ignored, will be removed\n        cpu_cores_per_job: 1\n        memory_per_job_gb: 1.0\n    \"\"\"\n\n    model_config = MODEL_CONFIG\n\n    build_ext_parallel: bool = False\n    \"\"\"Configure `build_ext[parallel]` in `DIST_EXTRA_CONFIG`\n\n    .. deprecated:: 0.72.0\n       This option is deprecated and will be removed in a future release.\n       The parallel build feature for extensions is unsafe due to race conditions.\n       This option is now ignored and will emit a warning if set to True.\n    \"\"\"\n\n    cpu_cores_per_job: int = Field(default=1, ge=1)\n    \"\"\"Scale parallel jobs by available CPU cores\n\n    Examples:\n\n    1: as many parallel jobs as CPU logical cores\n\n    2: allocate 2 cores per job\n    \"\"\"\n\n    memory_per_job_gb: float = Field(default=1.0, ge=0.1)\n    \"\"\"Scale parallel jobs by available virtual memory (without swap)\n\n    Examples:\n\n    0.5: assume each parallel job requires 512 MB virtual memory\n    \"\"\"\n\n    exclusive_build: bool = False\n    \"\"\"If true, this package must be built on its own (not in parallel with other packages). Default: False.\"\"\"\n\n\nclass ProjectOverride(pydantic.BaseModel):\n    \"\"\"Override pyproject.toml settings\n\n    ::\n\n      update_build_requires:\n        - setuptools\n      remove_build_requires:\n        - ninja\n      requires_external:\n        - openssl-libs\n    \"\"\"\n\n    model_config = MODEL_CONFIG\n\n    update_build_requires: list[str] = Field(default_factory=list)\n    \"\"\"Add / update requirements to pyproject.toml `[build-system] requires`\n    \"\"\"\n\n    remove_build_requires: list[Package] = Field(default_factory=list)\n    \"\"\"Remove requirement from pyproject.toml `[build-system] requires`\n    \"\"\"\n\n    requires_external: list[str] = Field(default_factory=list)\n    \"\"\"Add / update Requires-External core metadata field\n\n    Each entry contains a string describing some dependency in the system\n    that the distribution is to be used. See\n    https://packaging.python.org/en/latest/specifications/core-metadata/#requires-external-multiple-use\n\n    .. note::\n       Fromager does not modify ``METADATA`` file, yet. Read the information\n       from an ``importlib.metadata`` distribution with\n       ``tomlkit.loads(dist(pkgname).read_text(\"fromager-build-settings\"))``.\n    \"\"\"\n\n    @pydantic.field_validator(\"update_build_requires\")\n    @classmethod\n    def validate_update_build_requires(cls, v: list[str]) -> list[str]:\n        for reqstr in v:\n            Requirement(reqstr)\n        return v\n\n\nclass VersionSpecificSettings(pydantic.BaseModel):\n    \"\"\"Per-version overrides within a variant.\n\n    Allows overriding ``pre_built`` and ``wheel_server_url`` for\n    specific package versions.  When a field is ``None``, the\n    variant-wide default is used.\n\n    .. versionadded:: 0.90.0\n\n    ::\n\n      versions:\n        \"2.9.0\":\n          pre_built: true\n          wheel_server_url: https://gitlab.example.com/simple\n    \"\"\"\n\n    model_config = MODEL_CONFIG\n\n    wheel_server_url: str | None = None\n    \"\"\"Alternative package index for this version's pre-built wheel\"\"\"\n\n    pre_built: bool | None = None\n    \"\"\"Override pre-built flag for this version (None = inherit variant default)\"\"\"\n\n\nclass VariantInfo(pydantic.BaseModel):\n    \"\"\"Variant information for a package\n\n    ::\n\n      env:\n        VAR1: \"value 1\"\n        VAR2: \"2.0\n      wheel_server_url: https://pypi.org/simple/\n      pre_built: False\n      versions:\n        \"2.9.0\":\n          pre_built: true\n          wheel_server_url: https://gitlab.example.com/simple\n    \"\"\"\n\n    model_config = MODEL_CONFIG\n\n    annotations: RawAnnotations | None = None\n    \"\"\"Arbitrary metadata for variants\n\n    Variant annotation keys have a higher precedence than package\n    annotation keys.\n    \"\"\"\n\n    env: EnvVars = Field(default_factory=dict)\n    \"\"\"Additional env vars (overrides package env vars)\"\"\"\n\n    wheel_server_url: str | None = None\n    \"\"\"Alternative package index for pre-built wheel\"\"\"\n\n    pre_built: bool = False\n    \"\"\"Use pre-built wheel from index server?\"\"\"\n\n    versions: Mapping[PackageVersion, VersionSpecificSettings] = Field(\n        default_factory=dict\n    )\n    \"\"\"Per-version overrides for ``pre_built`` and ``wheel_server_url``.\n\n    Version-specific settings take precedence over variant defaults\n    when present.\n\n    .. versionadded:: 0.90.0\n    \"\"\"\n\n    # TODO\n    # source: SourceResolver | None\n    # \"\"\"Source resolver and downloader\"\"\"\n\n    @pydantic.field_validator(\"versions\", mode=\"before\")\n    @classmethod\n    def before_none_versions(\n        cls,\n        v: dict[str, typing.Any] | None,\n        info: core_schema.ValidationInfo,\n    ) -> dict[str, typing.Any]:\n        \"\"\"Coerce ``None`` to empty dict for bare ``versions:`` YAML key.\"\"\"\n        if v is None:\n            return {}\n        return v\n\n\nclass GitOptions(pydantic.BaseModel):\n    \"\"\"Git repository cloning options\n\n    ::\n\n        submodules: False\n        submodule_paths: []\n    \"\"\"\n\n    model_config = MODEL_CONFIG\n\n    submodules: bool = False\n    \"\"\"Clone git submodules recursively?\n\n    When True, all submodules will be cloned recursively.\n    When False (default), no submodules will be cloned.\n    \"\"\"\n\n    submodule_paths: list[str] = Field(default_factory=list)\n    \"\"\"Clone specific submodule paths only\n\n    If provided, only the specified submodule paths will be cloned.\n    This option takes precedence over the 'submodules' boolean setting.\n\n    Examples:\n    - [\"third-party/openssl\"]\n    - [\"vendor/lib1\", \"vendor/lib2\"]\n    \"\"\"\n\n\n_DictStrAny = dict[str, typing.Any]\n\n\nclass PackageSettings(pydantic.BaseModel):\n    \"\"\"Package settings\n\n    ::\n\n        build_dir: python\n        changelog:\n            \"1.0.1\":\n                - fixed bug\n        env:\n            EGG: spam\n        download_source:\n            url: https://egg.test\n            destination_filename: new_filename\n        resolver_dist:\n            sdist_server_url: https://sdist.test/egg\n            include_sdists: true\n            include_wheels: false\n        build_options:\n            build_ext_parallel: False\n            cpu_cores_per_job: 1\n            memory_per_job_gb: 1.0\n            exclusive_build: False\n        variants:\n            cpu:\n                env:\n                    EGG: spamalot\n                wheel_server_url: https://wheel.test/simple\n            rocm:\n                pre_built: True\n    \"\"\"\n\n    model_config = MODEL_CONFIG\n\n    name: Package\n    \"\"\"Canonicalized package name\"\"\"\n\n    has_config: bool\n    \"\"\"package has override setting\"\"\"\n\n    annotations: RawAnnotations | None = None\n    \"\"\"Arbitrary metadata for a package\"\"\"\n\n    build_dir: BuildDirectory | None = None\n    \"\"\"sub-directory with setup.py or pyproject.toml\"\"\"\n\n    changelog: VariantChangelog = Field(default_factory=dict)\n    \"\"\"Changelog entries\"\"\"\n\n    config_settings: dict[str, str | list[str]] = Field(default_factory=dict)\n    \"\"\"PEP 517 arbitrary configuration for wheel builds\n\n    https://peps.python.org/pep-0517/#config-settings\n\n    ::\n\n       config_settings:\n         setup-args:\n           - \"-Dsystem-freetype=true\"\n           - \"-Dsystem-qhull=true\"\n    \"\"\"\n\n    env: EnvVars = Field(default_factory=dict)\n    \"\"\"Common env var for all variants\"\"\"\n\n    download_source: DownloadSource = Field(default_factory=DownloadSource)\n    \"\"\"Alternative source download settings\"\"\"\n\n    purl: PurlConfig | None = None\n    \"\"\"Purl configuration for SBOM generation.\n\n    A ``PurlConfig`` object with individual field overrides and upstream\n    source identification.\n\n    .. versionchanged:: 0.81.0\n       The *purl* option now requires a valid PURL config object instead of a string.\n    \"\"\"\n\n    resolver_dist: ResolverDist = Field(default_factory=ResolverDist)\n    \"\"\"Resolve distribution version\"\"\"\n\n    build_options: BuildOptions = Field(default_factory=BuildOptions)\n    \"\"\"Build system options\"\"\"\n\n    git_options: GitOptions = Field(default_factory=GitOptions)\n    \"\"\"Git repository cloning options\"\"\"\n\n    project_override: ProjectOverride = Field(default_factory=ProjectOverride)\n    \"\"\"Patch project settings\"\"\"\n\n    # TODO\n    # source: SourceResolver | None\n    # \"\"\"Source resolver and downloader\"\"\"\n\n    variants: Mapping[Variant, VariantInfo] = Field(default_factory=dict)\n    \"\"\"Variant configuration\"\"\"\n\n    @pydantic.field_validator(\n        \"download_source\", \"resolver_dist\", \"git_options\", \"variants\", mode=\"before\"\n    )\n    @classmethod\n    def before_none_dict(\n        cls, v: _DictStrAny | None, info: core_schema.ValidationInfo\n    ) -> _DictStrAny:\n        if v is None:\n            v = {}\n        return v\n\n    @classmethod\n    def from_mapping(\n        cls,\n        package: str | Package,\n        parsed: dict[str, typing.Any],\n        *,\n        source: pathlib.Path | str | None,\n        has_config: bool,\n    ) -> PackageSettings:\n        \"\"\"Load from a dict\"\"\"\n        package = Package(canonicalize_name(package, validate=True))\n        try:\n            return cls(name=package, has_config=has_config, **parsed)\n        except Exception as err:\n            raise RuntimeError(\n                f\"{package}: failed to load settings (source: {source!r}): {err}\"\n            ) from err\n\n    @classmethod\n    def from_string(\n        cls,\n        package: str | Package,\n        raw_yaml: str,\n        *,\n        source: pathlib.Path | str | None = None,\n    ) -> PackageSettings:\n        \"\"\"Load from raw yaml string\"\"\"\n        parsed: typing.Any = yaml.safe_load(raw_yaml)\n        if parsed is None:\n            # empty file\n            parsed = {}\n        elif not isinstance(parsed, Mapping):\n            raise TypeError(\n                f\"{package}: invalid yaml, not a dict (source: {source!r}): {parsed}\"\n            )\n        return cls.from_mapping(package, parsed, source=source, has_config=True)\n\n    @classmethod\n    def from_file(cls, filename: pathlib.Path) -> PackageSettings:\n        \"\"\"Load from file\n\n        Raises :exc:`FileNotFound` when the file is not found.\n        The package name is taken from the stem of the file name.\n        \"\"\"\n        filename = filename.absolute()\n        logger.debug(\"loading package config from %s\", filename)\n        raw_yaml = filename.read_text(encoding=\"utf-8\")\n        return cls.from_string(filename.stem, raw_yaml, source=filename)\n\n    @classmethod\n    def from_default(cls, package: str | Package) -> PackageSettings:\n        \"\"\"Create a default package setting\"\"\"\n        return cls.from_mapping(package, {}, source=\"default\", has_config=False)\n\n    @property\n    def override_module_name(self) -> str:\n        \"\"\"Override module name from package name\"\"\"\n        return self.name.replace(\"-\", \"_\")\n\n    def serialize(\n        self,\n        mode: str = \"python\",\n        exclude_defaults: bool = True,\n        exclude_unset: bool = True,\n        exclude: set[str] | frozenset[str] = frozenset({\"name\", \"has_config\"}),\n        **kwargs: typing.Any,\n    ) -> dict[str, typing.Any]:\n        \"\"\"Serialize package configuration\"\"\"\n        return self.model_dump(\n            mode=mode,\n            # exclude defaults\n            exclude_defaults=exclude_defaults,\n            exclude_unset=exclude_unset,\n            # name and has_config are not serialized\n            exclude=set(exclude),\n            **kwargs,\n        )\n","numLines":760,"startLine":1,"totalLines":760}},"tool_result_meta":[{"id":"toolu_01DZTbWUoi1UNMjNEw8iTCXC","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
