{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VeS84mjBYHEVzMdeMYG6To","type":"tool_result","content":"557\tclass TestPhaseStart:\n558\t    def test_new_item_advances_to_prepare_source(\n559\t        self, tmp_context: WorkContext\n560\t    ) -> None:\n561\t        bt = bootstrapper.Bootstrapper(tmp_context)\n562\t        bt.why = []\n563\t        item = _make_start_item()\n564\t\n565\t        result = item.run(bt)\n566\t\n567\t        assert len(result) == 1\n568\t        assert isinstance(result[0], PrepareSource)\n569\t        assert result[0].work_item is item.work_item\n570\t\n571\t    def test_already_seen_returns_empty(self, tmp_context: WorkContext) -> None:\n572\t        bt = bootstrapper.Bootstrapper(tmp_context)\n573\t        bt.why = []\n574\t        item = _make_start_item()\n575\t        wi = item.work_item\n576\t\n577\t        # Mark as seen first\n578\t        assert wi.resolved_version is not None\n579\t        bt.mark_as_seen(wi.req, wi.resolved_version)\n580\t\n581\t        result = item.run(bt)\n582\t\n583\t        assert result == []\n584\t\n585\t    def test_adds_to_graph_for_non_toplevel(self, tmp_context: WorkContext) -> None:\n586\t        bt = bootstrapper.Bootstrapper(tmp_context)\n587\t        bt.why = []\n588\t        item = _make_start_item(req_type=RequirementType.INSTALL)\n589\t\n590\t        item.run(bt)\n591\t\n592\t        key = f\"{canonicalize_name('testpkg')}==1.0\"\n593\t        assert key in tmp_context.dependency_graph.nodes\n594\t\n595\t    def test_skips_graph_for_toplevel(self, tmp_context: WorkContext) -> None:\n596\t        bt = bootstrapper.Bootstrapper(tmp_context)\n597\t        bt.why = []\n598\t        item = _make_start_item(req_type=RequirementType.TOP_LEVEL)\n599\t\n600\t        item.run(bt)\n601\t\n602\t        key = f\"{canonicalize_name('testpkg')}==1.0\"\n603\t        assert key not in tmp_context.dependency_graph.nodes\n604\t\n605\t    def test_sdist_only_set_for_non_build_requirem