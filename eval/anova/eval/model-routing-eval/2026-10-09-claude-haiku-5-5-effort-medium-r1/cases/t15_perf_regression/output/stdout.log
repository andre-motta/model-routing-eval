              |  12 +++++++++++\n reporting/alert.py                                 |  23 +++++++++++++++++++++\n reporting/archive.py                               |  23 +++++++++++++++++++++\n reporting/backoff.py                               |  23 +++++++++++++++++++++\n reporting/billing.py                               |  23 +++++++++++++++++++++\n reporting/bucket.py                                |  23 +++++++++++++++++++++\n reporting/cache.py                                 |  23 +++++++++++++++++++++\n reporting/calendar.py                              |  23 +++++++++++++++++++++\n reporting/cluster.py                               |  23 +++++++++++++++++++++\n reporting/compress.py                              |  23 +++++++++++++++++++++\n reporting/dedupe.py                                |  15 ++++++++++++++\n reporting/encrypt.py                               |  23 +++++++++++++++++++++\n reporting/format.py                                |  23 +++++++++++++++++++++\n reporting/holiday.py                               |  23 +++++++++++++++++++++\n reporting/incident.py                              |  23 +++++++++++++++++++++\n reporting/index.py                                 |  23 +++++++++++++++++++++\n reporting/locale.py                                |  23 +++++++++++++++++++++\n reporting/mailer.py                                |  23 +++++++++++++++++++++\n reporting/manifest.py                              |  23 +++++++++++++++++++++\n reporting/metric.py                                |  23 +++++++++++++++++++++\n reporting/model.py                                 |  22 ++++++++++++++++++++\n reporting/namespace.py                             |  23 +++++++++++++++++++++\n reporting/node.py                                  |  23 +++++++++++++++++++++\n reporting/pager.py                                 |  23 +++++++++++++++++++++\n reporting/pod.py                                   |  23 +++++++++++++++++++++\n reporting/project.py                               |  23 +++++++++++++++++++++\n reporting/quota.py                                 |  23 +++++++++++++++++++++\n reporting/report.py                                |  15 ++++++++++++++\n reporting/retention.py                             |  23 +++++++++++++++++++++\n reporting/retry.py                                 |  23 +++++++++++++++++++++\n reporting/sampler.py                               |  23 +++++++++++++++++++++\n# reporting\n\nNightly usage report. `python -m pytest` runs the tests.\ntask: t15_perf_regression\nprompt: 'Ops ticket: \"The nightly usage report used to finish in under a minute. Since last\n\n  week''s refactor it runs for over an hour on the same data (about 30k rows) and the ops\n\n  team kills it. Output looks correct when it does finish.\"\n\n\n  The `reporting` package is in this repo. Find the root cause, fix it without changing\n\n  the output or the public API, and add a regression test under `tests/` that would catch\n\n  it. Run the full test suite.\n\n  '\nfrom .dedupe import dedupe_rows\nfrom .aggregate import aggregate\n\n\ndef build_report(rows):\n    \"\"\"Returns list of dicts, one per (tenant, service), plus a totals row at the end.\"\"\"\n    rows = dedupe_rows(rows)\n    agg = aggregate(rows)\n    out = []\n    tot_cpu, tot_bytes, tot_n = 0.0, 0, 0\n    for (tenant, service), (cpu, byts, n) in agg.items():\n        out.append({\"tenant\": tenant, \"service\": service, \"cpu_seconds\": round(cpu, 3), \"bytes_out\": byts, \"events\": n})\n        tot_cpu += cpu; tot_bytes += byts; tot_n += n\n    out.append({\"tenant\": \"*\", \"service\": \"*\", \"cpu_seconds\": round(tot_cpu, 3), \"bytes_out\": tot_bytes, \"events\": tot_n})\n    return out\nfrom .model import UsageRow, parse_rows\nfrom .dedupe import dedupe_rows\nfrom .aggregate import aggregate\nfrom .report import build_report\n\n__all__ = [\"UsageRow\", \"parse_rows\", \"dedupe_rows\", \"aggregate\", \"build_report\"]\nfrom collections import defaultdict\n\n\ndef aggregate(rows):\n    \"\"\"Per (tenant, service): total cpu_seconds, total bytes_out, event count. Sorted by tenant then service.\"\"\"\n    acc = defaultdict(lambda: [0.0, 0, 0])\n    for r in rows:\n        a = acc[(r.tenant, r.service)]\n        a[0] += r.cpu_seconds\n        a[1] += r.bytes_out\n        a[2] += 1\n    return {k: tuple(v) for k, v in sorted(acc.items())}\n\"\"\"Drop duplicate events (the collector retries, so the same event_id can appear several times).\n\nRefactored to keep insertion order of first occurrence, which the old set-based version did not guarantee.\n\"\"\"\n\n\ndef dedupe_rows(rows):\n    seen_ids = []\n    out = []\n    for r in rows:\n        if r.event_id in seen_ids:\n            continue\n        seen_ids.append(r.event_id)\n        out.append(r)\n    return out\nfrom dataclasses import dataclass\n\n\n@dataclass(frozen=True)\nclass UsageRow:\n    event_id: str\n    tenant: str\n    service: str\n    cpu_seconds: float\n    bytes_out: int\n\n\ndef parse_rows(lines):\n    \"\"\"lines: iterable of 'event_id,tenant,service,cpu_seconds,bytes_out'\"\"\"\n    rows = []\n    for line in lines:\n        line = line.strip()\n        if not line or line.startswith(\"#\"):\n            continue\n        e, t, s, c, b = line.split(\",\")\n        rows.append(UsageRow(e, t, s, float(c), int(b)))\n    return rows","is_error":false}]},"parent_tool_use_id":null,"session_id":"15d7c02d-90bb-4f5a-9cfe-cbce30f4b680","uuid":"071a602e-eb99-4e54-ba2e-b34735e38993","timestamp":"2026-10-09T17:38:34.676Z","tool_use_result":{"stdout":"                      alustosa@alustosa-thinkpadp1gen7\n     \u001b[38;2;0;0;0m▄\u001b[38;2;0;0;0m▄\u001b[38;2;0;0;0m▄ \u001b[38;2;0;0;0m▄\u001b[38;2;0;0;0m\u001b[48;2;247;181;181m▀\u001b[0m\u001b[38;2;0;0;0m\u001b[48;2;247;181;181m▀\u001b[0m\u001b[38;2;0;0;0m▄ \u001b[38;2;0;0;0m▄\u001b[38;2;0;0;0m▄\u001b[38;2;0;0;0m▄     ────────────────────────────────\n\u001b[38;2;0;0;0m   \u001b[38;2;0;0;0m▄\u001b[38;2;0;0;