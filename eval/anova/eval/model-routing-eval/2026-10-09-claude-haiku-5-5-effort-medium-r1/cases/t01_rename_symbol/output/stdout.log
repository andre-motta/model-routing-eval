 * qty for price, qty in items)\n    return round(subtotal * (1 + tax_rate), 2)\n=== tests/test_pricing.py\nfrom shop import calc, Cart\n\n\ndef test_calc():\n    assert calc([(10, 2), (5, 1)], 0.1) == 27.5\n\n\ndef test_cart():\n    c = Cart(0.0)\n    c.add(3, 3)\n    assert c.total() == 9\n\ntests:\ntest_pricing.py\n\nshop:\n__init__.py\ncart.py\npricing.py","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01FZJyVHf1KseNnajQukr1U9","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
