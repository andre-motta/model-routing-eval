+def _make_chained_resolve_item(
+    req: str = "flashinfer-python==0.6.8.post1",
+) -> Resolve:
+    """Return a RESOLVE item reached through its-hub -> reward-hub -> vllm."""
+    return _make_resolve_item(
+        req=req,
+        why_snapshot=[
+            (RequirementType.INSTALL, Requirement("its-hub"), Version("1.0")),
+            (RequirementType.INSTALL, Requirement("reward-hub"), Version("2.0")),
+            (RequirementType.INSTALL, Requirement("vllm"), Version("0.9.1")),
+        ],
+    )
+
+
+_CHAIN_SUFFIX = (
+    " (dependency chain: its-hub==1.0 -> reward-hub==2.0 -> vllm==0.9.1"
+    " -> flashinfer-python==0.6.8.post1)"
+)
+
+
+class TestDependencyChainEnrichment:
+    # -- _dependency_chain_suffix --
+
+    def test_suffix_lists_chain_then_requirement(
+        self, tmp_context: WorkContext
+    ) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context)
+        item = _make_chained_resolve_item()
+
+        assert bt._dependency_chain_suffix(item.work_item) == _CHAIN_SUFFIX
+
+    # -- _enrich_resolution_error --
+
+    def test_enrich_keeps_resolver_exception_type(
+        self, tmp_context: WorkContext
+    ) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context)
+        item = _make_chained_resolve_item()
+        err = ResolverException("no candidates")
+
+        result = bt._enrich_resolution_error(item, err)
+
+        assert type(result) is ResolverException
+        assert str(result) == "no candidates" + _CHAIN_SUFFIX
+
+    def test_enrich_keeps_runtime_error_type(self, tmp_context: WorkContext) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context)
+        item = _make_chained_resolve_item()
+        err = RuntimeError("no versions")
+
+        result = bt._enrich_resolution_error(item, err)
+
+        assert type(result) is RuntimeError
+        assert str(result) == "no versions" + _CHAIN_SUFFIX
+
+    def test_enrich_wraps_other_exception_types(self, tmp_context: WorkContext) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context)
+        item = _make_chained_resolve_item()
+        err = ValueError("bad specifier")
+
+        result = bt._enrich_resolution_error(item, err)
+
+        assert type(result) is RuntimeError
+        assert str(result) == "ValueError: bad specifier" + _CHAIN_SUFFIX
+
+    def test_enrich_top_level_requirement_returns_same_object(
+        self, tmp_context: WorkContext
+    ) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context)
+        item = _make_resolve_item()
+        err = RuntimeError("no versions")
+
+        assert bt._enrich_resolution_error(item, err) is err
+
+    def test_enrich_other_phase_returns_same_object(
+        self, tmp_context: WorkContext
+    ) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context)
+        item = _make_build_item(phase=BootstrapPhase.BUILD)
+        item.work_item.why_snapshot = (
+            _make_chained_resolve_item().work_item.why_snapshot
+        )
+        err = RuntimeError("build failed")
+
+        assert bt._enrich_resolution_error(item, err) is err
+
+    # -- _handle_phase_error --
+
+    def test_normal_mode_raises_enriched_error(self, tmp_context: WorkContext) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context)
+        item = _make_chained_resolve_item()
+        err = ResolverException("no candidates")
+
+        with pytest.raises(ResolverException) as exc_info:
+            try:
+                raise err
+            except ResolverException:
+                bt._handle_phase_error(item, err)
+
+        raised = exc_info.value
+        assert str(raised) == "no candidates" + _CHAIN_SUFFIX
+        # The original stays reachable through the implicit context only
+        assert raised.__context__ is err
+        assert raised.__cause__ is None
+
+    def test_normal_mode_top_level_raises_original(
+        self, tmp_context: WorkContext
+    ) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context)
+        item = _make_resolve_item()
+        err = RuntimeError("no versions")
+
+        with pytest.raises(RuntimeError) as exc_info:
+            try:
+                raise err
+            except RuntimeError:
+                bt._handle_phase_error(item, err)
+
+        assert exc_info.value is err
+
+    def test_test_mode_records_enriched_error(self, tmp_context: WorkContext) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context, test_mode=True)
+        item = _make_chained_resolve_item()
+        err = RuntimeError("no versions")
+
+        result = bt._handle_phase_error(item, err)
+
+        assert result == []
+        assert len(bt.failed_packages) == 1
+        assert bt.failed_packages[0]["failure_type"] == "resolution"
+        assert bt.failed_packages[0]["exception_type"] == "RuntimeError"
+        assert bt.failed_packages[0]["exception_message"] == (
+            "no versions" + _CHAIN_SUFFIX
+        )
+
+    def test_multiple_versions_records_enriched_error(
+        self, tmp_context: WorkContext
+    ) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context, multiple_versions=True)
+        item = _make_chained_resolve_item()
+        err = RuntimeError("no versions")
+
+        result = bt._handle_phase_error(item, err)
+
+        assert result == []
+        key = (canonicalize_name("flashinfer-python"), "unresolved")
+        recorded = bt._failed_versions[key]
+        assert str(recorded) == "no versions" + _CHAIN_SUFFIX
+
+
