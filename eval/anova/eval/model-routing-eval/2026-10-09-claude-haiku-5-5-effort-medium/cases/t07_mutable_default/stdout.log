\n        item = self.stock[sku]\n        if item.qty < qty:\n            raise ValueError(\"insufficient stock\")\n        item.qty -= qty\n        self.history.append((\"ship\", sku, qty))\n\n    def report(self):\n        return {sku: item.qty for sku, item in sorted(self.stock.items())}\n","structuredPatch":[{"oldStart":9,"oldLines":15,"newStart":9,"newLines":15,"lines":[" "," "," class Warehouse:","-    def __init__(self, name, stock={}, history=[]):","+    def __init__(self, name, stock=None, history=None):","         self.name = name","-        self.stock = stock","-        self.history = history","+        self.stock = {} if stock is None else stock","+        self.history = [] if history is None else history"," ","-    def restock(self, sku, qty, tags=[]):","+    def restock(self, sku, qty, tags=None):","         item = self.stock.get(sku)","         if item is None:","-            item = Item(sku, 0, tags)","+            item = Item(sku, 0, list(tags or []))","             self.stock[sku] = item","         item.qty += qty","         self.history.append((\"restock\", sku, qty))"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_017pFLZq6JDbMecNkRbPTHcD","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
