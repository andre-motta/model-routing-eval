+_CHAIN = [
+    (RequirementType.INSTALL, Requirement("its-hub"), Version("1.0")),
+    (RequirementType.INSTALL, Requirement("reward-hub"), Version("2.0")),
+]
+_CHAIN_SUFFIX = " (dependency chain: its-hub==1.0 -> reward-hub==2.0 -> vllm>=0.6)"
+
+
+class TestDependencyChainSuffix:
+    def test_suffix_lists_chain_and_requirement(self, tmp_context: WorkContext) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context)
+        wi = _make_work_item(req="vllm>=0.6", why_snapshot=list(_CHAIN))
+
+        assert bt._dependency_chain_suffix(wi) == _CHAIN_SUFFIX
+
+
+class TestEnrichResolutionError:
+    def test_resolver_exception_keeps_type(self, tmp_context: WorkContext) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context)
+        item = _make_resolve_item(req="vllm>=0.6", why_snapshot=list(_CHAIN))
+        err = ResolverException("no candidates")
+
+        result = bt._enrich_resolution_error(item, err)
+
+        assert type(result) is ResolverException
+        assert str(result) == f"no candidates{_CHAIN_SUFFIX}"
+
+    def test_runtime_error_keeps_type(self, tmp_context: WorkContext) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context)
+        item = _make_resolve_item(req="vllm>=0.6", why_snapshot=list(_CHAIN))
+
+        result = bt._enrich_resolution_error(item, RuntimeError("broken"))
+
+        assert type(result) is RuntimeError
+        assert str(result) == f"broken{_CHAIN_SUFFIX}"
+
+    def test_other_exception_becomes_runtime_error(
+        self, tmp_context: WorkContext
+    ) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context)
+        item = _make_resolve_item(req="vllm>=0.6", why_snapshot=list(_CHAIN))
+
+        result = bt._enrich_resolution_error(item, ValueError("bad spec"))
+
+        assert type(result) is RuntimeError
+        assert str(result) == f"ValueError: bad spec{_CHAIN_SUFFIX}"
+
+    def test_top_level_requirement_returns_same_object(
+        self, tmp_context: WorkContext
+    ) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context)
+        item = _make_resolve_item(req="vllm>=0.6", why_snapshot=[])
+        err = RuntimeError("broken")
+
+        assert bt._enrich_resolution_error(item, err) is err
+
+    def test_non_resolve_phase_returns_same_object(
+        self, tmp_context: WorkContext
+    ) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context)
+        item = _make_build_item(phase=BootstrapPhase.BUILD)
+        item.work_item.why_snapshot = list(_CHAIN)
+        err = RuntimeError("build failed")
+
+        assert bt._enrich_resolution_error(item, err) is err
+
+
+class TestHandlePhaseErrorEnrichment:
+    def test_normal_mode_raises_enriched_error(self, tmp_context: WorkContext) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context)
+        item = _make_resolve_item(req="vllm>=0.6", why_snapshot=list(_CHAIN))
+        err = ResolverException("no candidates")
+
+        with pytest.raises(ResolverException) as exc_info:
+            try:
+                raise err
+            except ResolverException:
+                bt._handle_phase_error(item, err)
+
+        raised = exc_info.value
+        assert str(raised) == f"no candidates{_CHAIN_SUFFIX}"
+        assert raised.__context__ is err
+        assert raised.__cause__ is None
+
+    def test_test_mode_records_enriched_message(self, tmp_context: WorkContext) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context, test_mode=True)
+        item = _make_resolve_item(req="vllm>=0.6", why_snapshot=list(_CHAIN))
+
+        bt._handle_phase_error(item, RuntimeError("broken"))
+
+        assert len(bt.failed_packages) == 1
+        assert bt.failed_packages[0]["exception_message"] == (f"broken{_CHAIN_SUFFIX}")
+
+    def test_multiple_versions_mode_records_enriched_error(
+        self, tmp_context: WorkContext
+    ) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context, multiple_versions=True)
+        item = _make_resolve_item(req="vllm>=0.6", why_snapshot=list(_CHAIN))
+
+        result = bt._handle_phase_error(item, RuntimeError("broken"))
+
+        assert result == []
+        key = (canonicalize_name("vllm"), "unresolved")
+        recorded = bt._failed_versions[key]
+        assert str(recorded) == f"broken{_CHAIN_SUFFIX}"
+        assert type(recorded) is RuntimeError
+
+
