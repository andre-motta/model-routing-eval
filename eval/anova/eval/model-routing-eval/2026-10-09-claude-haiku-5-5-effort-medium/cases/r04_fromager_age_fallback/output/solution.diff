+def _filter_by_age(
+    req: Requirement,
+    candidates: list[Candidate],
+    max_age_cutoff: datetime.datetime,
+    age_fallback: AgeFallback,
+) -> list[Candidate]:
+    """Drop candidates published before ``max_age_cutoff``.
+
+    ``candidates`` must be sorted highest version first. If every candidate
+    is too old, ``age_fallback`` decides the result.
+    """
+    max_age_days = (datetime.datetime.now(datetime.UTC) - max_age_cutoff).days
+    filtered = [
+        c
+        for c in candidates
+        if c.upload_time is None or c.upload_time >= max_age_cutoff
+    ]
+    dropped = len(candidates) - len(filtered)
+    if dropped:
+        logger.info(
+            "%s: have %d candidate(s) of %s published within %d days",
+            req.name,
+            len(filtered),
+            req,
+            max_age_days,
+        )
+    if filtered:
+        return filtered
+
+    if age_fallback is AgeFallback.ALL:
+        logger.warning(
+            "%s: all %d candidate(s) of %s are older than %d days, "
+            "keeping all to avoid empty resolution",
+            req.name,
+            len(candidates),
+            req,
+            max_age_days,
+        )
+        return candidates
+    if age_fallback is AgeFallback.NEWEST:
+        newest = candidates[0]
+        logger.info(
+            "%s: all %d candidate(s) of %s are older than %d days, "
+            "falling back to newest version %s",
+            req.name,
+            len(candidates),
+            req,
+            max_age_days,
+            newest.version,
+        )
+        return [newest]
+    logger.info(
+        "%s: all %d candidate(s) of %s are older than %d days",
+        req.name,
+        len(candidates),
+        req,
+        max_age_days,
+    )
+    return []
+
+
