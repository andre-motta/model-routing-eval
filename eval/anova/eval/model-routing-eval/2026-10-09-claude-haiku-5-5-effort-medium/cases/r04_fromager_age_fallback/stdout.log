    req.name,\n            len(candidates_list),\n            req,\n        )\n        constraint = provider.constraints.get_constraint(req.name)\n        if constraint is not None and _has_equality_pin(constraint):\n            logger.info(\n                \"%s: skipping age filter for pinned constraint (%d candidate(s))\",\n                req.name,\n                len(candidates_list),\n            )\n        else:\n            candidates_list = _filter_by_age(\n                req, candidates_list, max_age_cutoff, age_fallback\n            )\n\n    # Convert candidates to list of (url, version) tuples\n    # Candidates are sorted by version (highest first) by BaseProvider.find_matches()\n    # which calls sorted(candidates, key=attrgetter(\"version\", \"build_tag\"), reverse=True)\n    return [(c.url, c.version) for c in candidates_list]\n\n\ndef _filter_by_age(\n    req: Requirement,\n    candidates: list[Candidate],\n    max_age_cutoff: datetime.datetime,\n    age_fallback: AgeFallback,\n) -> list[Candidate]:\n    \"\"\"Drop candidates published before ``max_age_cutoff``.\n\n    ``candidates`` must be sorted highest version first. If every candidate\n    is too old, ``age_fallback`` decides the result.\n    \"\"\"\n    max_age_days = (datetime.datetime.now(datetime.UTC) - max_age_cutoff).days\n    filtered = [\n        c for c in candidates if c.upload_time is None or c.upload_time >= max_age_cutoff\n    ]\n    dropped = len(candidates) - len(filtered)\n    if dropped:\n        logger.info(\n            \"%s: have %d candidate(s) of %s published within %d days\",\n            req.name,\n            len(filtered),\n            req,\n            max_age_days,\n        )\n    if filtered:\n        return filtered\n\n    if age_fallback is AgeFallback.ALL:\n        logger.warning(\n            \"%s: all %d candidate(s) of %s are older than %d days, \"\n            \"keeping all to avoid empty resolution\",\n            req.name,\n            len(candidates),\n            req,\n            max_age_days,\n        )\n        return candidates\n    if age_fallback is AgeFallback.NEWEST:\n        newest = candidates[0]\n        logger.info(\n            \"%s: all %d candidate(s) of %s are older than %d days, \"\n            \"falling back to newest version %s\",\n            req.name,\n            len(candidates),\n            req,\n            max_age_days,\n            newest.version,\n        )\n        return [newest]\n    logger.info(\n        \"%s: all %d candidate(s) of %s are older than %d days\",\n        req.name,\n        len(candidates),\n        req,\n        max_age_days,\n    )\n    return []\n\n\ndef _unused_placeholder() -> None:\n    \"\"\"placeholder\"\"\"\n    # Convert candidates to list of (url, version) tuples\n    # Candidates are sorted by version (highest first) by BaseProvider.find_matches()\n    # which calls sorted(candidates, key=attrgetter(\"version\", \"build_tag\"), reverse=True)\n    return None"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3552,"cache_read_input_tokens":63177,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3552},"output_tokens":8,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"f96719f9-1d6c-4521-afff-e32c36e25008","uuid":"c6888dfa-9d29-4d2c-acb7-4da5a921e962","timestamp":"2026-10-09T16:17:04.187Z","request_id":"req_011Cfrxq7LJVRZvXKz4Xqs5e","wire_tool_inputs":{"toolu_01A4Mz8sX63khtrohENcinj8":{"file_path":"/home/alustosa/git/model-routing-eval/.work/agent-eval/2026-10-09-claude-haiku-5-5-effort-medium/cases/r04_fromager_age_fallback/src/fromager/resolver.py","old_string":"    if max_age_cutoff is not None:\n        logger.info(\n            \"%s: found %d candidate(s) matching %s\",\n            req.name,\n            