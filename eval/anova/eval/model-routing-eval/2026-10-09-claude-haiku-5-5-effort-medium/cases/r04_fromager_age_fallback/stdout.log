ersions","+        )","+        with (","+            patch.object(brr, \"_resolve_from_graph\", return_value=None),","+            patch(","+                \"fromager.bootstrap_requirement_resolver.sources.get_source_provider\",","+                return_value=PyPIProvider(include_sdists=True),","+            ),","+            patch(","+                \"fromager.bootstrap_requirement_resolver.resolver\"","+                \"._compute_max_age_cutoff\",","+                return_value=_OLD_BAR_CUTOFF,","+            ),","+        ):","+            results = brr.resolve(","+                Requirement(\"bar>=1.0\"),","+                RequirementType.INSTALL,","+                parent_req=None,","+                pre_built=False,","+                return_all_versions=True,","+            )","+","+    assert [str(version) for _, version in results] == expected_versions","+","+","+def test_resolve_multiple_versions_exact_pin_skips_age_filter(","+    tmp_context: WorkContext,","+) -> None:","+    \"\"\"An exact pin to an old release resolves in multi-version mode.\"\"\"","+    tmp_context.constraints.add_constraint(\"bar==2.0\")","+    with requests_mock.Mocker() as r:","+        r.get(","+            \"https://pypi.org/simple/bar/\",","+            json=_OLD_BAR_JSON_RESPONSE,","+            headers={\"Content-Type\": \"application/vnd.pypi.simple.v1+json\"},","+        )","+        brr = BootstrapRequirementResolver(tmp_context, multiple_versions=True)","+        with (","+            patch.object(brr, \"_resolve_from_graph\", return_value=None),","+            patch(","+                \"fromager.bootstrap_requirement_resolver.sources.get_source_provider\",","+                return_value=PyPIProvider(","+                    include_sdists=True, constraints=tmp_context.constraints","+                ),","+            ),","+            patch(","+                \"fromager.bootstrap_requirement_resolver.resolver\"","+                \"._compute_max_age_cutoff\",","+                return_value=_OLD_BAR_CUTOFF,","+            ),","+        ):","+            results = brr.resolve(","+                Requirement(\"bar==2.0\"),","+                RequirementType.INSTALL,","+                parent_req=None,","+                pre_built=False,","+                return_all_versions=True,","+            )","+","+    assert [str(version) for _, version in results] == [\"2.0\"]"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"tool_result_meta":[{"id":"toolu_011KyKx4RYorNMgjUTRwCa5g","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
