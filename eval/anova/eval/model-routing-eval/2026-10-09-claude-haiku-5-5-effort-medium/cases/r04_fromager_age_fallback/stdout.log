           version specifier or with extras are also refused.\n56\t        \"\"\"\n57\t        req = Requirement(unparsed)\n58\t        canon_name = canonicalize_name(req.name)\n59\t        previous = self._data.get(canon_name)\n60\t\n61\t        # validator properties: must have a specifier, must not have extras or URL\n62\t        if req.extras:\n63\t            raise InvalidConstraintError(f\"Constraint {unparsed!r} has extras\")\n64\t        if req.url:\n65\t            raise InvalidConstraintError(f\"Constraint {unparsed!r} has a URL\")\n66\t        if not req.specifier:\n67\t            raise InvalidConstraintError(f\"Constraint {unparsed!r} has no specifiers\")\n68\t\n69\t        # A \"blocked\" specifier (<0, <0.0, <0.0.0) is intentionally\n70\t        # unsatisfiable and used to exclude a package from builds.\n71\t        blocked = _is_blocked_specifier(req.specifier)\n72\t\n73\t        # verify that incoming constraint is okay by itself\n74\t        if not blocked and req.specifier.is_unsatisfiable():\n75\t            raise InvalidConstraintError(f\"Constraint {unparsed!r} is unsatisfiable\")\n76\t\n77\t        if not requirements_file.evaluate_marker(req, req):\n78\t            logger.debug(f\"Constraint {req} does not match environment\")\n79\t            return\n80\t\n81\t        if previous is not None:\n82\t            prev_blocked = _is_blocked_specifier(previous.specifier)\n83\t            if blocked != prev_blocked:\n84\t                raise InvalidConstraintError(\n85\t                    f\"Cannot combine blocked and non-blocked constraints \"\n86\t                    f\"(existing: {previous}, new: {req})\"\n87\t                )\n88\t            if not blocked:\n89\t                logger.debug(\"combining constraints %s and %s\", previous, req)\n90\t                new_specifier = req.specifier & previous.specifier\n91\t                if new_specifier.is_unsatisfiable():\n92\t                    raise InvalidConstraintError(\n93\t            