1\n849\t    assert str(results[0][1]) == \"1.0.0\"\n850\t\n851\t\n852\tdef test_max_release_age_combined_with_cooldown() -> None:\n853\t    \"\"\"Both cooldown (min-release-age) and max-release-age work together as a window.\"\"\"\n854\t    max_age_cutoff = _BOOTSTRAP_TIME - datetime.timedelta(days=30)\n855\t    with requests_mock.Mocker() as r:\n856\t        r.get(\n857\t            \"https://pypi.org/simple/test-pkg/\",\n858\t            json=_cooldown_json_response,\n859\t            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n860\t        )\n861\t        # Cooldown blocks 2.0.0 (too new), max-release-age blocks 1.2.2 (too old)\n862\t        provider = resolver.PyPIProvider(include_sdists=True, cooldown=_COOLDOWN)\n863\t        results = resolver.find_all_matching_from_provider(\n864\t            provider, Requirement(\"test-pkg\"), max_age_cutoff=max_age_cutoff\n865\t        )\n866\t\n867\t    versions = [str(v) for _, v in results]\n868\t    assert versions == [\"1.3.2\"]\n869\t\n870\t\n871\tdef test_compute_max_age_cutoff_with_cooldown(\n872\t    tmp_context: context.WorkContext,\n873\t) -> None:\n874\t    \"\"\"_compute_max_age_cutoff uses cooldown's bootstrap_time when available.\"\"\"\n875\t    tmp_context.cooldown = candidate.Cooldown(\n876\t        min_age=datetime.timedelta(days=7),\n877\t        bootstrap_time=_BOOTSTRAP_TIME,\n878\t    )\n879\t    tmp_context.set_max_release_age(30)\n880\t    cutoff = resolver._compute_max_age_cutoff(tmp_context)\n881\t    assert cutoff == _BOOTSTRAP_TIME - datetime.timedelta(days=30)\n882\t\n883\t\n884\tdef test_compute_max_age_cutoff_without_cooldown(\n885\t    tmp_context: context.WorkContext,\n886\t) -> None:\n887\t    \"\"\"_compute_max_age_cutoff uses current time when no cooldown is set.\"\"\"\n888\t    tmp_context.cooldown = None\n889\t    tmp_context.set_max_release_age(30)\n890\t    cutoff = resolver._compute_max_age_cutoff(tmp_context)\n891\t    assert cutoff is not None\n892\t    expected =