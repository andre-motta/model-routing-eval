22\t            results = resolver.find_all_matching_from_provider(\n723\t                provider, Requirement(\"test-pkg\"), max_age_cutoff=max_age_cutoff\n724\t            )\n725\t\n726\t    versions = [str(v) for _, v in results]\n727\t    assert \"2.0.0\" in versions\n728\t    assert \"1.3.2\" in versions\n729\t    assert \"1.2.2\" not in versions\n730\t    assert \"found 3 candidate(s)\" in caplog.text\n731\t    assert \"have 2 candidate(s)\" in caplog.text\n732\t    assert \"published within\" in caplog.text\n733\t\n734\t\n735\tdef test_max_release_age_keeps_only_recent(\n736\t    caplog: pytest.LogCaptureFixture,\n737\t) -> None:\n738\t    \"\"\"With a tight max-release-age, only very recent versions survive.\"\"\"\n739\t    max_age_cutoff = _BOOTSTRAP_TIME - datetime.timedelta(days=5)\n740\t    with requests_mock.Mocker() as r:\n741\t        r.get(\n742\t            \"https://pypi.org/simple/test-pkg/\",\n743\t            json=_cooldown_json_response,\n744\t            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n745\t        )\n746\t        provider = resolver.PyPIProvider(include_sdists=True)\n747\t        with caplog.at_level(logging.INFO, logger=\"fromager.resolver\"):\n748\t            results = resolver.find_all_matching_from_provider(\n749\t                provider, Requirement(\"test-pkg\"), max_age_cutoff=max_age_cutoff\n750\t            )\n751\t\n752\t    versions = [str(v) for _, v in results]\n753\t    assert versions == [\"2.0.0\"]\n754\t    assert \"found 3 candidate(s)\" in caplog.text\n755\t    assert \"have 1 candidate(s)\" in caplog.text\n756\t    assert \"published within\" in caplog.text\n757\t\n758\t\n759\tdef test_max_release_age_disabled_returns_all() -> None:\n760\t    \"\"\"When max_age_cutoff is None, all versions are returned.\"\"\"\n761\t    with requests_mock.Mocker() as r:\n762\t        r.get(\n763\t            \"https://pypi.org/simple/test-pkg/\",\n764\t            json=_cooldown_json_response,\n765\t            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n766\t        )\n767\t        provider = resolver.PyPIProvider(include_sdists=True)\n768\t        results = resolver.find_all_matching_from_provider(\n769\t            provider, Requirement(\"test-pkg\"), max_age_cutoff=None\n770\t        )\n771\t\n772\t    versions = [str(v) for _, v in results]\n773\t    assert \"2.0.0\" in versions\n774\t    assert \"1.3.2\" in versions\n775\t    assert \"1.2.2\" in versions\n776\t\n777\t\n778\tdef test_max_release_age_all_too_old_keeps_all(\n779\t    caplog: pytest.LogCaptureFixture,\n780\t) -> None:\n781\t    \"\"\"When all versions are older than cutoff, keep all candidates and warn.\"\"\"\n782\t    max_age_cutoff = _BOOTSTRAP_TIME + datetime.timedelta(days=1)\n783\t    with requests_mock.Mocker() as r:\n784\t        r.get(\n785\t            \"https://pypi.org/simple/test-pkg/\",\n786\t            json=_cooldown_json_response,\n787\t            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n788\t        )\n789\t        provider = resolver.PyPIProvider(include_sdists=True)\n790\t        with caplog.at_level(logging.WARNING, logger=\"fromager.resolver\"):\n791\t            results = resolver.find_all_matching_from_provider(\n792\t                provider, Requirement(\"test-pkg\"), max_age_cutoff=max_age_cutoff\n793\t            )\n794\t    versions = [str(v) for _, v in results]\n795\t    assert versions == [\"2.0.0\", \"1.3.2\", \"1.2.2\"]\n796\t    assert \"keeping all to avoid empty resolution\" in caplog.text\n797\t\n798\t\n799\tdef test_max_release_age_all_too_old_returns_empty_when_fallback_disabled(\n800\t    caplog: pytest.LogCaptureFixture,\n801\t) -> None:\n802\t    \"\"\"When fallback is disabled and all versions are too old, return empty list.\"\"\"\n803\t    max_age_cutoff = _BOOTSTRAP_TIME + datetime.timedelta(days=1)\n804\t    with requests_mock.Mocker() as r:\n805\t        r.get(\n806\t            \"https://pypi.org/simple/test-pkg/\",\