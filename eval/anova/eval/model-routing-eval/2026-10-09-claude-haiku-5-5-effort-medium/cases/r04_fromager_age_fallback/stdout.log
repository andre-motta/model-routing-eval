er\"\n                \"._compute_max_age_cutoff\",\n                return_value=_OLD_BAR_CUTOFF,\n            ),\n        ):\n            results = brr.resolve(\n                Requirement(\"bar==2.0\"),\n                RequirementType.INSTALL,\n                parent_req=None,\n                pre_built=False,\n                return_all_versions=True,\n            )\n\n    assert [str(version) for _, version in results] == [\"2.0\"]\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6290,"cache_read_input_tokens":102191,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6290},"output_tokens":4,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"f96719f9-1d6c-4521-afff-e32c36e25008","uuid":"3884537a-382c-4c29-b8f4-2fc3ec3bba77","timestamp":"2026-10-09T16:18:31.678Z","request_id":"req_011Cfrxxdmq3V1B9SwUKJ2ZU","wire_tool_inputs":{"toolu_011KyKx4RYorNMgjUTRwCa5g":{"file_path":"/home/alustosa/git/model-routing-eval/.work/agent-eval/2026-10-09-claude-haiku-5-5-effort-medium/cases/r04_fromager_age_fallback/tests/test_bootstrap_requirement_resolver.py","old_string":"            patch.object(brr, \"_resolve_from_cache_server\") as mock_cache,\n        ):\n            brr.resolve(\n                req,\n                RequirementType.INSTALL,\n                parent_req=None,\n                pre_built=False,\n                return_all_versions=True,\n            )\n\n        mock_cache.assert_not_called()\n","new_string":"            patch.object(brr, \"_resolve_from_cache_server\") as mock_cache,\n        ):\n            brr.resolve(\n                req,\n                RequirementType.INSTALL,\n                parent_req=None,\n                pre_built=False,\n                return_all_versions=True,\n            )\n\n        mock_cache.assert_not_called()\n\n\n# Both releases are about two years old, so neither is inside a 90-day window.\n_OLD_BAR_JSON_RESPONSE = {\n    \"meta\": {\"api-version\": \"1.1\"},\n    \"name\": \"bar\",\n    \"files\": [\n        {\n            \"filename\": \"bar-2.0.tar.gz\",\n            \"url\": \"https://files.pythonhosted.org/packages/bar-2.0.tar.gz\",\n            \"hashes\": {\"sha256\": \"aaa\"},\n            \"upload-time\": \"2024-01-10T00:00:00+00:00\",\n        },\n        {\n            \"filename\": \"bar-2.1.tar.gz\",\n            \"url\": \"https://files.pythonhosted.org/packages/bar-2.1.tar.gz\",\n            \"hashes\": {\"sha256\": \"bbb\"},\n            \"upload-time\": \"2024-05-02T00:00:00+00:00\",\n        },\n    ],\n}\n_OLD_BAR_CUTOFF = datetime.datetime(2026, 6, 1, tzinfo=datetime.UTC)\n\n\n@pytest.mark.parametrize(\n    (\"multiple_versions\", \"expected_fallback\"),\n    [\n        (True, AgeFallback.NEWEST),\n        (False, AgeFallback.ALL),\n    ],\n)\ndef test_resolve_passes_age_fallback_for_version_mode(\n    tmp_context: WorkContext,\n    multiple_versions: bool,\n    expected_fallback: AgeFallback,\n) -> None:\n    \"\"\"Multi-version mode uses AgeFallback.NEWEST, single-version uses ALL.\"\"\"\n    brr = BootstrapRequirementResolver(tmp_context, multiple_versions=multiple_versions)\n    with (\n        patch.object(brr, \"_resolve_from_graph\", return_value=None),\n        patch(\"fromager.bootstrap_requirement_resolver.sources.get_source_provider\"),\n        patch(\n            \"fromager.bootstrap_requirement_resolver.resolver._compute_max_age_cutoff\",\n            return_value=_OLD_BAR_CUTOFF,\n        ),\n        patch(\n            \"fromager.bootstrap_requirement_resolver.resolver\"\n            \".find_all_matching_from_provider\",\n            return_value=[(\"https://files.test/bar-2.1.tar.gz\", Version(\"2.1\"))],\n        ) as mock_find,\n    ):\n        brr.resolve(\n            Requirement(\"bar>=1.0\"),\n            RequirementType.INSTALL,\n            parent_req=None,\n            pre_built=False,\n        )\n\n    assert mock_find.call_args.kwargs[\"max_age_cutoff\"] == _OLD_BAR_CUTOFF\n    assert mock_find.call_args.kwargs[\"age_fallback\"] == expected_fallback\n\n\n@pytest.mark.parametrize(\n    (\"multiple_versions\", \"expected_versions\"),\n    [\n        (True, [\"2.1\"]),\n        (False, [\"2.1\", \"2.0\"]),\n    ],\n)\ndef test_resolve_all_releases_too_old_by_version_mode(\n    tmp_context: WorkContext,\n    multiple_versions: bool,\n    expected_versions: list[str],\n) -> None:\n    \"\"\"Multi-version mode builds the newest release when all are outside the window.\"\"\"\n    with requests_mock.Mocker() as r:\n        r.get(\n            \"https://pypi.org/simple/bar/\",\n            json=_OLD_BAR_JSON_RESPONSE,\n            headers={\"Content-Type\": \"application/vnd.pypi.simple.v1+json\"},\n        )\n        brr = BootstrapRequirementResolver(\n            tmp_context, multiple_versions=multiple_versions\n        )\n        with (\n            patch.object(brr, \"_resolve_from_graph\", return_value=None),\n            patch(\n                \"fromager.bootstrap_requirement_resolver.sources.get_source_provider\",\n                return_value=PyPIProvider(include_sdists=True),\n            ),\n            patch(\n                \"fromager.bootstrap_requirement_resolver.resolver\"\n                \"._compute_max_age_cutoff\",\n                return_value=_OLD_BAR_CUTOFF,\n            ),\n        ):\n            results = brr.resolve(\n                Requirement(\"bar>=1.0\"),\n                RequirementType.INSTALL,\n                parent_req=None,\n                pre_built=False,\n                return_all_versions=True,\n            )\n\n    assert [str(version) for _, version in results] == expected_versions\n\n\ndef test_resolve_multiple_versions_exact_pin_skips_age_filter(\n    tmp_context: WorkContext,\n) -> None:\n    \"\"\"An exact pin to an old release resolves in multi-version mode.\"\"\"\n    tmp_context.constraints.add_constraint(\"bar==2.0\")\n    with requests_mock.Mocker() as r:\n        r.get(\n            \"https://pypi.org/simple/bar/\",\n            json=_OLD_BAR_JSON_RESPONSE,\n            headers={\"Content-Type\": \"application/vnd.pypi.simple.v1+json\"},\n        )\n        brr = BootstrapRequirementResolver(tmp_context, multiple_versions=True)\n        with (\n            patch.object(brr, \"_resolve_from_graph\", return_value=None),\n            patch(\n                \"fromager.bootstrap_requirement_resolver.sources.get_source_provider\",\n                return_value=PyPIProvider(\n                    include_sdists=True, constraints=tmp_context.constraints\n                ),\n            ),\n            patch(\n                \"fromager.bootstrap_requirement_resolver.resolver\"\n                \"._compute_max_age_cutoff\",\n                return_value=_OLD_BAR_CUTOFF,\n            ),\n        ):\n            results = brr.resolve(\n                Requirement(\"bar==2.0\"),\n                RequirementType.INSTALL,\n                parent_req=None,\n                pre_built=False,\n                return_all_versions=True,\n            )\n\n    assert [str(version) for _, version in results] == [\"2.0\"]\n"}}}
