+def test_is_pre_built_hook_not_called_without_version(
+    testdata_context: context.WorkContext,
+) -> None:
+    """The override hook only runs when a version is given."""
+    pbi = testdata_context.settings.package_build_info(TEST_PKG)
+
+    def hook(*, version: Version, variant: str) -> bool:
+        raise AssertionError("hook must not run without a version")
+
+    with patch("fromager.overrides.find_override_method", return_value=hook) as find:
+        assert pbi.is_pre_built() is False
+        assert pbi.pre_built is False
+    find.assert_not_called()
+
+
+def test_is_pre_built_hook_overrides_yaml(
+    testdata_context: context.WorkContext,
+) -> None:
+    """A non-None hook result wins over the version-specific YAML."""
+    pbi = testdata_context.settings.package_build_info(TEST_PKG)
+    calls: list[dict[str, typing.Any]] = []
+
+    def hook(*, version: Version, variant: str) -> bool:
+        calls.append({"version": version, "variant": variant})
+        return True
+
+    with patch("fromager.overrides.find_override_method", return_value=hook):
+        # YAML says 2.8.0 is source, the hook says pre-built
+        assert pbi.is_pre_built(Version("2.8.0+cpu")) is True
+    # the hook receives the version as resolved, with the local segment
+    assert calls == [{"version": Version("2.8.0+cpu"), "variant": "cpu"}]
+
+
+def test_is_pre_built_hook_none_defers_to_yaml(
+    testdata_context: context.WorkContext,
+) -> None:
+    pbi = testdata_context.settings.package_build_info(TEST_PKG)
+
+    def hook(*, version: Version, variant: str) -> None:
+        return None
+
+    with patch("fromager.overrides.find_override_method", return_value=hook):
+        assert pbi.is_pre_built(Version("2.9.0")) is True
+        assert pbi.is_pre_built(Version("2.8.0")) is False
+
