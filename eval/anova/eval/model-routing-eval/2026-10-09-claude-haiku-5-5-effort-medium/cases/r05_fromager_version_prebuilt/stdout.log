{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KbP7XQ1n8A3SxYkxsKUsdf","type":"tool_result","content":"590\t    pbi = testdata_context.settings.package_build_info(TEST_PKG)\n591\t    assert pbi.package == TEST_PKG\n592\t    assert pbi.pre_built\n593\t    assert pbi.variant == \"rocm\"\n594\t    assert pbi.build_tag(Version(\"0.99\")) == ()\n595\t\n596\t    testdata_context.settings.variant = Variant(\"cpu\")\n597\t    pbi = testdata_context.settings.package_build_info(TEST_PREBUILT_PKG)\n598\t    assert pbi.package == TEST_PREBUILT_PKG\n599\t    assert pbi.pre_built\n600\t    assert pbi.variant == \"cpu\"\n601\t    assert pbi.get_changelog(Version(\"1.0.1\")) == [\"onboard\"]\n602\t    assert pbi.build_tag(Version(\"1.0.1\")) == ()\n603\t\n604\t\n605\tdef test_is_pre_built_version_specific(\n606\t    testdata_context: context.WorkContext,\n607\t) -> None:\n608\t    \"\"\"Version-specific pre_built overrides variant default.\"\"\"\n609\t    # cpu variant: pre_built=False by default, but 2.9.0 is pre_built=True\n610\t    pbi = testdata_context.settings.package_build_info(TEST_PKG)\n611\t    assert pbi.variant == \"cpu\"\n612\t    assert pbi.pre_built is False\n613\t    assert pbi.is_pre_built() is False\n614\t    assert pbi.is_pre_built(Version(\"2.9.0\")) is True\n615\t    assert pbi.is_pre_built(Version(\"2.8.0\")) is False\n616\t    assert pbi.is_pre_built(Version(\"3.0.0\")) is False\n617\t\n618\t    # rocm variant: pre_built=True by default, but 1.0.0 is pre_built=False\n619\t    testdata_context.settings.variant = Variant(\"rocm\")\n620\t    pbi = testdata_context.settings.package_build_info(TEST_PKG)\n621\t    assert pbi.pre_built is True\n622\t    assert pbi.is_pre_built() is True\n623\t    assert pbi.is_pre_built(Version(\"1.0.0\")) is False\n624\t    assert pbi.is_pre_built(Version(\"2.0.0\")) is True\n625\t\n626\t    # cuda variant: no version-specific settings\n627\t    testdata_context.settings.variant = Variant(\"cuda\")\n628\