ver_url)\n        return None\n\n    def get_wheel_server_url(self, version: Version | None = None) -> str | None:\n        \"\"\"Version-aware wheel server URL.\n\n        Returns the version-specific URL if defined, otherwise\n        falls back to the variant-wide default.\n\n        .. versionadded:: 0.90.0\n        \"\"\"\n        vi = self._ps.variants.get(self.variant)\n        if vi is None:\n            return None\n        if version is not None:\n            pv = typing.cast(PackageVersion, version)\n            vs = vi.versions.get(pv)","new_string":"    @property\n    def pre_built(self) -> bool:\n        \"\"\"Does the variant use pre-build wheels?\"\"\"\n        return self.is_pre_built()\n\n    def is_pre_built(self, version: Version | None = None) -> bool:\n        \"\"\"Version-aware pre-built check.\n\n        Resolution order:\n\n        1. Plugin hook ``is_pre_built`` (only if version given and hook exists)\n        2. Version-specific YAML setting\n        3. Variant-wide default\n\n        The local version segment is ignored for the YAML lookup, so\n        ``2.8.0+cpu`` uses the ``2.8.0`` settings.\n\n        .. versionadded:: 0.95.0\n        \"\"\"\n        vi = self._ps.variants.get(self.variant)\n        if vi is None:\n            return False\n        if version is None:\n            return vi.pre_built\n        hook_result = overrides.find_and_invoke(\n            self.package,\n            \"is_pre_built\",\n            _default_is_pre_built,\n            version=version,\n            variant=self.variant,\n        )\n        if hook_result is not None:\n            return bool(hook_result)\n        # ignore local version for version-specific settings\n        pv = typing.cast(PackageVersion, Version(version.public))\n        vs = vi.versions.get(pv)\n        if vs is not None and vs.pre_built is not None:\n            return vs.pre_built\n        return vi.pre_built\n\n    @property\n    def wheel_server_url(self) -> str | None:\n   