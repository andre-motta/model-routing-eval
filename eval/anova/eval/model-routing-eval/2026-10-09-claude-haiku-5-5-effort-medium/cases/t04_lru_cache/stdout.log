be O(n).\n    def __len__(self):\n        return len(self._data)\n\n    def __contains__(self, key):\n        entry = self._data.get(key)\n        if entry is None:\n            return False\n        if self._is_expired(entry[1]):\n            del self._data[key]\n            self._expirations += 1\n            return False\n        return True\n"}}}
