+def _wheel_metadata_path(url: str) -> str:
+    """Return the path of the METADATA file of the wheel's own dist-info.
+
+    The dist-info directory is named after the wheel filename:
+    ``{name}-{version}.dist-info/METADATA``. Vendored packages may ship
+    their own ``.dist-info`` directories, so the path must not be searched for.
+
+    Raises:
+        packaging.utils.InvalidWheelFilename: if the URL does not end in a
+            valid wheel filename
+    """
+    filename = urllib.parse.unquote(urllib.parse.urlsplit(url).path.rsplit("/", 1)[-1])
+    # Validates the filename; the raw name is used below because the
+    # normalized name from parse_wheel_filename() may differ (e.g. "_" vs "-").
+    parse_wheel_filename(filename)
+    # Wheel filenames are {name}-{version}[-{build}]-{python}-{abi}-{platform}.whl
+    dist_name, dist_version = filename.split("-")[:2]
+    return f"{dist_name}-{dist_version}.dist-info/METADATA"
+
+
