{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017CutCpsaobH6LtG1Stbwzd","type":"tool_result","content":"150\t\n151\tdef resolve_package_cooldown(\n152\t    ctx: context.WorkContext,\n153\t    req: Requirement,\n154\t    req_type: RequirementType | None = None,\n155\t) -> Cooldown | None:\n156\t    \"\"\"Compute the effective cooldown for a single package.\n157\t\n158\t    Args:\n159\t        ctx: The current work context (provides the global cooldown).\n160\t        req: The package requirement being resolved.\n161\t        req_type: The requirement type (top-level, install, etc.).\n162\t\n163\t    Returns:\n164\t        The cooldown to pass to the provider, or ``None`` if disabled.\n165\t    \"\"\"\n166\t    if req_type == RequirementType.TOP_LEVEL and _has_equality_pin(req):\n167\t        if ctx.cooldown is not None:\n168\t            logger.info(\"cooldown bypassed as the top-level requirement uses == pin\")\n169\t        return None\n170\t\n171\t    per_package_days = ctx.package_build_info(req).resolver_min_release_age\n172\t    global_cooldown = ctx.cooldown\n173\t    if per_package_days is None:\n174\t        return global_cooldown\n175\t    if per_package_days == 0:\n176\t        return None\n177\t    # Per-package positive override: inherit bootstrap_time from global so all\n178\t    # resolutions in a single run share the same fixed cutoff point.\n179\t    bootstrap_time = ("}]},"parent_tool_use_id":null,"session_id":"f506e136-b8ff-4ee7-a459-e9e96f52a5cc","uuid":"992cb7ba-cf9a-4539-9e29-b727d927641c","timestamp":"2026-10-09T16:12:31.002Z","tool_use_result":{"type":"text","file":{"filePath":"/home/alustosa/git/model-routing-eval/.work/agent-eval/2026-10-09-claude-haiku-5-5-effort-medium/cases/r02t_fromager_age_filter_ticket/src/fromager/resolver.py","content":"\ndef resolve_package_cooldown(\n    ctx: context.WorkContext,\n    req: Requirement,\n    req_type: RequirementType | None = None,\n) -> Cooldown | None:\n    \"\"\"Compute the effective cooldown for a single package.\n\n    Args:\n        ctx: The current work context (provides the global cooldown).\n        req: The package requirement being resolved.\n        req_type: The requirement type (top-level, install, etc.).\n\n    Returns:\n        The cooldown to pass to the provider, or ``None`` if disabled.\n    \"\"\"\n    if req_type == RequirementType.TOP_LEVEL and _has_equality_pin(req):\n        if ctx.cooldown is not None:\n            logger.info(\"cooldown bypassed as the top-level requirement uses == pin\")\n        return None\n\n    per_package_days = ctx.package_build_info(req).resolver_min_release_age\n    global_cooldown = ctx.cooldown\n    if per_package_days is None:\n        return global_cooldown\n    if per_package_days == 0:\n        return None\n    # Per-package positive override: inherit bootstrap_time from global so all\n    # resolutions in a single run share the same fixed cutoff point.\n    bootstrap_time = (","numLines":30,"startLine":150,"totalLines":1364}},"tool_result_meta":[{"id":"toolu_017CutCpsaobH6LtG1Stbwzd","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
