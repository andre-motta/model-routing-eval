{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01K2nhAXUdRNHJFe2oprWpV9","type":"tool_result","content":"60\t)\n61\t\n62\t\n63\t@functools.lru_cache(maxsize=200)\n64\tdef match_py_req(py_req: str, *, python_version: Version = PYTHON_VERSION) -> bool:\n65\t    \"\"\"Python version requirement lookup with LRU cache\n66\t\n67\t    Raises InvalidSpecifier on error\n68\t\n69\t    SpecifierSet parsing and matching takes a non-trivial amount of time. A\n70\t    bootstrap run can spend over 10% of its time in parsing and matching\n71\t    Python version requirements.\n72\t\n73\t    This function caches the result of SpecifierSet parsing and contains\n74\t    operation for Python version requirement. Most packages share similar\n75\t    constraints, e.g. ``>= 3.10``.\n76\t    \"\"\"\n77\t    return python_version in SpecifierSet(py_req)\n78\t\n79\t\n80\tdef resolve(\n81\t    *,\n82\t    ctx: context.WorkContext,\n83\t    req: Requirement,\n84\t    sdist_server_url: str,\n85\t    include_sdists: bool = True,\n86\t    include_wheels: bool = True,\n87\t    req_type: RequirementType | None = None,\n88\t    ignore_platform: bool = False,\n89\t) -> tuple[str, Version]:\n90\t    \"\"\"Resolve requirement and return the best matching version.\n91\t\n92\t    Returns (url, version) tuple for the highest matching version.\n93\t    \"\"\"\n94\t    # Create the (reusable) resolver.\n95\t    provider = overrides.find_and_invoke(\n96\t        req.name,\n97\t        \"get_resolver_provider\",\n98\t        default_resolver_provider,\n99\t        ctx=ctx,\n100\t        req=req,\n101\t        include_sdists=include_sdists,\n102\t        include_wheels=include_wheels,\n103\t        sdist_server_url=sdist_server_url,\n104\t        req_type=req_type,\n105\t        ignore_platform=ignore_platform,\n106\t    )\n107\t    provider.cooldown = resolve_package_cooldown(ctx, req, req_type=req_type)\n108\t    max_age_cutoff = _compute_max_age_cutoff(ctx)\n109\t    results = find_all_matching_from_provider(\n110\t        provider, req, max_age_cutoff=max_age_cutoff\n111\t    )\n112\t    return results[0]\n113\t\n114\t\n115\tdef default_resolver_provider(\n116\t    ctx: context.WorkContext,\n117\t    req: Requirement,\n118\t    sdist_server_url: str,\n119\t    include_sdists: bool,\n120\t    include_wheels: bool,\n121\t    req_type: RequirementType | None = None,\n122\t    ignore_platform: bool = False,\n123\t) -> (\n124\t    PyPIProvider\n125\t    | GenericProvider\n126\t    | GitHubTagProvider\n127\t    | GitLabTagProvider\n128\t    | VersionMapProvider\n129\t):\n130\t    \"\"\"Lookup resolver provider to resolve package versions\"\"\"\n131\t    return PyPIProvider(\n132\t        include_sdists=include_sdists,\n133\t        include_wheels=include_wheels,\n134\t        sdist_server_url=sdist_server_url,\n135\t        constraints=ctx.constraints,\n136\t        req_type=req_type,\n137\t        ignore_platform=ignore_platform,\n138\t    )\n139\t\n140\t\n141\tdef _has_equality_pin(req: Requirement) -> bool:\n142\t    \"\"\"Return True if the requirement has a single exact ``==`` pin.\n143\t\n144\t    Rejects wildcard pins (``==1.*``) and compound specifiers (``==1,>2``)\n145\t    which are not true exact version pins.\n146\t    \"\"\"\n147\t    specs = list(req.specifier)\n148\t    return len(specs) == 1 and specs[0].operator == \"==\" and \"*\" not in specs[0].version\n149\t"}]},"parent_tool_use_id":null,"session_id":"f506e136-b8ff-4ee7-a459-e9e96f52a5cc","uuid":"c90808c8-a947-4923-a5c9-3a8f882fbba2","timestamp":"2026-10-09T16:12:25.583Z","tool_use_result":{"type":"text","file":{"filePath":"/home/alustosa/git/model-routing-eval/.work/agent-eval/2026-10-09-claude-haiku-5-5-effort-medium/cases/r02t_fromager_age_filter_ticket/src/fromager/resolver.py","content":")\n\n\n@functools.lru_cache(maxsize=200)\ndef match_py_req(py_req: str, *, python_version: Version = PYTHON_VERSION) -> bool:\n    \"\"\"Python version requirement lookup with LRU cache\n\n    Raises InvalidSpecifier on error\n\n    SpecifierSet parsing and matching takes a non-trivial amount of time. A\n    bootstrap run can spend over 10% of its time in parsing and matching\n    Python version requirements.\n\n    This function caches the result of SpecifierSet parsing and contains\n    operation for Python version requirement. Most packages share similar\n    constraints, e.g. ``>= 3.10``.\n    \"\"\"\n    return python_version in SpecifierSet(py_req)\n\n\ndef resolve(\n    *,\n    ctx: context.WorkContext,\n    req: Requirement,\n    sdist_server_url: str,\n    include_sdists: bool = True,\n    include_wheels: bool = True,\n    req_type: RequirementType | None = None,\n    ignore_platform: bool = False,\n) -> tuple[str, Version]:\n    \"\"\"Resolve requirement and return the best matching version.\n\n    Returns (url, version) tuple for the highest matching version.\n    \"\"\"\n    # Create the (reusable) resolver.\n    provider = overrides.find_and_invoke(\n        req.name,\n        \"get_resolver_provider\",\n        default_resolver_provider,\n        ctx=ctx,\n        req=req,\n        include_sdists=include_sdists,\n        include_wheels=include_wheels,\n        sdist_server_url=sdist_server_url,\n        req_type=req_type,\n        ignore_platform=ignore_platform,\n    )\n    provider.cooldown = resolve_package_cooldown(ctx, req, req_type=req_type)\n    max_age_cutoff = _compute_max_age_cutoff(ctx)\n    results = find_all_matching_from_provider(\n        provider, req, max_age_cutoff=max_age_cutoff\n    )\n    return results[0]\n\n\ndef default_resolver_provider(\n    ctx: context.WorkContext,\n    req: Requirement,\n    sdist_server_url: str,\n    include_sdists: bool,\n    include_wheels: bool,\n    req_type: RequirementType | None = None,\n    ignore_platform: bool = False,\n) -> (\n    PyPIProvider\n    | GenericProvider\n    | GitHubTagProvider\n    | GitLabTagProvider\n    | VersionMapProvider\n):\n    \"\"\"Lookup resolver provider to resolve package versions\"\"\"\n    return PyPIProvider(\n        include_sdists=include_sdists,\n        include_wheels=include_wheels,\n        sdist_server_url=sdist_server_url,\n        constraints=ctx.constraints,\n        req_type=req_type,\n        ignore_platform=ignore_platform,\n    )\n\n\ndef _has_equality_pin(req: Requirement) -> bool:\n    \"\"\"Return True if the requirement has a single exact ``==`` pin.\n\n    Rejects wildcard pins (``==1.*``) and compound specifiers (``==1,>2``)\n    which are not true exact version pins.\n    \"\"\"\n    specs = list(req.specifier)\n    return len(specs) == 1 and specs[0].operator == \"==\" and \"*\" not in specs[0].version\n","numLines":90,"startLine":60,"totalLines":1364}},"tool_result_meta":[{"id":"toolu_01K2nhAXUdRNHJFe2oprWpV9","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
