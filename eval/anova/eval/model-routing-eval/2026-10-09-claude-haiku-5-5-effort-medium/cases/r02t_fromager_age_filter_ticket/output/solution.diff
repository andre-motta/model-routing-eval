+def test_max_release_age_equality_constraint_bypasses_filter(
+    caplog: pytest.LogCaptureFixture,
+) -> None:
+    """An ``==`` constraint outside the age window is kept, not filtered out."""
+    # Pinned to 1.2.2 (84 days old) with a 30 day window: the age filter
+    # would remove every candidate and fallback is disabled as in multi-version mode.
+    max_age_cutoff = _BOOTSTRAP_TIME - datetime.timedelta(days=30)
+    constraints = Constraints()
+    constraints.add_constraint("test-pkg==1.2.2")
+    with requests_mock.Mocker() as r:
+        r.get(
+            "https://pypi.org/simple/test-pkg/",
+            json=_cooldown_json_response,
+            headers={"Content-Type": _PYPI_SIMPLE_JSON_CONTENT_TYPE},
+        )
+        provider = resolver.PyPIProvider(include_sdists=True, constraints=constraints)
+        with caplog.at_level(logging.INFO, logger="fromager.resolver"):
+            results = resolver.find_all_matching_from_provider(
+                provider,
+                Requirement("test-pkg"),
+                max_age_cutoff=max_age_cutoff,
+                fallback_on_empty_age_filter=False,
+            )
+
+    versions = [str(v) for _, v in results]
+    assert versions == ["1.2.2"]
+    assert "max release age bypassed" in caplog.text
+    assert "older than" not in caplog.text
+    assert "keeping all to avoid empty resolution" not in caplog.text
+
+
+def test_max_release_age_range_constraint_still_filters() -> None:
+    """A non-``==`` constraint does not bypass max-release-age."""
+    max_age_cutoff = _BOOTSTRAP_TIME - datetime.timedelta(days=5)
+    constraints = Constraints()
+    constraints.add_constraint("test-pkg>=1.0")
+    with requests_mock.Mocker() as r:
+        r.get(
+            "https://pypi.org/simple/test-pkg/",
+            json=_cooldown_json_response,
+            headers={"Content-Type": _PYPI_SIMPLE_JSON_CONTENT_TYPE},
+        )
+        provider = resolver.PyPIProvider(include_sdists=True, constraints=constraints)
+        results = resolver.find_all_matching_from_provider(
+            provider, Requirement("test-pkg"), max_age_cutoff=max_age_cutoff
+        )
+
+    versions = [str(v) for _, v in results]
+    assert versions == ["2.0.0"]
+
