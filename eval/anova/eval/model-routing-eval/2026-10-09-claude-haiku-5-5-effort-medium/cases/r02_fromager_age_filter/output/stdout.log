{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TYXtRAiyXTUy64QX9WS95m","type":"tool_result","content":"690\t    assert str(version) == \"1.3.2\"\n691\t    assert \"cooldown check skipped\" in caplog.text\n692\t\n693\t\n694\t# ---------------------------------------------------------------------------\n695\t# max-release-age tests\n696\t# ---------------------------------------------------------------------------\n697\t\n698\t# Uses the same _cooldown_json_response fixture:\n699\t#   2.0.0  uploaded 2026-03-24 →  2 days old\n700\t#   1.3.2  uploaded 2026-03-15 → 11 days old\n701\t#   1.2.2  uploaded 2026-01-01 → 84 days old\n702\t# _BOOTSTRAP_TIME = 2026-03-26\n703\t\n704\t# max_age_cutoff = bootstrap_time - max_release_age\n705\t# With 30 days: cutoff = 2026-02-24 → keeps 2.0.0 and 1.3.2, filters 1.2.2\n706\t# With 5 days:  cutoff = 2026-03-21 → keeps only 2.0.0\n707\t\n708\t\n709\tdef test_max_release_age_filters_old_versions(\n710\t    caplog: pytest.LogCaptureFixture,\n711\t) -> None:\n712\t    \"\"\"Versions older than max-release-age are filtered out.\"\"\"\n713\t    max_age_cutoff = _BOOTSTRAP_TIME - datetime.timedelta(days=30)\n714\t    with requests_mock.Mocker() as r:\n715\t        r.get(\n716\t            \"https://pypi.org/simple/test-pkg/\",\n717\t            json=_cooldown_json_response,\n718\t            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n719\t        )\n720\t        provider = resolver.PyPIProvider(include_sdists=True)\n721\t        with caplog.at_level(logging.INFO, logger=\"fromager.resolver\"):\n722\t            results = resolver.find_all_matching_from_provider(\n723\t                provider, Requirement(\"test-pkg\"), max_age_cutoff=max_age_cutoff\n724\t            )\n725\t\n726\t    versions = [str(v) for _, v in results]\n727\t    assert \"2.0.0\" in versions\n728\t    assert \"1.3.2\" in versions\n729\t    assert \"1.2.2\" not in versions\n730\t    assert \"found 3 candidate(s)\" in caplog.text\n731\t    assert \"have 2 candidate(s)\" in caplog.text\n732\t    assert \"published within\" in caplog.text\n733\t\n734\t\n735\tdef test_max_release_age_keeps_only_recent(\n736\t    caplog: pytest.LogCaptureFixture,\n737\t) -> None:\n738\t    \"\"\"With a tight max-release-age, only very recent versions survive.\"\"\"\n739\t    max_age_cutoff = _BOOTSTRAP_TIME - datetime.timedelta(days=5)\n740\t    with requests_mock.Mocker() as r:\n741\t        r.get(\n742\t            \"https://pypi.org/simple/test-pkg/\",\n743\t            json=_cooldown_json_response,\n744\t            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n745\t        )\n746\t        provider = resolver.PyPIProvider(include_sdists=True)\n747\t        with caplog.at_level(logging.INFO, logger=\"fromager.resolver\"):\n748\t            results = resolver.find_all_matching_from_provider(\n749\t                provider, Requirement(\"test-pkg\"), max_age_cutoff=max_age_cutoff\n750\t            )\n751\t\n752\t    versions = [str(v) for _, v in results]\n753\t    assert versions == [\"2.0.0\"]\n754\t    assert \"found 3 candidate(s)\" in caplog.text\n755\t    assert \"have 1 candidate(s)\" in caplog.text\n756\t    assert \"published within\" in caplog.text\n757\t\n758\t\n759\tdef test_max_release_age_disabled_returns_all() -> None:\n760\t    \"\"\"When max_age_cutoff is None, all versions are returned.\"\"\"\n761\t    with requests_mock.Mocker() as r:\n762\t        r.get(\n763\t            \"https://pypi.org/simple/test-pkg/\",\n764\t            json=_cooldown_json_response,\n765\t            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n766\t        )\n767\t        provider = resolver.PyPIProvider(include_sdists=True)\n768\t        results = resolver.find_all_matching_from_provider(\n769\t            provider, Requirement(\"test-pkg\"), max_age_cutoff=None\n770\t        )\n771\t\n772\t    versions = [str(v) for _, v in results]\n773\t    assert \"2.0.0\" in versions\n774\t    assert \"1.3.2\" in versions\n775\t    assert \"1.2.2\" in versions\n776\t\n777\t\n778\tdef test_max_release_age_all_too_old_keeps_all(\n779\t    caplog: pytest.LogCaptureFixture,\n780\t) -> None:\n781\t    \"\"\"When all versions are older than cutoff, keep all candidates and warn.\"\"\"\n782\t    max_age_cutoff = _BOOTSTRAP_TIME + datetime.timedelta(days=1)\n783\t    with requests_mock.Mocker() as r:\n784\t        r.get(\n785\t            \"https://pypi.org/simple/test-pkg/\",\n786\t            json=_cooldown_json_response,\n787\t            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n788\t        )\n789\t        provider = resolver.PyPIProvider(include_sdists=True)\n790\t        with caplog.at_level(logging.WARNING, logger=\"fromager.resolver\"):\n791\t            results = resolver.find_all_matching_from_provider(\n792\t                provider, Requirement(\"test-pkg\"), max_age_cutoff=max_age_cutoff\n793\t            )\n794\t    versions = [str(v) for _, v in results]\n795\t    assert versions == [\"2.0.0\", \"1.3.2\", \"1.2.2\"]\n796\t    assert \"keeping all to avoid empty resolution\" in caplog.text\n797\t\n798\t\n799\tdef test_max_release_age_all_too_old_returns_empty_when_fallback_disabled(\n800\t    caplog: pytest.LogCaptureFixture,\n801\t) -> None:\n802\t    \"\"\"When fallback is disabled and all versions are too old, return empty list.\"\"\"\n803\t    max_age_cutoff = _BOOTSTRAP_TIME + datetime.timedelta(days=1)\n804\t    with requests_mock.Mocker() as r:\n805\t        r.get(\n806\t            \"https://pypi.org/simple/test-pkg/\",\n807\t            json=_cooldown_json_response,\n808\t            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n809\t        )\n810\t        provider = resolver.PyPIProvider(include_sdists=True)\n811\t        with caplog.at_level(logging.INFO, logger=\"fromager.resolver\"):\n812\t            results = resolver.find_all_matching_from_provider(\n813\t                provider,\n814\t                Requirement(\"test-pkg\"),\n815\t                max_age_cutoff=max_age_cutoff,\n816\t                fallback_on_empty_age_filter=False,\n817\t            )\n818\t    assert results == []\n819\t    assert \"all 3 candidate(s)\" in caplog.text\n820\t    assert \"keeping all to avoid empty resolution\" not in caplog.text\n821\t\n822\t\n823\tdef test_max_release_age_candidates_without_upload_time_pass_through() -> None:\n824\t    \"\"\"Candidates without upload_time are not filtered out by max-release-age.\"\"\"\n825\t    no_timestamp_response = {\n826\t        \"meta\": {\"api-version\": \"1.1\"},\n827\t        \"name\": \"test-pkg\",\n828\t        \"files\": [\n829\t            {\n830\t                \"filename\": \"test_pkg-1.0.0-py3-none-any.whl\",\n831\t                \"url\": \"https://files.pythonhosted.org/packages/test_pkg-1.0.0-py3-none-any.whl\",\n832\t                \"hashes\": {\"sha256\": \"aaa\"},\n833\t            },\n834\t        ],\n835\t    }\n836\t    max_age_cutoff = _BOOTSTRAP_TIME - datetime.timedelta(days=5)\n837\t    with requests_mock.Mocker() as r:\n838\t        r.get(\n839\t            \"https://pypi.org/simple/test-pkg/\",\n840\t            json=no_timestamp_response,\n841\t            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n842\t        )\n843\t        provider = resolver.PyPIProvider(include_sdists=True)\n844\t        results = resolver.find_all_matching_from_provider(\n845\t            provider, Requirement(\"test-pkg\"), max_age_cutoff=max_age_cutoff\n846\t        )\n847\t\n848\t    assert len(results) == 1\n849\t    assert str(results[0][1]) == \"1.0.0\"\n850\t\n851\t\n852\tdef test_max_release_age_combined_with_cooldown() -> None:\n853\t    \"\"\"Both cooldown (min-release-age) and max-release-age work together as a window.\"\"\"\n854\t    max_age_cutoff = _BOOTSTRAP_TIME - datetime.timedelta(days=30)\n855\t    with requests_mock.Mocker() as r:\n856\t        r.get(\n857\t            \"https://pypi.org/simple/test-pkg/\",\n858\t            json=_cooldown_json_response,\n859\t            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n860\t        )\n861\t        # Cooldown blocks 2.0.0 (too new), max-release-age blocks 1.2.2 (too old)\n862\t        provider = resolver.PyPIProvider(include_sdists=True, cooldown=_COOLDOWN)\n863\t        results = resolver.find_all_matching_from_provider(\n864\t            provider, Requirement(\"test-pkg\"), max_age_cutoff=max_age_cutoff\n865\t        )\n866\t\n867\t    versions = [str(v) for _, v in results]\n868\t    assert versions == [\"1.3.2\"]\n869\t\n870\t\n871\tdef test_compute_max_age_cutoff_with_cooldown(\n872\t    tmp_context: context.WorkContext,\n873\t) -> None:\n874\t    \"\"\"_compute_max_age_cutoff uses cooldown's bootstrap_time when available.\"\"\"\n875\t    tmp_context.cooldown = candidate.Cooldown(\n876\t        min_age=datetime.timedelta(days=7),\n877\t        bootstrap_time=_BOOTSTRAP_TIME,\n878\t    )\n879\t    tmp_context.set_max_release_age(30)"}]},"parent_tool_use_id":null,"session_id":"5d6a6c0a-3f52-4734-8ccf-f58db7f62c41","uuid":"df05cd7b-475b-4602-a1a1-b6ab8c68c86f","timestamp":"2026-10-09T16:10:42.482Z","tool_use_result":{"type":"text","file":{"filePath":"/home/alustosa/git/model-routing-eval/.work/agent-eval/2026-10-09-claude-haiku-5-5-effort-medium/cases/r02_fromager_age_filter/tests/test_cooldown.py","content":"    assert str(version) == \"1.3.2\"\n    assert \"cooldown check skipped\" in caplog.text\n\n\n# ---------------------------------------------------------------------------\n# max-release-age tests\n# ---------------------------------------------------------------------------\n\n# Uses the same _cooldown_json_response fixture:\n#   2.0.0  uploaded 2026-03-24 →  2 days old\n#   1.3.2  uploaded 2026-03-15 → 11 days old\n#   1.2.2  uploaded 2026-01-01 → 84 days old\n# _BOOTSTRAP_TIME = 2026-03-26\n\n# max_age_cutoff = bootstrap_time - max_release_age\n# With 30 days: cutoff = 2026-02-24 → keeps 2.0.0 and 1.3.2, filters 1.2.2\n# With 5 days:  cutoff = 2026-03-21 → keeps only 2.0.0\n\n\ndef test_max_release_age_filters_old_versions(\n    caplog: pytest.LogCaptureFixture,\n) -> None:\n    \"\"\"Versions older than max-release-age are filtered out.\"\"\"\n    max_age_cutoff = _BOOTSTRAP_TIME - datetime.timedelta(days=30)\n    with requests_mock.Mocker() as r:\n        r.get(\n            \"https://pypi.org/simple/test-pkg/\",\n            json=_cooldown_json_response,\n            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n        )\n        provider = resolver.PyPIProvider(include_sdists=True)\n        with caplog.at_level(logging.INFO, logger=\"fromager.resolver\"):\n            results = resolver.find_all_matching_from_provider(\n                provider, Requirement(\"test-pkg\"), max_age_cutoff=max_age_cutoff\n            )\n\n    versions = [str(v) for _, v in results]\n    assert \"2.0.0\" in versions\n    assert \"1.3.2\" in versions\n    assert \"1.2.2\" not in versions\n    assert \"found 3 candidate(s)\" in caplog.text\n    assert \"have 2 candidate(s)\" in caplog.text\n    assert \"published within\" in caplog.text\n\n\ndef test_max_release_age_keeps_only_recent(\n    caplog: pytest.LogCaptureFixture,\n) -> None:\n    \"\"\"With a tight max-release-age, only very recent versions survive.\"\"\"\n    max_age_cutoff = _BOOTSTRAP_TIME - datetime.timedelta(days=5)\n    with requests_mock.Mocker() as r:\n        r.get(\n            \"https://pypi.org/simple/test-pkg/\",\n            json=_cooldown_json_response,\n            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n        )\n        provider = resolver.PyPIProvider(include_sdists=True)\n        with caplog.at_level(logging.INFO, logger=\"fromager.resolver\"):\n            results = resolver.find_all_matching_from_provider(\n                provider, Requirement(\"test-pkg\"), max_age_cutoff=max_age_cutoff\n            )\n\n    versions = [str(v) for _, v in results]\n    assert versions == [\"2.0.0\"]\n    assert \"found 3 candidate(s)\" in caplog.text\n    assert \"have 1 candidate(s)\" in caplog.text\n    assert \"published within\" in caplog.text\n\n\ndef test_max_release_age_disabled_returns_all() -> None:\n    \"\"\"When max_age_cutoff is None, all versions are returned.\"\"\"\n    with requests_mock.Mocker() as r:\n        r.get(\n            \"https://pypi.org/simple/test-pkg/\",\n            json=_cooldown_json_response,\n            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n        )\n        provider = resolver.PyPIProvider(include_sdists=True)\n        results = resolver.find_all_matching_from_provider(\n            provider, Requirement(\"test-pkg\"), max_age_cutoff=None\n        )\n\n    versions = [str(v) for _, v in results]\n    assert \"2.0.0\" in versions\n    assert \"1.3.2\" in versions\n    assert \"1.2.2\" in versions\n\n\ndef test_max_release_age_all_too_old_keeps_all(\n    caplog: pytest.LogCaptureFixture,\n) -> None:\n    \"\"\"When all versions are older than cutoff, keep all candidates and warn.\"\"\"\n    max_age_cutoff = _BOOTSTRAP_TIME + datetime.timedelta(days=1)\n    with requests_mock.Mocker() as r:\n        r.get(\n            \"https://pypi.org/simple/test-pkg/\",\n            json=_cooldown_json_response,\n            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n        )\n        provider = resolver.PyPIProvider(include_sdists=True)\n        with caplog.at_level(logging.WARNING, logger=\"fromager.resolver\"):\n            results = resolver.find_all_matching_from_provider(\n                provider, Requirement(\"test-pkg\"), max_age_cutoff=max_age_cutoff\n            )\n    versions = [str(v) for _, v in results]\n    assert versions == [\"2.0.0\", \"1.3.2\", \"1.2.2\"]\n    assert \"keeping all to avoid empty resolution\" in caplog.text\n\n\ndef test_max_release_age_all_too_old_returns_empty_when_fallback_disabled(\n    caplog: pytest.LogCaptureFixture,\n) -> None:\n    \"\"\"When fallback is disabled and all versions are too old, return empty list.\"\"\"\n    max_age_cutoff = _BOOTSTRAP_TIME + datetime.timedelta(days=1)\n    with requests_mock.Mocker() as r:\n        r.get(\n            \"https://pypi.org/simple/test-pkg/\",\n            json=_cooldown_json_response,\n            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n        )\n        provider = resolver.PyPIProvider(include_sdists=True)\n        with caplog.at_level(logging.INFO, logger=\"fromager.resolver\"):\n            results = resolver.find_all_matching_from_provider(\n                provider,\n                Requirement(\"test-pkg\"),\n                max_age_cutoff=max_age_cutoff,\n                fallback_on_empty_age_filter=False,\n            )\n    assert results == []\n    assert \"all 3 candidate(s)\" in caplog.text\n    assert \"keeping all to avoid empty resolution\" not in caplog.text\n\n\ndef test_max_release_age_candidates_without_upload_time_pass_through() -> None:\n    \"\"\"Candidates without upload_time are not filtered out by max-release-age.\"\"\"\n    no_timestamp_response = {\n        \"meta\": {\"api-version\": \"1.1\"},\n        \"name\": \"test-pkg\",\n        \"files\": [\n            {\n                \"filename\": \"test_pkg-1.0.0-py3-none-any.whl\",\n                \"url\": \"https://files.pythonhosted.org/packages/test_pkg-1.0.0-py3-none-any.whl\",\n                \"hashes\": {\"sha256\": \"aaa\"},\n            },\n        ],\n    }\n    max_age_cutoff = _BOOTSTRAP_TIME - datetime.timedelta(days=5)\n    with requests_mock.Mocker() as r:\n        r.get(\n            \"https://pypi.org/simple/test-pkg/\",\n            json=no_timestamp_response,\n            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n        )\n        provider = resolver.PyPIProvider(include_sdists=True)\n        results = resolver.find_all_matching_from_provider(\n            provider, Requirement(\"test-pkg\"), max_age_cutoff=max_age_cutoff\n        )\n\n    assert len(results) == 1\n    assert str(results[0][1]) == \"1.0.0\"\n\n\ndef test_max_release_age_combined_with_cooldown() -> None:\n    \"\"\"Both cooldown (min-release-age) and max-release-age work together as a window.\"\"\"\n    max_age_cutoff = _BOOTSTRAP_TIME - datetime.timedelta(days=30)\n    with requests_mock.Mocker() as r:\n        r.get(\n            \"https://pypi.org/simple/test-pkg/\",\n            json=_cooldown_json_response,\n            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n        )\n        # Cooldown blocks 2.0.0 (too new), max-release-age blocks 1.2.2 (too old)\n        provider = resolver.PyPIProvider(include_sdists=True, cooldown=_COOLDOWN)\n        results = resolver.find_all_matching_from_provider(\n            provider, Requirement(\"test-pkg\"), max_age_cutoff=max_age_cutoff\n        )\n\n    versions = [str(v) for _, v in results]\n    assert versions == [\"1.3.2\"]\n\n\ndef test_compute_max_age_cutoff_with_cooldown(\n    tmp_context: context.WorkContext,\n) -> None:\n    \"\"\"_compute_max_age_cutoff uses cooldown's bootstrap_time when available.\"\"\"\n    tmp_context.cooldown = candidate.Cooldown(\n        min_age=datetime.timedelta(days=7),\n        bootstrap_time=_BOOTSTRAP_TIME,\n    )\n    tmp_context.set_max_release_age(30)","numLines":190,"startLine":690,"totalLines":968}},"tool_result_meta":[{"id":"toolu_01TYXtRAiyXTUy64QX9WS95m","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
