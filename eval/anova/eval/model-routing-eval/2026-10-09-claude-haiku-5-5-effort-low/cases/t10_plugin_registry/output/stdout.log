: \"c\"}]\n\n\ndef test_csv():\n    assert export_records(R, \"csv\") == b\"id,name\\n1,a&b\\n2,c\\n\"\n\n\ndef test_json():\n    assert json.loads(export_records(R, \"json\")) == R\n\n\ndef test_xml():\n    assert b\"<name>a&amp;b</name>\" in export_records(R, \"xml\")\n\n\ndef test_file_extension(tmp_path):\n    p = export_to_file(R, \"json\", tmp_path / \"out\")\n    assert p.endswith(\".json\")\n\n\ndef test_unknown():\n    try:\n        export_records(R, \"yaml\")\n    except UnknownFormat:\n        pass\n    else:\n        raise AssertionError\ntask: t10_plugin_registry\nprompt: \"`export/core.py` dispatches on format strings with if-chains in three places. Refactor\\nit into a plugin architecture:\\n\\n- an `Exporter` base class (or protocol) with `name`, `extension`, `dump(records) -> bytes`\\n- a registry with `register(exporter_cls)` usable as a decorator, `get(name)`, `names()`\\n- the three existing formats (csv, json, xml) move into `export/formats/` as separate\\n  modules, auto-discovered or imported by the package so they are registered on\\n  `import export`\\n- `export_records(records, fmt)` and `export_to_file(records, fmt, path)` keep their\\n  signatures and behaviour\\n- unknown format raises `export.UnknownFormat` with the list of known names in the message\\n- adding a new format must require no change to `core.py`\\n\\nKeep the existing tests passing and run them.\\n\"\nfa7b568 fixture\n33ff9f1 initial\nexport/__init__.py:1:from .core import export_records, export_to_file, UnknownFormat\nexport/__init__.py:3:__all__ = [\"export_records\", \"export_to_file\", \"UnknownFormat\"]\nexport/core.py:21:def export_records(records, fmt):\nexport/core.py:44:def export_to_file(records, fmt, path):\nexport/core.py:51:        f.write(export_records(records, fmt))","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_015j7pAJwV8cZQqftb31jaih","permission_decision":{"decision":"accept","source":"config"