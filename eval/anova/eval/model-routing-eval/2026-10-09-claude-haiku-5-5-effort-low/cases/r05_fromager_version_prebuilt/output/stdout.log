62\t        Returns ``None`` if the requirement has not been resolved yet, allowing\n163\t        callers to distinguish between \"no matching versions\" and \"not yet resolved\".\n164\t\n165\t        Args:\n166\t            req: Package requirement\n167\t            pre_built: Whether looking for prebuilt or source resolution\n168\t\n169\t        Returns:\n170\t            List of (url, version) tuples if previously resolved, None otherwise.\n171\t        \"\"\"\n172\t        rule_key = (str(req), pre_built)\n173\t        with self._lock:\n174\t            if rule_key in self._resolved_rules:\n175\t                return self._get_matching_versions(req, pre_built)\n176\t        return None\n177\t\n178\t    def _resolve_and_extend(\n179\t        self,\n180\t        req: Requirement,\n181\t        req_type: RequirementType,\n182\t        pre_built: bool,\n183\t        parent_req: Requirement | None,\n184\t    ) -> None:\n185\t        \"\"\"Resolve versions from graph/network and extend known versions cache.\"\"\"\n186\t        # Try previous dependency graph\n187\t        cached_resolution = self._resolve_from_graph(\n188\t            req=req,\n189\t            req_type=req_type,\n190\t            pre_built=pre_built,\n191\t            parent_req=parent_req,\n192\t        )\n193\t\n194\t        if cached_resolution:\n195\t            logger.debug(\n196\t                f\"resolved from previous bootstrap: {len(cached_resolution)} version(s)\"\n197\t            )\n198\t            results = cached_resolution\n199\t        elif pre_built:\n200\t            # Resolve prebuilt wheel\n201\t            pinned = _extract_pinned_version(req)\n202\t            wheel_server_urls = wheels.get_wheel_server_urls(\n203\t                self.ctx,\n204\t                req,\n205\t                cache_wheel_server_url=resolver.PYPI_SERVER_URL,\n206\t                version=pinned,\n207\t            )\n208\t            results = wheels.resolve_all_prebuilt_wheels(\n209\t             