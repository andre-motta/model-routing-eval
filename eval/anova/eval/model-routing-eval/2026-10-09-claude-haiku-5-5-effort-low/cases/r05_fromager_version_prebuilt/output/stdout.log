{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013ZXWRdVSJRkK6eGKqi9fi9","type":"tool_result","content":"20\t# Hooks that per-package plugins can implement to override default build behavior.\n21\tOVERRIDE_HOOK_NAMES: tuple[str, ...] = (\n22\t    \"add_extra_metadata_to_wheels\",\n23\t    \"build_sdist\",\n24\t    \"build_wheel\",\n25\t    \"download_source\",\n26\t    \"expected_source_archive_name\",\n27\t    \"expected_source_directory_name\",\n28\t    \"get_build_backend_dependencies\",\n29\t    \"get_build_sdist_dependencies\",\n30\t    \"get_build_system_dependencies\",\n31\t    \"get_install_dependencies_of_sdist\",\n32\t    \"get_resolver_provider\",\n33\t    \"is_pre_built\",\n34\t    \"prepare_source\",\n35\t    \"update_extra_environ\",\n36\t)\n37\t\n38\t\n39\tdef _get_extensions() -> extension.ExtensionManager:\n40\t    global _mgr\n41\t    if _mgr is None:\n42\t        _mgr = extension.ExtensionManager(\n43\t            namespace=\"fromager.project_overrides\",\n44\t            invoke_on_load=False,\n45\t            on_load_failure_callback=_die_on_plugin_load_failure,\n46\t        )\n47\t    return _mgr\n48\t\n49\t\n50\tdef _die_on_plugin_load_failure(\n51\t    mgr: extension.ExtensionManager,\n52\t    ep: metadata.EntryPoint,\n53\t    err: BaseException,\n54\t) -> None:\n55\t    raise RuntimeError(f\"failed to load overrides for {ep.name}\") from err\n56\t\n57\t\n58\tdef find_and_invoke(\n59\t    distname: str,"}]},"parent_tool_use_id":null,"session_id":"11316fc5-3114-41d9-8938-693c3d7008eb","uuid":"619e07c6-dc4f-4203-9789-77c26fb92323","timestamp":"2026-10-09T15:41:50.473Z","tool_use_result":{"type":"text","file":{"filePath":"/home/alustosa/git/model-routing-eval/.work/agent-eval/2026-10-09-claude-haiku-5-5-effort-low/cases/r05_fromager_version_prebuilt/src/fromager/overrides.py","content":"# Hooks that per-package plugins can implement to override default build behavior.\nOVERRIDE_HOOK_NAMES: tuple[str, ...] = (\n    \"add_extra_metadata_to_wheels\",\n    \"build_sdist\",\n    \"build_wheel\",\n    \"download_source\",\n    \"expected_source_archive_name\",\n    \"expected_source_directory_name\",\n    \"get_build_backend_dependencies\",\n    \"get_build_sdist_dependencies\",\n    \"get_build_system_dependencies\",\n    \"get_install_dependencies_of_sdist\",\n    \"get_resolver_provider\",\n    \"is_pre_built\",\n    \"prepare_source\",\n    \"update_extra_environ\",\n)\n\n\ndef _get_extensions() -> extension.ExtensionManager:\n    global _mgr\n    if _mgr is None:\n        _mgr = extension.ExtensionManager(\n            namespace=\"fromager.project_overrides\",\n            invoke_on_load=False,\n            on_load_failure_callback=_die_on_plugin_load_failure,\n        )\n    return _mgr\n\n\ndef _die_on_plugin_load_failure(\n    mgr: extension.ExtensionManager,\n    ep: metadata.EntryPoint,\n    err: BaseException,\n) -> None:\n    raise RuntimeError(f\"failed to load overrides for {ep.name}\") from err\n\n\ndef find_and_invoke(\n    distname: str,","numLines":40,"startLine":20,"totalLines":155}},"tool_result_meta":[{"id":"toolu_013ZXWRdVSJRkK6eGKqi9fi9","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
