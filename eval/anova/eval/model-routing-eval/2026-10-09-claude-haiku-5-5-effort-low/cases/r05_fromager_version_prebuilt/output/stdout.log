hook(\n    result: bool | None,\n    calls: list[Version] | None = None,\n) -> typing.Callable[..., bool | None]:\n    \"\"\"Build an ``is_pre_built`` override hook returning *result*.\"\"\"\n\n    def is_pre_built(*, version: Version, variant: str) -> bool | None:\n        if calls is not None:\n            calls.append(version)\n        return result\n\n    return is_pre_built\n\n\ndef test_is_pre_built_hook_overrides_yaml(\n    testdata_context: context.WorkContext,\n) -> None:\n    \"\"\"A non-None hook result wins over the version-specific YAML setting.\"\"\"\n    pbi = testdata_context.settings.package_build_info(TEST_PKG)\n    # YAML: 2.8.0 is False and 2.9.0 is True\n    with patch.object(\n        overrides, \"find_override_method\", return_value=_make_is_pre_built_hook(True)\n    ):\n        assert pbi.is_pre_built(Version(\"2.8.0\")) is True\n    with patch.object(\n        overrides, \"find_override_method\", return_value=_make_is_pre_built_hook(False)\n    ):\n        assert pbi.is_pre_built(Version(\"2.9.0\")) is False\n\n\ndef test_is_pre_built_hook_none_defers_to_yaml(\n    testdata_context: context.WorkContext,\n) -> None:\n    \"\"\"A None hook result falls back to the YAML settings.\"\"\"\n    pbi = testdata_context.settings.package_build_info(TEST_PKG)\n    with patch.object(\n        overrides, \"find_override_method\", return_value=_make_is_pre_built_hook(None)\n    ):\n        assert pbi.is_pre_built(Version(\"2.9.0\")) is True\n        assert pbi.is_pre_built(Version(\"2.8.0\")) is False\n\n\ndef test_is_pre_built_hook_not_called_without_version(\n    testdata_context: context.WorkContext,\n) -> None:\n    \"\"\"Without a version the hook is skipped and the variant default is used.\"\"\"\n    pbi = testdata_context.settings.package_build_info(TEST_PKG)\n    calls: list[Version] = []\n    with patch.object(\n        overrides,\n        \"find_override_method\",\n        return_value=_make_is_pre_built_hook(True, calls),\n    ):\n        assert pbi.is_pre_built() is False\n        assert pbi.pre_built is False\n    assert calls == []\n\n\ndef test_is_pre_built_hook_receives_version(\n    testdata_context: context.WorkContext,\n) -> None:\n    \"\"\"The hook is called with the resolved version and variant.\"\"\"\n    pbi = testdata_context.settings.package_build_info(TEST_PKG)\n    calls: list[Version] = []\n    with patch.object(\n        overrides,\n        \"find_override_method\",\n        return_value=_make_is_pre_built_hook(None, calls),\n    ):\n        pbi.is_pre_built(Version(\"2.9.0\"))\n    assert calls == [Version(\"2.9.0\")]\n\n\n@pytest.mark.parametrize(\n    \"variant_yaml\",\n    [\n        pytest.param(\"    versions:\\n\", id=\"bare-key\"),\n        pytest.param(\"\", id=\"omitted-key\"),\n    ],\n)\ndef test_versions_none_or_omitted_is_empty_mapping(variant_yaml: str) -> None:\n    \"\"\"A bare or omitted ``versions`` key yields an empty mapping.\"\"\"\n    raw_yaml = f\"variants:\\n  cpu:\\n    pre_built: true\\n{variant_yaml}\"\n    ps = PackageSettings.from_string(TEST_PKG, raw_yaml)\n    assert ps.variants[\"cpu\"].versions == {}\n\n\ndef test_build_tag_version_specific_prebuilt("},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":638,"cache_read_input_tokens":138535,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":638},"output_tokens":16,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"11316fc5-3114-41d9-8938-693c3d7008eb","uuid":"c8903402-7f80-458d-b648-403a9e5489dc","timestamp":"2026-10-09T15:43:17.336Z","request_id":"req_011CfrvH1vVqBsdEefTPzhpQ","wire_tool_inputs":{"toolu_01AShwiBrpUZF9z3keVbUtYv":{"file_path":"/home/alustosa/git/model-routing-eval/.work/agent-eval/2026-10-09-claude-haiku-5-5-effort-low/cases/r05_fromager_versio