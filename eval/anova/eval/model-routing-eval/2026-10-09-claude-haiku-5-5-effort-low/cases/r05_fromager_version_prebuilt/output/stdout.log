{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017txcptEUowCscDaWWBthyV","type":"tool_result","content":"560\t        TEST_PREBUILT_PKG,\n561\t        TEST_COOLDOWN_PKG,\n562\t    }\n563\t\n564\t\n565\tdef test_global_changelog(testdata_context: context.WorkContext) -> None:\n566\t    pbi = testdata_context.settings.package_build_info(TEST_PKG)\n567\t    assert pbi.package == TEST_PKG\n568\t    assert not pbi.pre_built\n569\t    assert pbi.variant == \"cpu\"\n570\t    assert pbi.build_tag(Version(\"0.99\")) == ()\n571\t    assert pbi.build_tag(Version(\"1.0.1\")) == (1, \"\")\n572\t    assert pbi.build_tag(Version(\"1.0.2\")) == (2, \"\")\n573\t    assert pbi.build_tag(Version(\"1.0.2+local\")) == pbi.build_tag(Version(\"1.0.2\"))\n574\t    assert pbi.build_tag(Version(\"2.0.0\")) == ()\n575\t\n576\t    # CUDA variant has no global changelog\n577\t    testdata_context.settings.variant = Variant(\"cuda\")\n578\t    pbi = testdata_context.settings.package_build_info(TEST_PKG)\n579\t    assert pbi.package == TEST_PKG\n580\t    assert not pbi.pre_built\n581\t    assert pbi.variant == \"cuda\"\n582\t    assert pbi.build_tag(Version(\"0.99\")) == ()\n583\t    assert pbi.build_tag(Version(\"1.0.1\")) == (1, \"\")\n584\t    assert pbi.build_tag(Version(\"1.0.2\")) == (2, \"\")\n585\t    assert pbi.build_tag(Version(\"1.0.2+local\")) == pbi.build_tag(Version(\"1.0.2\"))\n586\t    assert pbi.build_tag(Version(\"2.0.0\")) == ()\n587\t\n588\t    # ROCm variant has pre-built flag\n589\t    testdata_context.settings.variant = Variant(\"rocm\")\n590\t    pbi = testdata_context.settings.package_build_info(TEST_PKG)\n591\t    assert pbi.package == TEST_PKG\n592\t    assert pbi.pre_built\n593\t    assert pbi.variant == \"rocm\"\n594\t    assert pbi.build_tag(Version(\"0.99\")) == ()\n595\t\n596\t    testdata_context.settings.variant = Variant(\"cpu\")\n597\t    pbi = testdata_context.settings.package_build_info(TEST_PREBUILT_PKG)\n598\t    assert pbi.package == TEST_PREBUILT_PKG\n599\t    assert pbi.pre_built\n600\t    assert pbi.variant == \"cpu\"\n601\t    assert pbi.get_changelog(Version(\"1.0.1\")) == [\"onboard\"]\n602\t    assert pbi.build_tag(Version(\"1.0.1\")) == ()\n603\t\n604\t\n605\tdef test_is_pre_built_version_specific(\n606\t    testdata_context: context.WorkContext,\n607\t) -> None:\n608\t    \"\"\"Version-specific pre_built overrides variant default.\"\"\"\n609\t    # cpu variant: pre_built=False by default, but 2.9.0 is pre_built=True\n610\t    pbi = testdata_context.settings.package_build_info(TEST_PKG)\n611\t    assert pbi.variant == \"cpu\"\n612\t    assert pbi.pre_built is False\n613\t    assert pbi.is_pre_built() is False\n614\t    assert pbi.is_pre_built(Version(\"2.9.0\")) is True\n615\t    assert pbi.is_pre_built(Version(\"2.8.0\")) is False\n616\t    assert pbi.is_pre_built(Version(\"3.0.0\")) is False\n617\t\n618\t    # rocm variant: pre_built=True by default, but 1.0.0 is pre_built=False\n619\t    testdata_context.settings.variant = Variant(\"rocm\")\n620\t    pbi = testdata_context.settings.package_build_info(TEST_PKG)\n621\t    assert pbi.pre_built is True\n622\t    assert pbi.is_pre_built() is True\n623\t    assert pbi.is_pre_built(Version(\"1.0.0\")) is False\n624\t    assert pbi.is_pre_built(Version(\"2.0.0\")) is True\n625\t\n626\t    # cuda variant: no version-specific settings\n627\t    testdata_context.settings.variant = Variant(\"cuda\")\n628\t    pbi = testdata_context.settings.package_build_info(TEST_PKG)\n629\t    assert pbi.is_pre_built() is False\n630\t    assert pbi.is_pre_built(Version(\"2.9.0\")) is False\n631\t\n632\t\n633\tdef test_get_wheel_server_url_version_specific(\n634\t    testdata_context: context.WorkContext,\n635\t) -> None:\n636\t    \"\"\"Version-specific wheel_server_url overrides variant default.\"\"\"\n637\t    # cpu variant: default wheel_server_url, 2.9.0 has override\n638\t    pbi = testdata_context.settings.package_build_info(TEST_PKG)\n639\t    assert pbi.wheel_server_url == \"https://wheel.test/simple\"\n640\t    assert pbi.get_wheel_server_url() == \"https://wheel.test/simple\"\n641\t    assert pbi.get_wheel_server_url(Version(\"2.9.0\")) == \"https://mirror.test/simple\"\n642\t    assert pbi.get_wheel_server_url(Version(\"2.8.0\")) == \"https://wheel.test/simple\"\n643\t    assert pbi.get_wheel_server_url(Version(\"3.0.0\")) == \"https://wheel.test/simple\"\n644\t\n645\t\n646\tdef test_build_tag_version_specific_prebuilt(\n647\t    testdata_context: context.WorkContext,\n648\t) -> None:\n649\t    \"\"\"Pre-built versions return empty build tag even when variant default is source.\"\"\"\n650\t    pbi = testdata_context.settings.package_build_info(TEST_PKG)\n651\t    assert pbi.variant == \"cpu\"\n652\t    # 2.9.0 is version-specific pre_built=True, so no build tag\n653\t    assert pbi.build_tag(Version(\"2.9.0\")) == ()\n654\t\n655\t\n656\tdef test_settings_list(testdata_context: context.WorkContext) -> None:\n657\t    assert testdata_context.settings.list_overrides() == {\n658\t        TEST_COOLDOWN_PKG,\n659\t        TEST_PKG,\n660\t        TEST_EMPTY_PKG,\n661\t        TEST_OTHER_PKG,\n662\t        TEST_RELATED_PKG,\n663\t        TEST_PREBUILT_PKG,\n664\t    }\n665\t    assert testdata_context.settings.list_pre_built() == {TEST_PREBUILT_PKG}\n666\t    assert testdata_context.settings.variant_changelog() == []\n667\t    testdata_context.settings.variant = Variant(\"rocm\")\n668\t    assert testdata_context.settings.list_pre_built() == {TEST_PKG}\n669\t    assert testdata_context.settings.variant_changelog() == ["}]},"parent_tool_use_id":null,"session_id":"11316fc5-3114-41d9-8938-693c3d7008eb","uuid":"39a77d13-1a35-4467-bb07-27e3fa2b8aad","timestamp":"2026-10-09T15:41:39.835Z","tool_use_result":{"type":"text","file":{"filePath":"/home/alustosa/git/model-routing-eval/.work/agent-eval/2026-10-09-claude-haiku-5-5-effort-low/cases/r05_fromager_version_prebuilt/tests/test_packagesettings.py","content":"        TEST_PREBUILT_PKG,\n        TEST_COOLDOWN_PKG,\n    }\n\n\ndef test_global_changelog(testdata_context: context.WorkContext) -> None:\n    pbi = testdata_context.settings.package_build_info(TEST_PKG)\n    assert pbi.package == TEST_PKG\n    assert not pbi.pre_built\n    assert pbi.variant == \"cpu\"\n    assert pbi.build_tag(Version(\"0.99\")) == ()\n    assert pbi.build_tag(Version(\"1.0.1\")) == (1, \"\")\n    assert pbi.build_tag(Version(\"1.0.2\")) == (2, \"\")\n    assert pbi.build_tag(Version(\"1.0.2+local\")) == pbi.build_tag(Version(\"1.0.2\"))\n    assert pbi.build_tag(Version(\"2.0.0\")) == ()\n\n    # CUDA variant has no global changelog\n    testdata_context.settings.variant = Variant(\"cuda\")\n    pbi = testdata_context.settings.package_build_info(TEST_PKG)\n    assert pbi.package == TEST_PKG\n    assert not pbi.pre_built\n    assert pbi.variant == \"cuda\"\n    assert pbi.build_tag(Version(\"0.99\")) == ()\n    assert pbi.build_tag(Version(\"1.0.1\")) == (1, \"\")\n    assert pbi.build_tag(Version(\"1.0.2\")) == (2, \"\")\n    assert pbi.build_tag(Version(\"1.0.2+local\")) == pbi.build_tag(Version(\"1.0.2\"))\n    assert pbi.build_tag(Version(\"2.0.0\")) == ()\n\n    # ROCm variant has pre-built flag\n    testdata_context.settings.variant = Variant(\"rocm\")\n    pbi = testdata_context.settings.package_build_info(TEST_PKG)\n    assert pbi.package == TEST_PKG\n    assert pbi.pre_built\n    assert pbi.variant == \"rocm\"\n    assert pbi.build_tag(Version(\"0.99\")) == ()\n\n    testdata_context.settings.variant = Variant(\"cpu\")\n    pbi = testdata_context.settings.package_build_info(TEST_PREBUILT_PKG)\n    assert pbi.package == TEST_PREBUILT_PKG\n    assert pbi.pre_built\n    assert pbi.variant == \"cpu\"\n    assert pbi.get_changelog(Version(\"1.0.1\")) == [\"onboard\"]\n    assert pbi.build_tag(Version(\"1.0.1\")) == ()\n\n\ndef test_is_pre_built_version_specific(\n    testdata_context: context.WorkContext,\n) -> None:\n    \"\"\"Version-specific pre_built overrides variant default.\"\"\"\n    # cpu variant: pre_built=False by default, but 2.9.0 is pre_built=True\n    pbi = testdata_context.settings.package_build_info(TEST_PKG)\n    assert pbi.variant == \"cpu\"\n    assert pbi.pre_built is False\n    assert pbi.is_pre_built() is False\n    assert pbi.is_pre_built(Version(\"2.9.0\")) is True\n    assert pbi.is_pre_built(Version(\"2.8.0\")) is False\n    assert pbi.is_pre_built(Version(\"3.0.0\")) is False\n\n    # rocm variant: pre_built=True by default, but 1.0.0 is pre_built=False\n    testdata_context.settings.variant = Variant(\"rocm\")\n    pbi = testdata_context.settings.package_build_info(TEST_PKG)\n    assert pbi.pre_built is True\n    assert pbi.is_pre_built() is True\n    assert pbi.is_pre_built(Version(\"1.0.0\")) is False\n    assert pbi.is_pre_built(Version(\"2.0.0\")) is True\n\n    # cuda variant: no version-specific settings\n    testdata_context.settings.variant = Variant(\"cuda\")\n    pbi = testdata_context.settings.package_build_info(TEST_PKG)\n    assert pbi.is_pre_built() is False\n    assert pbi.is_pre_built(Version(\"2.9.0\")) is False\n\n\ndef test_get_wheel_server_url_version_specific(\n    testdata_context: context.WorkContext,\n) -> None:\n    \"\"\"Version-specific wheel_server_url overrides variant default.\"\"\"\n    # cpu variant: default wheel_server_url, 2.9.0 has override\n    pbi = testdata_context.settings.package_build_info(TEST_PKG)\n    assert pbi.wheel_server_url == \"https://wheel.test/simple\"\n    assert pbi.get_wheel_server_url() == \"https://wheel.test/simple\"\n    assert pbi.get_wheel_server_url(Version(\"2.9.0\")) == \"https://mirror.test/simple\"\n    assert pbi.get_wheel_server_url(Version(\"2.8.0\")) == \"https://wheel.test/simple\"\n    assert pbi.get_wheel_server_url(Version(\"3.0.0\")) == \"https://wheel.test/simple\"\n\n\ndef test_build_tag_version_specific_prebuilt(\n    testdata_context: context.WorkContext,\n) -> None:\n    \"\"\"Pre-built versions return empty build tag even when variant default is source.\"\"\"\n    pbi = testdata_context.settings.package_build_info(TEST_PKG)\n    assert pbi.variant == \"cpu\"\n    # 2.9.0 is version-specific pre_built=True, so no build tag\n    assert pbi.build_tag(Version(\"2.9.0\")) == ()\n\n\ndef test_settings_list(testdata_context: context.WorkContext) -> None:\n    assert testdata_context.settings.list_overrides() == {\n        TEST_COOLDOWN_PKG,\n        TEST_PKG,\n        TEST_EMPTY_PKG,\n        TEST_OTHER_PKG,\n        TEST_RELATED_PKG,\n        TEST_PREBUILT_PKG,\n    }\n    assert testdata_context.settings.list_pre_built() == {TEST_PREBUILT_PKG}\n    assert testdata_context.settings.variant_changelog() == []\n    testdata_context.settings.variant = Variant(\"rocm\")\n    assert testdata_context.settings.list_pre_built() == {TEST_PKG}\n    assert testdata_context.settings.variant_changelog() == [","numLines":110,"startLine":560,"totalLines":1224}},"tool_result_meta":[{"id":"toolu_017txcptEUowCscDaWWBthyV","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
