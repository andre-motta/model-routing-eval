{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013ir5cZG9DubFwLFrqFRUd6","type":"tool_result","content":"1\t\"\"\"Tests for the iterative bootstrap implementation.\n2\t\n3\tTests cover:\n4\t- Phase class hierarchy: class variables and base class behavior\n5\t- WorkItem dataclass defaults and state accumulation\n6\t- _track_why context manager behavior\n7\t- create_unresolved_work_items helper\n8\t- Resolve.run() version expansion\n9\t- Start.run() graph addition and seen-check\n10\t- PrepareSource.run() all branches (prebuilt, source, cached, bad path)\n11\t- PrepareBuild.run() dep installation and extraction\n12\t- Build.run() conditional install and result construction\n13\t- ProcessInstallDeps.run() hooks, dep extraction, error modes\n14\t- Complete.run() cleanup\n15\t- _handle_phase_error for all three error modes\n16\t- End-to-end iterative loop with LIFO ordering\n17\t\"\"\"\n18\t\n19\tfrom __future__ import annotations\n20\t\n21\timport concurrent.futures\n22\timport logging\n23\timport pathlib\n24\timport typing\n25\tfrom unittest.mock import Mock, call, patch\n26\t\n27\timport pytest\n28\tfrom packaging.requirements import Requirement\n29\tfrom packaging.utils import canonicalize_name\n30\tfrom packaging.version import Version\n31\tfrom resolvelib.resolvers import ResolverException\n32\t\n33\tfrom fromager import bootstrapper, build_environment\n34\tfrom fromager.bootstrapper._build import Build\n35\tfrom fromager.bootstrapper._complete import Complete\n36\tfrom fromager.bootstrapper._phase import Phase\n37\tfrom fromager.bootstrapper._prepare_build import PrepareBuild\n38\tfrom fromager.bootstrapper._prepare_source import PrepareSource\n39\tfrom fromager.bootstrapper._process_install_deps import ProcessInstallDeps\n40\tfrom fromager.bootstrapper._resolve import Resolve\n41\tfrom fromager.bootstrapper._start import Start\n42\tfrom fromager.bootstrapper._types import (\n43\t    BootstrapPhase,\n44\t    PreparedSourceData,\n45\t    SourceBuildResult,\n46\t)\n47\tfrom fromager.bootstrapper._work_item import WorkItem\n48\tfrom fromager.context import WorkContext\n49\tfrom fromager.requirements_file import RequirementType, SourceType\n50\t\n51\t\n52\tdef _make_resolved_future(\n53\t    result: typing.Any,\n54\t) -> concurrent.futures.Future[typing.Any]:\n55\t    \"\"\"Return an already-completed Future carrying *result*.\"\"\"\n56\t    future: concurrent.futures.Future[typing.Any] = concurrent.futures.Future()\n57\t    future.set_result(result)\n58\t    return future\n59\t\n60\t\n61\tdef _make_work_item(\n62\t    req: str = \"testpkg\",\n63\t    req_type: RequirementType = RequirementType.INSTALL,\n64\t    why_snapshot: list | None = None,\n65\t    parent: tuple | None = None,\n66\t    source_url: str | None = None,\n67\t    version: str | None = None,\n68\t    build_env: build_environment.BuildEnvironment | None = None,\n69\t    sdist_root_dir: pathlib.Path | None = None,\n70\t    unpack_dir: pathlib.Path | None = None,\n71\t    build_result: SourceBuildResult | None = None,\n72\t    build_system_deps: set[Requirement] | None = None,\n73\t    build_backend_deps: set[Requirement] | None = None,\n74\t    build_sdist_deps: set[Requirement] | None = None,\n75\t    pbi_pre_built: bool = False,\n76\t    cached_wheel_filename: pathlib.Path | None = None,\n77\t    build_sdist_only: bool = False,\n78\t) -> WorkItem:\n79\t    return WorkItem(\n80\t        req=Requirement(req),\n81\t        req_type=req_type,\n82\t        why_snapshot=why_snapshot or [],\n83\t        parent=parent,\n84\t        source_url=source_url,\n85\t        resolved_version=Version(version) if version else None,\n86\t        build_env=build_env,\n87\t        sdist_root_dir=sdist_root_dir,\n88\t        unpack_dir=unpack_dir,\n89\t        build_result=build_result,\n90\t        build_system_deps=build_system_deps if build_system_deps is not None else set(),\n91\t        build_backend_deps=build_backend_deps\n92\t        if build_backend_deps is not None\n93\t        else set(),\n94\t        build_sdist_deps=build_sdist_deps if build_sdist_deps is not None else set(),\n95\t        pbi_pre_built=pbi_pre_built,\n96\t        cached_wheel_filename=cached_wheel_filename,\n97\t        build_sdist_only=build_sdist_only,\n98\t    )\n99\t\n100\t\n101\tdef _make_resolve_item(\n102\t    req: str = \"testpkg\",\n103\t    req_type: RequirementType = RequirementType.INSTALL,\n104\t    why_snapshot: list | None = None,\n105\t    parent: tuple | None = None,\n106\t) -> Resolve:\n107\t    return Resolve(\n108\t        WorkItem(\n109\t            req=Requirement(req),\n110\t            req_type=req_type,\n111\t            why_snapshot=why_snapshot or [],\n112\t            parent=parent,\n113\t        )\n114\t    )\n115\t\n116\t\n117\tdef _make_start_item(\n118\t    req: str = \"testpkg\",\n119\t    req_type: RequirementType = RequirementType.INSTALL,\n120\t    source_url: str = \"https://pypi.org/testpkg-1.0.tar.gz\",\n121\t    version: str = \"1.0\",\n122\t    why_snapshot: list | None = None,\n123\t    parent: tuple | None = None,\n124\t) -> Start:\n125\t    return Start(\n126\t        WorkItem(\n127\t            req=Requirement(req),\n128\t            req_type=req_type,\n129\t            why_snapshot=why_snapshot or [],\n130\t            parent=parent,\n131\t            source_url=source_url,\n132\t            resolved_version=Version(version),\n133\t        )\n134\t    )\n135\t\n136\t\n137\t_PHASE_TO_CLASS: dict[BootstrapPhase, type[Phase]] = {\n138\t    BootstrapPhase.RESOLVE: Resolve,\n139\t    BootstrapPhase.START: Start,\n140\t    BootstrapPhase.PREPARE_SOURCE: PrepareSource,\n141\t    BootstrapPhase.PREPARE_BUILD: PrepareBuild,\n142\t    BootstrapPhase.BUILD: Build,\n143\t    BootstrapPhase.PROCESS_INSTALL_DEPS: ProcessInstallDeps,\n144\t    BootstrapPhase.COMPLETE: Complete,\n145\t}\n146\t\n147\t\n148\tdef _make_build_item(\n149\t    req: str = \"testpkg\",\n150\t    version: str = \"1.0\",\n151\t    phase: BootstrapPhase = BootstrapPhase.PREPARE_SOURCE,\n152\t    source_url: str = \"https://pypi.org/testpkg-1.0.tar.gz\",\n153\t    build_env: build_environment.BuildEnvironment | None = None,\n154\t    sdist_root_dir: pathlib.Path | None = None,\n155\t    unpack_dir: pathlib.Path | None = None,\n156\t    build_result: SourceBuildResult | None = None,\n157\t    build_system_deps: set[Requirement] | None = None,\n158\t    build_backend_deps: set[Requirement] | None = None,\n159\t    build_sdist_deps: set[Requirement] | None = None,\n160\t    pbi_pre_built: bool = False,\n161\t    cached_wheel_filename: pathlib.Path | None = None,\n162\t    build_sdist_only: bool = False,\n163\t) -> Phase:\n164\t    wi = WorkItem(\n165\t        req=Requirement(req),\n166\t        req_type=RequirementType.INSTALL,\n167\t        why_snapshot=[],\n168\t        source_url=source_url,\n169\t        resolved_version=Version(version),\n170\t        build_env=build_env,\n171\t        sdist_root_dir=sdist_root_dir,\n172\t        unpack_dir=unpack_dir,\n173\t        build_result=build_result,\n174\t        build_system_deps=build_system_deps if build_system_deps is not None else set(),\n175\t        build_backend_deps=build_backend_deps\n176\t        if build_backend_deps is not None\n177\t        else set(),\n178\t        build_sdist_deps=build_sdist_deps if build_sdist_deps is not None else set(),\n179\t        pbi_pre_built=pbi_pre_built,\n180\t        cached_wheel_filename=cached_wheel_filename,\n181\t        build_sdist_only=build_sdist_only,\n182\t    )\n183\t    return _PHASE_TO_CLASS[phase](wi)\n184\t\n185\t\n186\tclass TestPhaseClassVariables:\n187\t    \"\"\"Verify class-variable declarations on each Phase subclass.\"\"\"\n188\t\n189\t    @pytest.mark.parametrize(\n190\t        \"cls, expected_phase, expected_tracks_why\","}]},"parent_tool_use_id":null,"session_id":"11316fc5-3114-41d9-8938-693c3d7008eb","uuid":"24ef2763-3179-4168-9409-ee4732ffdae5","timestamp":"2026-10-09T15:41:40.498Z","tool_use_result":{"type":"text","file":{"filePath":"/home/alustosa/git/model-routing-eval/.work/agent-eval/2026-10-09-claude-haiku-5-5-effort-low/cases/r05_fromager_version_prebuilt/tests/test_bootstrapper_iterative.py","content":"\"\"\"Tests for the iterative bootstrap implementation.\n\nTests cover:\n- Phase class hierarchy: class variables and base class behavior\n- WorkItem dataclass defaults and state accumulation\n- _track_why context manager behavior\n- create_unresolved_work_items helper\n- Resolve.run() version expansion\n- Start.run() graph addition and seen-check\n- PrepareSource.run() all branches (prebuilt, source, cached, bad path)\n- PrepareBuild.run() dep installation and extraction\n- Build.run() conditional install and result construction\n- ProcessInstallDeps.run() hooks, dep extraction, error modes\n- Complete.run() cleanup\n- _handle_phase_error for all three error modes\n- End-to-end iterative loop with LIFO ordering\n\"\"\"\n\nfrom __future__ import annotations\n\nimport concurrent.futures\nimport logging\nimport pathlib\nimport typing\nfrom unittest.mock import Mock, call, patch\n\nimport pytest\nfrom packaging.requirements import Requirement\nfrom packaging.utils import canonicalize_name\nfrom packaging.version import Version\nfrom resolvelib.resolvers import ResolverException\n\nfrom fromager import bootstrapper, build_environment\nfrom fromager.bootstrapper._build import Build\nfrom fromager.bootstrapper._complete import Complete\nfrom fromager.bootstrapper._phase import Phase\nfrom fromager.bootstrapper._prepare_build import PrepareBuild\nfrom fromager.bootstrapper._prepare_source import PrepareSource\nfrom fromager.bootstrapper._process_install_deps import ProcessInstallDeps\nfrom fromager.bootstrapper._resolve import Resolve\nfrom fromager.bootstrapper._start import Start\nfrom fromager.bootstrapper._types import (\n    BootstrapPhase,\n    PreparedSourceData,\n    SourceBuildResult,\n)\nfrom fromager.bootstrapper._work_item import WorkItem\nfrom fromager.context import WorkContext\nfrom fromager.requirements_file import RequirementType, SourceType\n\n\ndef _make_resolved_future(\n    result: typing.Any,\n) -> concurrent.futures.Future[typing.Any]:\n    \"\"\"Return an already-completed Future carrying *result*.\"\"\"\n    future: concurrent.futures.Future[typing.Any] = concurrent.futures.Future()\n    future.set_result(result)\n    return future\n\n\ndef _make_work_item(\n    req: str = \"testpkg\",\n    req_type: RequirementType = RequirementType.INSTALL,\n    why_snapshot: list | None = None,\n    parent: tuple | None = None,\n    source_url: str | None = None,\n    version: str | None = None,\n    build_env: build_environment.BuildEnvironment | None = None,\n    sdist_root_dir: pathlib.Path | None = None,\n    unpack_dir: pathlib.Path | None = None,\n    build_result: SourceBuildResult | None = None,\n    build_system_deps: set[Requirement] | None = None,\n    build_backend_deps: set[Requirement] | None = None,\n    build_sdist_deps: set[Requirement] | None = None,\n    pbi_pre_built: bool = False,\n    cached_wheel_filename: pathlib.Path | None = None,\n    build_sdist_only: bool = False,\n) -> WorkItem:\n    return WorkItem(\n        req=Requirement(req),\n        req_type=req_type,\n        why_snapshot=why_snapshot or [],\n        parent=parent,\n        source_url=source_url,\n        resolved_version=Version(version) if version else None,\n        build_env=build_env,\n        sdist_root_dir=sdist_root_dir,\n        unpack_dir=unpack_dir,\n        build_result=build_result,\n        build_system_deps=build_system_deps if build_system_deps is not None else set(),\n        build_backend_deps=build_backend_deps\n        if build_backend_deps is not None\n        else set(),\n        build_sdist_deps=build_sdist_deps if build_sdist_deps is not None else set(),\n        pbi_pre_built=pbi_pre_built,\n        cached_wheel_filename=cached_wheel_filename,\n        build_sdist_only=build_sdist_only,\n    )\n\n\ndef _make_resolve_item(\n    req: str = \"testpkg\",\n    req_type: RequirementType = RequirementType.INSTALL,\n    why_snapshot: list | None = None,\n    parent: tuple | None = None,\n) -> Resolve:\n    return Resolve(\n        WorkItem(\n            req=Requirement(req),\n            req_type=req_type,\n            why_snapshot=why_snapshot or [],\n            parent=parent,\n        )\n    )\n\n\ndef _make_start_item(\n    req: str = \"testpkg\",\n    req_type: RequirementType = RequirementType.INSTALL,\n    source_url: str = \"https://pypi.org/testpkg-1.0.tar.gz\",\n    version: str = \"1.0\",\n    why_snapshot: list | None = None,\n    parent: tuple | None = None,\n) -> Start:\n    return Start(\n        WorkItem(\n            req=Requirement(req),\n            req_type=req_type,\n            why_snapshot=why_snapshot or [],\n            parent=parent,\n            source_url=source_url,\n            resolved_version=Version(version),\n        )\n    )\n\n\n_PHASE_TO_CLASS: dict[BootstrapPhase, type[Phase]] = {\n    BootstrapPhase.RESOLVE: Resolve,\n    BootstrapPhase.START: Start,\n    BootstrapPhase.PREPARE_SOURCE: PrepareSource,\n    BootstrapPhase.PREPARE_BUILD: PrepareBuild,\n    BootstrapPhase.BUILD: Build,\n    BootstrapPhase.PROCESS_INSTALL_DEPS: ProcessInstallDeps,\n    BootstrapPhase.COMPLETE: Complete,\n}\n\n\ndef _make_build_item(\n    req: str = \"testpkg\",\n    version: str = \"1.0\",\n    phase: BootstrapPhase = BootstrapPhase.PREPARE_SOURCE,\n    source_url: str = \"https://pypi.org/testpkg-1.0.tar.gz\",\n    build_env: build_environment.BuildEnvironment | None = None,\n    sdist_root_dir: pathlib.Path | None = None,\n    unpack_dir: pathlib.Path | None = None,\n    build_result: SourceBuildResult | None = None,\n    build_system_deps: set[Requirement] | None = None,\n    build_backend_deps: set[Requirement] | None = None,\n    build_sdist_deps: set[Requirement] | None = None,\n    pbi_pre_built: bool = False,\n    cached_wheel_filename: pathlib.Path | None = None,\n    build_sdist_only: bool = False,\n) -> Phase:\n    wi = WorkItem(\n        req=Requirement(req),\n        req_type=RequirementType.INSTALL,\n        why_snapshot=[],\n        source_url=source_url,\n        resolved_version=Version(version),\n        build_env=build_env,\n        sdist_root_dir=sdist_root_dir,\n        unpack_dir=unpack_dir,\n        build_result=build_result,\n        build_system_deps=build_system_deps if build_system_deps is not None else set(),\n        build_backend_deps=build_backend_deps\n        if build_backend_deps is not None\n        else set(),\n        build_sdist_deps=build_sdist_deps if build_sdist_deps is not None else set(),\n        pbi_pre_built=pbi_pre_built,\n        cached_wheel_filename=cached_wheel_filename,\n        build_sdist_only=build_sdist_only,\n    )\n    return _PHASE_TO_CLASS[phase](wi)\n\n\nclass TestPhaseClassVariables:\n    \"\"\"Verify class-variable declarations on each Phase subclass.\"\"\"\n\n    @pytest.mark.parametrize(\n        \"cls, expected_phase, expected_tracks_why\",","numLines":190,"startLine":1,"totalLines":2684}},"tool_result_meta":[{"id":"toolu_013ir5cZG9DubFwLFrqFRUd6","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
