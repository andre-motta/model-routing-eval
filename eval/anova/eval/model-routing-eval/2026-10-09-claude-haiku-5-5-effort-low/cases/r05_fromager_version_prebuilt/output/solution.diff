+def _make_is_pre_built_hook(
+    result: bool | None,
+    calls: list[Version] | None = None,
+) -> typing.Callable[..., bool | None]:
+    """Build an ``is_pre_built`` override hook returning *result*."""
+
+    def is_pre_built(*, version: Version, variant: str) -> bool | None:
+        if calls is not None:
+            calls.append(version)
+        return result
+
+    return is_pre_built
+
+
+def test_is_pre_built_hook_overrides_yaml(
+    testdata_context: context.WorkContext,
+) -> None:
+    """A non-None hook result wins over the version-specific YAML setting."""
+    pbi = testdata_context.settings.package_build_info(TEST_PKG)
+    # YAML: 2.8.0 is False and 2.9.0 is True
+    with patch.object(
+        overrides, "find_override_method", return_value=_make_is_pre_built_hook(True)
+    ):
+        assert pbi.is_pre_built(Version("2.8.0")) is True
+    with patch.object(
+        overrides, "find_override_method", return_value=_make_is_pre_built_hook(False)
+    ):
+        assert pbi.is_pre_built(Version("2.9.0")) is False
+
+
+def test_is_pre_built_hook_none_defers_to_yaml(
+    testdata_context: context.WorkContext,
+) -> None:
+    """A None hook result falls back to the YAML settings."""
+    pbi = testdata_context.settings.package_build_info(TEST_PKG)
+    with patch.object(
+        overrides, "find_override_method", return_value=_make_is_pre_built_hook(None)
+    ):
+        assert pbi.is_pre_built(Version("2.9.0")) is True
+        assert pbi.is_pre_built(Version("2.8.0")) is False
+
+
+def test_is_pre_built_hook_not_called_without_version(
+    testdata_context: context.WorkContext,
+) -> None:
+    """Without a version the hook is skipped and the variant default is used."""
+    pbi = testdata_context.settings.package_build_info(TEST_PKG)
+    calls: list[Version] = []
+    with patch.object(
+        overrides,
+        "find_override_method",
+        return_value=_make_is_pre_built_hook(True, calls),
+    ):
+        assert pbi.is_pre_built() is False
+        assert pbi.pre_built is False
+    assert calls == []
+
+
+def test_is_pre_built_hook_receives_version(
+    testdata_context: context.WorkContext,
+) -> None:
+    """The hook is called with the resolved version and variant."""
+    pbi = testdata_context.settings.package_build_info(TEST_PKG)
+    calls: list[Version] = []
+    with patch.object(
+        overrides,
+        "find_override_method",
+        return_value=_make_is_pre_built_hook(None, calls),
+    ):
+        pbi.is_pre_built(Version("2.9.0"))
+    assert calls == [Version("2.9.0")]
+
