            return None\n        return entry\n\n    def get(self, key, default=None):\n        entry = self._lookup_live(key)\n        if entry is None:\n            self._misses += 1\n            return default\n        self._data.move_to_end(key)\n        self._hits += 1\n        return entry[0]\n\n    def put(self, key, value):\n        expires_at = None if self.ttl is None else self._clock() + self.ttl\n        self._data[key] = (value, expires_at)\n        self._data.move_to_end(key)\n        if len(self._data) > self.capacity:\n            self._data.popitem(last=False)\n            self._evictions += 1\n\n    def delete(self, key):\n        return self._lookup_live(key) is not None and self._data.pop(key) is not None\n\n    def stats(self):\n        return {\n            \"hits\": self._hits,\n            \"misses\": self._misses,\n            \"evictions\": self._evictions,\n            \"expirations\": self._expirations,\n        }\n\n    def __len__(self):\n        return len(self._data)\n\n    def __contains__(self, key):\n        return self._lookup_live(key) is not None\n","structuredPatch":[{"oldStart":49,"oldLines":7,"newStart":49,"newLines":10,"lines":["             self._evictions += 1"," ","     def delete(self, key):","-        return self._lookup_live(key) is not None and self._data.pop(key) is not None","+        if self._lookup_live(key) is None:","+            return False","+        del self._data[key]","+        return True"," ","     def stats(self):","         return {"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_01BybnhTXDuT7NUCPryev5TS","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
