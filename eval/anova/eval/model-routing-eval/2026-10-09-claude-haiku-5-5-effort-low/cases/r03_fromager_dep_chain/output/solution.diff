+    def _dependency_chain_suffix(self, wi: WorkItem) -> str:
+        """Render the dependency chain leading to *wi* for error messages."""
+        chain = " -> ".join(
+            f"{req.name}=={version}" for _, req, version in wi.why_snapshot
+        )
+        return f" (dependency chain: {chain} -> {wi.req})"
+
+    def _enrich_resolution_error(self, item: Phase, err: Exception) -> Exception:
+        """Append the dependency chain to a resolution error.
+
+        Only RESOLVE items with a non-empty ``why_snapshot`` are changed.
+        Returns *err* itself for every other case.
+        """
+        wi = item.work_item
+        if not isinstance(item, Resolve) or not wi.why_snapshot:
+            return err
+        suffix = self._dependency_chain_suffix(wi)
+        if isinstance(err, ResolverException):
+            return ResolverException(f"{err}{suffix}")
+        if isinstance(err, RuntimeError):
+            return RuntimeError(f"{err}{suffix}")
+        return RuntimeError(f"{type(err).__name__}: {err}{suffix}")
+
     def _handle_phase_error(
         self,
         item: Phase,
