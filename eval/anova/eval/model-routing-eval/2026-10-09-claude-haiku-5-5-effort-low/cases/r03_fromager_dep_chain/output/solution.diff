+class TestDependencyChainErrors:
+    """Resolution errors name the dependency chain that led to them."""
+
+    _CHAIN = [
+        (RequirementType.INSTALL, Requirement("its-hub"), Version("2.0")),
+        (RequirementType.INSTALL, Requirement("reward-hub"), Version("1.0")),
+    ]
+    _SUFFIX = " (dependency chain: its-hub==2.0 -> reward-hub==1.0 -> vllm)"
+
+    def test_dependency_chain_suffix_renders_chain(
+        self, tmp_context: WorkContext
+    ) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context)
+        wi = _make_work_item(req="vllm", why_snapshot=self._CHAIN)
+
+        suffix = bt._dependency_chain_suffix(wi)
+
+        assert suffix == self._SUFFIX
+
+    def test_enrich_returns_same_error_without_chain(
+        self, tmp_context: WorkContext
+    ) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context)
+        item = _make_resolve_item(req="vllm")
+        err = RuntimeError("resolution failed")
+
+        result = bt._enrich_resolution_error(item, err)
+
+        assert result is err
+
+    def test_enrich_returns_same_error_for_non_resolve_phase(
+        self, tmp_context: WorkContext
+    ) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context)
+        item = _make_build_item(phase=BootstrapPhase.BUILD)
+        item.work_item.why_snapshot = list(self._CHAIN)
+        err = RuntimeError("build failed")
+
+        result = bt._enrich_resolution_error(item, err)
+
+        assert result is err
+
+    def test_enrich_keeps_resolver_exception_type(
+        self, tmp_context: WorkContext
+    ) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context)
+        item = _make_resolve_item(req="vllm", why_snapshot=list(self._CHAIN))
+        err = ResolverException("no candidates")
+
+        result = bt._enrich_resolution_error(item, err)
+
+        assert type(result) is ResolverException
+        assert str(result) == f"no candidates{self._SUFFIX}"
+
+    def test_enrich_keeps_runtime_error_type(self, tmp_context: WorkContext) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context)
+        item = _make_resolve_item(req="vllm", why_snapshot=list(self._CHAIN))
+        err = RuntimeError("no versions")
+
+        result = bt._enrich_resolution_error(item, err)
+
+        assert type(result) is RuntimeError
+        assert str(result) == f"no versions{self._SUFFIX}"
+
+    def test_enrich_wraps_other_exception_types(
+        self, tmp_context: WorkContext
+    ) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context)
+        item = _make_resolve_item(req="vllm", why_snapshot=list(self._CHAIN))
+        err = ValueError("bad specifier")
+
+        result = bt._enrich_resolution_error(item, err)
+
+        assert type(result) is RuntimeError
+        assert str(result) == f"ValueError: bad specifier{self._SUFFIX}"
+
+    def test_normal_mode_raises_enriched_error_with_context(
+        self, tmp_context: WorkContext
+    ) -> None:
+        """Enriched error has no __cause__, so the formatter prints it once."""
+        bt = bootstrapper.Bootstrapper(tmp_context)
+        item = _make_resolve_item(req="vllm", why_snapshot=list(self._CHAIN))
+        err = ResolverException("no candidates")
+
+        with pytest.raises(ResolverException) as excinfo:
+            try:
+                raise err
+            except ResolverException:
+                bt._handle_phase_error(item, err)
+
+        assert str(excinfo.value) == f"no candidates{self._SUFFIX}"
+        assert excinfo.value.__context__ is err
+        assert excinfo.value.__cause__ is None
+
+    def test_multiple_versions_records_enriched_error(
+        self, tmp_context: WorkContext
+    ) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context, multiple_versions=True)
+        item = _make_resolve_item(req="vllm", why_snapshot=list(self._CHAIN))
+        err = ResolverException("no candidates")
+
+        try:
+            raise err
+        except ResolverException:
+            result = bt._handle_phase_error(item, err)
+
+        assert result == []
+        recorded = bt._failed_versions[(canonicalize_name("vllm"), "unresolved")]
+        assert recorded is not err
+        assert str(recorded) == f"no candidates{self._SUFFIX}"
+
+    def test_test_mode_records_enriched_error(self, tmp_context: WorkContext) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context, test_mode=True)
+        item = _make_resolve_item(req="vllm", why_snapshot=list(self._CHAIN))
+        err = ResolverException("no candidates")
+
+        try:
+            raise err
+        except ResolverException:
+            result = bt._handle_phase_error(item, err)
+
+        assert result == []
+        assert len(bt.failed_packages) == 1
+        assert self._SUFFIX in str(bt.failed_packages[0])
