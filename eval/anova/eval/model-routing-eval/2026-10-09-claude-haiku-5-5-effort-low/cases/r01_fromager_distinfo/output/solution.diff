+def _wheel_metadata_path(url: str) -> str:
+    """Return the zip member path of the METADATA file for a wheel URL.
+
+    The wheel filename is the last path segment of the URL. The query
+    string and fragment are ignored. A wheel can contain other
+    ``.dist-info`` directories, such as vendored packages, so the path
+    is built from the wheel's own name and version.
+
+    Args:
+        url: URL of the wheel file
+
+    Returns:
+        Path such as ``MarkupSafe-3.0.2.dist-info/METADATA``
+
+    Raises:
+        packaging.utils.InvalidWheelFilename: If the URL path is not a wheel filename.
+    """
+    path = urllib.parse.urlsplit(url).path
+    filename = urllib.parse.unquote(path.rsplit("/", 1)[-1])
+    return f"{dist_info_name(filename)}/METADATA"
+
