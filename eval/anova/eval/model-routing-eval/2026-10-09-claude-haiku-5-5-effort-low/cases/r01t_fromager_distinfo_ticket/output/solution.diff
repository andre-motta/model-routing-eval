+def _wheel_metadata_path(url: str) -> str:
+    """Return the expected root METADATA path inside a wheel.
+
+    The wheel filename is {name}-{version}[-{build}]-{python}-{abi}-{platform}.whl,
+    and the metadata lives at {name}-{version}.dist-info/METADATA.
+
+    Args:
+        url: URL of the wheel file
+
+    Returns:
+        Path of the METADATA file within the wheel archive
+    """
+    filename = urllib.parse.urlsplit(url).path.rsplit("/", 1)[-1]
+    # Name and version never contain "-", so the first two fields are reliable
+    # even when an optional build tag is present.
+    name, version = filename.split("-")[:2]
+    return f"{name}-{version}.dist-info/METADATA"
