+def test_max_release_age_constraint_overrides_age_filter(
+    caplog: pytest.LogCaptureFixture,
+) -> None:
+    """A constrained package keeps its pinned version even if it is too old."""
+    max_age_cutoff = _BOOTSTRAP_TIME - datetime.timedelta(days=5)
+    constraint = constraints.Constraints()
+    constraint.add_constraint("test-pkg==1.2.2")
