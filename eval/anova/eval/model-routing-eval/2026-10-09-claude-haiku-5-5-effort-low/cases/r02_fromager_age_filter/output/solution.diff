diff --git a/tests/test_cooldown.py b/tests/test_cooldown.py
index 0d47cc5..cafeebd 100644
--- a/tests/test_cooldown.py
+++ b/tests/test_cooldown.py
@@ -965,3 +965,56 @@ def test_resolve_package_cooldown_toplevel_compound_specifier_not_exempt(
         ctx, Requirement("test-pkg==1.0,>0.9"), req_type=RequirementType.TOP_LEVEL
     )
     assert result is _COOLDOWN
+
+
+def test_max_release_age_skips_constrained_package(
+    caplog: pytest.LogCaptureFixture,
+) -> None:
+    """A constrained package bypasses the age filter, even if all candidates are too old."""
+    max_age_cutoff = _BOOTSTRAP_TIME - datetime.timedelta(days=30)
+    constraints = resolver.Constraints()
+    constraints.add_constraint("test-pkg==1.2.2")
+    with requests_mock.Mocker() as r:
+        r.get(
+            "https://pypi.org/simple/test-pkg/",
+            json=_cooldown_json_response,
+            headers={"Content-Type": _PYPI_SIMPLE_JSON_CONTENT_TYPE},
+        )
+        provider = resolver.PyPIProvider(include_sdists=True, constraints=constraints)
+        with caplog.at_level(logging.INFO, logger="fromager.resolver"):
+            results = resolver.find_all_matching_from_provider(
+                provider, Requirement("test-pkg"), max_age_cutoff=max_age_cutoff
+            )
+
+    versions = [str(v) for _, v in results]
+    assert versions == ["1.2.2"]
+    assert "test-pkg: skipping age filter for constrained package (1 candidate(s))" in (
+        caplog.text
+    )
+    assert "keeping all to avoid empty resolution" not in caplog.text
+    assert "published within" not in caplog.text
+
+
+def test_max_release_age_filters_unconstrained_package_with_other_constraint(
+    caplog: pytest.LogCaptureFixture,
+) -> None:
+    """An unconstrained package still gets age-filtered when other packages are constrained."""
+    max_age_cutoff = _BOOTSTRAP_TIME - datetime.timedelta(days=30)
+    constraints = resolver.Constraints()
+    constraints.add_constraint("other-pkg==1.0.0")
+    with requests_mock.Mocker() as r:
+        r.get(
+            "https://pypi.org/simple/test-pkg/",
+            json=_cooldown_json_response,
+            headers={"Content-Type": _PYPI_SIMPLE_JSON_CONTENT_TYPE},
+        )
+        provider = resolver.PyPIProvider(include_sdists=True, constraints=constraints)
+        with caplog.at_level(logging.INFO, logger="fromager.resolver"):
+            results = resolver.find_all_matching_from_provider(
+                provider, Requirement("test-pkg"), max_age_cutoff=max_age_cutoff
+            )
+
+    versions = [str(v) for _, v in results]
+    assert versions == ["2.0.0", "1.3.2"]
+    assert "skipping age filter" not in caplog.text
+    assert "have 2 candidate(s)" in caplog.text
