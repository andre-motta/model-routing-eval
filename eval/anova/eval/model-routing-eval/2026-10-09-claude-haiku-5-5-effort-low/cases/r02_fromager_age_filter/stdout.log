{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PTdoqQs5Z4PLWTPk7j6o1v","type":"tool_result","content":"230\t        self._report(\"selecting %s\", candidate)\n231\t\n232\t    def ending(self, state: typing.Any) -> None:\n233\t        self._report(\"successfully resolved %r\", self.req)\n234\t\n235\t\n236\tdef find_all_matching_from_provider(\n237\t    provider: BaseProvider,\n238\t    req: Requirement,\n239\t    max_age_cutoff: datetime.datetime | None = None,\n240\t    fallback_on_empty_age_filter: bool = True,\n241\t) -> list[tuple[str, Version]]:\n242\t    \"\"\"Find all matching candidates from provider without full dependency resolution.\n243\t\n244\t    This function collects ALL candidates that match the requirement, rather than\n245\t    performing full dependency resolution to find a single best candidate.\n246\t\n247\t    Args:\n248\t        provider: The provider to query for candidates.\n249\t        req: The requirement to match.\n250\t        max_age_cutoff: If set, reject candidates published before this time.\n251\t            If all candidates are older than the cutoff, all are kept and\n252\t            a warning is emitted to avoid empty resolution.\n253\t        fallback_on_empty_age_filter: If ``True`` (default), keep all\n254\t            candidates when age filtering would produce an empty result.\n255\t            If ``False``, return an empty list instead, allowing the\n256\t            caller to implement its own fallback strategy.\n257\t\n258\t    Returns list of (url, version) tuples sorted by version (highest first).\n259\t\n260\t    IMPORTANT: This bypasses resolvelib's full resolver to collect all matching\n261\t    candidates. This is safe ONLY because BaseProvider.get_dependencies() returns\n262\t    an empty list (no transitive dependencies to resolve). The empty incompatibilities\n263\t    dict means no version is ever excluded based on conflicts.\n264\t\n265\t    If get_dependencies() is ever extended to return actual dependencies, this\n266\t    function must be revisited to use resolvelib's full resolution algorithm\n267\t    (Resolver.resolve()) to properly handle dependency conflicts and backtracking.\n268\t    \"\"\"\n269\t    # Get all matching candidates directly from provider\n270\t    # instead of using resolvelib's resolver which picks just one\n271\t    identifier = provider.identify(req)\n272\t    try:\n273\t        # Bypass resolvelib's resolver to collect all matching candidates rather than\n274\t        # just the single best one. This is safe because get_dependencies() returns []\n275\t        # (no transitive deps to resolve). If get_dependencies() is ever extended,\n276\t        # this must be revisited to use resolvelib's full resolution.\n277\t        candidates = provider.find_matches(\n278\t            identifier=identifier,\n279\t            requirements={identifier: [req]},\n280\t            incompatibilities={},  # Empty - safe only because no transitive deps\n281\t        )\n282\t    except resolvelib.resolvers.ResolverException as err:\n283\t        constraint = provider.constraints.get_constraint(req.name)\n284\t        provider_desc = provider.get_provider_description()\n285\t        original_msg = str(err)\n286\t        raise resolvelib.resolvers.ResolverException(\n287\t            f\"Unable to resolve requirement specifier {req} with constraint {constraint} using {provider_desc}: {original_msg}\"\n288\t        ) from err\n289\t\n290\t    # Materialize candidates so we can iterate more than once if filtering\n291\t    candidates_list = list(candidates)\n292\t\n293\t    if max_age_cutoff is not None:\n294\t        logger.info(\n295\t            \"%s: found %d candidate(s) matching %s\",\n296\t            req.name,\n297\t            len(candidates_list),\n298\t            req,\n299\t        )\n300\t        max_age_days = (datetime.datetime.now(datetime.UTC) - max_age_cutoff).days\n301\t        filtered = [\n302\t            c\n303\t            for c in candidates_list\n304\t            if c.upload_time is None or c.upload_time >= max_age_cutoff\n305\t        ]\n306\t        dropped = len(candidates_list) - len(filtered)\n307\t        if dropped:\n308\t            logger.info(\n309\t                \"%s: have %d candidate(s) of %s published within %d days\",\n310\t                req.name,\n311\t                len(filtered),\n312\t                req,\n313\t                max_age_days,\n314\t            )\n315\t        if filtered:\n316\t            candidates_list = filtered\n317\t        elif fallback_on_empty_age_filter:\n318\t            logger.warning(\n319\t                \"%s: all %d candidate(s) of %s are older than %d days, \"\n320\t                \"keeping all to avoid empty resolution\",\n321\t                req.name,\n322\t                len(candidates_list),\n323\t                req,\n324\t                max_age_days,\n325\t            )\n326\t        else:\n327\t            logger.info(\n328\t                \"%s: all %d candidate(s) of %s are older than %d days\",\n329\t                req.name,\n330\t                len(candidates_list),\n331\t                req,\n332\t                max_age_days,\n333\t            )\n334\t            candidates_list = []\n335\t\n336\t    # Convert candidates to list of (url, version) tuples\n337\t    # Candidates are sorted by version (highest first) by BaseProvider.find_matches()\n338\t    # which calls sorted(candidates, key=attrgetter(\"version\", \"build_tag\"), reverse=True)\n339\t    return [(c.url, c.version) for c in candidates_list]\n340\t\n341\t\n342\tdef get_project_from_pypi(\n343\t    project: str,\n344\t    extras: typing.Iterable[str],\n345\t    sdist_server_url: str,\n346\t    ignore_platform: bool = False,\n347\t    *,\n348\t    override_download_url: str | None = None,\n349\t) -> Candidates:\n350\t    \"\"\"Fetch and filter package candidates from a PyPI-compatible server.\n351\t\n352\t    Filters the project's package list by: project status, filename\n353\t    validity, package type (sdist/wheel), yanked status, Python version\n354\t    compatibility, and platform tags. Can substitute\n355\t    ``override_download_url`` into each candidate's URL.\n356\t    \"\"\"\n357\t    found_candidates: set[str] = set()\n358\t    ignored_candidates: set[str] = set()\n359\t    logger.debug(\"%s: getting available versions from %s\", project, sdist_server_url)\n360\t\n361\t    client = pypi_simple.PyPISimple(\n362\t        endpoint=sdist_server_url,\n363\t        session=session,\n364\t        accept=pypi_simple.ACCEPT_JSON_PREFERRED,"}]},"parent_tool_use_id":null,"session_id":"e9be3c2c-1981-4f22-8eb9-7ebe2cfb336d","uuid":"ae0c95e9-f4dd-402d-8771-dc287fafdc96","timestamp":"2026-10-09T15:35:17.063Z","tool_use_result":{"type":"text","file":{"filePath":"/home/alustosa/git/model-routing-eval/.work/agent-eval/2026-10-09-claude-haiku-5-5-effort-low/cases/r02_fromager_age_filter/src/fromager/resolver.py","content":"        self._report(\"selecting %s\", candidate)\n\n    def ending(self, state: typing.Any) -> None:\n        self._report(\"successfully resolved %r\", self.req)\n\n\ndef find_all_matching_from_provider(\n    provider: BaseProvider,\n    req: Requirement,\n    max_age_cutoff: datetime.datetime | None = None,\n    fallback_on_empty_age_filter: bool = True,\n) -> list[tuple[str, Version]]:\n    \"\"\"Find all matching candidates from provider without full dependency resolution.\n\n    This function collects ALL candidates that match the requirement, rather than\n    performing full dependency resolution to find a single best candidate.\n\n    Args:\n        provider: The provider to query for candidates.\n        req: The requirement to match.\n        max_age_cutoff: If set, reject candidates published before this time.\n            If all candidates are older than the cutoff, all are kept and\n            a warning is emitted to avoid empty resolution.\n        fallback_on_empty_age_filter: If ``True`` (default), keep all\n            candidates when age filtering would produce an empty result.\n            If ``False``, return an empty list instead, allowing the\n            caller to implement its own fallback strategy.\n\n    Returns list of (url, version) tuples sorted by version (highest first).\n\n    IMPORTANT: This bypasses resolvelib's full resolver to collect all matching\n    candidates. This is safe ONLY because BaseProvider.get_dependencies() returns\n    an empty list (no transitive dependencies to resolve). The empty incompatibilities\n    dict means no version is ever excluded based on conflicts.\n\n    If get_dependencies() is ever extended to return actual dependencies, this\n    function must be revisited to use resolvelib's full resolution algorithm\n    (Resolver.resolve()) to properly handle dependency conflicts and backtracking.\n    \"\"\"\n    # Get all matching candidates directly from provider\n    # instead of using resolvelib's resolver which picks just one\n    identifier = provider.identify(req)\n    try:\n        # Bypass resolvelib's resolver to collect all matching candidates rather than\n        # just the single best one. This is safe because get_dependencies() returns []\n        # (no transitive deps to resolve). If get_dependencies() is ever extended,\n        # this must be revisited to use resolvelib's full resolution.\n        candidates = provider.find_matches(\n            identifier=identifier,\n            requirements={identifier: [req]},\n            incompatibilities={},  # Empty - safe only because no transitive deps\n        )\n    except resolvelib.resolvers.ResolverException as err:\n        constraint = provider.constraints.get_constraint(req.name)\n        provider_desc = provider.get_provider_description()\n        original_msg = str(err)\n        raise resolvelib.resolvers.ResolverException(\n            f\"Unable to resolve requirement specifier {req} with constraint {constraint} using {provider_desc}: {original_msg}\"\n        ) from err\n\n    # Materialize candidates so we can iterate more than once if filtering\n    candidates_list = list(candidates)\n\n    if max_age_cutoff is not None:\n        logger.info(\n            \"%s: found %d candidate(s) matching %s\",\n            req.name,\n            len(candidates_list),\n            req,\n        )\n        max_age_days = (datetime.datetime.now(datetime.UTC) - max_age_cutoff).days\n        filtered = [\n            c\n            for c in candidates_list\n            if c.upload_time is None or c.upload_time >= max_age_cutoff\n        ]\n        dropped = len(candidates_list) - len(filtered)\n        if dropped:\n            logger.info(\n                \"%s: have %d candidate(s) of %s published within %d days\",\n                req.name,\n                len(filtered),\n                req,\n                max_age_days,\n            )\n        if filtered:\n            candidates_list = filtered\n        elif fallback_on_empty_age_filter:\n            logger.warning(\n                \"%s: all %d candidate(s) of %s are older than %d days, \"\n                \"keeping all to avoid empty resolution\",\n                req.name,\n                len(candidates_list),\n                req,\n                max_age_days,\n            )\n        else:\n            logger.info(\n                \"%s: all %d candidate(s) of %s are older than %d days\",\n                req.name,\n                len(candidates_list),\n                req,\n                max_age_days,\n            )\n            candidates_list = []\n\n    # Convert candidates to list of (url, version) tuples\n    # Candidates are sorted by version (highest first) by BaseProvider.find_matches()\n    # which calls sorted(candidates, key=attrgetter(\"version\", \"build_tag\"), reverse=True)\n    return [(c.url, c.version) for c in candidates_list]\n\n\ndef get_project_from_pypi(\n    project: str,\n    extras: typing.Iterable[str],\n    sdist_server_url: str,\n    ignore_platform: bool = False,\n    *,\n    override_download_url: str | None = None,\n) -> Candidates:\n    \"\"\"Fetch and filter package candidates from a PyPI-compatible server.\n\n    Filters the project's package list by: project status, filename\n    validity, package type (sdist/wheel), yanked status, Python version\n    compatibility, and platform tags. Can substitute\n    ``override_download_url`` into each candidate's URL.\n    \"\"\"\n    found_candidates: set[str] = set()\n    ignored_candidates: set[str] = set()\n    logger.debug(\"%s: getting available versions from %s\", project, sdist_server_url)\n\n    client = pypi_simple.PyPISimple(\n        endpoint=sdist_server_url,\n        session=session,\n        accept=pypi_simple.ACCEPT_JSON_PREFERRED,","numLines":135,"startLine":230,"totalLines":1364}},"tool_result_meta":[{"id":"toolu_01PTdoqQs5Z4PLWTPk7j6o1v","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011Cfrug24TRt2UXasfxRdAT","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_014EEaAGA5gcoarJznpAV8NT","name":"Read","input":{"file_path":"/home/alustosa/git/model-routing-eval/.work/agent-eval/2026-10-09-claude-haiku-5-5-effort-low/cases/r02_fromager_age_filter/tests/test_cooldown.py","offset":690,"limit":180},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8715,"cache_read_input_tokens":25773,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8715},"output_tokens":20,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e9be3c2c-1981-4f22-8eb9-7ebe2cfb336d","uuid":"77352241-db82-428e-a1bf-7e6e30f4569f","timestamp":"2026-10-09T15:35:17.466Z","request_id":"req_011Cfrug1oL2N6ug3np2ySZF","wire_tool_inputs":{"toolu_014EEaAGA5gcoarJznpAV8NT":{"file_path":"/home/alustosa/git/model-routing-eval/.work/agent-eval/2026-10-09-claude-haiku-5-5-effort-low/cases/r02_fromager_age_filter/tests/test_cooldown.py","offset":690,"limit":180}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014EEaAGA5gcoarJznpAV8NT","type":"tool_result","content":"690\t    assert str(version) == \"1.3.2\"\n691\t    assert \"cooldown check skipped\" in caplog.text\n692\t\n693\t\n694\t# ---------------------------------------------------------------------------\n695\t# max-release-age tests\n696\t# ---------------------------------------------------------------------------\n697\t\n698\t# Uses the same _cooldown_json_response fixture:\n699\t#   2.0.0  uploaded 2026-03-24 →  2 days old\n700\t#   1.3.2  uploaded 2026-03-15 → 11 days old\n701\t#   1.2.2  uploaded 2026-01-01 → 84 days old\n702\t# _BOOTSTRAP_TIME = 2026-03-26\n703\t\n704\t# max_age_cutoff = bootstrap_time - max_release_age\n705\t# With 30 days: cutoff = 2026-02-24 → keeps 2.0.0 and 1.3.2, filters 1.2.2\n706\t# With 5 days:  cutoff = 2026-03-21 → keeps only 2.0.0\n707\t\n708\t\n709\tdef test_max_release_age_filters_old_versions(\n710\t    caplog: pytest.LogCaptureFixture,\n711\t) -> None:\n712\t    \"\"\"Versions older than max-release-age are filtered out.\"\"\"\n713\t    max_age_cutoff = _BOOTSTRAP_TIME - datetime.timedelta(days=30)\n714\t    with requests_mock.Mocker() as r:\n715\t        r.get(\n716\t            \"https://pypi.org/simple/test-pkg/\",\n717\t            json=_cooldown_json_response,\n718\t            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n719\t        )\n720\t        provider = resolver.PyPIProvider(include_sdists=True)\n721\t        with caplog.at_level(logging.INFO, logger=\"fromager.resolver\"):\n722\t            results = resolver.find_all_matching_from_provider(\n723\t                provider, Requirement(\"test-pkg\"), max_age_cutoff=max_age_cutoff\n724\t            )\n725\t\n726\t    versions = [str(v) for _, v in results]\n727\t    assert \"2.0.0\" in versions\n728\t    assert \"1.3.2\" in versions\n729\t    assert \"1.2.2\" not in versions\n730\t    assert \"found 3 candidate(s)\" in caplog.text\n731\t    assert \"have 2 candidate(s)\" in caplog.text\n732\t    assert \"published within\" in caplog.text\n733\t\n734\t\n735\tdef test_max_release_age_keeps_only_recent(\n736\t    caplog: pytest.LogCaptureFixture,\n737\t) -> None:\n738\t    \"\"\"With a tight max-release-age, only very recent versions survive.\"\"\"\n739\t    max_age_cutoff = _BOOTSTRAP_TIME - datetime.timedelta(days=5)\n740\t    with requests_mock.Mocker() as r:\n741\t        r.get(\n742\t            \"https://pypi.org/simple/test-pkg/\",\n743\t            json=_cooldown_json_response,\n744\t            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n745\t        )\n746\t        provider = resolver.PyPIProvider(include_sdists=True)\n747\t        with caplog.at_level(logging.INFO, logger=\"fromager.resolver\"):\n748\t            results = resolver.find_all_matching_from_provider(\n749\t                provider, Requirement(\"test-pkg\"), max_age_cutoff=max_age_cutoff\n750\t            )\n751\t\n752\t    versions = [str(v) for _, v in results]\n753\t    assert versions == [\"2.0.0\"]\n754\t    assert \"found 3 candidate(s)\" in caplog.text\n755\t    assert \"have 1 candidate(s)\" in caplog.text\n756\t    assert \"published within\" in caplog.text\n757\t\n758\t\n759\tdef test_max_release_age_disabled_returns_all() -> None:\n760\t    \"\"\"When max_age_cutoff is None, all versions are returned.\"\"\"\n761\t    with requests_mock.Mocker() as r:\n762\t        r.get(\n763\t            \"https://pypi.org/simple/test-pkg/\",\n764\t            json=_cooldown_json_response,\n765\t            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n766\t        )\n767\t        provider = resolver.PyPIProvider(include_sdists=True)\n768\t        results = resolver.find_all_matching_from_provider(\n769\t            provider, Requirement(\"test-pkg\"), max_age_cutoff=None\n770\t        )\n771\t\n772\t    versions = [str(v) for _, v in results]\n773\t    assert \"2.0.0\" in versions\n774\t    assert \"1.3.2\" in versions\n775\t    assert \"1.2.2\" in versions\n776\t\n777\t\n778\tdef test_max_release_age_all_too_old_keeps_all(\n779\t    caplog: pytest.LogCaptureFixture,\n780\t) -> None:\n781\t    \"\"\"When all versions are older than cutoff, keep all candidates and warn.\"\"\"\n782\t    max_age_cutoff = _BOOTSTRAP_TIME + datetime.timedelta(days=1)\n783\t    with requests_mock.Mocker() as r:\n784\t        r.get(\n785\t            \"https://pypi.org/simple/test-pkg/\",\n786\t            json=_cooldown_json_response,\n787\t            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n788\t        )\n789\t        provider = resolver.PyPIProvider(include_sdists=True)\n790\t        with caplog.at_level(logging.WARNING, logger=\"fromager.resolver\"):\n791\t            results = resolver.find_all_matching_from_provider(\n792\t                provider, Requirement(\"test-pkg\"), max_age_cutoff=max_age_cutoff\n793\t            )\n794\t    versions = [str(v) for _, v in results]\n795\t    assert versions == [\"2.0.0\", \"1.3.2\", \"1.2.2\"]\n796\t    assert \"keeping all to avoid empty resolution\" in caplog.text\n797\t\n798\t\n799\tdef test_max_release_age_all_too_old_returns_empty_when_fallback_disabled(\n800\t    caplog: pytest.LogCaptureFixture,\n801\t) -> None:\n802\t    \"\"\"When fallback is disabled and all versions are too old, return empty list.\"\"\"\n803\t    max_age_cutoff = _BOOTSTRAP_TIME + datetime.timedelta(days=1)\n804\t    with requests_mock.Mocker() as r:\n805\t        r.get(\n806\t            \"https://pypi.org/simple/test-pkg/\",\n807\t            json=_cooldown_json_response,\n808\t            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n809\t        )\n810\t        provider = resolver.PyPIProvider(include_sdists=True)\n811\t        with caplog.at_level(logging.INFO, logger=\"fromager.resolver\"):\n812\t            results = resolver.find_all_matching_from_provider(\n813\t                provider,\n814\t                Requirement(\"test-pkg\"),\n815\t                max_age_cutoff=max_age_cutoff,\n816\t                fallback_on_empty_age_filter=False,\n817\t            )\n818\t    assert results == []\n819\t    assert \"all 3 candidate(s)\" in caplog.text\n820\t    assert \"keeping all to avoid empty resolution\" not in caplog.text\n821\t\n822\t\n823\tdef test_max_release_age_candidates_without_upload_time_pass_through() -> None:\n824\t    \"\"\"Candidates without upload_time are not filtered out by max-release-age.\"\"\"\n825\t    no_timestamp_response = {\n826\t        \"meta\": {\"api-version\": \"1.1\"},\n827\t        \"name\": \"test-pkg\",\n828\t        \"files\": [\n829\t            {\n830\t                \"filename\": \"test_pkg-1.0.0-py3-none-any.whl\",\n831\t                \"url\": \"https://files.pythonhosted.org/packages/test_pkg-1.0.0-py3-none-any.whl\",\n832\t                \"hashes\": {\"sha256\": \"aaa\"},\n833\t            },\n834\t        ],\n835\t    }\n836\t    max_age_cutoff = _BOOTSTRAP_TIME - datetime.timedelta(days=5)\n837\t    with requests_mock.Mocker() as r:\n838\t        r.get(\n839\t            \"https://pypi.org/simple/test-pkg/\",\n840\t            json=no_timestamp_response,\n841\t            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n842\t        )\n843\t        provider = resolver.PyPIProvider(include_sdists=True)\n844\t        results = resolver.find_all_matching_from_provider(\n845\t            provider, Requirement(\"test-pkg\"), max_age_cutoff=max_age_cutoff\n846\t        )\n847\t\n848\t    assert len(results) == 1\n849\t    assert str(results[0][1]) == \"1.0.0\"\n850\t\n851\t\n852\tdef test_max_release_age_combined_with_cooldown() -> None:\n853\t    \"\"\"Both cooldown (min-release-age) and max-release-age work together as a window.\"\"\"\n854\t    max_age_cutoff = _BOOTSTRAP_TIME - datetime.timedelta(days=30)\n855\t    with requests_mock.Mocker() as r:\n856\t        r.get(\n857\t            \"https://pypi.org/simple/test-pkg/\",\n858\t            json=_cooldown_json_response,\n859\t            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n860\t        )\n861\t        # Cooldown blocks 2.0.0 (too new), max-release-age blocks 1.2.2 (too old)\n862\t        provider = resolver.PyPIProvider(include_sdists=True, cooldown=_COOLDOWN)\n863\t        results = resolver.find_all_matching_from_provider(\n864\t            provider, Requirement(\"test-pkg\"), max_age_cutoff=max_age_cutoff\n865\t        )\n866\t\n867\t    versions = [str(v) for _, v in results]\n868\t    assert versions == [\"1.3.2\"]\n869\t"}]},"parent_tool_use_id":null,"session_id":"e9be3c2c-1981-4f22-8eb9-7ebe2cfb336d","uuid":"e8157086-53b1-47f1-ade4-6dd5e81c6727","timestamp":"2026-10-09T15:35:17.509Z","tool_use_result":{"type":"text","file":{"filePath":"/home/alustosa/git/model-routing-eval/.work/agent-eval/2026-10-09-claude-haiku-5-5-effort-low/cases/r02_fromager_age_filter/tests/test_cooldown.py","content":"    assert str(version) == \"1.3.2\"\n    assert \"cooldown check skipped\" in caplog.text\n\n\n# ---------------------------------------------------------------------------\n# max-release-age tests\n# ---------------------------------------------------------------------------\n\n# Uses the same _cooldown_json_response fixture:\n#   2.0.0  uploaded 2026-03-24 →  2 days old\n#   1.3.2  uploaded 2026-03-15 → 11 days old\n#   1.2.2  uploaded 2026-01-01 → 84 days old\n# _BOOTSTRAP_TIME = 2026-03-26\n\n# max_age_cutoff = bootstrap_time - max_release_age\n# With 30 days: cutoff = 2026-02-24 → keeps 2.0.0 and 1.3.2, filters 1.2.2\n# With 5 days:  cutoff = 2026-03-21 → keeps only 2.0.0\n\n\ndef test_max_release_age_filters_old_versions(\n    caplog: pytest.LogCaptureFixture,\n) -> None:\n    \"\"\"Versions older than max-release-age are filtered out.\"\"\"\n    max_age_cutoff = _BOOTSTRAP_TIME - datetime.timedelta(days=30)\n    with requests_mock.Mocker() as r:\n        r.get(\n            \"https://pypi.org/simple/test-pkg/\",\n            json=_cooldown_json_response,\n            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n        )\n        provider = resolver.PyPIProvider(include_sdists=True)\n        with caplog.at_level(logging.INFO, logger=\"fromager.resolver\"):\n            results = resolver.find_all_matching_from_provider(\n                provider, Requirement(\"test-pkg\"), max_age_cutoff=max_age_cutoff\n            )\n\n    versions = [str(v) for _, v in results]\n    assert \"2.0.0\" in versions\n    assert \"1.3.2\" in versions\n    assert \"1.2.2\" not in versions\n    assert \"found 3 candidate(s)\" in caplog.text\n    assert \"have 2 candidate(s)\" in caplog.text\n    assert \"published within\" in caplog.text\n\n\ndef test_max_release_age_keeps_only_recent(\n    caplog: pytest.LogCaptureFixture,\n) -> None:\n    \"\"\"With a tight max-release-age, only very recent versions survive.\"\"\"\n    max_age_cutoff = _BOOTSTRAP_TIME - datetime.timedelta(days=5)\n    with requests_mock.Mocker() as r:\n        r.get(\n            \"https://pypi.org/simple/test-pkg/\",\n            json=_cooldown_json_response,\n            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n        )\n        provider = resolver.PyPIProvider(include_sdists=True)\n        with caplog.at_level(logging.INFO, logger=\"fromager.resolver\"):\n            results = resolver.find_all_matching_from_provider(\n                provider, Requirement(\"test-pkg\"), max_age_cutoff=max_age_cutoff\n            )\n\n    versions = [str(v) for _, v in results]\n    assert versions == [\"2.0.0\"]\n    assert \"found 3 candidate(s)\" in caplog.text\n    assert \"have 1 candidate(s)\" in caplog.text\n    assert \"published within\" in caplog.text\n\n\ndef test_max_release_age_disabled_returns_all() -> None:\n    \"\"\"When max_age_cutoff is None, all versions are returned.\"\"\"\n    with requests_mock.Mocker() as r:\n        r.get(\n            \"https://pypi.org/simple/test-pkg/\",\n            json=_cooldown_json_response,\n            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n        )\n        provider = resolver.PyPIProvider(include_sdists=True)\n        results = resolver.find_all_matching_from_provider(\n            provider, Requirement(\"test-pkg\"), max_age_cutoff=None\n        )\n\n    versions = [str(v) for _, v in results]\n    assert \"2.0.0\" in versions\n    assert \"1.3.2\" in versions\n    assert \"1.2.2\" in versions\n\n\ndef test_max_release_age_all_too_old_keeps_all(\n    caplog: pytest.LogCaptureFixture,\n) -> None:\n    \"\"\"When all versions are older than cutoff, keep all candidates and warn.\"\"\"\n    max_age_cutoff = _BOOTSTRAP_TIME + datetime.timedelta(days=1)\n    with requests_mock.Mocker() as r:\n        r.get(\n            \"https://pypi.org/simple/test-pkg/\",\n            json=_cooldown_json_response,\n            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n        )\n        provider = resolver.PyPIProvider(include_sdists=True)\n        with caplog.at_level(logging.WARNING, logger=\"fromager.resolver\"):\n            results = resolver.find_all_matching_from_provider(\n                provider, Requirement(\"test-pkg\"), max_age_cutoff=max_age_cutoff\n            )\n    versions = [str(v) for _, v in results]\n    assert versions == [\"2.0.0\", \"1.3.2\", \"1.2.2\"]\n    assert \"keeping all to avoid empty resolution\" in caplog.text\n\n\ndef test_max_release_age_all_too_old_returns_empty_when_fallback_disabled(\n    caplog: pytest.LogCaptureFixture,\n) -> None:\n    \"\"\"When fallback is disabled and all versions are too old, return empty list.\"\"\"\n    max_age_cutoff = _BOOTSTRAP_TIME + datetime.timedelta(days=1)\n    with requests_mock.Mocker() as r:\n        r.get(\n            \"https://pypi.org/simple/test-pkg/\",\n            json=_cooldown_json_response,\n            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n        )\n        provider = resolver.PyPIProvider(include_sdists=True)\n        with caplog.at_level(logging.INFO, logger=\"fromager.resolver\"):\n            results = resolver.find_all_matching_from_provider(\n                provider,\n                Requirement(\"test-pkg\"),\n                max_age_cutoff=max_age_cutoff,\n                fallback_on_empty_age_filter=False,\n            )\n    assert results == []\n    assert \"all 3 candidate(s)\" in caplog.text\n    assert \"keeping all to avoid empty resolution\" not in caplog.text\n\n\ndef test_max_release_age_candidates_without_upload_time_pass_through() -> None:\n    \"\"\"Candidates without upload_time are not filtered out by max-release-age.\"\"\"\n    no_timestamp_response = {\n        \"meta\": {\"api-version\": \"1.1\"},\n        \"name\": \"test-pkg\",\n        \"files\": [\n            {\n                \"filename\": \"test_pkg-1.0.0-py3-none-any.whl\",\n                \"url\": \"https://files.pythonhosted.org/packages/test_pkg-1.0.0-py3-none-any.whl\",\n                \"hashes\": {\"sha256\": \"aaa\"},\n            },\n        ],\n    }\n    max_age_cutoff = _BOOTSTRAP_TIME - datetime.timedelta(days=5)\n    with requests_mock.Mocker() as r:\n        r.get(\n            \"https://pypi.org/simple/test-pkg/\",\n            json=no_timestamp_response,\n            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n        )\n        provider = resolver.PyPIProvider(include_sdists=True)\n        results = resolver.find_all_matching_from_provider(\n            provider, Requirement(\"test-pkg\"), max_age_cutoff=max_age_cutoff\n        )\n\n    assert len(results) == 1\n    assert str(results[0][1]) == \"1.0.0\"\n\n\ndef test_max_release_age_combined_with_cooldown() -> None:\n    \"\"\"Both cooldown (min-release-age) and max-release-age work together as a window.\"\"\"\n    max_age_cutoff = _BOOTSTRAP_TIME - datetime.timedelta(days=30)\n    with requests_mock.Mocker() as r:\n        r.get(\n            \"https://pypi.org/simple/test-pkg/\",\n            json=_cooldown_json_response,\n            headers={\"Content-Type\": _PYPI_SIMPLE_JSON_CONTENT_TYPE},\n        )\n        # Cooldown blocks 2.0.0 (too new), max-release-age blocks 1.2.2 (too old)\n        provider = resolver.PyPIProvider(include_sdists=True, cooldown=_COOLDOWN)\n        results = resolver.find_all_matching_from_provider(\n            provider, Requirement(\"test-pkg\"), max_age_cutoff=max_age_cutoff\n        )\n\n    versions = [str(v) for _, v in results]\n    assert versions == [\"1.3.2\"]\n","numLines":180,"startLine":690,"totalLines":968}},"tool_result_meta":[{"id":"toolu_014EEaAGA5gcoarJznpAV8NT","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
