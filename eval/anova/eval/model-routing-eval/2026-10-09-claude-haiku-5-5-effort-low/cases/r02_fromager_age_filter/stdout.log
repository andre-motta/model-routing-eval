f(ctx)\n110:        provider, req, max_age_cutoff=max_age_cutoff\n130:    \"\"\"Lookup resolver provider to resolve package versions\"\"\"\n135:        constraints=ctx.constraints,\n151:def resolve_package_cooldown(\n156:    \"\"\"Compute the effective cooldown for a single package.\n160:        req: The package requirement being resolved.\n171:    per_package_days = ctx.package_build_info(req).resolver_min_release_age\n173:    if per_package_days is None:\n175:    if per_package_days == 0:\n177:    # Per-package positive override: inherit bootstrap_time from global so all\n185:        min_age=datetime.timedelta(days=per_package_days),\n190:def _compute_max_age_cutoff(\n193:    \"\"\"Compute the cutoff time for max release age filtering.\n198:    if ctx.max_release_age is None:\n205:    return bootstrap_time - ctx.max_release_age\n236:def find_all_matching_from_provider(\n239:    max_age_cutoff: datetime.datetime | None = None,\n240:    fallback_on_empty_age_filter: bool = True,\n250:        max_age_cutoff: If set, reject candidates published before this time.\n253:        fallback_on_empty_age_filter: If ``True`` (default), keep all\n254:            candidates when age filtering would produce an empty result.\n283:        constraint = provider.constraints.get_constraint(req.name)\n287:            f\"Unable to resolve requirement specifier {req} with constraint {constraint} using {provider_desc}: {original_msg}\"\n293:    if max_age_cutoff is not None:\n300:        max_age_days = (datetime.datetime.now(datetime.UTC) - max_age_cutoff).days\n304:            if c.upload_time is None or c.upload_time >= max_age_cutoff\n313:                max_age_days,\n317:        elif fallback_on_empty_age_filter:\n320:                \"keeping all to avoid empty resolution\",\n324:                max_age_days,\n332:                max_age_days,\n350:    \"\"\"Fetch and filter package candidates from a PyPI-compatible server.\n352:    Filters the project's package list by: project status, filename\n353:    validity, package type (sdist/wheel), yanked status, Python version\n367:        package = client.get_project_page(project)\n374:            \"failed to fetch package index from %s: %s\",\n380:    # PEP 792 package status\n381:    match package.status:\n383:            logger.debug(\"no package status\")\n385:            logger.debug(\"project %r is active: %s\", project, package.status_reason)\n390:                package.status,\n391:                package.status_reason,\n395:                f\"project {project!r} is quarantined: {package.status_reason}\"\n401:                package.status,\n402:                package.status_reason,\n405:    for dp in package.packages:\n413:            or dp.package_type is None\n434:        if dp.package_type not in {\"sdist\", \"wheel\"}:\n439:                    dp.package_type,\n484:            if dp.package_type == \"sdist\":\n567:        constraints: Constraints | None = None,\n573:        self.constraints = constraints or Constraints()\n598:        This is used in error messages to indicate what resolver was being used.\n675:        allow_prerelease = self.constraints.allow_prerelease(requirement.name) or bool(\n687:        if not self.constraints.is_satisfied_by(requirement.name, candidate.version):\n689:                c = self.constraints.get_constraint(requirement.name)\n691:                    f\"{requirement.name}: skipping {candidate.version} due to constraint {c}\"\n698:        \"\"\"Return True if the candidate is rejected by the release-age cooldown.\"\"\"\n708:                # Warn once per package name across all provider instances.\n712:                        \"release-age cooldown cannot be enforced — upload \"\n720:            # Fail closed: we cannot verify the age of this candidate, so reject it.\n731:        cutoff = self.cooldown.bootstrap_time - self.cooldown.min_age\n735:                age = self.cooldown.bootstrap_time - candidate.upload_time\n739:                    age,\n740:                    self.cooldown.min_age,\n790:    def _get_no_match_error_message(\n793:        \"\"\"Generate an error message when no candidates are found.\n818:        # Apply cooldown filtering after specifier/constraint validation\n831:                self._get_no_match_error_message(identifier, requirements)\n837:    \"\"\"Lookup package and versions from a simple Python index (PyPI)\n852:        constraints: Constraints | None = None,\n862:            constraints=constraints,\n925:    def _get_no_match_error_message(\n928:        \"\"\"Generate a PyPI-specific error message with file type and pre-release details.\"\"\"\n934:            self.constraints.allow_prerelease(r.name) or req_allows_prerelease\n947:        # failure so we can give a more actionable error message.\n949:            cutoff = self.cooldown.bootstrap_time - self.cooldown.min_age\n962:                    f\"{self.cooldown.min_age.days}-day release-age cooldown\"\n972:                    f\"were published within the last {self.cooldown.min_age.days} days \"\n973:                    f\"(release-age cooldown; oldest is {oldest_days} day(s) old)\"\n996:    \"\"\"Lookup package and version by using a callback\"\"\"\n1001:        constraints: Constraints | None = None,\n1010:            constraints=constraints,\n1111:        constraints: Constraints | None = None,\n1120:            constraints=constraints,\n1206:        constraints: Constraints | None = None,\n1215:            constraints=constraints,\n1311:    \"\"\"Lookup package versions from a VersionMap\n1314:    for package resolution. The VersionMap should contain Version keys mapped\n1319:        \"VersionMap resolver (package: {self.package_name})\"\n1325:        package_name: str | None,\n1326:        constraints: Constraints | None = None,\n1331:        if package_name is None:\n1334:            constraints=constraints,\n1339:        self.package_name = package_name","is_error":false}]},"parent_tool_use_id":null,"session_id":"e9b