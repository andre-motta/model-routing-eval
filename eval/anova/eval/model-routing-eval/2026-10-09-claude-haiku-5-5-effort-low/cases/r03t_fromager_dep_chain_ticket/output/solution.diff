+def test_bg_resolve_failure_names_broken_parent() -> None:
+    """A failed dependency resolution names the parent that broke the chain."""
+    bg_resolver = Mock()
+    bg_resolver.resolve.side_effect = ResolverException("no matching version")
+    req = Requirement("flashinfer-python==0.6.8.post1")
+    parent_req = Requirement("vllm==0.20.0")
+
+    with pytest.raises(ResolverException) as exc_info:
+        _bg_resolve(bg_resolver, req, RequirementType.INSTALL, parent_req, False)
+
+    assert str(exc_info.value) == (
+        "vllm requires flashinfer-python==0.6.8.post1, "
+        "which cannot be resolved: no matching version"
+    )
+    assert isinstance(exc_info.value.__cause__, ResolverException)
+
+
+def test_bg_resolve_top_level_failure_is_unchanged() -> None:
+    """Without a parent, the original resolver error is re-raised as is."""
+    bg_resolver = Mock()
+    bg_resolver.resolve.side_effect = ResolverException("no matching version")
+    req = Requirement("its-hub")
+
+    with pytest.raises(ResolverException) as exc_info:
+        _bg_resolve(bg_resolver, req, RequirementType.TOP_LEVEL, None, False)
+
+    assert str(exc_info.value) == "no matching version"
+
+
