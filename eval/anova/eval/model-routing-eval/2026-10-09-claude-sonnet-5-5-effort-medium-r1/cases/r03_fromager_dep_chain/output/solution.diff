+_CHAIN = [
+    (RequirementType.TOP_LEVEL, Requirement("its-hub"), Version("1.0")),
+    (RequirementType.INSTALL, Requirement("reward-hub>=2"), Version("2.1")),
+]
+
+
+class TestEnrichResolutionError:
+    def test_chain_suffix(self, tmp_context: WorkContext) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context)
+        item = _make_resolve_item("vllm>=0.6", why_snapshot=list(_CHAIN))
+
+        assert bt._dependency_chain_suffix(item.work_item) == (
+            " (dependency chain: its-hub==1.0 -> reward-hub==2.1 -> vllm>=0.6)"
+        )
+
+    def test_resolver_exception_stays_resolver_exception(
+        self, tmp_context: WorkContext
+    ) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context)
+        item = _make_resolve_item("vllm", why_snapshot=list(_CHAIN))
+
+        result = bt._enrich_resolution_error(item, ResolverException("boom"))
+
+        assert type(result) is ResolverException
+        assert str(result) == (
+            "boom (dependency chain: its-hub==1.0 -> reward-hub==2.1 -> vllm)"
+        )
+
+    def test_runtime_error_stays_runtime_error(self, tmp_context: WorkContext) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context)
+        item = _make_resolve_item("vllm", why_snapshot=list(_CHAIN))
+
+        result = bt._enrich_resolution_error(item, RuntimeError("boom"))
+
+        assert type(result) is RuntimeError
+        assert str(result).startswith("boom (dependency chain: its-hub==1.0")
+
+    def test_other_error_becomes_runtime_error(self, tmp_context: WorkContext) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context)
+        item = _make_resolve_item("vllm", why_snapshot=list(_CHAIN))
+
+        result = bt._enrich_resolution_error(item, ValueError("boom"))
+
+        assert type(result) is RuntimeError
+        assert str(result).startswith("ValueError: boom (dependency chain: ")
+
+    def test_top_level_unchanged(self, tmp_context: WorkContext) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context)
+        item = _make_resolve_item("vllm")
+        err = ResolverException("boom")
+
+        assert bt._enrich_resolution_error(item, err) is err
+
+    def test_other_phase_unchanged(self, tmp_context: WorkContext) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context)
+        item = _make_build_item(phase=BootstrapPhase.BUILD)
+        item.work_item.why_snapshot = list(_CHAIN)
+        err = RuntimeError("boom")
+
+        assert bt._enrich_resolution_error(item, err) is err
+
+    def test_normal_mode_raises_enriched_without_cause(
+        self, tmp_context: WorkContext
+    ) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context)
+        item = _make_resolve_item("vllm", why_snapshot=list(_CHAIN))
+        err = ResolverException("boom")
+
+        with pytest.raises(ResolverException) as exc_info:
+            try:
+                raise err
+            except ResolverException:
+                bt._handle_phase_error(item, err)
+
+        assert "dependency chain: its-hub==1.0 -> reward-hub==2.1 -> vllm" in str(
+            exc_info.value
+        )
+        assert exc_info.value.__cause__ is None
+        assert exc_info.value.__context__ is err
+
+    def test_test_mode_records_enriched(self, tmp_context: WorkContext) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context, test_mode=True)
+        item = _make_resolve_item("vllm", why_snapshot=list(_CHAIN))
+
+        bt._handle_phase_error(item, RuntimeError("boom"))
+
+        assert "dependency chain: its-hub==1.0" in bt.failed_packages[0]["exception_message"]
+
+    def test_multiple_versions_records_enriched(
+        self, tmp_context: WorkContext
+    ) -> None:
+        bt = bootstrapper.Bootstrapper(tmp_context, multiple_versions=True)
+        item = _make_resolve_item("vllm", why_snapshot=list(_CHAIN))
+
+        bt._handle_phase_error(item, RuntimeError("boom"))
+
+        recorded = bt._failed_versions[(canonicalize_name("vllm"), "unresolved")]
+        assert "dependency chain: its-hub==1.0" in str(recorded)
+
