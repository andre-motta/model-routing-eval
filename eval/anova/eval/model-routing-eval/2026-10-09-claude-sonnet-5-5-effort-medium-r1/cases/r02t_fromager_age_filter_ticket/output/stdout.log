r(include_sdists=True)\n        with caplog.at_level(logging.INFO, logger=\"fromager.resolver\"):\n            results = resolver.find_all_matching_from_provider(\n                provider, Requirement(\"test-pkg\"), max_age_cutoff=max_age_cutoff\n            )\n\n    versions = [str(v) for _, v in results]\n    assert versions == [\"2.0.0\"]\n    assert \"found 3 candidate(s)\" in caplog.text\n    assert \"have 1 candidate(s)\" in caplog.text\n    assert \"published within\" in caplog.text\n\n\ndef test_max_release_age_disabled_returns_all() -> None:\n    \"\"\"When max_age_cutoff is None, all versions are returned.\"\"\"\n49:    def add_constraint(self, unparsed: str) -> None:\n50-        \"\"\"Add new constraint, must not conflict with any existing constraints\n51-\n52-        .. versionchanged: 0.83.0\n53-           Non-conflicting constraints are now combined. Constraints with\n54-           conflicts now raise :exc:`InvalidConstraintError`. Inputs without a\n55-           version specifier or with extras are also refused.\n--\n102:    def load_constraints_file(self, constraints_file: str | pathlib.Path) -> None:\n103-        \"\"\"Load constraints from a constraints file or URL\"\"\"\n104-        logger.info(\"loading constraints from %s\", constraints_file)\n105-        content = requirements_file.parse_requirements_file(constraints_file)\n106-        for line in content:\n107-            self.add_constraint(line)\n108-\n--\n117:    def get_constraint(self, name: str) -> Requirement | None:\n118-        return self._data.get(canonicalize_name(name))\n119-\n120-    def allow_prerelease(self, pkg_name: str) -> bool:\n121-        constraint = self.get_constraint(pkg_name)\n122-        if constraint:\n123-            return bool(constraint.specifier.prereleases)","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01PUNPaYGGszNGDe5SZox1rB","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
