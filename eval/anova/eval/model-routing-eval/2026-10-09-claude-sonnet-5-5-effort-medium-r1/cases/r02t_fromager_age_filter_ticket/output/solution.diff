+def test_max_release_age_skipped_for_constrained_package(
+    fallback: bool, caplog: pytest.LogCaptureFixture
+) -> None:
+    """A pinned package keeps its pinned version despite max-release-age."""
+    max_age_cutoff = _BOOTSTRAP_TIME - datetime.timedelta(days=5)
+    constraints = Constraints()
+    constraints.add_constraint("test-pkg==1.2.2")
