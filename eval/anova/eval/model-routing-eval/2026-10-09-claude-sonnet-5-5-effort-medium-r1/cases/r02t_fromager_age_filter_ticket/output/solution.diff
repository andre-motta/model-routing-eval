+        )
+        provider = resolver.PyPIProvider(include_sdists=True, constraints=constraints)
+        with caplog.at_level(logging.INFO, logger="fromager.resolver"):
+            results = resolver.find_all_matching_from_provider(
+                provider,
+                Requirement("test-pkg"),
+                max_age_cutoff=max_age_cutoff,
+                fallback_on_empty_age_filter=fallback,
+            )
+
+    assert [str(v) for _, v in results] == ["1.2.2"]
