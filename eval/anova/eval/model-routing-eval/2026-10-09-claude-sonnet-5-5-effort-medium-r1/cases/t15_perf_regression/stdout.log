\n\n\ndef aggregate(rows):\n    \"\"\"Per (tenant, service): total cpu_seconds, total bytes_out, event count. Sorted by tenant then service.\"\"\"\n    acc = defaultdict(lambda: [0.0, 0, 0])\n    for r in rows:\n        a = acc[(r.tenant, r.service)]\n        a[0] += r.cpu_seconds\n        a[1] += r.bytes_out\n        a[2] += 1\n    return {k: tuple(v) for k, v in sorted(acc.items())}\n\"\"\"Drop duplicate events (the collector retries, so the same event_id can appear several times).\n\nRefactored to keep insertion order of first occurrence, which the old set-based version did not guarantee.\n\"\"\"\n\n\ndef dedupe_rows(rows):\n    seen_ids = []\n    out = []\n    for r in rows:\n        if r.event_id in seen_ids:\n            continue\n        seen_ids.append(r.event_id)\n        out.append(r)\n    return out\nfrom dataclasses import dataclass\n\n\n@dataclass(frozen=True)\nclass UsageRow:\n    event_id: str\n    tenant: str\n    service: str\n    cpu_seconds: float\n    bytes_out: int\n\n\ndef parse_rows(lines):\n    \"\"\"lines: iterable of 'event_id,tenant,service,cpu_seconds,bytes_out'\"\"\"\n    rows = []\n    for line in lines:\n        line = line.strip()\n        if not line or line.startswith(\"#\"):\n            continue\n        e, t, s, c, b = line.split(\",\")\n        rows.append(UsageRow(e, t, s, float(c), int(b)))\n    return rows\nfrom .dedupe import dedupe_rows\nfrom .aggregate import aggregate\n\n\ndef build_report(rows):\n    \"\"\"Returns list of dicts, one per (tenant, service), plus a totals row at the end.\"\"\"\n    rows = dedupe_rows(rows)\n    agg = aggregate(rows)\n    out = []\n    tot_cpu, tot_bytes, tot_n = 0.0, 0, 0\n    for (tenant, service), (cpu, byts, n) in agg.items():\n        out.append({\"tenant\": tenant, \"service\": service, \"cpu_seconds\": round(cpu, 3), \"bytes_out\": byts, \"events\": n})\n        tot_cpu += cpu; tot_bytes += byts; tot_n += n\n    out.append({\"tenant\": \"*\", \"service\": \"*\", \"cpu_seconds\": round(tot_cpu, 3), \"bytes_out\": tot_bytes, \"events\": tot_n})\n    return out\nfrom reporting import parse_rows, build_report\n\n\ndef test_small_report():\n    rows = parse_rows([\"e1,acme,api,1.5,100\", \"e2,acme,api,0.5,50\", \"e2,acme,api,0.5,50\", \"e3,beta,web,2,10\"])\n    rep = build_report(rows)\n    assert rep[0] == {\"tenant\": \"acme\", \"service\": \"api\", \"cpu_seconds\": 2.0, \"bytes_out\": 150, \"events\": 2}\n    assert rep[-1][\"events\"] == 3\n# reporting\n\nNightly usage report. `python -m pytest` runs the tests.","is_error":false}]},"parent_tool_use_id":null,"session_id":"6e2f4172-e73a-4e65-8376-a38fc12df9ac","uuid":"1ed52d74-0b42-48df-99c3-28165d5fc782","timestamp":"2026-10-09T18:06:42.368Z","tool_use_result":{"stdout":"                                          alustosa@alustosa-thinkpadp1gen7\n               .',;::::;,'.               ────────────────────────────────\n           .';:cccccccccccc:;,.             OS  Fedora Linux 44 (Workstation Edition) x86_64\n        .;cccccccccccccccccccccc;.          Kernel  Linux 7.1.8-200.fc44.x86_64\n      .:cccccccccccccccccccccccccc:.       󰅐 Uptime  8 days, 21 hours, 34 mins\n    .;ccccccccccccc;.:dddl:.;ccccccc;.      Shell  bash 5.3.9\n   .:ccccccccccccc;OWMKOOXMWd;ccccccc:.     Terminal  claude\n  .:ccccccccccccc;KMMc;cc;xMMc;ccccccc:.  ────────────────────────────────\n  ,cccccccccccccc;MMM.;cc;;WW:;cccccccc,   󰻠 CPU  Intel(R) Core(TM) Ultra 7 165H (12+8+2) @ 5.00 GHz\n  :cccccccccccccc;MMM.;cccccccccccccccc:   󰍛 GPU  Intel Arc Graphics @ 2.30 GHz [Integrated]\n  :ccccccc;oxOOOo;MMM000k.;cccccccccccc:    RAM  55.33 GiB / 62.23 GiB (89%)\n  cccccc;0MMKxdd:;MMMkddc.;cccccccccccc;   󰋊 Disk  240.98 GiB / 952.27 GiB (25%) - btrfs\n  ccccc;XMO';cccc;MMM.;cccccccccccccccc'  ────────────────────────────────\n  ccccc;MMo;ccccc;MMW.;ccccccccccccccc;    󰍹 Display  1920x1200 in 16\", 60 Hz [Built-in]\n  ccccc;0MNc.ccc.xMMd;ccccccccccccccc;     󰍹 Display  1920x1080 in 24\", 144 Hz [External]\n  cccccc;dNMWXXXWM