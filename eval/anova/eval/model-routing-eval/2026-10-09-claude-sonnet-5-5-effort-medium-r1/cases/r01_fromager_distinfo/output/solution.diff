 class TestPEP658Support:
@@ -191,3 +198,43 @@ Requires-Dist: requests >= 2.0.0
         assert candidate_with_metadata.name == candidate_without_metadata.name
         assert candidate_with_metadata.version == candidate_without_metadata.version
         assert candidate_with_metadata.url == candidate_without_metadata.url
+
+
+def _wheel_bytes(members: dict[str, str]) -> bytes:
+    buf = io.BytesIO()
+    with zipfile.ZipFile(buf, "w") as zf:
+        for name, content in members.items():
+            zf.writestr(name, content)
+    return buf.getvalue()
+
+
+def _metadata(name: str) -> str:
+    return f"Metadata-Version: 2.1\nName: {name}\nVersion: 1.0\n"
+
+
+def test_wheel_metadata_path_ignores_query_and_fragment() -> None:
+    url = "https://pkg.test/files/MarkupSafe-3.0.2-py3-none-any.whl?x=1#sha256=abc"
+    assert _wheel_metadata_path(url) == "MarkupSafe-3.0.2.dist-info/METADATA"
+
+
+@patch("fromager.candidate.session")
+def test_get_metadata_for_wheel_ignores_vendored_dist_info(
+    mock_session: typing.Any,
+) -> None:
+    mock_session.get.return_value.content = _wheel_bytes(
+        {
+            "pkg/_vendor/other-9.0.dist-info/METADATA": _metadata("other"),
+            "pkg-1.0.dist-info/METADATA": _metadata("pkg"),
+        }
+    )
+    metadata = get_metadata_for_wheel("https://pkg.test/pkg-1.0-py3-none-any.whl")
+    assert metadata.name == "pkg"
+
+
+@patch("fromager.candidate.session")
+def test_get_metadata_for_wheel_missing_member(mock_session: typing.Any) -> None:
+    mock_session.get.return_value.content = _wheel_bytes(
+        {"other-9.0.dist-info/METADATA": _metadata("other")}
+    )
+    with pytest.raises(ValueError, match="Could not find METADATA"):
+        get_metadata_for_wheel("https://pkg.test/pkg-1.0-py3-none-any.whl")
