+def test_is_pre_built_hook(testdata_context: context.WorkContext) -> None:
+    """Hook is consulted only with a version; non-None result wins."""
+    pbi = testdata_context.settings.package_build_info(TEST_PKG)
+    calls: list[tuple[Version, str]] = []
+    result: list[bool | None] = [True]
+
+    def hook(*, version: Version, variant: str) -> bool | None:
+        calls.append((version, variant))
+        return result[0]
+
+    with patch("fromager.overrides.find_override_method", return_value=hook):
+        assert pbi.is_pre_built(Version("2.8.0+cpu")) is True
+        assert calls == [(Version("2.8.0"), "cpu")]
+
+        calls.clear()
+        assert pbi.is_pre_built() is False
+        assert pbi.pre_built is False
+        assert calls == []
+
+        result[0] = None
+        assert pbi.is_pre_built(Version("2.9.0")) is True
+
+
