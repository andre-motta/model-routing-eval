  tmp_context,\n            Requirement(\"testpkg==2.0+cpu\"),\n            cache_wheel_server_url=\"https://cache.test/simple\",\n            version=Version(\"2.0+cpu\"),\n        )\n        assert resolve.call_args.kwargs[\"req\"] == Requirement(\"testpkg==2.0+cpu\")\n        assert resolve.call_args.kwargs[\"wheel_server_urls\"] == [\n            \"https://w.test/simple\"\n        ]\n\n    def test_pre_built_returns_none_on_exception_group(\n        self, tmp_context: WorkContext\n    ) -> None:\n        with (\n            patch(\"fromager.wheels.get_wheel_server_urls\", return_value=[\"u\"]),\n            patch(\n                \"fromager.wheels.resolve_prebuilt_wheel\",\n                side_effect=ExceptionGroup(\"nope\", [ValueError(\"x\")]),\n            ),\n        ):\n            url = _re_resolve_url(\n                tmp_context,\n                Requirement(\"testpkg\"),\n                RequirementType.INSTALL,\n                Version(\"2.0\"),\n                True,\n                None,\n            )\n\n        assert url is None\n\n    def test_source_returns_first_match(self, tmp_context: WorkContext) -> None:\n        with (\n            patch(\"fromager.sources.get_source_provider\") as get_provider,\n            patch(\n                \"fromager.resolver.find_all_matching_from_provider\",\n                return_value=[(\"https://s.test/testpkg-2.0.tar.gz\", Version(\"2.0\"))],\n            ) as find,\n        ):\n            url = _re_resolve_url(\n                tmp_context,\n                Requirement(\"testpkg\"),\n                RequirementType.INSTALL,\n                Version(\"2.0\"),\n                False,\n                None,\n            )\n\n        assert url == \"https://s.test/testpkg-2.0.tar.gz\"\n        find.assert_called_once_with(\n            get_provider.return_value, Requirement(\"testpkg==2.0\")\n        )\n\n    def test_source_returns_none_without_match(self, tmp_context: WorkContext) -> None:\n        with (\n            patch(\"fromager.sources.get_source_provider\"),\n            patch(\n                \"fromager.resolver.find_all_matching_from_provider\",\n                side_effect=ResolverException(\"none\"),\n            ),\n        ):\n            url = _re_resolve_url(\n                tmp_context,\n                Requirement(\"testpkg\"),\n                RequirementType.INSTALL,\n                Version(\"2.0\"),\n                False,\n                None,\n            )\n\n        assert url is None\n''',1)\ns=s.replace(\"from fromager.bootstrapper._start import Start\",\"from fromager.bootstrapper._start import Start, _re_resolve_url\")\nopen(p,'w').write(s)\nEOF\n.venv/bin/python -m pytest -o addopts=\"\" tests/test_packagesettings.py tests/test_bootstrapper_iterative.py -q 2>&1 | sed -n '/^ZZZ\\|passed\\|failed\\|FAILED\\|Error/p' | tail -30; grep -n \"VariantInfo\" tests/test_packagesettings.py | head -2", "uuid": "34a22ced-570a-46d4-bb18-48a1954ac800", "session_id": "97ddeb5e-36cf-4ab2-ab92-86345dca8664", "timestamp": "2026-10-09T18:00:38.168Z"}
