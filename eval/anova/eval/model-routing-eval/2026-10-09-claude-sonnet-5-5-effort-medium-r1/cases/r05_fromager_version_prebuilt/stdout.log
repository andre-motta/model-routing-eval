n        with (\n            patch.object(tmp_context, \"package_build_info\", return_value=pbi),\n            patch(\n                \"fromager.bootstrapper._start._re_resolve_url\",\n                return_value=\"https://new.test/testpkg-1.0.whl\",\n            ) as re_resolve,\n        ):\n            item.run(bt)\n\n        assert re_resolve.called is expect_re_resolve\n        expected = (\n            \"https://new.test/testpkg-1.0.whl\"\n            if expect_re_resolve\n            else \"https://pypi.org/testpkg-1.0.tar.gz\"\n        )\n        assert item.work_item.source_url == expected\n        node = tmp_context.dependency_graph.nodes[\n            f\"{canonicalize_name('testpkg')}==1.0\"\n        ]\n        assert node.download_url == expected\n\n    def test_re_resolve_failure_keeps_original_url(\n        self, tmp_context: WorkContext, caplog: pytest.LogCaptureFixture\n    ) -> None:\n        bt = bootstrapper.Bootstrapper(tmp_context)\n        bt.why = []\n        item = _make_start_item()\n        pbi = Mock(pre_built=False, is_pre_built=Mock(return_value=True))\n\n        with (\n            caplog.at_level(logging.WARNING),\n            patch.object(tmp_context, \"package_build_info\", return_value=pbi),\n            patch(\"fromager.bootstrapper._start._re_resolve_url\", return_value=None),\n        ):\n            item.run(bt)\n\n        assert item.work_item.source_url == \"https://pypi.org/testpkg-1.0.tar.gz\"\n        assert \"could not re-resolve\" in caplog.text\n\n    def test_re_resolve_happens_for_already_seen_parent_edge(\n        self, tmp_context: WorkContext\n    ) -> None:\n        \"\"\"A second parent of a seen package still gets its edge with the new URL.\"\"\"\n        bt = bootstrapper.Bootstrapper(tmp_context)\n        bt.why = []\n        pbi = Mock(pre_built=False, is_pre_built=Mock(return_value=True))\n        parents = [\n            (Requirement(\"parent-a\"), Version(\"1.0\")),\n            (Requirement(\"parent-b\"), Version(\"1.0\")),\n        ]\n        for parent in parents:\n            tmp_context.dependency_graph.add_dependency(\n                parent_name=None,\n                parent_version=None,\n                req_type=RequirementType.TOP_LEVEL,\n                req=parent[0],\n                req_version=parent[1],\n                download_url=\"https://pypi.org/parent.tar.gz\",\n            )\n\n        with (\n            patch.object(tmp_context, \"package_build_info\", return_value=pbi),\n            patch(\n                \"fromager.bootstrapper._start._re_resolve_url\",\n                return_value=\"https://new.test/testpkg-1.0.whl\",\n            ),\n        ):\n            for parent in parents:\n                _make_start_item(parent=parent).run(bt)\n\n        node = tmp_context.dependency_graph.nodes[\n            f\"{canonicalize_name('testpkg')}==1.0\"\n        ]\n        assert node.download_url == \"https://new.test/testpkg-1.0.whl\"\n        assert {e.destination_node.key for e in node.parents} == {\n            \"parent-a==1.0\",\n            \"parent-b==1.0\",\n        }\n\n\nclass TestReResolveUrl:\n    def test_pre_built_uses_wheel_servers(self, tmp_context: WorkContext) -> None:\n        req = Requirement(\"testpkg\")\n        with (\n            patch(\n                \"fromager.wheels.get_wheel_server_urls\",\n                return_value=[\"https://w.test/simple\"],\n            ) as get_urls,\n            patch(\n                \"fromager.wheels.resolve_prebuilt_wheel\",\n                return_value=(\"https://w.test/testpkg-2.0.whl\", Version(\"2.0\")),\n            ) as resolve,\n        ):\n            url = _re_resolve_url(\n                tmp_context,\n                req,\n                RequirementType.INSTALL,\n                Version(\"2.0+cpu\"),\n                True,\n                \"https://cache.test/simple\",\n            )\n\n        assert url == \"https://w.test/testpkg-2.0.whl\"\n        get_urls.assert_called_once_with(\n            tmp_context,\n            Requirement(\"testpkg==2.0+cpu\"),\n            cache_wheel_server_url=\"https://cache.test/simple\",\n            version=Version(\"2.0+cpu\"),\n        )\n        assert resolve.call_args.kwargs[\"req\"] == Requirement(\"testpkg==2.0+cpu\")\n        assert resolve.call_args.kwargs[\"wheel_server_urls\"] == [\n            \"https://w.test/simple\"\n        ]\n\n    def test_pre_built_returns_none_on_exception_group(\n        self, tmp_context: WorkContext\n    ) -> None:\n        with (\n            patch(\"fromager.wheels.get_wheel_server_urls\", return_value=[\"u\"]),\n            patch(\n                \"fromager.wheels.resolve_prebuilt_wheel\",\n                side_effect=ExceptionGroup(\"nope\", [ValueError(\"x\")]),\n            ),\n        ):\n            url = _re_resolve_url(\n                tmp_context,\n                Requirement(\"testpkg\"),\n                RequirementType.INSTALL,\n                Version(\"2.0\"),\n                True,\n                None,\n            )\n\n        assert url is None\n\n    def test_source_returns_first_match(self, tmp_context: WorkContext) -> None:\n        with (\n            patch(\"fromager.sources.get_source_provider\") as get_provider,\n            patch(\n                \"fromager.resolver.find_all_matching_from_provider\",\n                return_value=[(\"https://s.test/testpkg-2.0.tar.gz\", Version(\"2.0\"))],\n            ) as find,\n        ):\n            url = _re_resolve_url(\n                tmp_context,\n                Requirement(\"testpkg\"),\n                RequirementType.INSTALL,\n                Version(\"2.0\"),\n                False,\n                None,\n            )\n\n        assert url == \"https://s.test/testpkg-2.0.tar.gz\"\n        find.assert_called_once_with(\n            get_provider.return_value, Requirement(\"testpkg==2.0\")\n        )\n\n    def test_source_returns_none_without_match(self, tmp_context: WorkContext)