on`` and ``variant`` keyword arguments, but only when\na version is given.  The version has its local segment removed.  Return\n``True`` or ``False`` to override the YAML settings, or ``None`` to defer\nto them.  Without a version, the variant default is returned and the hook\nis not called.\n\n.. versionadded:: 0.95.0\n\n'''\n# insert before the heading preceding Global Hooks: find start of its line\ns=s[:i]+add+s[i:]\nopen(p,'w').write(s)\nEOF\necho ZZZ; sed -n 55,75p docs/concepts/hooks-and-overrides.rst; grep -n \"def test_sets_pbi_pre_built\" -A25 tests/test_bootstrapper_iterative.py; grep -n \"pre_built\\|^def test\\|^class \" tests/test_packagesettings.py | grep -n \"pre_built\\|wheel_server\" | head -20"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6751,"cache_read_input_tokens":82002,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6751},"output_tokens":7,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"97ddeb5e-36cf-4ab2-ab92-86345dca8664","uuid":"74ccb33f-8c66-47c3-b455-8c55f2c217c2","timestamp":"2026-10-09T18:00:07.812Z","request_id":"req_011Cfs6i1ouBzEv66x5uRG9K","wire_tool_inputs":{"toolu_011aY7PiCnU9KtgDpMVeM8hu":{"command":"cd /home/alustosa/git/model-routing-eval/.work/agent-eval/2026-10-09-claude-sonnet-5-5-effort-medium-r1/cases/r05_fromager_version_prebuilt; python3 - <<'EOF' >/dev/null 2>&1\np='src/fromager/bootstrapper/_start.py'\ns=open(p).read()\ns=s.replace(\"from packaging.version import Version\\n\",\"from packaging.version import Version\\nfrom resolvelib.resolvers import ResolverException\\n\",1)\ns=s.replace(\"    except Exception:\\n        return None\\n    if not results:\",\"    except ResolverException:\\n        return None\\n    if not results:\")\nopen(p,'w').write(s)\n\np