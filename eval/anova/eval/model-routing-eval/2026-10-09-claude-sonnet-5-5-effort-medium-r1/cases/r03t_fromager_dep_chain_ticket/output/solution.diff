+def test_resolve_failure_reports_dependency_chain(tmp_context: WorkContext) -> None:
+    """A failed dependency resolution names the full chain, not just the top level."""
+    bt = bootstrapper.Bootstrapper(tmp_context)
+    req = Requirement("flashinfer-python==0.6.8.post1")
+    item = Resolve(
+        WorkItem(
+            req=req,
+            req_type=RequirementType.INSTALL,
+            why_snapshot=[
+                (RequirementType.TOP_LEVEL, Requirement("its-hub"), Version("1.0")),
+                (RequirementType.INSTALL, Requirement("reward-hub"), Version("2.0")),
+                (RequirementType.INSTALL, Requirement("vllm"), Version("3.0")),
+            ],
+            parent=(Requirement("vllm"), Version("3.0")),
+        )
+    )
+    err = ResolverException("no matching versions")
+
+    with pytest.raises(RuntimeError) as exc_info:
+        bt._handle_phase_error(item, err)
+
+    msg = str(exc_info.value)
+    assert (
+        "its-hub==1.0 -> reward-hub==2.0 -> vllm==3.0 -> "
+        "flashinfer-python==0.6.8.post1" in msg
+    )
+    assert exc_info.value.__cause__ is err
+
+
