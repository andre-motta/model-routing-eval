t_dir is not None\n57\t        assert build_env is not None\n58\t        logger.debug(\n59\t            \"get install dependencies of sdist from directory %s\",\n60\t            sdist_root_dir,\n61\t        )\n62\t        return list(\n63\t            dependencies.get_install_dependencies_of_sdist(\n64\t                ctx=ctx,\n65\t                req=req,\n66\t                version=resolved_version,\n67\t                sdist_root_dir=sdist_root_dir,\n68\t                build_env=build_env,\n69\t            )\n70\t        )\n71\t    else:\n72\t        raise RuntimeError(\"wheel_filename and sdist_filename are None\")\n73\t\n74\t\n75\tclass ProcessInstallDeps(Phase):\n76\t    \"\"\"Run post-bootstrap hooks, extract install deps, and record the build order.\n77\t\n78\t    Runs any configured post-bootstrap hooks for the completed package (errors\n79\t    are fatal in normal mode; recorded as warnings in test mode).  Extracts\n80\t    install-time dependencies from the built wheel or sdist.  Appends the\n81\t    package to the persistent build-order file via ``Bootstrapper.add_to_build_order``.\n82\t\n83\t    Next phase: ``Complete`` + one ``Resolve`` per install dependency.\n84\t    \"\"\"\n85\t\n86\t    phase: typing.ClassVar[BootstrapPhase] = BootstrapPhase.PROCESS_INSTALL_DEPS\n87\t    tracks_why: typing.ClassVar[bool] = True\n88\t\n89\t    def run(self, bt: Bootstrapper) -> list[Phase]:\n90\t        \"\"\"PROCESS_INSTALL_DEPS phase: hooks, extract deps, build order.\n91\t\n92\t        Returns:\n93\t            [Complete, *install_dep_items].\n94\t        \"\"\"\n95\t        wi = self.work_item\n96\t        assert wi.resolved_version is not None\n97\t        assert wi.source_url is not None\n98\t        assert wi.build_result is not None\n99\t\n100\t        # Run post-bootstrap hooks (non-fatal in test mode)\n101\t        try:\n102\t            hooks.run_post_bootstrap_hooks(\n103\t                ctx=bt.ctx,\n104\t                req=wi.req,\n105\t                dist_name=canonicalize_name(wi.req.name),\n106\t                dist_version=str(wi.resolved_version),\n107\t                sdist_filename=wi.build_result.sdist_filename,\n108\t                wheel_filename=wi.build_result.wheel_filename,\n109\t            )\n110\t        except Exception as hook_error:\n111\t            if not bt.test_mode:\n112\t                raise\n113\t            bt.record_test_mode_failure(\n114\t                wi.req,\n115\t                str(wi.resolved_version),\n116\t                hook_error,\n117\t                \"hook\",\n118\t                \"warning\",\n119\t            )\n120\t\n121\t        # Extract install dependencies (non-fatal in test mode)\n122\t        try:\n123\t            install_dependencies = _get_install_dependencies(\n124\t                ctx=bt.ctx,\n125\t                req=wi.req,\n126\t                resolved_version=wi.resolved_version,\n127\t                wheel_filename=wi.build_result.wheel_filename,\n128\t                sdist_filename=wi.build_result.sdist_filename,\n129\t                sdist_root_dir=wi.build_result.sdist_root_dir,\n130\t                build_env=wi.build_result.build_env,\n131\t                unpack_dir=wi.build_result.unpack_dir,\n132\t            )\n133\t        except Exception as dep_error:\n134\t            if not bt.test_mode:\n135\t                raise\n136\t            bt.record_test_mode_failure(\n137\t                wi.req,\n138\t                str(wi.resolved_version),\n139\t                dep_error,\n140\t                \"dependency_extraction\",\n141\t                \"warning\",\n142\t            )\n143\t            install_dependencies = []\n144\t\n145\t        logger.debug(\n146\t            \"install dependencies: %s\",\n147\t            \", \".join(sorted(str(r) for r in install_dependencies)),\n148\t        )\n149\t\n150\t        pbi = bt.ctx.package_build_info(wi.req)\n151\t        constraint = bt.ctx.constraints.get_constraint(wi.req.name)\n152\t        bt.add_to_build_order(\n153\t            req=wi.req,\n154\t            version=wi.resolved_version,\n155\t            source_url=wi.source_url,\n156\t            source_type=wi.build_result.source_type,\n157\t            prebuilt=pbi.pre_built,\n158\t            constraint=constraint,\n159\t        )\n160\t\n161\t        dep_items: list[Phase] = bt.create_unresolved_work_items(\n162\t            install_dependencies,\n163\t            RequirementType.INSTALL,\n164\t            wi.req,\n165\t            wi.resolved_version,\n166\t        )\n167\t\n168\t        return [Complete(wi)] + dep_items\n169\t"}]},"parent_tool_use_id":null,"session_id":"cb119ce1-57c4-49dd-a03c-a07e77d5d813","uuid":"d97d1abd-d777-47b1-b76f-9c8412a0ef85","timestamp":"2026-10-09T17:57:18.814Z","tool_use_result":{"type":"text","file":{"filePath":"/home/alustosa/git/model-routing-eval/.work/agent-eval/2026-10-09-claude-sonnet-5-5-effort-medium-r1/cases/r03t_fromager_dep_chain_ticket/src/fromager/bootstrapper/_process_install_deps.py","content":"from __future__ import annotations\n\nimport logging\nimport pathlib\nimport typing\n\nfrom packaging.requirements import Requirement\nfrom packaging.utils import canonicalize_name\nfrom packaging.version import Version\n\nfrom .. import build_environment, dependencies, hooks\nfrom ..requirements_file import RequirementType\nfrom ._complete import Complete\nfrom ._phase import Phase\nfrom ._types import BootstrapPhase\n\nif typing.TYPE_CHECKING:\n    from .. import context\n    from ._bootstrapper import Bootstrapper\n\nlogger = logging.getLogger(__name__)\n\n\ndef _get_install_dependencies(\n    ctx: context.WorkContext,\n    req: Requirement,\n    resolved_version: Version,\n    wheel_filename: pathlib.Path | None,\n    sdist_filename: pathlib.Path | None,\n    sdist_root_dir: pathlib.Path | None,\n    build_env: build_environment.BuildEnvironment | None,\n    unpack_dir: pathlib.Path | None,\n) -> list[Requirement]:\n    \"\"\"Extract install dependencies from a built wheel or sdist.\n\n    Returns:\n        List of install requirements.\n\n    Raises:\n        RuntimeError: If both wheel_filename and sdist_filename are None.\n    \"\"\"\n    if wheel_filename is not None:\n        assert unpack_dir is not None\n        logger.debug(\n            \"get install dependencies of wheel %s\",\n            wheel_filename.name,\n        )\n        return list(\n            dependencies.get_install_dependencies_of_wheel(\n                req=req,\n                wheel_filename=wheel_filename,\n                requirements_file_dir=unpack_dir,\n            )\n        )\n    elif sdist_filename is not None:\n        assert sdist_root_dir is not None\n        assert build_env is not None\n        logger.debug(\n            \"get install dependencies of sdist from directory %s\",\n            sdist_root_dir,\n        )\n        return list(\n            dependencies.get_install_dependencies_of_sdist(\n                ctx=ctx,\n                req=req,\n                version=resolved_version,\n                sdist_root_dir=sdist_root_dir,\n                build_env=build_env,\n            )\n        )\n    else:\n        raise RuntimeError(\"wheel_filename and sdist_filename are None\")\n\n\nclass ProcessInstallDeps(Phase):\n    \"\"\"Run post-bootstrap hooks, extract install deps, and record the build order.\n\n    Runs any configured post-bootstrap hooks for the completed package (errors\n    are fatal in normal mode; recorded as warnings in test mode).  Extracts\n    install-time dependencies from the built wheel or sdist.  Appends the\n    package to the persistent build-order file via ``Bootstrapper.add_to_build_order``.\n\n    Next phase: ``Complete`` + one ``Resolve`` per install dependency.\n    \"\"\"\n\n    phase: typing.ClassVar[BootstrapPhase] = BootstrapPhase.PROCESS_INSTALL_DEPS\n    tracks_why: typing.ClassVar[bool] = True\n\n    def run(self, bt: Bootstrapper) -> list[Phase]:\n        \"\"\"PROCESS_INSTALL_DEPS phase: hooks, extract deps, build order.\n\n        Returns:\n            [Complete, *install_dep_items].\n        \"\"\"\n        wi = self.work_item\n        assert wi.resolved_version is not None\n        assert wi.source_url is not None\n        assert wi.build_result is not None\n\n        # Run post-bootstrap hooks (non-fatal in test mode)\n        try:\n            hooks.run_post_bootstrap_hooks(\n                ctx=bt.ctx,\n                req=wi.req,\n                dist_name=canonicalize_name(wi.req.name),\n                dist_version=str(wi.resolved_version),\n                sdist_filename=wi.build_result.sdist_filename,\n                wheel_filename=wi.build_result.wheel_filename,\n            )\n        except Exception as hook_error:\n            if not bt.test_mode:\n                raise\n            bt.record_test_mode_failure(\n                wi.req,\n                str(wi.resolved_version),\n                hook_error,\n                \"hook\",\n                \"warning\",\n            )\n\n        # Extract install dependencies (non-fatal in test mode)\n        try:\n            install_dependencies = _get_install_dependencies(\n                ctx=bt.ctx,\n                req=wi.req,\n                resolved_version=wi.resolved_version,\n                wheel_filename=wi.build_result.wheel_filename,\n                sdist_filename=wi.build_result.sdist_filename,\n                sdist_root_dir=wi.build_result.sdist_root_dir,\n                build_env=wi.build_result.build_env,\n                unpack_dir=wi.build_result.unpack_dir,\n            )\n        except Exception as dep_error:\n            if not bt.test_mode:\n                raise\n            bt.record_test_mode_failure(\n                wi.req,\n                str(wi.resolved_version),\n                dep_error,\n                \"dependency_extraction\",\n                \"warning\",\n            )\n            install_dependencies = []\n\n        logger.debug(\n            \"install dependencies: %s\",\n            \", \".join(sorted(str(r) for r in install_dependencies)),\n        )\n\n        pbi = bt.ctx.package_build_info(wi.req)\n        constraint = bt.ctx.constraints.get_constraint(wi.req.name)\n        bt.add_to_build_order(\n            req=wi.req,\n            version=wi.resolved_version,\n            source_url=wi.source_url,\n            source_type=wi.build_result.source_type,\n            prebuilt=pbi.pre_built,\n            constraint=constraint,\n        )\n\n        dep_items: list[Phase] = bt.create_unresolved_work_items(\n            install_dependencies,\n            RequirementType.INSTALL,\n            wi.req,\n            wi.resolved_version,\n        )\n\n        return [Complete(wi)] + dep_items\n","numLines":169,"startLine":1,"totalLines":169}},"tool_result_meta":[{"id":"toolu_01113Cj4nnLdtciWtviMDtMU","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
