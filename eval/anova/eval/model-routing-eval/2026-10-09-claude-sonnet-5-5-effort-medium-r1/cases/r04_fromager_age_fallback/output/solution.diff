+def test_max_release_age_all_too_old_newest_fallback(
+    caplog: pytest.LogCaptureFixture,
+) -> None:
+    """With AgeFallback.NEWEST and all versions too old, keep only the newest."""
+    max_age_cutoff = _BOOTSTRAP_TIME + datetime.timedelta(days=1)
+    with requests_mock.Mocker() as r:
+        r.get(
+            "https://pypi.org/simple/test-pkg/",
+            json=_cooldown_json_response,
+            headers={"Content-Type": _PYPI_SIMPLE_JSON_CONTENT_TYPE},
+        )
+        provider = resolver.PyPIProvider(include_sdists=True)
+        with caplog.at_level(logging.INFO, logger="fromager.resolver"):
+            results = resolver.find_all_matching_from_provider(
+                provider,
+                Requirement("test-pkg"),
+                max_age_cutoff=max_age_cutoff,
+                age_fallback=resolver.AgeFallback.NEWEST,
+            )
+    assert [str(v) for _, v in results] == ["2.0.0"]
+    assert "falling back to newest version 2.0.0" in caplog.text
+    assert "keeping all to avoid empty resolution" not in caplog.text
+
+
+def _pinned_provider(constraint: str) -> resolver.PyPIProvider:
+    constraints = Constraints()
+    constraints.add_constraint(f"test-pkg{constraint}")
+    return resolver.PyPIProvider(include_sdists=True, constraints=constraints)
+
+
+@pytest.mark.parametrize(
+    "age_fallback",
+    list(resolver.AgeFallback),
+)
+def test_max_release_age_skipped_for_pinned_constraint(
+    caplog: pytest.LogCaptureFixture, age_fallback: resolver.AgeFallback
+) -> None:
+    """An exact-version pin is not age filtered, whatever the fallback."""
+    max_age_cutoff = _BOOTSTRAP_TIME - datetime.timedelta(days=30)
+    with requests_mock.Mocker() as r:
+        r.get(
+            "https://pypi.org/simple/test-pkg/",
+            json=_cooldown_json_response,
+            headers={"Content-Type": _PYPI_SIMPLE_JSON_CONTENT_TYPE},
+        )
+        provider = _pinned_provider("==1.2.2")
+        with caplog.at_level(logging.INFO, logger="fromager.resolver"):
+            results = resolver.find_all_matching_from_provider(
+                provider,
+                Requirement("test-pkg"),
+                max_age_cutoff=max_age_cutoff,
+                age_fallback=age_fallback,
+            )
+    assert [str(v) for _, v in results] == ["1.2.2"]
+    assert "skipping age filter for pinned constraint (1 candidate(s))" in caplog.text
+    assert "keeping all to avoid empty resolution" not in caplog.text
+
+
