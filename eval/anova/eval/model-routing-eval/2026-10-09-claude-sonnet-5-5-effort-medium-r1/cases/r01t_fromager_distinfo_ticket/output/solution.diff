+        # Only consider dist-info directories in the wheel root. Wheels may
+        # contain nested dist-info directories of vendored packages.
+        candidates = [
+            n
+            for n in z.namelist()
+            if n.endswith(".dist-info/METADATA") and n.count("/") == 1
+        ]
+        if len(candidates) > 1:
+            # disambiguate with the distribution name from the wheel filename
+            candidates = [
+                n for n in candidates if _dist_info_matches_wheel(n, url)
+            ] or candidates
+        if candidates:
+            metadata_content = z.read(candidates[0])
+            # Parse metadata directly using packaging.metadata.Metadata
