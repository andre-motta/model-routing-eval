+import copy
+
+import pytest
+
+from jsonpatch.core import PatchError, PointerError, apply_patch, resolve_pointer
+
+
+def test_resolve_basic():
+    doc = {"a": [1, {"b": 2}], "": 0, "a/b": 1, "m~n": 2}
+    assert resolve_pointer(doc, "") is doc
+    assert resolve_pointer(doc, "/a/1/b") == 2
+    assert resolve_pointer(doc, "/") == 0
+    assert resolve_pointer(doc, "/a~1b") == 1
+    assert resolve_pointer(doc, "/m~0n") == 2
+
+
+def test_unescape_order():
+    assert resolve_pointer({"~1": 5}, "/~01") == 5
+
+
+@pytest.mark.parametrize(
+    "ptr", ["a", "/a/01", "/a/-", "/a/5", "/a/x", "/a/-1", "/b", "/a/0/x", "/a/١", None, 3]
+)
+def test_resolve_errors(ptr):
+    with pytest.raises(PointerError):
+        resolve_pointer({"a": [1]}, ptr)
+
+
+def test_pointer_error_is_patch_error():
+    assert issubclass(PointerError, PatchError)
+
+
+def test_add_ops():
+    assert apply_patch({}, [{"op": "add", "path": "/a", "value": 1}]) == {"a": 1}
+    assert apply_patch([1, 2], [{"op": "add", "path": "/1", "value": 9}]) == [1, 9, 2]
+    assert apply_patch([1], [{"op": "add", "path": "/1", "value": 9}]) == [1, 9]
+    assert apply_patch([1], [{"op": "add", "path": "/-", "value": 9}]) == [1, 9]
+    assert apply_patch({"a": 1}, [{"op": "add", "path": "", "value": [3]}]) == [3]
+
+
+@pytest.mark.parametrize("path", ["/3", "/-1", "/01", "/x"])
+def test_add_bad_index(path):
+    with pytest.raises(PatchError):
+        apply_patch([1], [{"op": "add", "path": path, "value": 0}])
+
+
+def test_add_missing_parent_and_scalar_parent():
+    with pytest.raises(PatchError):
+        apply_patch({}, [{"op": "add", "path": "/a/b", "value": 1}])
+    with pytest.raises(PatchError):
+        apply_patch({"a": 1}, [{"op": "add", "path": "/a/b", "value": 1}])
+
+
+def test_remove_replace():
+    assert apply_patch({"a": 1, "b": 2}, [{"op": "remove", "path": "/a"}]) == {"b": 2}
+    assert apply_patch([1, 2, 3], [{"op": "remove", "path": "/1"}]) == [1, 3]
+    assert apply_patch({"a": 1}, [{"op": "replace", "path": "/a", "value": 2}]) == {"a": 2}
+    assert apply_patch([1], [{"op": "replace", "path": "", "value": 7}]) == 7
+    for op in ("remove", "replace"):
+        with pytest.raises(PatchError):
+            apply_patch({}, [{"op": op, "path": "/a", "value": 1}])
+        with pytest.raises(PatchError):
+            apply_patch([1], [{"op": op, "path": "/-", "value": 1}])
+        with pytest.raises(PatchError):
+            apply_patch([1], [{"op": op, "path": "/1", "value": 1}])
+
+
+def test_move():
+    assert apply_patch({"a": 1}, [{"op": "move", "from": "/a", "path": "/b"}]) == {"b": 1}
+    assert apply_patch([1, 2, 3], [{"op": "move", "from": "/0", "path": "/2"}]) == [2, 3, 1]
+    doc = {"a": 1}
+    assert apply_patch(doc, [{"op": "move", "from": "/a", "path": "/a"}]) == {"a": 1}
+    with pytest.raises(PatchError):
+        apply_patch({"a": {"b": 1}}, [{"op": "move", "from": "/a", "path": "/a/c"}])
+    with pytest.raises(PatchError):
+        apply_patch({}, [{"op": "move", "from": "/a", "path": "/b"}])
+    # sibling with shared string prefix is not a child
+    assert apply_patch({"a": 1}, [{"op": "move", "from": "/a", "path": "/ab"}]) == {"ab": 1}
+
+
+def test_copy_is_deep():
+    doc = {"a": {"x": [1]}}
+    out = apply_patch(doc, [{"op": "copy", "from": "/a", "path": "/b"}])
+    out["b"]["x"].append(2)
+    assert out["a"]["x"] == [1]
+    with pytest.raises(PatchError):
+        apply_patch(doc, [{"op": "copy", "from": "/z", "path": "/b"}])
+
+
+def test_value_not_aliased():
+    value = {"k": [1]}
+    out = apply_patch({}, [{"op": "add", "path": "/a", "value": value}])
+    out["a"]["k"].append(2)
+    assert value == {"k": [1]}
+
+
+def test_test_op():
+    doc = {"a": 1, "b": True, "c": [1, {"d": 2}]}
+    ok = [
+        {"op": "test", "path": "/a", "value": 1.0},
+        {"op": "test", "path": "/b", "value": True},
+        {"op": "test", "path": "/c", "value": [1.0, {"d": 2}]},
+        {"op": "test", "path": "", "value": doc},
+    ]
+    assert apply_patch(doc, ok) == doc
+    bad = [
+        ("/a", True),
+        ("/b", 1),
+        ("/c", [True, {"d": 2}]),
+        ("/c", [1]),
+        ("/c/1", {"d": 2, "e": 3}),
+        ("/a", "1"),
+        ("/a", [1]),
+    ]
+    for path, value in bad:
+        with pytest.raises(PatchError):
+            apply_patch(doc, [{"op": "test", "path": path, "value": value}])
+
+
+def test_test_null_value():
+    assert apply_patch({"a": None}, [{"op": "test", "path": "/a", "value": None}]) == {"a": None}
+
+
+def test_atomic_not_in_place():
+    doc = {"a": [1, 2]}
+    snap = copy.deepcopy(doc)
+    with pytest.raises(PatchError):
+        apply_patch(doc, [
+            {"op": "add", "path": "/a/0", "value": 0},
+            {"op": "remove", "path": "/nope"},
+        ])
+    assert doc == snap
+    out = apply_patch(doc, [{"op": "add", "path": "/b", "value": 1}])
+    assert doc == snap and out is not doc
+
+
+def test_atomic_in_place():
+    doc = {"a": [1, 2]}
+    snap = copy.deepcopy(doc)
+    with pytest.raises(PatchError):
+        apply_patch(doc, [
+            {"op": "add", "path": "/a/0", "value": 0},
+            {"op": "test", "path": "/a/0", "value": 99},
+        ], in_place=True)
+    assert doc == snap
+
+
+def test_in_place_success():
+    doc = {"a": 1}
+    out = apply_patch(doc, [{"op": "add", "path": "/b", "value": 2}], in_place=True)
+    assert out is doc and doc == {"a": 1, "b": 2}
+    lst = [1]
+    out = apply_patch(lst, [{"op": "add", "path": "/-", "value": 2}], in_place=True)
+    assert out is lst and lst == [1, 2]
+    assert apply_patch(lst, [{"op": "replace", "path": "", "value": [9]}], in_place=True) == [9]
+
+
+def test_sequential_semantics():
+    out = apply_patch([], [
+        {"op": "add", "path": "/-", "value": 1},
+        {"op": "add", "path": "/-", "value": 2},
+        {"op": "move", "from": "/0", "path": "/1"},
+    ])
+    assert out == [2, 1]
+
+
+@pytest.mark.parametrize("op", [
+    {"op": "bogus", "path": "/a"},
+    {"path": "/a"},
+    {"op": 1, "path": "/a"},
+    {"op": "add", "path": "/a"},
+    {"op": "add", "value": 1},
+    {"op": "add", "path": 5, "value": 1},
+    {"op": "replace", "path": "/a"},
+    {"op": "test", "path": "/a"},
+    {"op": "move", "path": "/b"},
+    {"op": "copy", "path": "/b"},
+    {"op": "move", "from": 1, "path": "/b"},
+    "add",
+    None,
+])
+def test_malformed_ops(op):
+    with pytest.raises(PatchError):
+        apply_patch({"a": 1}, [op])
+
+
+@pytest.mark.parametrize("patch", [None, {}, "x", ()])
+def test_patch_must_be_list(patch):
+    with pytest.raises(PatchError):
+        apply_patch({}, patch)
