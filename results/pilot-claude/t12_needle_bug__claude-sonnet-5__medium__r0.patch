+def test_multiline_discount_matches_pdf_line_sum():
+    """Regression: invoice_total must equal sum(line_totals) exactly.
+
+    Previously invoice_total rounded the aggregate discount once while the
+    PDF (line_totals) rounds each discounted line separately, so the two
+    could differ by a cent when per-line roundings landed on opposite sides.
+    """
+    inv = build_invoice(
+        "A4",
+        [
+            ("x", "3.33", 1, percent_off("D1", "10")),
+            ("y", "3.33", 1, percent_off("D2", "10")),
+        ],
+    )
+    assert invoice_total(inv) == sum(line_totals(inv), Decimal("0"))
+    assert invoice_total(inv) == Decimal("6.00")
