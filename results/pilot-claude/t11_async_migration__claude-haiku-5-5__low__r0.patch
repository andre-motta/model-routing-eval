+def test_get_many_keeps_order_and_limits_concurrency():
+    state = {"active": 0, "peak": 0}
+
+    async def slow(url):
+        state["active"] += 1
+        state["peak"] = max(state["peak"], state["active"])
+        await asyncio.sleep(0.01 * (10 - int(url)))
+        state["active"] -= 1
+        return url.encode()
+
+    async def run():
+        c = Client(transport=slow, max_concurrency=3)
+        return await c.get_many([str(i) for i in range(10)])
+
+    res = asyncio.run(run())
+    assert res == [str(i).encode() for i in range(10)]
+    assert state["peak"] == 3
+
+
+def test_get_many_returns_errors_in_place():
+    async def transport(url):
+        if url == "bad":
+            raise TransientError("always")
+        return b"ok"
+
+    async def run():
+        c = Client(transport=transport, retries=2, backoff=0)
+        return await c.get_many(["a", "bad", "b"])
+
+    res = asyncio.run(run())
+    assert res[0] == b"ok" and res[2] == b"ok"
+    assert isinstance(res[1], FetchError) and isinstance(res[1].cause, TransientError)
+
+
+def test_non_transient_error_not_retried():
+    calls = {"n": 0}
+
+    async def transport(url):
+        calls["n"] += 1
+        raise KeyError("boom")
+
+    async def run():
+        c = Client(transport=transport, retries=3)
+        return await c.get("u")
+
+    try:
+        asyncio.run(run())
+    except KeyError:
+        pass
+    assert calls["n"] == 1
+
+
+def test_closed_client_raises():
+    async def run():
+        c = Client()
+        await c.close()
+        await c.get("u")
+
+    try:
+        asyncio.run(run())
+    except RuntimeError as e:
+        assert str(e) == "client closed"
+    else:
+        raise AssertionError("expected RuntimeError")
+
+
