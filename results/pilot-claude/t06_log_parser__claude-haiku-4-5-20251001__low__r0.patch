diff --git a/logstats/parse.py b/logstats/parse.py
index fcc184a..bfe6935 100644
--- a/logstats/parse.py
+++ b/logstats/parse.py
@@ -1 +1,120 @@
 """Implement parse_line and summarize here. See FORMAT.md."""
+
+from dataclasses import dataclass
+from datetime import datetime
+from typing import Optional
+from collections import defaultdict
+
+
+@dataclass
+class Record:
+    ts: datetime
+    method: str
+    path: str
+    status: int
+    latency_ms: float
+    bytes: int
+
+
+@dataclass
+class Summary:
+    total: int
+    malformed: int
+    by_status: dict[int, int]
+    by_method: dict[str, int]
+    p50_latency_ms: float
+    p95_latency_ms: float
+    bytes_total: int
+    error_rate: float
+    top_paths: list[tuple[str, int]]
+
+
+def parse_line(line: str) -> Optional[Record]:
+    """Parse a single log line. Returns None if malformed."""
+    parts = line.split()
+
+    # Need at least 5 parts: timestamp, method, path, status, latency
+    if len(parts) < 5:
+        return None
+
+    try:
+        ts_str = parts[0]
+        method = parts[1]
+        path = parts[2]
+        status = int(parts[3])
+        latency_ms = float(parts[4])
+        bytes_val = int(parts[5]) if len(parts) > 5 else 0
+
+        ts = datetime.fromisoformat(ts_str.replace('Z', '+00:00'))
+
+        return Record(
+            ts=ts,
+            method=method,
+            path=path,
+            status=status,
+            latency_ms=latency_ms,
+            bytes=bytes_val
+        )
+    except (ValueError, IndexError):
+        return None
+
+
+def summarize(lines: list[str]) -> Summary:
+    """Summarize a collection of log lines."""
+    records = []
+    malformed_count = 0
+    by_status = defaultdict(int)
+    by_method = defaultdict(int)
+    path_counts = defaultdict(int)
+    latencies = []
+    bytes_total = 0
+    error_count = 0
+
+    for line in lines:
+        record = parse_line(line)
+        if record is None:
+            malformed_count += 1
+            continue
+
+        records.append(record)
+        by_status[record.status] += 1
+        by_method[record.method] += 1
+        path_counts[record.path] += 1
+        latencies.append(record.latency_ms)
+        bytes_total += record.bytes
+        if record.status >= 500:
+            error_count += 1
+
+    # Calculate percentiles
+    p50 = 0.0
+    p95 = 0.0
+    if latencies:
+        latencies_sorted = sorted(latencies)
+        # Nearest-rank method: index = ceil(percentile * n) - 1
+        p50_idx = max(0, int(0.50 * len(latencies_sorted) + 0.5) - 1)
+        p95_idx = max(0, int(0.95 * len(latencies_sorted) + 0.5) - 1)
+        p50 = latencies_sorted[p50_idx]
+        p95 = latencies_sorted[p95_idx]
+
+    # Calculate error rate
+    error_rate = 0.0
+    if records:
+        error_rate = error_count / len(records)
+
+    # Get top 5 paths: sort by count descending, then path ascending
+    top_paths = sorted(
+        path_counts.items(),
+        key=lambda x: (-x[1], x[0])
+    )[:5]
+
+    return Summary(
+        total=len(records),
+        malformed=malformed_count,
+        by_status=dict(by_status),
+        by_method=dict(by_method),
+        p50_latency_ms=p50,
+        p95_latency_ms=p95,
+        bytes_total=bytes_total,
+        error_rate=error_rate,
+        top_paths=top_paths
+    )
