@@ -0,0 +1,211 @@
+import copy
+import os
+import sys
+import unittest
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
+
+from jsonpatch import apply_patch, resolve_pointer, PatchError, PointerError
+
+
+DOC = {
+    "foo": ["bar", "baz"],
+    "": 0,
+    "a/b": 1,
+    "m~n": 8,
+    "nested": {"x": {"y": 1}},
+}
+
+
+class PointerTests(unittest.TestCase):
+    def test_root(self):
+        self.assertIs(resolve_pointer(DOC, ""), DOC)
+
+    def test_rfc_examples(self):
+        self.assertEqual(resolve_pointer(DOC, "/foo"), ["bar", "baz"])
+        self.assertEqual(resolve_pointer(DOC, "/foo/0"), "bar")
+        self.assertEqual(resolve_pointer(DOC, "/"), 0)
+        self.assertEqual(resolve_pointer(DOC, "/a~1b"), 1)
+        self.assertEqual(resolve_pointer(DOC, "/m~0n"), 8)
+
+    def test_escape_order(self):
+        self.assertEqual(resolve_pointer({"~1": 5}, "/~01"), 5)
+
+    def test_invalid(self):
+        for ptr in ["foo", "/missing", "/foo/2", "/foo/01", "/foo/-", "/foo/x",
+                    "/foo/0/deeper", "/nested/x/y/z"]:
+            with self.subTest(ptr=ptr):
+                with self.assertRaises(PointerError):
+                    resolve_pointer(DOC, ptr)
+
+    def test_pointer_error_is_patch_error(self):
+        self.assertTrue(issubclass(PointerError, PatchError))
+
+
+class OpTests(unittest.TestCase):
+    def test_add_object_and_array(self):
+        self.assertEqual(apply_patch({}, [{"op": "add", "path": "/a", "value": 1}]), {"a": 1})
+        self.assertEqual(apply_patch([1, 3], [{"op": "add", "path": "/1", "value": 2}]), [1, 2, 3])
+        self.assertEqual(apply_patch([1], [{"op": "add", "path": "/-", "value": 2}]), [1, 2])
+        self.assertEqual(apply_patch([1], [{"op": "add", "path": "/1", "value": 2}]), [1, 2])
+
+    def test_add_out_of_range(self):
+        with self.assertRaises(PointerError):
+            apply_patch([1], [{"op": "add", "path": "/2", "value": 2}])
+
+    def test_add_replaces_root(self):
+        self.assertEqual(apply_patch({"a": 1}, [{"op": "add", "path": "", "value": [9]}]), [9])
+
+    def test_remove(self):
+        self.assertEqual(apply_patch({"a": 1, "b": 2}, [{"op": "remove", "path": "/a"}]), {"b": 2})
+        self.assertEqual(apply_patch([1, 2, 3], [{"op": "remove", "path": "/0"}]), [2, 3])
+        with self.assertRaises(PointerError):
+            apply_patch({"a": 1}, [{"op": "remove", "path": "/b"}])
+        with self.assertRaises(PatchError):
+            apply_patch({"a": 1}, [{"op": "remove", "path": ""}])
+
+    def test_replace(self):
+        self.assertEqual(apply_patch({"a": 1}, [{"op": "replace", "path": "/a", "value": 2}]), {"a": 2})
+        self.assertEqual(apply_patch([1, 2], [{"op": "replace", "path": "/1", "value": 9}]), [1, 9])
+        self.assertEqual(apply_patch(1, [{"op": "replace", "path": "", "value": "x"}]), "x")
+        with self.assertRaises(PointerError):
+            apply_patch({}, [{"op": "replace", "path": "/a", "value": 2}])
+
+    def test_move(self):
+        self.assertEqual(
+            apply_patch({"a": 1, "b": {}}, [{"op": "move", "from": "/a", "path": "/b/c"}]),
+            {"b": {"c": 1}},
+        )
+        self.assertEqual(apply_patch([1, 2], [{"op": "move", "from": "/0", "path": "/-"}]), [2, 1])
+
+    def test_move_into_own_child_rejected(self):
+        with self.assertRaises(PatchError):
+            apply_patch({"a": {"b": 1}}, [{"op": "move", "from": "/a", "path": "/a/b/c"}])
+        # from == path is allowed: remove then add restores the same value
+        self.assertEqual(apply_patch({"a": 1}, [{"op": "move", "from": "/a", "path": "/a"}]), {"a": 1})
+
+    def test_move_missing_source(self):
+        with self.assertRaises(PointerError):
+            apply_patch({}, [{"op": "move", "from": "/a", "path": "/b"}])
+
+    def test_copy_is_deep(self):
+        doc = {"a": {"x": [1]}}
+        out = apply_patch(doc, [{"op": "copy", "from": "/a", "path": "/b"}])
+        self.assertEqual(out, {"a": {"x": [1]}, "b": {"x": [1]}})
+        out["b"]["x"].append(2)
+        self.assertEqual(out["a"]["x"], [1])
+
+    def test_copy_missing_source(self):
+        with self.assertRaises(PointerError):
+            apply_patch({}, [{"op": "copy", "from": "/a", "path": "/b"}])
+
+    def test_test_op(self):
+        apply_patch({"a": [1, {"b": None}]}, [{"op": "test", "path": "/a", "value": [1.0, {"b": None}]}])
+        with self.assertRaises(PatchError):
+            apply_patch({"a": 1}, [{"op": "test", "path": "/a", "value": "1"}])
+
+    def test_test_bool_vs_int(self):
+        with self.assertRaises(PatchError):
+            apply_patch({"a": True}, [{"op": "test", "path": "/a", "value": 1}])
+        with self.assertRaises(PatchError):
+            apply_patch({"a": 0}, [{"op": "test", "path": "/a", "value": False}])
+        with self.assertRaises(PatchError):
+            apply_patch({"a": [1]}, [{"op": "test", "path": "/a", "value": [True]}])
+        apply_patch({"a": True}, [{"op": "test", "path": "/a", "value": True}])
+
+    def test_test_null_and_dict_keys(self):
+        with self.assertRaises(PatchError):
+            apply_patch({"a": None}, [{"op": "test", "path": "/a", "value": {}}])
+        with self.assertRaises(PatchError):
+            apply_patch({"a": {"x": 1}}, [{"op": "test", "path": "/a", "value": {"x": 1, "y": 2}}])
+
+
+class AtomicityTests(unittest.TestCase):
+    def test_failure_leaves_input_unchanged(self):
+        doc = {"a": 1}
+        snapshot = copy.deepcopy(doc)
+        patch = [
+            {"op": "add", "path": "/b", "value": 2},
+            {"op": "remove", "path": "/missing"},
+        ]
+        with self.assertRaises(PointerError):
+            apply_patch(doc, patch, in_place=True)
+        self.assertEqual(doc, snapshot)
+        with self.assertRaises(PointerError):
+            apply_patch(doc, patch)
+        self.assertEqual(doc, snapshot)
+
+    def test_not_in_place_does_not_mutate(self):
+        doc = {"a": [1]}
+        out = apply_patch(doc, [{"op": "add", "path": "/a/-", "value": 2}])
+        self.assertEqual(doc, {"a": [1]})
+        self.assertEqual(out, {"a": [1, 2]})
+
+    def test_in_place_mutates(self):
+        doc = {"a": [1]}
+        out = apply_patch(doc, [{"op": "add", "path": "/a/-", "value": 2}], in_place=True)
+        self.assertEqual(doc, {"a": [1, 2]})
+        self.assertIs(out, doc)
+
+    def test_in_place_list(self):
+        doc = [1]
+        apply_patch(doc, [{"op": "replace", "path": "/0", "value": 5}], in_place=True)
+        self.assertEqual(doc, [5])
+
+    def test_value_not_aliased(self):
+        value = {"x": 1}
+        out = apply_patch({}, [{"op": "add", "path": "/a", "value": value}])
+        out["a"]["x"] = 2
+        self.assertEqual(value, {"x": 1})
+
+    def test_ops_in_order(self):
+        out = apply_patch({}, [
+            {"op": "add", "path": "/a", "value": 1},
+            {"op": "replace", "path": "/a", "value": 2},
+        ])
+        self.assertEqual(out, {"a": 2})
+
+
+class ValidationTests(unittest.TestCase):
+    def test_bad_patch_shapes(self):
+        bad = [
+            "not an op",
+            [{"op": "add", "path": "/a", "value": 1}],
+        ]
+        with self.assertRaises(PatchError):
+            apply_patch({}, {"op": "add"})
+        for op in bad:
+            with self.subTest(op=op):
+                with self.assertRaises(PatchError):
+                    apply_patch({}, [op])
+
+    def test_unknown_op(self):
+        with self.assertRaises(PatchError):
+            apply_patch({}, [{"op": "frobnicate", "path": "/a"}])
+
+    def test_missing_fields(self):
+        cases = [
+            {"op": "add", "path": "/a"},
+            {"op": "replace", "path": "/a"},
+            {"op": "test", "path": "/a"},
+            {"op": "move", "path": "/a"},
+            {"op": "copy", "from": "/a"},
+            {"op": "remove"},
+        ]
+        for op in cases:
+            with self.subTest(op=op):
+                with self.assertRaises(PatchError):
+                    apply_patch({"a": 1}, [op])
+
+    def test_wrong_types(self):
+        with self.assertRaises(PatchError):
+            apply_patch({}, [{"op": "add", "path": 3, "value": 1}])
+        with self.assertRaises(PatchError):
+            apply_patch({"a": 1}, [{"op": "move", "from": 1, "path": "/b"}])
+
+    def test_empty_patch(self):
+        self.assertEqual(apply_patch({"a": 1}, []), {"a": 1})
+
+
+if __name__ == "__main__":
+    unittest.main()
