new file mode 100644
index 0000000..d533abb
--- /dev/null
+++ b/tests/test_pep376.py
@@ -0,0 +1,73 @@
+import io
+import zipfile
+from unittest.mock import Mock, patch
+
+import pytest
+from packaging.utils import InvalidWheelFilename
+
+from fromager.candidate import _wheel_metadata_path, get_metadata_for_wheel
+from fromager.pkgmetadata import dist_info_name, verbatim_dist_name
+
+METADATA = b"Metadata-Version: 2.1\nName: {name}\nVersion: 1.0\n"
+
+
+def test_verbatim_dist_name() -> None:
+    assert verbatim_dist_name("MarkupSafe-3.0.2-py3-none-any.whl") == "MarkupSafe"
+    assert verbatim_dist_name("foo_bar-1.0-1-py3-none-any.whl") == "foo_bar"
+
+
+def test_dist_info_name() -> None:
+    assert (
+        dist_info_name("MarkupSafe-3.0.2-py3-none-any.whl")
+        == "MarkupSafe-3.0.2.dist-info"
+    )
+    wheel = "pkg-1.0.0.RC1-1-py3-none-any.whl"
+    assert dist_info_name(wheel) == "pkg-1.0.0.RC1.dist-info"
+
+
+@pytest.mark.parametrize("func", [verbatim_dist_name, dist_info_name])
+@pytest.mark.parametrize("name", ["pkg-1.0.tar.gz", "pkg.whl", "pkg-1.0-py3.whl"])
+def test_invalid_wheel_filename(func: object, name: str) -> None:
+    with pytest.raises(InvalidWheelFilename):
+        func(name)  # type: ignore[operator]
+
+
+def test_wheel_metadata_path_ignores_query_and_fragment() -> None:
+    url = "https://pkg.test/files/MarkupSafe-3.0.2-py3-none-any.whl?x=1#sha256=ab"
+    assert _wheel_metadata_path(url) == "MarkupSafe-3.0.2.dist-info/METADATA"
+
+
+def test_wheel_metadata_path_unquotes() -> None:
+    url = "https://pkg.test/pkg-1.0%2Blocal-py3-none-any.whl"
+    assert _wheel_metadata_path(url) == "pkg-1.0+local.dist-info/METADATA"
+
+
+def _wheel_bytes(members: dict[str, bytes]) -> bytes:
+    buf = io.BytesIO()
+    with zipfile.ZipFile(buf, "w") as z:
+        for name, content in members.items():
+            z.writestr(name, content)
+    return buf.getvalue()
+
+
+@patch("fromager.candidate.session")
+def test_get_metadata_ignores_vendored_dist_info(session: Mock) -> None:
+    session.get.return_value.content = _wheel_bytes(
+        {
+            "pkg/_vendor/other-9.9.dist-info/METADATA": METADATA.replace(
+                b"{name}", b"other"
+            ),
+            "pkg-1.0.dist-info/METADATA": METADATA.replace(b"{name}", b"pkg"),
+        }
+    )
+    md = get_metadata_for_wheel("https://pkg.test/pkg-1.0-py3-none-any.whl")
+    assert md.name == "pkg"
+
+
+@patch("fromager.candidate.session")
+def test_get_metadata_missing_member(session: Mock) -> None:
+    session.get.return_value.content = _wheel_bytes(
+        {"other-9.9.dist-info/METADATA": METADATA.replace(b"{name}", b"other")}
+    )
+    with pytest.raises(ValueError, match="Could not find METADATA"):
+        get_metadata_for_wheel("https://pkg.test/pkg-1.0-py3-none-any.whl")
