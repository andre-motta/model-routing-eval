+def test_dedupe_scales_linearly_and_keeps_first_occurrence_order():
+    import time
+    from reporting import dedupe_rows, UsageRow
+
+    n = 50_000
+    rows = [UsageRow(f"e{i % (n // 2)}", "t", "s", 1.0, 1) for i in range(n)]
+    start = time.perf_counter()
+    out = dedupe_rows(rows)
+    elapsed = time.perf_counter() - start
+    assert [r.event_id for r in out] == [f"e{i}" for i in range(n // 2)]
+    # quadratic list-scan version takes tens of seconds here; linear takes milliseconds
+    assert elapsed < 2
