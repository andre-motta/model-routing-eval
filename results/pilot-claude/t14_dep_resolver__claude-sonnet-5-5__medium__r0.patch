@@ -0,0 +1,136 @@
+import itertools
+import random
+import time
+
+import pytest
+
+from resolver.solve import Constraint, ResolutionError, Version, resolve
+
+INDEX = {
+    "app": {"1.0": ["web>=2", "db"]},
+    "web": {"1.0": [], "2.0": ["json<3"], "2.1": ["json>=3"]},
+    "json": {"2.0": [], "3.0": []},
+    "db": {"1.0": ["json<3"]},
+}
+
+
+def test_version():
+    assert Version("1.0") == Version("1")
+    assert hash(Version("1.0")) == hash(Version("1"))
+    assert Version("1.10") > Version("1.9")
+    assert str(Version("1.0")) == "1.0"
+
+
+def test_constraint():
+    c = Constraint.parse("json>=2,<3")
+    assert c.name == "json"
+    assert c.allows(Version("2.5"))
+    assert not c.allows(Version("3"))
+    assert not c.allows(Version("1.9"))
+    assert Constraint.parse("db").allows(Version("0.1"))
+    assert Constraint.parse("db!=1.0").allows(Version("1.1"))
+    assert not Constraint.parse("db==1").allows(Version("1.1"))
+
+
+def test_example():
+    assert resolve(["app"], INDEX) == {
+        "app": "1.0", "web": "2.0", "json": "2.0", "db": "1.0"}
+
+
+def test_unreachable_excluded():
+    assert set(resolve(["db"], INDEX)) == {"db", "json"}
+
+
+def test_cycle():
+    idx = {"a": {"1": ["b"]}, "b": {"1": ["a"], "2": ["a<1"]}}
+    assert resolve(["a"], idx) == {"a": "1", "b": "1"}
+
+
+def test_error_names_leaf():
+    idx = {"a": {"1": ["b<1"]}, "b": {"1": [], "2": []}}
+    with pytest.raises(ResolutionError, match="b"):
+        resolve(["a"], idx)
+
+
+def test_missing_package():
+    with pytest.raises(ResolutionError, match="zzz"):
+        resolve(["a"], {"a": {"1": ["zzz"]}})
+
+
+def test_earlier_name_priority():
+    # a prefers highest; b=2 requires a<2 so b must be 1.
+    idx = {"a": {"1": [], "2": []}, "b": {"1": [], "2": ["a<2"]}}
+    assert resolve(["a", "b"], idx) == {"a": "2", "b": "1"}
+
+
+def test_late_discovered_earlier_name():
+    # c=2 pulls in a (a<c alphabetically); lower c allows higher a.
+    idx = {
+        "c": {"1": ["a>=2"], "2": ["a==1"]},
+        "a": {"1": [], "2": []},
+    }
+    assert resolve(["c"], idx) == {"c": "1", "a": "2"}
+
+
+def brute(roots, index):
+    cons = [Constraint.parse(r) for r in roots]
+    names = sorted(index)
+    best = None
+    for combo in itertools.product(*[[None] + sorted(index[n], key=Version, reverse=True)
+                                     for n in names]):
+        ch = {n: v for n, v in zip(names, combo) if v is not None}
+        # closure must be exactly reachable set
+        need, stack = set(), list(cons)
+        ok = True
+        while stack and ok:
+            c = stack.pop()
+            if c.name not in ch or not c.allows(Version(ch[c.name])):
+                ok = False
+                break
+            if c.name not in need:
+                need.add(c.name)
+                stack.extend(Constraint.parse(r) for r in index[c.name][ch[c.name]])
+        if ok and need == set(ch):
+            key = [Version(ch[n]) if n in ch else None for n in names]
+            k2 = [(0,) if v is None else (1, v) for v in key]
+            if best is None or k2 > best[0]:
+                best = (k2, ch)
+    return None if best is None else best[1]
+
+
+def test_random_vs_brute():
+    rnd = random.Random(1)
+    names = list("abcde")
+    for _ in range(150):
+        idx = {}
+        for n in names:
+            idx[n] = {}
+            for v in range(1, rnd.randint(2, 3) + 1):
+                reqs = []
+                for m in rnd.sample(names, rnd.randint(0, 2)):
+                    op = rnd.choice(["", ">=1", "<2", "<3", "==2", "!=1"])
+                    reqs.append(m + op)
+                idx[n][str(v)] = reqs
+        roots = ["a"]
+        exp = brute(roots, idx)
+        if exp is None:
+            with pytest.raises(ResolutionError):
+                resolve(roots, idx)
+        else:
+            assert resolve(roots, idx) == exp, idx
+
+
+def test_large():
+    rnd = random.Random(5)
+    n = 40
+    idx = {}
+    for i in range(n):
+        idx[f"p{i:02d}"] = {}
+        for v in range(8):
+            reqs = []
+            for j in rnd.sample(range(i + 1, n), min(3, n - i - 1)):
+                reqs.append(f"p{j:02d}>={rnd.randint(0, 3)}")
+            idx[f"p{i:02d}"][str(v)] = reqs
+    t = time.time()
+    resolve(["p00"], idx)
+    assert time.time() - t < 20
