+def test_discount_total_matches_printed_lines():
+    # Each line 0.075 rounds to 0.08 on the PDF; total must be 0.16, not 0.15.
+    inv = build_invoice("A4", [
+        ("a", "0.15", 1, percent_off("HALF", "50")),
+        ("b", "0.15", 1, percent_off("HALF", "50")),
+    ])
+    assert line_totals(inv) == [Decimal("0.08"), Decimal("0.08")]
+    assert invoice_total(inv) == sum(line_totals(inv)) == Decimal("0.16")
+
+
+def test_discount_with_tax_matches_printed_lines():
+    inv = build_invoice("A5", [
+        ("a", "0.15", 1, percent_off("HALF", "50")),
+        ("b", "0.15", 1, percent_off("HALF", "50")),
+    ], TaxRule("DE", Decimal("0.19")))
+    net = sum(line_totals(inv), Decimal("0"))
+    assert invoice_total(inv) == Decimal("0.16") + Decimal("0.03")
+    assert invoice_total(inv) == net + (net * Decimal("0.19")).quantize(Decimal("0.01"))
