@@ -0,0 +1,31 @@
+"""PEP 376 dist-info helpers for wheel filenames
+
+Wheel filenames and the ``.dist-info`` directory inside a wheel both use the
+verbatim distribution name (e.g. ``MarkupSafe``, not ``markupsafe``).
+"""
+
+from packaging.utils import parse_wheel_filename
+
+
+def verbatim_dist_name(wheel_filename: str) -> str:
+    """Return the distribution name exactly as spelled in the wheel filename.
+
+    Raises:
+        packaging.utils.InvalidWheelFilename: If the filename is not a valid wheel name
+    """
+    parse_wheel_filename(wheel_filename)
+    return wheel_filename.split("-", 1)[0]
+
+
+def dist_info_name(wheel_filename: str) -> str:
+    """Return the ``.dist-info`` directory name for a wheel filename.
+
+    The version is taken verbatim from the filename, not normalized.
+
+    Raises:
+        packaging.utils.InvalidWheelFilename: If the filename is not a valid wheel name
+    """
+    parse_wheel_filename(wheel_filename)
+    # Wheel names and versions cannot contain "-", so the second segment is the version.
+    version = wheel_filename.split("-")[1]
+    return f"{verbatim_dist_name(wheel_filename)}-{version}.dist-info"
