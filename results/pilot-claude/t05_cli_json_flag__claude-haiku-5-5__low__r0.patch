diff --git a/tests/test_cli.py b/tests/test_cli.py
index f3451ff..bf96463 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -1,3 +1,5 @@
+import json
+
 from wc.cli import main
 
 
@@ -5,3 +7,28 @@ def test_text(tmp_path, capsys):
     p = tmp_path / "a.txt"; p.write_text("hello world\nbye\n")
     assert main([str(p)]) == 0
     assert capsys.readouterr().out == f"       2       3      16 {p}\n"
+
+
+def test_json(tmp_path, capsys):
+    a = tmp_path / "a.txt"; a.write_text("hello world\nbye\n")
+    b = tmp_path / "b.txt"; b.write_text("one two\n")
+    assert main(["--json", str(a), str(b)]) == 0
+    out = json.loads(capsys.readouterr().out)
+    assert out == {
+        "files": [
+            {"path": str(a), "lines": 2, "words": 3, "chars": 16},
+            {"path": str(b), "lines": 1, "words": 2, "chars": 8},
+        ],
+        "total": {"lines": 3, "words": 5, "chars": 24},
+    }
+
+
+def test_json_missing_file(tmp_path, capsys):
+    a = tmp_path / "a.txt"; a.write_text("hi\n")
+    missing = tmp_path / "nope.txt"
+    assert main(["--json", str(a), str(missing)]) == 1
+    cap = capsys.readouterr()
+    out = json.loads(cap.out)
+    assert [f["path"] for f in out["files"]] == [str(a)]
+    assert out["total"] == {"lines": 1, "words": 1, "chars": 3}
+    assert f"wc: {missing}:" in cap.err
