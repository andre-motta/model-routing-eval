@@ -0,0 +1,21 @@
+import time
+
+from reporting import parse_rows, build_report, dedupe_rows
+
+
+def test_dedupe_keeps_first_occurrence_order():
+    rows = parse_rows(["e1,a,s,1,1", "e2,a,s,1,1", "e1,a,s,9,9", "e3,a,s,1,1"])
+    out = dedupe_rows(rows)
+    assert [r.event_id for r in out] == ["e1", "e2", "e3"]
+    assert out[0].cpu_seconds == 1.0
+
+
+def test_report_on_30k_rows_is_fast():
+    # Quadratic dedupe (list membership) takes several seconds on this size; linear takes well under one.
+    lines = [f"e{i},t{i % 50},s{i % 9},1.0,10" for i in range(30000)]
+    rows = parse_rows(lines)
+    start = time.perf_counter()
+    rep = build_report(rows)
+    elapsed = time.perf_counter() - start
+    assert rep[-1]["events"] == 30000
+    assert elapsed < 2.0, f"build_report took {elapsed:.2f}s on 30k rows"
